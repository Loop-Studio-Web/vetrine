---
import { Image } from 'astro:assets';
import logoDark from '../assets/hub/loop-logo-on-dark.svg';
import logoLight from '../assets/hub/loop-logo-on-light.svg';
import { concepts, macros, prossime, CONTACT } from './data';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// La via è divisa per macrocategoria: una riga per ogni categoria che ha vetrine aperte
// (con accanto le sue "in arrivo"); le categorie ancora senza vetrine finiscono insieme in una riga finale.
const gruppi = macros
	.map((m) => ({
		slug: m.slug as string,
		nome: m.nome as string,
		live: concepts.filter((c) => c.macro === m.slug),
		soon: prossime.filter((p) => p.macro === m.slug),
	}))
	.filter((g) => g.live.length > 0);
const soloInArrivo = prossime.filter((p) => !gruppi.some((g) => g.slug === p.macro));
// Le categorie senza vetrine si dividono per stato: "stanno per aprire" e "in cantiere"
const statiLabel = {
	presto: { titolo: 'Stanno per aprire', conto: (n: number) => `${n} ${n === 1 ? 'categoria quasi pronta' : 'categorie quasi pronte'}`, cat: 'Sta per aprire' },
	cantiere: { titolo: 'In cantiere', conto: (n: number) => `${n} ${n === 1 ? 'categoria in costruzione' : 'categorie in costruzione'}`, cat: 'In cantiere' },
} as const;
const perStato = (['presto', 'cantiere'] as const)
	.map((stato) => ({ stato, ...statiLabel[stato], lista: soloInArrivo.filter((p) => p.stato === stato) }))
	.filter((g) => g.lista.length > 0);
const haPresto = prossime.some((p) => p.stato === 'presto');

// Testo di benvenuto: i numeri si adeguano a quante vetrine ci sono davvero
const parole = ['nessuna', 'una', 'due', 'tre', 'quattro', 'cinque', 'sei', 'sette', 'otto', 'nove', 'dieci'];
const nAperte = concepts.length;
const apertePar = (parole[nAperte] ?? String(nAperte)).replace(/^./, (c) => c.toUpperCase());
const verboAperte = nAperte === 1 ? 'è già aperta' : 'sono già aperte';

// Tenda a strisce con il bordo a scalloni, uguale per ogni negozio ma nei colori del concept
function awning([a, b]: [string, string] | string[]) {
	const n = 6;
	const w = 100 / n;
	let s = '';
	for (let i = 0; i < n; i++) {
		const c = i % 2 === 0 ? a : b;
		s += `<rect x="${(i * w).toFixed(2)}" width="${(w + 0.3).toFixed(2)}" height="20" fill="${c}"/><circle cx="${(i * w + w / 2).toFixed(2)}" cy="20" r="${(w / 2).toFixed(2)}" fill="${c}"/>`;
	}
	return `<svg viewBox="0 0 100 29" preserveAspectRatio="none" aria-hidden="true" focusable="false">${s}</svg>`;
}
const soonAwning = awning(['#2b2b2e', '#1b1b1d']);
---

<section class="hero" aria-labelledby="hero-title">
	<div class="hero__glow" aria-hidden="true"></div>
	<div class="wrap hero__top">
		<p class="hero__eyebrow">
			<span class="hero__eyebrow-a">Vetrine</span>
			<span class="hero__sep" aria-hidden="true"></span>
			<span class="hero__eyebrow-b">Homepage concept di</span>
			<img class="hero__logo hero__logo--dark" src={logoDark.src} alt="Loop Studio" width="95" height="50" />
			<img class="hero__logo hero__logo--light" src={logoLight.src} alt="Loop Studio" width="95" height="50" />
		</p>
		<h1 id="hero-title" class="hero__title">
			Ogni attività ha una vetrina.
			<span class="hero__accent">La tua dovrebbe sembrare solo tua.</span>
		</h1>
		<p class="hero__lead">
			Homepage complete pensate per attività locali: identità, struttura, tipografia e movimento diversi per ogni
			tipologia. Nessun template condiviso. Dalla trattoria al pub con il palco, dal ristorante da menù degustazione al barbiere di quartiere, ognuna è disegnata
			come se fosse l’unica.
		</p>
		<div class="hero__cta">
			<a class="btn" href="#vetrine">Entra nella via <span aria-hidden="true">↓</span></a>
			<a class="btn btn--ghost" href={CONTACT}>Parliamone</a>
		</div>
	</div>

	<div class="wrap">
		<div class="welcome" data-reveal>
			<p class="eyebrow">Loop Street</p>
			<h2 class="h2 welcome__title" data-scramble>Benvenuto in Loop Street.</h2>
			<p class="welcome__text">
				Questa è la via dove abitano i nostri concept: ogni vetrina è una homepage completa, pensata da zero per un tipo di
				attività. {apertePar} {verboAperte}: entra, scorri, prova a prenotare un tavolo.
				{haPresto && ' Altre stanno per aprire, e altre'}{!haPresto && ' Altre'} sono ancora in cantiere, dietro le tende abbassate.
				Nessun modello, nessun locale vero: serve a farti vedere cosa può diventare il tuo.
			</p>
		</div>

		<div class="street" data-reveal>
			<div class="street__sign" aria-hidden="true">
				<p class="street__neon">
					<span class="nl nl--a">A</span><span class="nl">p</span><span class="nl nl--e">e</span><span class="nl nl--r">r</span><span class="nl">t</span><span class="nl">o</span>
				</p>
				<span class="street__arrow">
					<svg viewBox="0 0 36 16" width="36" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"
						><path d="M2 8h31M26 2l7 6-7 6"></path></svg
					>
				</span>
			</div>
			{
				gruppi.map((g) => (
					<div class="street__group">
						<p class="street__tag" id={`via-${g.slug}`}>
							<a href={`#${g.slug}`}>{g.nome}</a>
							<span class="street__n">{g.live.length} {g.live.length === 1 ? 'vetrina aperta' : 'vetrine aperte'}</span>
						</p>
						<ul class="street__row" role="list" aria-labelledby={`via-${g.slug}`}>
							{g.live.map((c) => (
								<li class="shop shop--live" style={`--glow:${c.glow}`}>
									<a class="shop__link" href={`${base}${c.path}`} target="_blank" rel="noopener" aria-label={`${c.nome}, ${c.archetipo.toLowerCase()}: entra nella vetrina (si apre in una nuova scheda)`}>
										<span class="shop__awning" set:html={awning(c.awning)} />
										<span class="shop__window">
											<Image
												src={c.shot}
												alt={c.shotAlt}
												widths={[320, 520, 760]}
												sizes="(min-width: 1100px) 24vw, (min-width: 700px) 22vw, min(62vw, 280px)"
												loading="eager"
												class="shop__img"
												style={`object-position:${c.crop}`}
											/>
											<span class="shop__open">Entra <span aria-hidden="true">→</span></span>
										</span>
										<span class="shop__name">{c.nome}</span>
										<span class="shop__cat">{c.archetipo}</span>
									</a>
								</li>
							))}
							{g.soon.map((p) => (
								<li class="shop shop--soon">
									<div class="shop__link">
										<span class="shop__awning" set:html={soonAwning} />
										<span class="shop__window" aria-hidden="true">
											<span class="shop__plus">+</span>
										</span>
										<span class="shop__name">{p.nome}</span>
										<span class="shop__cat">{statiLabel[p.stato].cat}</span>
									</div>
								</li>
							))}
						</ul>
					</div>
				))
			}
			{
				perStato.map((g) => (
					<div class="street__group street__group--soon">
						<p class="street__tag" id={`via-${g.stato}`}>
							<span>{g.titolo}</span>
							<span class="street__n">{g.conto(g.lista.length)}</span>
						</p>
						<ul class="street__row" role="list" aria-labelledby={`via-${g.stato}`}>
							{g.lista.map((p) => (
								<li class="shop shop--soon">
									<div class="shop__link">
										<span class="shop__awning" set:html={soonAwning} />
										<span class="shop__window" aria-hidden="true">
											<span class="shop__plus">+</span>
										</span>
										<span class="shop__name">{p.nome}</span>
										<span class="shop__cat">{p.categoria}</span>
									</div>
								</li>
							))}
						</ul>
					</div>
				))
			}
			<div class="street__ground" aria-hidden="true"></div>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		padding: clamp(120px, 16vw, 190px) 0 clamp(60px, 8vw, 110px);
		overflow: hidden;
		isolation: isolate;
	}
	.hero__glow {
		position: absolute;
		inset: -10% -10% auto -10%;
		height: 90%;
		z-index: -1;
		background:
			radial-gradient(ellipse 55% 60% at 80% 10%, color-mix(in srgb, var(--accent) 22%, transparent), transparent 70%),
			radial-gradient(ellipse 40% 50% at 10% 0%, color-mix(in srgb, var(--accent) 10%, transparent), transparent 70%);
	}
	/* Su telefono l'intestazione è su tre righe, centrate: "Vetrine", "Homepage concept di", il logo dello studio */
	.hero__eyebrow {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 6px;
		margin-bottom: 30px;
		text-align: center;
	}
	.hero__eyebrow-a {
		font-family: var(--display);
		font-weight: 800;
		font-size: clamp(1.9rem, 9vw, 2.6rem);
		line-height: 1;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		margin-right: -0.2em; /* compensa lo spazio dopo l'ultima lettera, per centrare davvero */
		color: var(--text); /* bianco nel tema scuro, nero nel chiaro */
	}
	.hero__eyebrow-b {
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--accent);
	}
	.hero__sep {
		display: none;
	}
	.hero__logo {
		display: block;
		height: 46px;
		width: auto;
		margin-top: 4px;
	}
	.hero__logo--light {
		display: none;
	}
	:global(:root[data-theme='light']) .hero__logo--dark {
		display: none;
	}
	:global(:root[data-theme='light']) .hero__logo--light {
		display: block;
	}
	.hero__title {
		font-family: var(--display);
		font-weight: 800;
		font-size: clamp(2.5rem, 6.6vw, 5.6rem);
		line-height: 1.02;
		letter-spacing: -0.035em;
		max-width: 16ch;
	}
	.hero__accent {
		display: block;
		color: var(--accent);
	}
	.hero__lead {
		margin-top: 28px;
		max-width: 56ch;
		font-size: clamp(1.05rem, 1.5vw, 1.25rem);
		color: var(--muted);
	}
	.hero__cta {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin-top: 36px;
	}

	/* Benvenuto in Loop Street */
	.welcome {
		max-width: 60ch;
		margin: clamp(56px, 8vw, 100px) auto 0;
		text-align: center;
	}
	.welcome__title {
		margin-top: 12px;
	}
	.welcome__text {
		margin-top: 18px;
		color: var(--muted);
		font-size: 1.08rem;
	}

	/* La via di negozi */
	.street {
		position: relative;
		margin-top: clamp(40px, 5vw, 64px);
	}
	@media (prefers-reduced-motion: reduce) {
		.nl,
		.street__neon {
			animation: none;
		}
		.nl--e {
			opacity: 0.3;
			text-shadow: none;
		}
	}
	/* Su telefono l'insegna sta nel flusso, centrata, con una freccia al neon che invita a scorrere */
	.street__sign {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 14px;
		margin-bottom: 28px;
		transition: opacity 0.5s;
	}
	.street.is-scrolled .street__sign .street__arrow {
		animation: none; /* altrimenti lo sfarfallio riporta l'opacità a 1 */
		opacity: 0;
	}
	/* La freccia è una targa gemella di "Aperto": stesso bordo, stesso alone, stesso sfarfallio (sfasato) */
	.street__arrow {
		display: inline-flex;
		align-items: center;
		padding: 7px 14px;
		border: 2px solid #ff3b30;
		border-radius: 10px;
		color: #ff3b30;
		filter: drop-shadow(0 0 4px rgba(255, 59, 48, 0.6));
		box-shadow: 0 0 14px rgba(255, 59, 48, 0.5), inset 0 0 10px rgba(255, 59, 48, 0.3);
		animation: neon 7s infinite -3.2s;
		transition: opacity 0.5s;
	}
	.street__arrow svg {
		display: block;
		animation: swipe 1.6s ease-in-out infinite;
	}
	:global(:root[data-theme='light']) .street__arrow {
		background: #0a0a0a;
	}
	.street__neon {
		margin: 0;
		padding: 5px 16px;
		border: 2px solid #ff3b30;
		border-radius: 10px;
		color: #ff3b30;
		font-weight: 800;
		font-size: 0.85rem;
		letter-spacing: 0.3em;
		text-transform: uppercase;
		--g: 0 0 10px rgba(255, 59, 48, 0.8);
		text-shadow: var(--g);
		box-shadow: 0 0 14px rgba(255, 59, 48, 0.5), inset 0 0 10px rgba(255, 59, 48, 0.3);
		animation: neon-box 13s infinite;
	}
	/* Insegna mezza rotta: ogni lettera ha il suo difetto. La "e" è quasi sempre spenta (il tubo si vede appena),
	   la "A" balbetta, la "r" ronza. Mai più di tre lampi al secondo, e solo quando l'insegna è in vista. */
	.nl {
		display: inline-block;
	}
	.nl--a {
		animation: nl-a 8.3s infinite;
	}
	.nl--e {
		animation: nl-e 11s infinite;
	}
	.nl--r {
		animation: nl-r 6.7s infinite;
	}
	.street:not(.is-visible) .nl,
	.street:not(.is-visible) .street__neon {
		animation-play-state: paused;
	}
	:global(:root[data-theme='light']) .street__neon {
		background: #0a0a0a;
	}
	/* La via è divisa per macrocategoria: un'etichetta (tag) e sotto la sua riga di vetrine */
	.street__group + .street__group {
		margin-top: 38px;
	}
	.street__tag {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 4px 14px;
		margin-bottom: 14px;
	}
	.street__tag > :first-child {
		font-family: var(--display);
		font-weight: 800;
		font-size: 1.3rem;
		letter-spacing: -0.02em;
		text-decoration: none;
		transition: color 0.25s;
	}
	.street__tag a:hover {
		color: var(--accent);
	}
	.street__n {
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.street__group--soon .shop__window {
		aspect-ratio: 4 / 3;
	}
	/* Su telefono la via è una riga a scorrimento orizzontale, a tutto schermo, con snap */
	.street__row {
		display: flex;
		gap: 16px;
		margin-inline: calc(var(--gutter) * -1);
		padding: 6px var(--gutter) 14px;
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scroll-snap-type: x mandatory;
		scroll-padding-inline: var(--gutter);
		-webkit-overflow-scrolling: touch;
		scrollbar-width: thin;
		scrollbar-color: var(--border) transparent;
	}
	.street__row > .shop {
		flex: 0 0 62%;
		/* Senza questo la larghezza minima segue l'immagine scelta dal browser (su iPhone, a densità 3,
		   la più grande) e le schede si allargano da sole mentre si scorre */
		min-width: 0;
		max-width: 280px;
		scroll-snap-align: start;
	}
	.shop__link {
		display: flex;
		flex-direction: column;
		text-decoration: none;
		color: inherit;
	}
	.shop__awning {
		display: block;
		line-height: 0;
		position: relative;
		z-index: 1;
		filter: drop-shadow(0 6px 8px rgba(0, 0, 0, 0.35));
	}
	.shop__awning :global(svg) {
		display: block;
		width: 100%;
		height: clamp(26px, 3.2vw, 44px);
	}
	.shop__window {
		position: relative;
		display: block;
		margin: -2px 6px 0;
		aspect-ratio: 3 / 4;
		overflow: hidden;
		border: 1px solid var(--border);
		border-radius: 4px 4px 2px 2px;
		background: var(--surface);
	}
	.shop__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 35%;
		filter: brightness(0.68) saturate(0.85);
		transform: scale(1.06);
		transition: filter 0.7s ease, transform 1.4s cubic-bezier(0.2, 0.7, 0.2, 1);
	}
	.shop--live .shop__window {
		transition: box-shadow 0.7s ease, border-color 0.7s;
	}
	.shop--live .shop__link:hover .shop__window,
	.shop--live .shop__link:focus-visible .shop__window {
		box-shadow: 0 0 70px -6px var(--glow);
		border-color: color-mix(in srgb, var(--text) 35%, transparent);
	}
	.shop--live .shop__link:hover .shop__img,
	.shop--live .shop__link:focus-visible .shop__img {
		filter: none;
		transform: scale(1);
	}
	.shop__open {
		position: absolute;
		left: 50%;
		bottom: 16px;
		transform: translate(-50%, 10px);
		padding: 9px 18px;
		border-radius: 999px;
		background: var(--text);
		color: var(--bg);
		font-size: 0.85rem;
		font-weight: 700;
		white-space: nowrap;
		opacity: 0;
		transition: opacity 0.4s, transform 0.4s;
	}
	.shop--live .shop__link:hover .shop__open,
	.shop--live .shop__link:focus-visible .shop__open {
		opacity: 1;
		transform: translate(-50%, 0);
	}
	.shop__name {
		margin-top: 14px;
		font-family: var(--display);
		font-weight: 700;
		font-size: 1.05rem;
		line-height: 1.2;
	}
	.shop__cat {
		margin-top: 2px;
		font-size: 0.82rem;
		color: var(--muted);
	}
	.shop--soon .shop__window {
		display: grid;
		place-items: center;
		background: transparent;
		border-style: dashed;
	}
	.shop__plus {
		font-size: 2.4rem;
		font-weight: 200;
		color: var(--muted);
		opacity: 0.55;
	}
	.shop--soon .shop__name {
		color: var(--muted);
	}
	.shop--soon .shop__awning {
		opacity: 0.7;
	}
	.street__ground {
		margin-top: 26px;
		height: 1px;
		background: linear-gradient(to right, transparent, var(--border) 15%, var(--border) 85%, transparent);
	}
	@keyframes swipe {
		0%, 100% { transform: translateX(0); }
		50% { transform: translateX(8px); }
	}
	@keyframes neon-box {
		0%, 92%, 100% { opacity: 1; }
		93% { opacity: 0.6; }
		94.5% { opacity: 1; }
	}
	@keyframes nl-a {
		0%, 52%, 100% { opacity: 1; text-shadow: var(--g); }
		53% { opacity: 0.18; text-shadow: none; }
		55% { opacity: 1; text-shadow: var(--g); }
		57% { opacity: 0.2; text-shadow: none; }
		59.5% { opacity: 1; text-shadow: var(--g); }
	}
	@keyframes nl-e {
		0%, 100% { opacity: 0.22; text-shadow: none; }
		18% { opacity: 0.22; text-shadow: none; }
		19% { opacity: 1; text-shadow: var(--g); }
		20.5% { opacity: 0.25; text-shadow: none; }
		22% { opacity: 1; text-shadow: var(--g); }
		24.5% { opacity: 0.22; text-shadow: none; }
		62% { opacity: 0.22; text-shadow: none; }
		63% { opacity: 1; text-shadow: var(--g); }
		65% { opacity: 0.3; text-shadow: none; }
		67% { opacity: 0.22; }
	}
	@keyframes nl-r {
		0%, 68%, 74%, 100% { opacity: 1; }
		70% { opacity: 0.5; }
		72% { opacity: 0.95; }
	}
	@keyframes neon {
		0%, 90%, 100% { opacity: 1; }
		92% { opacity: 0.3; }
		94% { opacity: 1; }
		96% { opacity: 0.45; }
		97% { opacity: 1; }
	}

	@media (min-width: 700px) {
		.street__row {
			display: grid;
			grid-template-columns: repeat(4, minmax(0, 1fr));
			gap: 22px 16px;
			margin-inline: 0;
			padding: 0;
			overflow: visible;
			scroll-snap-type: none;
		}
		.street__row > .shop {
			max-width: none;
		}
		/* Le categorie ancora vuote sono segnaposto: schede piccole, sei per riga */
		.street__group--soon .street__row {
			grid-template-columns: repeat(6, minmax(0, 1fr));
		}
		.street__group--soon .shop__name {
			font-size: 0.92rem;
		}
		/* Su schermi larghi una riga sola, a sinistra: Vetrine | Homepage concept di + logo */
		.hero__eyebrow {
			flex-direction: row;
			flex-wrap: wrap;
			justify-content: flex-start;
			gap: 14px 20px;
			text-align: left;
		}
		.hero__eyebrow-a {
			margin-right: 0;
			font-size: 1.5rem;
		}
		.hero__sep {
			display: block;
			width: 1px;
			height: 28px;
			background: var(--border);
		}
		.hero__logo {
			height: 34px;
			margin: 0 0 0 -6px;
		}
		/* Su schermi larghi l'insegna è più grande e centrata sopra la via */
		.street__sign {
			margin-bottom: 44px;
		}
		.street__neon {
			padding: 9px 34px;
			border-width: 3px;
			border-radius: 14px;
			font-size: 1.35rem;
			--g: 0 0 14px rgba(255, 59, 48, 0.85);
			box-shadow: 0 0 22px rgba(255, 59, 48, 0.55), inset 0 0 14px rgba(255, 59, 48, 0.3);
		}
		.street__arrow {
			display: none;
		}
	}
	@media (min-width: 1100px) {
		.street__row {
			gap: 22px 18px;
			align-items: start;
		}
	}
	/* ——— Scena di strada (prova): facciate, tetti, lampioni, marciapiede e carreggiata ———
	   Tema scuro = notte (lampioni accesi), tema chiaro = giorno (lampioni spenti). Solo CSS. */
	.street {
		--wall: #131315;
		--wall-edge: #2a2a2e;
		--roof: #232328;
		--walk: #222226;
		--kerb: #3a3a40;
		--road: #0b0b0c;
		--lane: #5a5a60;
		--pole: #3a3a40;
		--lamp: #ffd9a0;
		--lamp-glow: rgba(255, 200, 120, 0.55);
		--ground: 40px;
	}
	:global(:root[data-theme='light']) .street {
		--wall: #ece9e4;
		--wall-edge: #cfcbc4;
		--roof: #cfcac1;
		--walk: #dedbd5;
		--kerb: #b9b5ad;
		--road: #c4c1ba;
		--lane: #f5f3ef;
		--pole: #8d8a84;
		--lamp: #f4efe4;
		--lamp-glow: transparent;
	}
	.street__group {
		position: relative;
		padding-bottom: var(--ground);
	}
	/* Marciapiede + cordolo + carreggiata con la linea tratteggiata */
	.street__group::after {
		content: '';
		position: absolute;
		inset: auto calc(var(--gutter) * -1) 0;
		height: var(--ground);
		background:
			repeating-linear-gradient(90deg, var(--lane) 0 26px, transparent 26px 56px) 0 calc(100% - 7px) / 100% 3px no-repeat,
			linear-gradient(to bottom, var(--kerb) 0 3px, var(--walk) 3px 14px, var(--kerb) 14px 17px, var(--road) 17px);
		-webkit-mask: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
		mask: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
		pointer-events: none;
	}
	.street__row {
		position: relative;
		z-index: 1;
		padding-bottom: 0;
	}
	.shop {
		position: relative;
	}
	.shop__link {
		background: var(--wall);
		border: 1px solid var(--wall-edge);
		border-top: 0;
		padding: 0 8px 14px;
		margin-top: 0;
	}
	.shop__awning {
		margin-inline: -8px;
	}
	.shop__window {
		margin-inline: 0;
	}
	/* Tetto: un profilo diverso per ogni negozio (frontone, parapetto a gradini, camino, arco) */
	.shop__link::before {
		content: '';
		display: block;
		height: 34px;
		margin: 0 -9px;
		background: var(--roof);
		border: 1px solid var(--wall-edge);
		border-bottom: 0;
		clip-path: polygon(0 100%, 0 0, 100% 0, 100% 100%);
	}
	.shop:nth-child(4n + 1) .shop__link::before {
		clip-path: polygon(0 100%, 50% 0, 100% 100%);
		border: 0;
	}
	.shop:nth-child(4n + 2) .shop__link::before {
		clip-path: polygon(0 100%, 0 40%, 22% 40%, 22% 0, 78% 0, 78% 40%, 100% 40%, 100% 100%);
		border: 0;
	}
	.shop:nth-child(4n + 3) .shop__link::before {
		clip-path: polygon(0 100%, 0 30%, 68% 30%, 68% 0, 82% 0, 82% 30%, 100% 30%, 100% 100%);
		border: 0;
	}
	.shop:nth-child(4n) .shop__link::before {
		border-radius: 50% 50% 0 0 / 100% 100% 0 0;
		clip-path: none;
		border: 0;
	}
	/* Il nome sta sulla targa: una fascia sotto la vetrina, sopra il gradino */
	.shop__name {
		margin-top: 12px;
	}
	.shop__link:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}
	/* Lampione nello spazio tra due negozi */
	.shop:not(:last-child)::before,
	.shop:not(:last-child)::after {
		content: '';
		position: absolute;
		pointer-events: none;
	}
	.shop:not(:last-child)::after {
		right: -9.5px;
		bottom: 0;
		width: 3px;
		height: 52%;
		background: var(--pole);
		z-index: 2;
	}
	.shop:not(:last-child)::before {
		right: -16px;
		bottom: calc(52% - 2px);
		width: 17px;
		height: 9px;
		border-radius: 7px 7px 2px 2px;
		background: var(--lamp);
		box-shadow: 0 0 22px 8px var(--lamp-glow), 0 22px 40px 6px color-mix(in srgb, var(--lamp-glow) 40%, transparent);
		z-index: 2;
	}
	@media (prefers-reduced-motion: no-preference) {
		.street.is-visible .shop:not(:last-child)::before {
			animation: lamp-on 1.2s ease-out both;
			animation-delay: calc(var(--i, 0) * 0.15s);
		}
	}
	@keyframes lamp-on {
		0%, 30% { opacity: 0; }
		38% { opacity: 0.9; }
		44% { opacity: 0.3; }
		60%, 100% { opacity: 1; }
	}
	.street__group--soon .shop__link::before {
		background: #1b1b1d;
	}
	:global(:root[data-theme='light']) .street__group--soon .shop__link::before {
		background: var(--roof);
	}
	@media (min-width: 700px) {
		.street__group::after {
			inset-inline: 0;
		}
	}
	@media (hover: none) {		/* Sul touch non c'è hover: le vetrine aperte restano accese */
		.shop--live .shop__img {
			filter: none;
			transform: none;
		}
		.shop__open {
			opacity: 1;
			transform: translate(-50%, 0);
		}
	}
</style>

<script>
	// La freccia al neon sparisce quando la via viene scorsa per la prima volta
	const street = document.querySelector<HTMLElement>('.street');
	const rows = street?.querySelectorAll<HTMLElement>('.street__row') ?? [];
	rows.forEach((row) =>
		row.addEventListener('scroll', () => street!.classList.add('is-scrolled'), { passive: true, once: true }),
	);
	// Una riga che scorre ma non ha link (le "in arrivo") deve poter ricevere il focus, per scorrerla da tastiera
	const focusable = () =>
		rows.forEach((row) => {
			if (row.querySelector('a')) return;
			if (row.scrollWidth > row.clientWidth + 1) row.setAttribute('tabindex', '0');
			else row.removeAttribute('tabindex');
		});
	focusable();
	addEventListener('resize', focusable);
</script>

---
// Perché queste vetrine: tre principi e quattro numeri. I numeri vengono dai test reali (axe-core e Lighthouse su mobile).
const numeri = [
	{ n: '2', t: 'vetrine aperte', s: 'e altre in costruzione, una alla volta' },
	{ n: '0', t: 'componenti condivisi', s: 'ogni vetrina nasce da zero' },
	{ n: '0', t: 'violazioni di accessibilità', s: 'verificate con axe-core' },
	{ n: '97+', t: 'performance su mobile', s: 'Lighthouse, build di produzione' },
];
const principi = [
	{
		t: 'Un’identità per ogni attività',
		d: 'Non cambiamo i colori a un template. Ogni vetrina ha struttura, tipografia, ritmo e movimento propri, perché ogni attività ha un modo suo di farsi riconoscere.',
	},
	{
		t: 'Veloci e accessibili, sul serio',
		d: 'Si caricano in un attimo anche da telefono e si usano da tastiera e con lettori di schermo. Non è un extra: è parte del lavoro finito.',
	},
	{
		t: 'Pulite, senza zone d’ombra',
		d: 'Font e immagini sono nostri, nessun tracciamento, nessuna dipendenza nascosta. Quello che vedi è tutto quello che c’è.',
	},
];
---

<section class="metodo" aria-labelledby="metodo-title">
	<div class="wrap">
		<header class="metodo__head" data-reveal>
			<p class="eyebrow">Come le costruiamo</p>
			<h2 id="metodo-title" class="h2">Una vetrina funziona se si nota. E se funziona.</h2>
		</header>

		<ul class="numeri" role="list">
			{
				numeri.map((x, i) => (
					<li data-reveal style={`--d:${i * 0.08}s`}>
						<strong>{x.n}</strong>
						<span class="numeri__t">{x.t}</span>
						<span class="numeri__s">{x.s}</span>
					</li>
				))
			}
		</ul>

		<ul class="principi" role="list">
			{
				principi.map((p, i) => (
					<li class="principio" data-reveal style={`--d:${i * 0.1}s`}>
						<span class="principio__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
						<h3>{p.t}</h3>
						<p>{p.d}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.metodo {
		padding: clamp(70px, 10vw, 140px) 0;
	}
	.metodo__head {
		max-width: 30ch;
	}
	.metodo__head .h2 {
		margin-top: 14px;
	}
	.numeri {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1px;
		margin-top: clamp(40px, 6vw, 70px);
		background: var(--border);
		border: 1px solid var(--border);
		border-radius: 20px;
		overflow: hidden;
	}
	.numeri li {
		display: flex;
		flex-direction: column;
		padding: clamp(22px, 3vw, 36px);
		background: var(--bg);
	}
	.numeri strong {
		font-family: var(--display);
		font-weight: 800;
		font-size: clamp(2.6rem, 6vw, 4.6rem);
		line-height: 1;
		letter-spacing: -0.04em;
		color: var(--accent);
	}
	.numeri__t {
		margin-top: 12px;
		font-weight: 600;
		line-height: 1.3;
	}
	.numeri__s {
		margin-top: 4px;
		font-size: 0.88rem;
		color: var(--muted);
	}
	.principi {
		display: grid;
		gap: 18px;
		margin-top: 28px;
	}
	.principio {
		position: relative;
		padding: clamp(26px, 3vw, 38px);
		border: 1px solid var(--border);
		border-radius: 20px;
		background: var(--bg-2);
	}
	.principio__n {
		font-family: var(--display);
		font-weight: 800;
		font-size: 0.95rem;
		color: var(--accent);
	}
	.principio h3 {
		margin-top: 16px;
		font-family: var(--display);
		font-weight: 700;
		font-size: 1.45rem;
		line-height: 1.15;
		letter-spacing: -0.02em;
	}
	.principio p {
		margin-top: 12px;
		color: var(--muted);
	}
	@media (min-width: 800px) {
		.numeri {
			grid-template-columns: repeat(4, 1fr);
		}
		.principi {
			grid-template-columns: repeat(3, 1fr);
		}
	}
</style>

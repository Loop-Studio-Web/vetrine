---
import logoDark from '../assets/hub/loop-logo-on-dark.svg';
import logoLight from '../assets/hub/loop-logo-on-light.svg';
import { SITE, CONTACT } from './data';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="hdr" data-hdr>
	<div class="hdr__in wrap">
		<a class="hdr__logo" href={SITE} aria-label="Loop Studio, torna al sito dello studio">
			<img class="logo logo--dark" src={logoDark.src} alt="" width="95" height="50" />
			<img class="logo logo--light" src={logoLight.src} alt="" width="95" height="50" />
		</a>
		<nav class="hdr__nav" aria-label="Sezioni">
			<a href={`${base}/#vetrine`}>Le vetrine</a>
			<a href={`${base}/#prossime`}>Prossime</a>
			<a href={SITE}>Sito dello studio <span aria-hidden="true">↗</span></a>
		</nav>
		<div class="hdr__tools">
			<button type="button" class="hdr__theme" data-theme-toggle aria-label="Passa al tema chiaro">
				<span class="hdr__tip" aria-hidden="true">
					<span class="tip-dark">Modalità scura</span>
					<span class="tip-light">Modalità chiara</span>
				</span>
					<span class="trk" aria-hidden="true">
						<span class="thumb">
							<span class="st st1"></span><span class="st st2"></span><span class="st st3"></span><span class="st st4"></span>
							<span class="cl cl1"></span><span class="cl cl2"></span>
						</span>
						<svg class="ic ic--sun" viewBox="0 0 24 24" fill="currentColor">
							<circle cx="12" cy="12" r="4.6"></circle>
							<g class="raggi" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
								<path d="M12 1.6v2.8M12 19.6v2.8M1.6 12h2.8M19.6 12h2.8M4.65 4.65l2 2M17.35 17.35l2 2M4.65 19.35l2-2M17.35 6.65l2-2"></path>
							</g>
						</svg>
						<svg class="ic ic--moon" viewBox="0 0 24 24" fill="currentColor">
							<path d="M20.6 14.6A9 9 0 0 1 9.4 3.4a9 9 0 1 0 11.2 11.2Z"></path>
						</svg>
					</span>
			</button>
			<a class="btn btn--sm hdr__cta" href={CONTACT}>Parliamone</a>
			<button type="button" class="hdr__burger" aria-expanded="false" aria-controls="hub-menu" aria-label="Apri il menu" data-burger>
				<span class="hdr__bar"></span>
				<span class="hdr__bar"></span>
			</button>
		</div>
	</div>
</header>

<nav class="menu" id="hub-menu" aria-label="Menu" data-menu inert>
	<div class="menu__nav">
		<a href={`${base}/#vetrine`} style="--i:0"><span class="menu__n" aria-hidden="true">01</span>Le vetrine</a>
		<a href={`${base}/#prossime`} style="--i:1"><span class="menu__n" aria-hidden="true">02</span>Prossime</a>
		<a href={SITE} style="--i:2"><span class="menu__n" aria-hidden="true">03</span>Il sito dello studio <span aria-hidden="true">↗</span></a>
	</div>
	<a class="btn menu__cta" href={CONTACT} style="--i:3">Parliamone <span aria-hidden="true">→</span></a>
</nav>

<style>
	.hdr {
		position: fixed;
		inset: 0 0 auto 0;
		z-index: 100;
		transition: padding 0.4s;
	}
	.hdr::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: color-mix(in srgb, var(--bg) 78%, transparent);
		-webkit-backdrop-filter: blur(16px) saturate(1.2);
		backdrop-filter: blur(16px) saturate(1.2);
		border-bottom: 1px solid var(--border);
		opacity: 0;
		transition: opacity 0.4s;
	}
	.hdr.is-scrolled::before {
		opacity: 1;
	}
	.hdr__in {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		padding-block: 18px;
		transition: padding 0.4s;
	}
	.hdr.is-scrolled .hdr__in {
		padding-block: 10px;
	}
	.hdr__logo {
		display: inline-flex;
		line-height: 0;
	}
	/* misure del sito dello studio: 52 px, 42 px quando si scorre, con il piccolo scarto ottico verso il basso */
	.logo {
		height: 52px;
		width: auto;
		transform: translateY(2px);
		transition: height 0.3s ease;
	}
	.hdr.is-scrolled .logo {
		height: 42px;
	}
	.logo--light {
		display: none;
	}
	:global(:root[data-theme='light']) .logo--dark {
		display: none;
	}
	:global(:root[data-theme='light']) .logo--light {
		display: block;
	}
	.hdr__nav {
		display: none;
		gap: 34px;
	}
	.hdr__nav a {
		position: relative;
		font-size: 1rem;
		font-weight: 500;
		text-decoration: none;
		color: var(--text);
		padding: 4px 0;
	}
	/* la riga rossa che si disegna da sinistra: stessa del sito dello studio */
	.hdr__nav a::after {
		content: '';
		position: absolute;
		left: 0;
		bottom: 0;
		width: 100%;
		height: 2px;
		background: var(--accent);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.3s ease;
	}
	.hdr__nav a:hover::after,
	.hdr__nav a:focus-visible::after {
		transform: scaleX(1);
	}
	.hdr__tools {
		display: flex;
		align-items: center;
		gap: 12px;
	}
	/* Interruttore tema "liquid glass": una pillola di vetro con sole e luna sempre visibili e un selettore di vetro
	   che scorre da uno all'altra (si allunga mentre lo premi). Nessun colore di fondo: il vetro prende la pagina.
	   Dentro il selettore, di notte brillano le stelle, di giorno girano i pianeti. */
	.hdr__theme {
		--w: 98px;
		--h: 40px;
		--pad: 4px;
		--tw: 46px;
		--corsa: calc(var(--w) - var(--tw) - 2 * var(--pad));
		--molla: cubic-bezier(0.3, 1.35, 0.5, 1);
		--muto: color-mix(in srgb, var(--text) 40%, transparent);
		--sole: var(--accent);
		--luna: #fff;
		--vetro: rgba(255, 255, 255, 0.07);
		--bordo-alto: rgba(255, 255, 255, 0.55);
		--bordo-basso: rgba(255, 255, 255, 0.14);
		position: relative;
		width: var(--w);
		height: var(--h);
		padding: 0;
		border: 0;
		border-radius: 999px;
		background: transparent;
		color: var(--text);
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
	}
	:global(:root[data-theme='light']) .hdr__theme {
		--vetro: rgba(0, 0, 0, 0.035);
		--bordo-alto: rgba(255, 255, 255, 0.95);
		--bordo-basso: rgba(0, 0, 0, 0.12);
	}
	.hdr__theme:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}
	.trk {
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background: linear-gradient(160deg, var(--vetro), transparent 70%);
		-webkit-backdrop-filter: blur(10px) saturate(1.5);
		backdrop-filter: blur(10px) saturate(1.5);
		box-shadow:
			inset 1.5px 1.5px 1px -0.5px var(--bordo-alto),
			inset -1.5px -1.5px 1px -0.5px var(--bordo-basso),
			inset 0 0 0 1px var(--border),
			0 6px 16px rgba(0, 0, 0, 0.22);
		transition: box-shadow 0.3s ease;
	}
	.hdr__theme:hover .trk {
		box-shadow:
			inset 1.5px 1.5px 1px -0.5px var(--bordo-alto),
			inset -1.5px -1.5px 1px -0.5px var(--bordo-basso),
			inset 0 0 0 1px var(--accent),
			0 6px 16px rgba(0, 0, 0, 0.22);
	}
	/* selettore di vetro */
	.thumb {
		position: absolute;
		top: var(--pad);
		left: var(--pad);
		width: var(--tw);
		height: calc(var(--h) - 2 * var(--pad));
		overflow: hidden;
		border-radius: 999px;
		background: linear-gradient(155deg, rgba(255, 255, 255, 0.34), rgba(255, 255, 255, 0.08) 55%, rgba(255, 255, 255, 0.18));
		-webkit-backdrop-filter: blur(3px) brightness(1.18) saturate(1.5);
		backdrop-filter: blur(3px) brightness(1.18) saturate(1.5);
		box-shadow:
			inset 0 1.5px 1px rgba(255, 255, 255, 0.85),
			inset 0 -2px 4px rgba(255, 255, 255, 0.2),
			inset 0 0 0 1px rgba(255, 255, 255, 0.3),
			0 3px 10px rgba(0, 0, 0, 0.3);
		translate: var(--corsa) 0;
		transition: translate 0.65s var(--molla), width 0.3s var(--molla);
	}
	:global(:root[data-theme='light']) .thumb {
		translate: 0 0;
		background: linear-gradient(155deg, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0.55) 55%, rgba(255, 255, 255, 0.8));
		box-shadow:
			inset 0 1.5px 1px #fff,
			inset 0 -2px 4px rgba(0, 0, 0, 0.06),
			inset 0 0 0 1px rgba(0, 0, 0, 0.1),
			0 3px 10px rgba(0, 0, 0, 0.16);
	}
	/* premuto: il selettore si allunga verso il lato opposto */
	.hdr__theme:active .thumb {
		transition: translate 0.25s var(--molla), width 0.25s var(--molla);
		width: calc(var(--tw) + 12px);
		translate: calc(var(--corsa) - 12px) 0;
	}
	:global(:root[data-theme='light']) .hdr__theme:active .thumb {
		translate: 0 0;
	}
	/* sole e luna: stanno sul vetro, sopra il selettore; quella scelta si accende */
	.ic {
		position: absolute;
		top: 11px;
		width: 18px;
		height: 18px;
		overflow: visible;
		pointer-events: none;
		color: var(--muto);
		transition: color 0.4s ease, transform 0.6s var(--molla);
	}
	.ic--sun {
		left: calc(var(--pad) + var(--tw) / 2 - 9px);
	}
	.ic--moon {
		right: calc(var(--pad) + var(--tw) / 2 - 9px);
	}
	.ic--moon {
		color: var(--luna);
		transform: rotate(0deg) scale(1.08);
	}
	.raggi {
		transform-origin: 12px 12px;
		transition: transform 0.7s var(--molla);
		transform: rotate(45deg);
	}
	:global(:root[data-theme='light']) .ic--sun {
		color: var(--sole);
		transform: scale(1.08);
	}
	:global(:root[data-theme='light']) .ic--sun .raggi {
		transform: rotate(0deg);
	}
	:global(:root[data-theme='light']) .ic--moon {
		color: var(--muto);
		transform: rotate(-25deg) scale(1);
	}
	:global(:root:not([data-theme='light'])) .ic--sun {
		transform: scale(1);
	}
	/* dentro il selettore: stelle di notte, pianeti di giorno */
	.st,
	.cl {
		position: absolute;
		display: block;
		transition: transform 0.5s var(--molla), opacity 0.35s ease;
		transition-delay: var(--d, 0s);
	}
	.st {
		background: #fff;
		border-radius: 50%;
		box-shadow: 0 0 5px rgba(255, 255, 255, 0.9);
		animation: twinkle 2.6s ease-in-out infinite;
		animation-delay: var(--t, 0s);
	}
	.st1 {
		left: 6px;
		top: 6px;
		width: 6px;
		height: 6px;
		border-radius: 0;
		clip-path: polygon(50% 0, 62% 38%, 100% 50%, 62% 62%, 50% 100%, 38% 62%, 0 50%, 38% 38%);
		--d: 0.15s;
	}
	.st2 {
		left: 9px;
		top: 21px;
		width: 2px;
		height: 2px;
		--d: 0.22s;
		--t: 0.8s;
	}
	.st3 {
		right: 7px;
		top: 6px;
		width: 3px;
		height: 3px;
		--d: 0.3s;
		--t: 1.4s;
	}
	.st4 {
		right: 6px;
		top: 20px;
		width: 5px;
		height: 5px;
		border-radius: 0;
		clip-path: polygon(50% 0, 62% 38%, 100% 50%, 62% 62%, 50% 100%, 38% 62%, 0 50%, 38% 38%);
		background: var(--accent);
		box-shadow: none;
		--d: 0.26s;
		--t: 0.4s;
	}
	:global(:root[data-theme='light']) .st {
		opacity: 0;
		transform: scale(0.2);
		transition-delay: 0s;
		animation: none;
	}
	/* nuvolette (grigio chiaro sul chiaro): sbucano da dietro il sole (l'icona sta sopra il selettore), solo di giorno */
	.cl {
		height: 6px;
		border-radius: 999px;
		background: #d3d6dc;
		opacity: 0;
		transform: translateX(-10px) scale(0.5);
	}
	.cl::before {
		content: '';
		position: absolute;
		left: 28%;
		top: -3px;
		width: 42%;
		height: 6px;
		border-radius: 50%;
		background: #d3d6dc;
	}
	.cl1 {
		left: 7px;
		top: 19px;
		width: 16px;
		--d: 0.2s;
	}
	.cl2 {
		left: 25px;
		top: 8px;
		width: 14px;
		--d: 0.32s;
	}
	:global(:root[data-theme='light']) .cl {
		opacity: 1;
		transform: none;
		animation: fluttua 6s ease-in-out infinite;
	}
	:global(:root[data-theme='light']) .cl2 {
		animation-delay: -3s;
	}
	/* selettore chiaro: carta, con nuvole grigie */
	:global(:root[data-theme='light']) .thumb {
		background: linear-gradient(155deg, rgba(255, 255, 255, 0.98), rgba(236, 236, 238, 0.9) 85%);
	}
	@keyframes twinkle {
		0%,
		100% {
			opacity: 1;
		}
		50% {
			opacity: 0.3;
		}
	}
	@keyframes fluttua {
		0%,
		100% {
			translate: 0 0;
		}
		50% {
			translate: 2px 0;
		}
	}
	/* animazione dell'icona scelta, solo al clic (classe .anim messa dallo script) */
	.hdr__theme.anim .ic--moon {
		animation: luna-click 0.9s var(--molla) 0.12s both;
	}
	:global(:root[data-theme='light']) .hdr__theme.anim .ic--sun .raggi {
		animation: sole-click 1s cubic-bezier(0.2, 0.7, 0.2, 1) 0.1s both;
	}
	:global(:root[data-theme='light']) .hdr__theme.anim .ic--sun {
		animation: sole-pulsa 0.8s var(--molla) 0.1s both;
	}
	:global(:root[data-theme='light']) .hdr__theme.anim .ic--moon {
		animation: none;
	}
	@keyframes luna-click {
		from {
			rotate: -70deg;
			scale: 0.5;
		}
		to {
			rotate: 0deg;
			scale: 1;
		}
	}
	@keyframes sole-click {
		from {
			rotate: -120deg;
		}
		to {
			rotate: 0deg;
		}
	}
	@keyframes sole-pulsa {
		from {
			scale: 0.6;
		}
		to {
			scale: 1;
		}
	}
	@media (hover: hover) and (pointer: fine) {
		.hdr__theme:hover .thumb {
			translate: calc(var(--corsa) - 3px) 0;
		}
		:global(:root[data-theme='light']) .hdr__theme:hover .thumb {
			translate: 3px 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.st,
		.cl,
		.thumb,
		.ic,
		.raggi {
			transition-duration: 0.01s;
			transition-delay: 0s;
			animation: none !important;
		}
	}
	/* l'etichetta dice dove porta il clic: nel tema scuro "Modalità chiara", nel chiaro "Modalità scura" */
	.hdr__tip {
		position: absolute;
		top: calc(100% + 10px);
		right: 0;
		padding: 0.35rem 0.75rem;
		border-radius: 999px;
		border: 1px solid var(--border);
		background: color-mix(in srgb, var(--surface) 94%, transparent);
		color: var(--text);
		font-size: 0.8rem;
		font-weight: 600;
		line-height: 1.2;
		white-space: nowrap;
		opacity: 0;
		transform: translateY(-4px);
		pointer-events: none;
		transition: opacity 0.2s ease, transform 0.2s ease;
	}
	.tip-dark {
		display: none;
	}
	:global(:root[data-theme='light']) .tip-dark {
		display: inline;
	}
	:global(:root[data-theme='light']) .tip-light {
		display: none;
	}
	.hdr__theme:focus-visible .hdr__tip {
		opacity: 1;
		transform: none;
	}
	@media (hover: hover) and (pointer: fine) {
		.hdr__theme:hover .hdr__tip {
			opacity: 1;
			transform: none;
		}
	}
	/* dopo il clic l'etichetta resta nascosta finché il mouse non esce: durante il cambio tema l'hover si perde e torna */
	.hdr__theme.is-clicked .hdr__tip {
		opacity: 0;
		transform: translateY(-4px);
		transition: none;
	}
	/* Menu su telefono: il pannello si apre a cerchio dal pulsante, le voci salgono una dopo l'altra */
	.hdr__burger {
		display: grid;
		place-content: center;
		gap: 6px;
		width: 42px;
		height: 42px;
		border-radius: 50%;
		border: 1px solid var(--border);
		background: transparent;
		color: var(--text);
		cursor: pointer;
		transition: background 0.25s, border-color 0.25s;
	}
	.hdr__burger:hover {
		background: var(--surface);
	}
	.hdr__bar {
		display: block;
		width: 18px;
		height: 2px;
		border-radius: 2px;
		background: currentColor;
		transition: transform 0.45s cubic-bezier(0.7, 0, 0.2, 1);
	}
	.hdr__burger[aria-expanded='true'] {
		background: var(--accent-strong);
		border-color: var(--accent-strong);
		color: var(--on-accent);
	}
	.hdr__burger[aria-expanded='true'] .hdr__bar:first-child {
		transform: translateY(4px) rotate(45deg);
	}
	.hdr__burger[aria-expanded='true'] .hdr__bar:last-child {
		transform: translateY(-4px) rotate(-45deg);
	}
	.menu {
		position: fixed;
		inset: 0;
		z-index: 99;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 36px;
		padding: 96px var(--gutter) 40px;
		background: var(--bg);
		clip-path: circle(0 at calc(100% - 40px) 40px);
		visibility: hidden;
		transition: clip-path 0.7s cubic-bezier(0.7, 0, 0.2, 1), visibility 0s 0.7s;
	}
	.menu::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: radial-gradient(ellipse 70% 50% at 100% 0%, color-mix(in srgb, var(--accent) 24%, transparent), transparent 70%);
	}
	.menu.is-open {
		clip-path: circle(150% at calc(100% - 40px) 40px);
		visibility: visible;
		transition: clip-path 0.7s cubic-bezier(0.7, 0, 0.2, 1), visibility 0s;
	}
	.menu__nav {
		display: grid;
	}
	.menu__nav a {
		display: flex;
		align-items: baseline;
		gap: 16px;
		padding: 16px 0;
		border-bottom: 1px solid var(--border);
		font-family: var(--display);
		font-weight: 800;
		font-size: clamp(2rem, 9vw, 3rem);
		line-height: 1.05;
		letter-spacing: -0.03em;
		text-decoration: none;
	}
	.menu__n {
		font-family: var(--sans);
		font-weight: 600;
		font-size: 0.8rem;
		letter-spacing: 0.1em;
		color: var(--accent);
	}
	.menu__nav a,
	.menu__cta {
		opacity: 0;
		transform: translateY(24px);
		transition: opacity 0.4s, transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
	}
	.menu.is-open .menu__nav a,
	.menu.is-open .menu__cta {
		opacity: 1;
		transform: none;
		transition-delay: calc(0.3s + var(--i) * 0.08s);
	}
	.menu__cta {
		align-self: flex-start;
	}
	:global(html.menu-open) {
		overflow: hidden;
	}
	@media (max-width: 520px) {
		.hdr__cta {
			display: none;
		}
	}
	@media (min-width: 900px) {
		.hdr__nav {
			display: flex;
		}
		.hdr__burger,
		.menu {
			display: none;
		}
	}

	/* Cerchio che si espande dal pulsante: solo durante il click sul tema (classe messa dallo script) */
	:global(html.theme-transition::view-transition-old(root)),
	:global(html.theme-transition::view-transition-new(root)) {
		animation: none;
		mix-blend-mode: normal;
	}
	:global(html.theme-swap *),
	:global(html.theme-swap *::before),
	:global(html.theme-swap *::after) {
		transition: none !important;
	}
</style>

<script>
	const hdr = document.querySelector<HTMLElement>('[data-hdr]');
	const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
	const root = document.documentElement;

	if (hdr) {
		const upd = () => {
			hdr.classList.toggle('is-scrolled', scrollY > 24);
			// avanzamento della pagina per la barra in cima
			const tot = document.documentElement.scrollHeight - innerHeight;
			root.style.setProperty('--scroll', String(tot > 0 ? Math.min(1, scrollY / tot) : 0));
		};
		addEventListener('resize', upd);
		addEventListener('scroll', upd, { passive: true });
		upd();
	}

	// Menu su telefono: apri/chiudi, Esc, link, ritorno del focus, blocco dello scorrimento
	const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
	const menu = document.querySelector<HTMLElement>('[data-menu]');
	if (burger && menu) {
		const set = (open: boolean) => {
			menu.classList.toggle('is-open', open);
			menu.toggleAttribute('inert', !open);
			root.classList.toggle('menu-open', open);
			burger.setAttribute('aria-expanded', String(open));
			burger.setAttribute('aria-label', open ? 'Chiudi il menu' : 'Apri il menu');
			if (open) menu.querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
		};
		burger.addEventListener('click', () => set(burger.getAttribute('aria-expanded') !== 'true'));
		menu.querySelectorAll('a').forEach((a) =>
			a.addEventListener('click', () => {
				// Chiude subito: l'ancora scorre la pagina sotto il pannello che si ritira
				set(false);
			}),
		);
		addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && burger.getAttribute('aria-expanded') === 'true') {
				set(false);
				burger.focus();
			}
		});
		matchMedia('(min-width: 900px)').addEventListener('change', (e) => e.matches && set(false));
	}

	if (btn) {
		const label = () => {
			const light = root.getAttribute('data-theme') === 'light';
			btn.setAttribute('aria-label', light ? 'Passa al tema scuro' : 'Passa al tema chiaro');
			document.querySelector('meta[name="theme-color"]')?.setAttribute('content', light ? '#ffffff' : '#000000');
		};
		label();
		// Cambio tema come sul sito dello studio: un cerchio si espande dal pulsante (View Transitions).
		// Durante il cambio nessuna transizione CSS (theme-swap), altrimenti il testo cambia colore
		// all'istante mentre lo sfondo sfuma. Senza View Transitions o con "riduci animazioni": scambio netto.
		const pulisci = () => btn.classList.remove('is-clicked');
		btn.addEventListener('mouseleave', pulisci);
		btn.addEventListener('blur', pulisci);
		btn.addEventListener('click', (event) => {
			btn.classList.add('is-clicked');
			// animazione di sole/luna solo al clic: riparte a ogni clic
			btn.classList.remove('anim');
			void btn.offsetWidth;
			btn.classList.add('anim');
			setTimeout(() => btn.classList.remove('anim'), 1300);
			const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
			const apply = () => {
				root.setAttribute('data-theme', next);
				try {
					localStorage.setItem('vetrine-theme', next);
				} catch (e) {}
				label();
			};
			root.classList.add('theme-swap');
			const fine = () => root.classList.remove('theme-swap');
			if (matchMedia('(prefers-reduced-motion: reduce)').matches || !document.startViewTransition) {
				apply();
				requestAnimationFrame(() => requestAnimationFrame(fine));
				return;
			}
			// il cerchio parte dal punto cliccato (o dal centro del pulsante se da tastiera)
			const r = btn.getBoundingClientRect();
			const x = event.clientX || r.left + r.width / 2;
			const y = event.clientY || r.top + r.height / 2;
			const raggio = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
			root.classList.add('theme-transition');
			const t = document.startViewTransition(apply);
			t.ready.then(() =>
				root.animate(
					{ clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${raggio}px at ${x}px ${y}px)`] },
					{ duration: 500, easing: 'ease-in-out', pseudoElement: '::view-transition-new(root)' },
				),
			);
			// le classi si tolgono 150 ms DOPO `finished` (Firefox lo risolve un attimo prima della fine dello strato)
			t.finished.finally(() =>
				setTimeout(() => {
					root.classList.remove('theme-transition');
					fine();
				}, 150),
			);
		});
	}
</script>

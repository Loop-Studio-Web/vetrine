---
// Impianto comune delle pagine dell'hub (ingresso e pagine di dettaglio): head, tema, header, footer.
// Vive in src/hub/: i concept non lo usano, hanno ognuno il proprio impianto.
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/hanken-grotesk';
import './hub.css';
import Header from './Header.astro';
import Footer from './Footer.astro';

interface Props {
	title: string;
	description: string;
	path?: string; // percorso relativo alla base, con slash finale
	ogImage?: string; // percorso relativo alla base
	ogAlt?: string;
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const {
	title,
	description,
	path = '/',
	ogImage = '/images/hub/og.jpg',
	ogAlt = 'Vetrine di Loop Studio: una via di negozi con le tende, due vetrine accese',
} = Astro.props;
const og = new URL(`${base}${ogImage}`, Astro.site).href;
const pageUrl = new URL(`${base}${path}`, Astro.site).href;
---

<html lang="it">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
		<link rel="apple-touch-icon" href={`${base}/images/hub/apple-touch-icon.png`} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={pageUrl} />
		<meta name="robots" content="index, follow" />
		<meta name="theme-color" content="#000000" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="it_IT" />
		<meta property="og:site_name" content="Loop Studio" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:image" content={og} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={ogAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<script is:inline>
			document.documentElement.classList.add('js');
			// Tema prima del primo paint: come il sito dello studio, scuro di default
			try {
				var t = localStorage.getItem('vetrine-theme');
				if (t === 'light') document.documentElement.setAttribute('data-theme', 'light');
			} catch (e) {}
		</script>
	</head>
	<body>
		<a href="#main" class="skip-link">Vai al contenuto</a>
		<Header />
		<main id="main">
			<slot />
		</main>
		<Footer />

		<script>
			// Rivela le sezioni quando entrano in vista
			const els = document.querySelectorAll('[data-reveal]');
			const io = new IntersectionObserver(
				(entries) => {
					for (const e of entries) {
						if (e.isIntersecting) {
							e.target.classList.add('is-visible');
							io.unobserve(e.target);
						}
					}
				},
				{ threshold: 0.12 },
			);
			els.forEach((el) => io.observe(el));
		</script>
		<script>
			// Titoli che si "decodificano" quando entrano in vista, come sul sito dello studio. Solo titoli sotto
			// la piega (mai l'h1: lì lo scramble ritarda l'LCP su mobile, già misurato sul sito madre).
			const titoli = document.querySelectorAll<HTMLElement>('[data-scramble]');
			const ridotto = matchMedia('(prefers-reduced-motion: reduce)').matches;
			const POOL = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';

			function decodifica(el: HTMLElement) {
				const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
				const nodi: Text[] = [];
				let n: Node | null;
				while ((n = walker.nextNode())) nodi.push(n as Text);
				const originali = nodi.map((t) => t.nodeValue ?? '');
				let tot = 0;
				const inizi = originali.map((t) => {
					const i = tot;
					tot += t.length;
					return i;
				});
				// il testo vero resta il nome accessibile per tutta l'animazione
				el.setAttribute('aria-label', originali.join('').replace(/\s+/g, ' ').trim());
				// blocca la scatola sul testo vero: lettere diverse non devono far andare a capo in modo diverso
				const r = el.getBoundingClientRect();
				el.style.width = `${r.width}px`;
				el.style.height = `${r.height}px`;
				const ritardo = matchMedia('(max-width: 48rem)').matches ? 14 : 30;
				let frame = 0;
				const id = setInterval(() => {
					nodi.forEach((t, i) => {
						let out = '';
						for (let c = 0; c < originali[i].length; c++) {
							const ch = originali[i][c];
							// spazi e punteggiatura restano al loro posto; ogni lettera si assesta dopo 10 fotogrammi
							if (!/[\p{L}\d]/u.test(ch) || frame >= inizi[i] + c + 10) out += ch;
							else out += POOL[Math.floor(Math.random() * POOL.length)];
						}
						t.nodeValue = out;
					});
					frame++;
					if (frame > tot + 14) {
						nodi.forEach((t, i) => (t.nodeValue = originali[i]));
						el.style.width = '';
						el.style.height = '';
						clearInterval(id);
					}
				}, ritardo);
			}

			if (ridotto || !('IntersectionObserver' in window)) {
				titoli.forEach((el) => el.classList.add('sc-on'));
			} else {
				const so = new IntersectionObserver(
					(entries) => {
						for (const e of entries) {
							if (!e.isIntersecting) continue;
							const el = e.target as HTMLElement;
							so.unobserve(el);
							el.classList.add('sc-on');
							decodifica(el);
						}
					},
					{ threshold: 0.6 },
				);
				titoli.forEach((el) => so.observe(el));
			}
		</script>
	</body>
</html>

---
import { Image } from 'astro:assets';
import { concepts, macros, prossime, CONTACT, lingueNomi } from './data';
import Livello from './Livello.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const live = (slug: string) => concepts.filter((c) => c.macro === slug).length;
// Una riga per macro, con i livelli in ordine: le vetrine di una categoria stanno sulla stessa linea.
const gruppi = macros
	.map((m) => ({ ...m, voci: concepts.filter((c) => c.macro === m.slug).sort((a, b) => a.livello - b.livello) }))
	.filter((g) => g.voci.length);
const nomeLivello = ['', 'Essenziale', 'Evoluto', 'Esperienza'];
---

<section class="concepts" id="vetrine" aria-labelledby="vetrine-title">
	<div class="wrap">
		<header class="concepts__head" data-reveal>
			<p class="eyebrow">Le vetrine, per tipo di attività</p>
			<h2 id="vetrine-title" class="h2" data-scramble>Le vetrine aperte</h2>
			<p class="concepts__lead">
				Ogni vetrina è una homepage completa e funzionante: si naviga, si prenota, si scorre. Scegli il tipo di
				attività, entra, guarda con calma, poi dicci quale somiglia di più alla tua.
			</p>
		</header>

		<div class="barra">
			<div class="filtri" role="group" aria-label="Filtra per tipo di attività" data-filtri>
				<button type="button" class="chip" data-macro="tutte" aria-pressed="true">
					Tutte <span class="chip__n">{concepts.length}</span>
				</button>
				{
					macros.map((m) => (
						<button type="button" class="chip" data-macro={m.slug} aria-pressed="false">
							{m.nome}
							<span class="chip__n">{live(m.slug) || 'presto'}</span>
						</button>
					))
				}
			</div>
		</div>
		<p class="sr-only" role="status" aria-live="polite" data-stato></p>

		<div class="gruppi" id="vetrine-elenco">
			{
				gruppi.map((g) => (
					<section class="gruppo" data-gruppo={g.slug} aria-labelledby={`g-${g.slug}`}>
						<header class="gruppo__head">
							<h3 class="gruppo__nome" id={`g-${g.slug}`}>{g.nome}</h3>
							<p class="gruppo__scala" aria-hidden="true">{g.voci.map((c) => nomeLivello[c.livello]).join(' · ')}</p>
						</header>
						<div class="riga" role="group" aria-label={`Vetrine di ${g.nome}`}>
							{g.voci.map((c) => (
								<article class="card" id={c.slug} data-macro={c.macro} style={`--glow:${c.glow}`}>
									<a class="card__media" href={`${base}${c.path}`} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
										<Image
											src={c.card}
											alt=""
											widths={[420, 640, 900]}
											sizes="(min-width: 1320px) 390px, (min-width: 900px) 31vw, 80vw"
											loading="lazy"
											class="card__img"
										/>
									</a>
									<div class="card__body">
										<p class="card__cat">{c.archetipo}</p>
										<p class="card__meta">
											<Livello n={c.livello} />
											<span class="card__lang" title={`Lingua: ${lingueNomi[c.lingua]}`}>
												<span aria-hidden="true">{c.lingua}</span><span class="sr-only">Lingua: {lingueNomi[c.lingua]}</span>
											</span>
										</p>
										<h4 class="card__name">{c.nome}</h4>
										<p class="card__claim">{c.claim}</p>
										<div class="card__cta">
											<a class="btn btn--sm" href={`${base}${c.path}`} target="_blank" rel="noopener">
												Entra <span aria-hidden="true">→</span><span class="sr-only"> (si apre in una nuova scheda)</span>
											</a>
											<a class="btn btn--sm btn--ghost" href={`${base}${c.infoPath}`}>
												Scopri di più<span class="sr-only"> su {c.nome}</span>
											</a>
										</div>
										<a class="card__want" href={`${CONTACT}?concept=${c.slug}`}>
											Ne voglio una così
										</a>
									</div>
								</article>
							))}
						</div>
					</section>
				))
			}
		</div>

		{
			macros
				.filter((m) => !live(m.slug))
				.map((m) => (
					<div class="vuoto" data-vuoto={m.slug} hidden>
						<p class="vuoto__t">Nessuna vetrina di {m.nome.toLowerCase()} per ora.</p>
						<p class="vuoto__d">
							In costruzione, una alla volta:{' '}
							{prossime
								.filter((p) => p.macro === m.slug)
								.map((p) => p.nome)
								.join(', ')}
							. Se è la tua attività, <a href={CONTACT}>raccontacela</a>.
						</p>
					</div>
				))
		}
	</div>
</section>

<style>
	.concepts {
		padding: clamp(70px, 10vw, 140px) 0;
		background: var(--bg-2);
		border-block: 1px solid var(--border);
	}
	.concepts__head {
		max-width: 62ch;
	}
	.concepts__head .h2 {
		margin-top: 14px;
	}
	.concepts__lead {
		margin-top: 20px;
		color: var(--muted);
		font-size: 1.15rem;
	}

	/* Barra dei filtri: fissa sotto l'header mentre si scorre l'elenco, su una riga sola (scorre di lato) */
	.barra {
		position: sticky;
		top: 62px;
		z-index: 5;
		margin: clamp(24px, 4vw, 40px) calc(-1 * var(--gutter)) 0;
		padding: 10px var(--gutter);
		background: color-mix(in srgb, var(--bg-2) 96%, transparent);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--border);
	}
	.filtri {
		display: flex;
		gap: 8px;
		overflow-x: auto;
		scrollbar-width: none;
		margin-inline: calc(-1 * var(--gutter));
		padding-inline: var(--gutter);
		scroll-padding-inline: var(--gutter);
	}
	.filtri::-webkit-scrollbar {
		display: none;
	}
	.chip {
		flex: none;
		display: inline-flex;
		align-items: center;
		gap: 10px;
		min-height: 44px;
		padding: 8px 18px;
		border-radius: 999px;
		border: 1px solid var(--border);
		background: transparent;
		color: var(--text);
		font: inherit;
		font-size: 0.95rem;
		font-weight: 600;
		white-space: nowrap;
		cursor: pointer;
		transition: background 0.25s, border-color 0.25s, color 0.25s;
	}
	.chip:hover {
		border-color: var(--text);
	}
	.chip[aria-pressed='true'] {
		background: var(--text);
		border-color: var(--text);
		color: var(--bg);
	}
	.chip__n {
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--muted);
	}
	.chip[aria-pressed='true'] .chip__n {
		color: var(--bg);
		opacity: 0.7;
	}

	/* Una riga per macro: i livelli sulla stessa linea (a scorrimento, con la card dopo che si intravede, sotto i 900 px) */
	.gruppi {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: clamp(44px, 6vw, 76px);
		margin-top: clamp(28px, 4vw, 44px);
		scroll-margin-top: 150px;
	}
	.gruppo[hidden] {
		display: none;
	}
	.gruppo__head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 16px;
		padding-bottom: 14px;
		margin-bottom: clamp(18px, 3vw, 28px);
		border-bottom: 1px solid var(--border);
	}
	.gruppo__nome {
		font-family: var(--display);
		font-weight: 800;
		font-size: clamp(1.5rem, 2.6vw, 2.1rem);
		line-height: 1.05;
		letter-spacing: -0.03em;
	}
	.gruppo__scala {
		display: none;
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.riga {
		position: relative; /* i testi .sr-only (absolute) restano dentro la riga e non allargano la pagina */
		display: flex;
		gap: 16px;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		overscroll-behavior-x: contain;
		scrollbar-width: none;
		margin-inline: calc(-1 * var(--gutter));
		padding: 4px var(--gutter) 8px;
		scroll-padding-inline: var(--gutter);
	}
	.riga::-webkit-scrollbar {
		display: none;
	}
	.card {
		flex: 0 0 min(80vw, 340px);
		scroll-snap-align: start;
		display: flex;
		flex-direction: column;
		gap: 18px;
	}
	.card__media {
		display: block;
		border-radius: 16px;
		overflow: hidden;
		border: 1px solid var(--border);
		box-shadow: var(--shadow);
		transition: box-shadow 0.6s, transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
	}
	.card__media:hover {
		box-shadow: 0 40px 110px -30px var(--glow);
		transform: translateY(-4px);
	}
	.card__img {
		width: 100%;
		height: auto;
		aspect-ratio: 5 / 3;
		object-fit: cover;
	}
	.card__body {
		display: flex;
		flex: 1;
		flex-direction: column;
	}
	.card__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px;
		margin-top: 8px;
	}
	.card__lang {
		padding: 2px 8px;
		border: 1px solid var(--border);
		border-radius: 4px;
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		color: var(--muted);
	}
	.card__cat {
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.card__name {
		margin-top: 8px;
		font-family: var(--display);
		font-weight: 800;
		font-size: clamp(1.45rem, 2.2vw, 1.8rem);
		line-height: 1.05;
		letter-spacing: -0.03em;
	}
	.card__claim {
		margin-top: 10px;
		max-width: 38ch;
		color: var(--muted);
		font-size: 0.95rem;
	}
	.card__cta {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-top: auto;
		padding-top: 18px;
	}
	.card__want {
		align-self: flex-start;
		margin-top: 6px;
		padding: 8px 0;
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--accent);
		text-underline-offset: 4px;
	}

	.vuoto {
		margin-top: 28px;
		padding: 36px 28px;
		border: 1px dashed var(--border);
		border-radius: 18px;
		text-align: center;
	}
	.vuoto[hidden] {
		display: none;
	}
	.vuoto__t {
		font-family: var(--display);
		font-weight: 700;
		font-size: 1.3rem;
	}
	.vuoto__d {
		margin: 10px auto 0;
		max-width: 52ch;
		color: var(--muted);
	}

	@media (min-width: 700px) {
		.gruppo__scala {
			display: block;
		}
	}
	@media (min-width: 900px) {
		.riga {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 24px;
			overflow: visible;
			margin-inline: 0;
			padding-inline: 0;
		}
		.card {
			flex: initial;
		}
	}
</style>

<script>
	// Filtro per macrocategoria: stato nell'indirizzo (#ristorazione), senza JS si vede tutto.
	const wrap = document.querySelector<HTMLElement>('[data-filtri]');
	if (wrap) {
		const chips = [...wrap.querySelectorAll<HTMLButtonElement>('.chip')];
		const slugs = chips.map((c) => c.dataset.macro!);
		const gruppi = document.querySelectorAll<HTMLElement>('[data-gruppo]');
		const elenco = document.getElementById('vetrine-elenco');
		const vuoti = document.querySelectorAll<HTMLElement>('[data-vuoto]');
		const stato = document.querySelector<HTMLElement>('[data-stato]');

		const apply = (macro: string) => {
			let n = 0;
			chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.macro === macro)));
			gruppi.forEach((g) => {
				const show = macro === 'tutte' || g.dataset.gruppo === macro;
				g.hidden = !show;
				if (show) n += g.querySelectorAll('.card').length;
			});
			vuoti.forEach((v) => (v.hidden = v.dataset.vuoto !== macro));
			if (stato) {
				const nome = chips.find((c) => c.dataset.macro === macro)?.firstChild?.textContent?.trim() ?? '';
				stato.textContent = n ? `${n} vetrine: ${nome}` : `Nessuna vetrina per ora: ${nome}`;
			}
		};

		const fromHash = () => {
			const h = location.hash.slice(1);
			return slugs.includes(h) ? h : null;
		};

		chips.forEach((c) =>
			c.addEventListener('click', () => {
				const m = c.dataset.macro!;
				apply(m);
				c.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'instant' });
				// Se si era già scesi nell'elenco, riparte dall'inizio del nuovo gruppo.
				if (elenco && elenco.getBoundingClientRect().top < 120) elenco.scrollIntoView({ block: 'start', behavior: 'instant' });
				history.replaceState(null, '', m === 'tutte' ? location.pathname + location.search : `#${m}`);
			}),
		);
		addEventListener('hashchange', () => {
			const m = fromHash();
			if (m) {
				apply(m);
				document.getElementById('vetrine')?.scrollIntoView();
			}
		});

		const initial = fromHash();
		if (initial) {
			apply(initial);
			requestAnimationFrame(() => document.getElementById('vetrine')?.scrollIntoView());
		}
	}
</script>

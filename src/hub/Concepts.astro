---
import { Image } from 'astro:assets';
import { concepts, CONTACT } from './data';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="concepts" id="vetrine" aria-labelledby="vetrine-title">
	<div class="wrap">
		<header class="concepts__head" data-reveal>
			<p class="eyebrow">Ristorazione · 2 archetipi su 4</p>
			<h2 id="vetrine-title" class="h2">Le vetrine aperte</h2>
			<p class="concepts__lead">
				Ogni vetrina è una homepage completa e funzionante: si naviga, si prenota, si scorre. Entra, guarda con
				calma, poi dicci quale somiglia di più alla tua attività.
			</p>
		</header>

		<div class="concepts__list">
			{
				concepts.map((c, i) => (
					<article class={`concept ${i % 2 ? 'concept--rev' : ''}`} id={c.slug} style={`--glow:${c.glow}`}>
						<a class="concept__media" href={`${base}${c.path}`} tabindex="-1" aria-hidden="true" data-reveal>
							<Image
								src={c.card}
								alt=""
								widths={[700, 1100, 1600]}
								sizes="(min-width: 1000px) 56vw, 100vw"
								loading="lazy"
								class="concept__img"
							/>
						</a>
						<div class="concept__body" data-reveal style="--d: 0.12s">
							<p class="concept__cat">
								<span class="concept__num">{String(i + 1).padStart(2, '0')}</span>
								{c.categoria} · {c.archetipo}
							</p>
							<h3 class="concept__name">{c.nome}</h3>
							<p class="concept__claim">{c.claim}</p>

							<dl class="concept__facts">
								<div>
									<dt>Atmosfera</dt>
									<dd>{c.mood}</dd>
								</div>
								<div>
									<dt>Caratteri</dt>
									<dd>{c.caratteri}</dd>
								</div>
								<div>
									<dt>Colori</dt>
									<dd>
										<span class="swatches" role="img" aria-label="Palette dei colori della vetrina">
											{c.palette.map((p) => <span class="sw" style={`--c:${p}`} />)}
										</span>
									</dd>
								</div>
							</dl>

							<h4 class="concept__sub">Cosa trovi dentro</h4>
							<ul class="concept__punti">
								{c.punti.map((p) => <li>{p}</li>)}
							</ul>

							<ul class="metrics" aria-label="Risultati dei test Lighthouse su mobile">
								{
									c.metriche.map((m) => (
										<li>
											<strong>{m.valore}</strong>
											<span>{m.label}</span>
										</li>
									))
								}
							</ul>

							<div class="concept__cta">
								<a class="btn" href={`${base}${c.path}`}>
									Entra nella vetrina <span aria-hidden="true">→</span>
								</a>
								<a class="btn btn--ghost" href={`${CONTACT}?concept=${c.slug}`}>Ne voglio una così</a>
							</div>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	.concepts {
		padding: clamp(70px, 10vw, 140px) 0;
		background: var(--bg-2);
		border-block: 1px solid var(--border);
	}
	.concepts__head {
		max-width: 62ch;
	}
	.concepts__head .h2 {
		margin-top: 14px;
	}
	.concepts__lead {
		margin-top: 20px;
		color: var(--muted);
		font-size: 1.15rem;
	}
	.concepts__list {
		display: grid;
		gap: clamp(70px, 10vw, 140px);
		margin-top: clamp(48px, 7vw, 90px);
	}

	.concept {
		display: grid;
		gap: 36px;
		align-items: center;
	}
	.concept__media {
		display: block;
		border-radius: 22px;
		overflow: hidden;
		border: 1px solid var(--border);
		box-shadow: var(--shadow);
		transition: box-shadow 0.6s, transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
	}
	.concept__media:hover {
		box-shadow: 0 40px 110px -30px var(--glow);
		transform: translateY(-4px);
	}
	.concept__img {
		width: 100%;
		height: auto;
		aspect-ratio: 5 / 3;
		object-fit: cover;
	}
	.concept__cat {
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.concept__num {
		margin-right: 10px;
		color: var(--accent);
	}
	.concept__name {
		margin-top: 12px;
		font-family: var(--display);
		font-weight: 800;
		font-size: clamp(2.2rem, 4.4vw, 3.6rem);
		line-height: 1;
		letter-spacing: -0.03em;
	}
	.concept__claim {
		margin-top: 16px;
		font-size: 1.2rem;
		line-height: 1.45;
		max-width: 34ch;
	}
	.concept__facts {
		display: grid;
		gap: 14px;
		margin-top: 28px;
		padding-top: 24px;
		border-top: 1px solid var(--border);
	}
	.concept__facts > div {
		display: grid;
		grid-template-columns: 110px 1fr;
		gap: 16px;
		align-items: baseline;
	}
	.concept__facts dt {
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.concept__facts dd {
		font-size: 0.98rem;
	}
	.swatches {
		display: inline-flex;
		border-radius: 999px;
		overflow: hidden;
		border: 1px solid var(--border);
		vertical-align: middle;
	}
	.sw {
		display: block;
		width: 30px;
		height: 22px;
		background: var(--c);
	}
	.concept__sub {
		margin-top: 28px;
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.concept__punti {
		display: grid;
		gap: 8px;
		margin-top: 12px;
	}
	.concept__punti li {
		position: relative;
		padding-left: 22px;
		font-size: 0.98rem;
	}
	.concept__punti li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.62em;
		width: 9px;
		height: 2px;
		background: var(--accent);
	}
	.metrics {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-top: 26px;
	}
	.metrics li {
		display: flex;
		align-items: baseline;
		gap: 8px;
		padding: 8px 16px;
		border-radius: 999px;
		border: 1px solid var(--border);
		background: var(--surface);
	}
	.metrics strong {
		font-family: var(--display);
		font-weight: 800;
		font-size: 1.15rem;
		color: var(--accent);
	}
	.metrics span {
		font-size: 0.8rem;
		color: var(--muted);
	}
	.concept__cta {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 34px;
	}

	@media (min-width: 1000px) {
		.concept {
			grid-template-columns: 7fr 5fr;
			gap: clamp(40px, 6vw, 96px);
		}
		.concept--rev {
			grid-template-columns: 5fr 7fr;
		}
		.concept--rev .concept__media {
			order: 2;
		}
		.concept {
			align-items: start;
		}
		.concept__media {
			position: sticky;
			top: 110px;
		}
	}
	@media (max-width: 480px) {
		.concept__facts > div {
			grid-template-columns: 1fr;
			gap: 2px;
		}
	}
</style>

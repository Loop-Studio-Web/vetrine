---
// Hub delle vetrine di Loop Studio: ingresso pubblico a tutti i concept.
// Segue il design system dello studio (nero, rosso, Bricolage Grotesque e Hanken Grotesk).
// I concept restano indipendenti tra loro: qui vive solo l'ingresso, in src/hub/.
// Questa pagina è indicizzabile; i singoli concept restano `noindex, nofollow`.
import Layout from '../hub/Layout.astro';
import Hero from '../hub/Hero.astro';
import Concepts from '../hub/Concepts.astro';
import Metodo from '../hub/Metodo.astro';
import Prossime from '../hub/Prossime.astro';

const title = 'Vetrine — homepage concept per attività locali | Loop Studio';
const description =
	'Homepage complete per attività locali, ognuna con la propria identità: dalla trattoria al ristorante da menù degustazione. Concept dimostrativi di Loop Studio.';
---

<Layout title={title} description={description} path="/">
	<Hero />
	<Concepts />
	<Metodo />
	<Prossime />
</Layout>

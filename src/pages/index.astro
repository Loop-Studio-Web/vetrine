---
// Indice dei concept pubblicati, sul modello della index.html del repo
// `lab`: un elenco semplice di link, aggiornato a mano ogni volta che un
// nuovo concept viene pubblicato. Raggruppato per macrocategoria.
// import.meta.env.BASE_URL invece di percorsi assoluti: con `base: '/vetrine'`
// in astro.config.mjs, un href="/qualcosa" punterebbe alla radice del
// dominio (loop-studio-web.github.io/qualcosa) invece che dentro /vetrine/.
const base = import.meta.env.BASE_URL;
---

<html lang="it">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Loop Studio — Vetrine</title>
		<meta
			name="description"
			content="Homepage concept dimostrative di Loop Studio, per settore e per tipologia di attività."
		/>
	</head>
	<body>
		<h1>Loop Studio — Vetrine</h1>
		<p>
			Homepage concept dimostrative, una per tipologia di attività. In
			costruzione: il primo concept arriva a breve.
		</p>
	</body>
</html>

<style>
	body {
		font-family:
			-apple-system,
			BlinkMacSystemFont,
			'Segoe UI',
			sans-serif;
		background: #000;
		color: #fff;
		margin: 0;
		padding: 60px 24px;
	}
	h1 {
		color: #ff3b30;
	}
	p {
		max-width: 480px;
		line-height: 1.5;
	}
</style>

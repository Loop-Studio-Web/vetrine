---
import '@fontsource-variable/bricolage-grotesque';
import '../../../concepts/softriot/base.css';
import cowboyUrl from '../../../assets/softriot/font/ltcowboy.woff2?url';
import cowboyTextUrl from '../../../assets/softriot/font/ltcowboytext.woff2?url';
import bricolageUrl from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import Fascia from '../../../concepts/softriot/Fascia.astro';
import Testata from '../../../concepts/softriot/Testata.astro';
import Carosello from '../../../concepts/softriot/Carosello.astro';
import Catalogo from '../../../concepts/softriot/Catalogo.astro';
import Striscia from '../../../concepts/softriot/Striscia.astro';
import Footer from '../../../concepts/softriot/Footer.astro';
import Scheda from '../../../concepts/softriot/Scheda.astro';
import Carrello from '../../../concepts/softriot/Carrello.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = 'Soft Riot — Quilted, knotted, loud clothes and accessories';
const description =
	'Soft Riot is a made-up clothing and accessories shop: a demo storefront with a carousel, a filterable catalogue, quick view and a side bag. A concept by Loop Studio.';
const ogImage = new URL(`${base}/images/softriot/og.jpg`, Astro.site).href;
const pageUrl = new URL(`${base}/ecommerce/softriot/`, Astro.site).href;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href={`${base}/images/softriot/favicon.png`} />
		<link rel="preload" as="font" type="font/woff2" href={cowboyUrl} crossorigin />
		<link rel="preload" as="font" type="font/woff2" href={cowboyTextUrl} crossorigin />
		<link rel="preload" as="font" type="font/woff2" href={bricolageUrl} crossorigin />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="theme-color" content="#1d1033" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="en_GB" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body>
		<a href="#main" class="skip-link">Skip to content</a>
		<Fascia />
		<Testata />
		<main id="main">
			<Carosello />
			<Catalogo />
			<Striscia />
		</main>
		<Footer />
		<Scheda />
		<Carrello />
		<script>
			// Le ancore interne si muovono via script: su Safari/iPhone lo scroll fluido nativo può atterrare storto.
			document.addEventListener('click', (e) => {
				const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="#"]');
				if (!a || e.defaultPrevented || e.metaKey || e.ctrlKey || e.shiftKey) return;
				const id = a.getAttribute('href')!.slice(1);
				const el = id && id !== 'main' ? document.getElementById(id) : document.documentElement;
				if (!el) return;
				e.preventDefault();
				const ridotto = matchMedia('(prefers-reduced-motion: reduce)').matches;
				requestAnimationFrame(() => el.scrollIntoView({ behavior: ridotto ? 'auto' : 'smooth', block: 'start' }));
			});
		</script>
	</body>
</html>

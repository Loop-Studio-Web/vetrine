---
import '@fontsource/anton/400.css';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '@fontsource-variable/archivo/wght.css';
import '@fontsource/caveat/600.css';
import '@fontsource/caveat/700.css';
import '../../../concepts/sobremesa/base.css';
import antonUrl from '@fontsource/anton/files/anton-latin-400-normal.woff2?url';
import barlowUrl from '@fontsource/barlow-condensed/files/barlow-condensed-latin-700-normal.woff2?url';
import archivoUrl from '@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url';
import wall from '../../../assets/sobremesa/plates/wall.png';
import Fascia from '../../../concepts/sobremesa/Fascia.astro';
import Pared from '../../../concepts/sobremesa/Pared.astro';
import Testata from '../../../concepts/sobremesa/Testata.astro';
import Portada from '../../../concepts/sobremesa/Portada.astro';
import Historias from '../../../concepts/sobremesa/Historias.astro';
import Envio from '../../../concepts/sobremesa/Envio.astro';
import Objetos from '../../../concepts/sobremesa/Objetos.astro';
import Talleres from '../../../concepts/sobremesa/Talleres.astro';
import Envios from '../../../concepts/sobremesa/Envios.astro';
import Revista from '../../../concepts/sobremesa/Revista.astro';
import Cuenta from '../../../concepts/sobremesa/Cuenta.astro';
import Chapa from '../../../concepts/sobremesa/Chapa.astro';
import Bolsa from '../../../concepts/sobremesa/Bolsa.astro';
import Pie from '../../../concepts/sobremesa/Pie.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = 'Sobremesa — Revista y tienda de objetos para la casa y la mesa';
const description =
	'Sobremesa es una tienda-revista inventada: cada historia tiene sus objetos adentro y se compran sin salir del cuento. Una vitrina demostrativa de Loop Studio.';
const ogImage = new URL(`${base}/images/sobremesa/og.jpg`, Astro.site).href;
const pageUrl = new URL(`${base}/ecommerce/sobremesa/`, Astro.site).href;
---

<html lang="es-AR">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${base}/images/sobremesa/favicon.svg`} />
		<link rel="preload" as="font" type="font/woff2" href={antonUrl} crossorigin />
		<link rel="preload" as="font" type="font/woff2" href={barlowUrl} crossorigin />
		<link rel="preload" as="font" type="font/woff2" href={archivoUrl} crossorigin />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="theme-color" content="#16261c" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_AR" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body style={`--pared-img:url(${wall.src})`}>
		<a href="#main" class="skip-link">Ir al contenido</a>
		<Fascia />
		<main id="main">
			<Pared>
				<Testata />
				<Portada />
				<Historias />
				<Envio />
			</Pared>
			<div class="cuerpo">
				<Objetos />
				<Talleres />
				<Envios />
				<Revista />
				<Cuenta />
			</div>
		</main>
		<Pie />
		<Chapa />
		<Bolsa />
		<script>
			import { cuenta } from '../../../concepts/sobremesa/estado';
			const pintar = () => document.querySelectorAll('[data-bolsa-n]').forEach((el) => (el.textContent = String(cuenta())));
			pintar();
			window.addEventListener('sb:bolsa', pintar);
			window.addEventListener('storage', pintar);
		</script>
	</body>
</html>

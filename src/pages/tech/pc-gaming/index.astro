---
import '@fontsource-variable/rubik';
import '@fontsource-variable/albert-sans';
import '../../../concepts/hotswap/base.css';
import rubikUrl from '@fontsource-variable/rubik/files/rubik-latin-wght-normal.woff2?url';
import albertUrl from '@fontsource-variable/albert-sans/files/albert-sans-latin-wght-normal.woff2?url';
import Fascia from '../../../concepts/hotswap/Fascia.astro';
import Navbar from '../../../concepts/hotswap/Navbar.astro';
import Ingresso from '../../../concepts/hotswap/Ingresso.astro';
import Shop from '../../../concepts/hotswap/Shop.astro';
import Builder from '../../../concepts/hotswap/Builder.astro';
import Lista from '../../../concepts/hotswap/Lista.astro';
import Servizi from '../../../concepts/hotswap/Servizi.astro';
import Offerte from '../../../concepts/hotswap/Offerte.astro';
import Recensioni from '../../../concepts/hotswap/Recensioni.astro';
import Visita from '../../../concepts/hotswap/Visita.astro';
import Footer from '../../../concepts/hotswap/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = 'Hot Swap — Computer & gaming store';
const description = 'Demo computer and gaming store: gaming PCs, notebooks, components and a drag-and-drop PC builder. Demonstration showcase.';
const ogImage = new URL(`${base}/images/hotswap/og.jpg`, Astro.site).href;
const pageUrl = new URL(`${base}/tech/pc-gaming/`, Astro.site).href;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${base}/images/hotswap/favicon.svg`} />
		<link rel="icon" type="image/png" href={`${base}/images/hotswap/favicon.png`} />
		<link rel="apple-touch-icon" href={`${base}/images/hotswap/apple-touch-icon.png`} />
		<link rel="preload" as="font" type="font/woff2" href={rubikUrl} crossorigin />
		<link rel="preload" as="font" type="font/woff2" href={albertUrl} crossorigin />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="theme-color" content="#e7e0d1" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="en_GB" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>
	</head>
	<body>
		<a href="#main" class="skip-link">Skip to content</a>
		<Fascia />
		<Navbar />
		<main id="main">
			<Ingresso />
			<Shop />
			<Builder />
			<Servizi />
			<Offerte />
			<Recensioni />
			<Visita />
		</main>
		<Footer />
		<Lista />
		<script>
			// Le ancore interne scorrono via script e non con l'ancora nativa: su Safari/iPhone l'ancora con scorrimento
			// morbido può partire dall'alto e atterrare storta quando la pagina cambia altezza mentre scorre.
			document.addEventListener('click', (e) => {
				const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="#"]');
				if (!a || e.defaultPrevented || e.metaKey || e.ctrlKey || e.shiftKey) return;
				const id = a.getAttribute('href')!.slice(1);
				const el = id ? document.getElementById(id) : document.documentElement;
				if (!el) return;
				e.preventDefault();
				const ridotto = matchMedia('(prefers-reduced-motion: reduce)').matches;
				requestAnimationFrame(() => el.scrollIntoView({ behavior: ridotto ? 'auto' : 'smooth', block: 'start' }));
				if (id) history.replaceState(null, '', `#${id}`);
			});
		</script>
		<script>
			// Rivela gli elementi quando entrano in vista
			const els = document.querySelectorAll('[data-reveal]');
			const io = new IntersectionObserver(
				(entries) => {
					for (const e of entries) {
						if (e.isIntersecting) {
							e.target.classList.add('is-visible');
							io.unobserve(e.target);
						}
					}
				},
				{ threshold: 0.12 },
			);
			els.forEach((el) => io.observe(el));
		</script>
	</body>
</html>

---
import '@fontsource-variable/syne';
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource/share-tech';
import '../../../concepts/ordito/base.css';
import syneUrl from '@fontsource-variable/syne/files/syne-latin-wght-normal.woff2?url';
import shareUrl from '@fontsource/share-tech/files/share-tech-latin-400-normal.woff2?url';
import schibstedUrl from '@fontsource-variable/schibsted-grotesk/files/schibsted-grotesk-latin-wght-normal.woff2?url';
import Fascia from '../../../concepts/ordito/Fascia.astro';
import Navbar from '../../../concepts/ordito/Navbar.astro';
import Casa from '../../../concepts/ordito/Casa.astro';
import Regole from '../../../concepts/ordito/Regole.astro';
import Striscia from '../../../concepts/ordito/Striscia.astro';
import SuMisura from '../../../concepts/ordito/SuMisura.astro';
import Casi from '../../../concepts/ordito/Casi.astro';
import Metodo from '../../../concepts/ordito/Metodo.astro';
import Sopralluogo from '../../../concepts/ordito/Sopralluogo.astro';
import Footer from '../../../concepts/ordito/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = 'Ordito — Domotica, sicurezza ed energia su misura';
const description = 'Studio tecnologico di fantasia: domotica, sicurezza, energia e automazioni per case, studi e uffici, con una casa in 3D da toccare. Vetrina dimostrativa.';
const ogImage = new URL(`${base}/images/ordito/og.jpg`, Astro.site).href;
const pageUrl = new URL(`${base}/tech/studio/`, Astro.site).href;
---

<html lang="it">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${base}/images/ordito/favicon.svg`} />
		<link rel="icon" type="image/png" href={`${base}/images/ordito/favicon.png`} />
		<link rel="apple-touch-icon" href={`${base}/images/ordito/apple-touch-icon.png`} />
		<link rel="preload" as="font" type="font/woff2" href={syneUrl} crossorigin />
		<link rel="preload" as="font" type="font/woff2" href={schibstedUrl} crossorigin />
		<link rel="preload" as="font" type="font/woff2" href={shareUrl} crossorigin />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="theme-color" content="#0b0620" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="it_IT" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>
	</head>
	<body>
		<a href="#main" class="skip-link">Vai al contenuto</a>
		<Fascia />
		<Navbar />
		<main id="main">
			<span id="top"></span>
			<Casa>
				<Regole />
			</Casa>
			<Striscia />
			<SuMisura />
			<Casi />
			<Metodo />
			<Sopralluogo />
		</main>
		<Footer />
		<script>
			// Le ancore interne scorrono via script e non con l'ancora nativa: su Safari/iPhone l'ancora con scorrimento
			// morbido può partire dall'alto e atterrare storta quando la pagina cambia altezza mentre scorre.
			document.addEventListener('click', (e) => {
				const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="#"]');
				if (!a || e.defaultPrevented || e.metaKey || e.ctrlKey || e.shiftKey) return;
				const id = a.getAttribute('href')!.slice(1);
				const el = id ? document.getElementById(id) : document.documentElement;
				if (!el) return;
				e.preventDefault();
				const ridotto = matchMedia('(prefers-reduced-motion: reduce)').matches;
				requestAnimationFrame(() => (id === 'top' ? scrollTo({ top: 0, behavior: ridotto ? 'auto' : 'smooth' }) : el.scrollIntoView({ behavior: ridotto ? 'auto' : 'smooth', block: 'start' })));
				if (id) history.replaceState(null, '', `#${id}`);
			});
		</script>
		<script>
			// Bagliore che segue il mouse sulle schede di vetro (solo con puntatore preciso)
			if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
				document.addEventListener('pointermove', (e) => {
					const v = (e.target as HTMLElement).closest<HTMLElement>('.vetro');
					if (!v) return;
					const r = v.getBoundingClientRect();
					v.style.setProperty('--mx', `${e.clientX - r.left}px`);
					v.style.setProperty('--my', `${e.clientY - r.top}px`);
				});
			}
		</script>
		<script>
			// Rivela gli elementi quando entrano in vista
			const els = document.querySelectorAll('[data-reveal]');
			const io = new IntersectionObserver(
				(entries) => {
					for (const e of entries) {
						if (e.isIntersecting) {
							e.target.classList.add('is-visible');
							io.unobserve(e.target);
						}
					}
				},
				{ threshold: 0.12 },
			);
			els.forEach((el) => io.observe(el));
		</script>
	</body>
</html>

---
import '@fontsource-variable/space-grotesk';
import '@fontsource/newsreader/400.css';
import '@fontsource/newsreader/400-italic.css';
import '@fontsource/newsreader/700.css';
import { Image } from 'astro:assets';

const base = import.meta.env.BASE_URL;

const feedImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/trattoria/feed/*.jpg', { eager: true });
const feedImg = (file: string) => feedImages[`/src/assets/trattoria/feed/${file}`].default;

const piatti = [
	{ img: 'pizza.jpg', alt: 'Pizza con pomodoro, mozzarella e basilico' },
	{ img: 'pappardelle-ragu.jpg', alt: 'Pappardelle al ragù con salsiccia e parmigiano' },
	{ img: 'antipasto-rustico.jpg', alt: 'Tagliere rustico con pane, prosciutto, olive e formaggio' },
	{ img: 'brasato.jpg', alt: 'Brasato con patate e carote' },
	{ img: 'ravioli.jpg', alt: 'Ravioli fatti in casa' },
	{ img: 'risotto.jpg', alt: 'Risotto ai frutti di mare' },
	{ img: 'tagliata.jpg', alt: 'Tagliata di carne alla griglia' },
	{ img: 'panna-cotta.jpg', alt: 'Panna cotta con frutti rossi e crumble' },
	{ img: 'pesce.jpg', alt: 'Pesce al forno con limone' },
	{ img: 'tiramisu.jpg', alt: 'Tiramisù' },
	{ img: 'sfoglie-frutti-di-bosco.jpg', alt: 'Sfoglie con crema e frutti di bosco' },
];
const carouselImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/trattoria/carousel/*.jpg', { eager: true });
const carouselImg = (file: string) => carouselImages[`/src/assets/trattoria/carousel/${file}`].default;

const diario = [
	{ img: 'verdure.jpg', alt: 'Cassette di verdure di stagione dal contadino', time: '7:40', caption: 'Spesa dal contadino di Via Vecchia. Quello che troviamo stamattina è quello che trovate nel piatto.' },
	{ img: 'pasta.jpg', alt: 'Sfoglia tirata con la macchinetta a mano', time: '9:12', caption: 'Si tira la sfoglia come ci ha insegnato la nonna. La macchinetta è la sua, il resto lo facciamo a mano.' },
	{ img: 'pane.jpg', alt: 'Pane a lievitazione lunga appena sfornato', time: '10:30', caption: 'Pane a lievitazione lunga, 24 ore di attesa. Appena sfornato, finito entro stasera.' },
	{ img: 'cucina.jpg', alt: 'Il cuoco al lavoro in cucina prima del servizio', time: '11:15', caption: 'Prima del servizio ognuno al suo posto. Il menu del giorno va in lavagna alle 12.' },
	{ img: 'sala.jpg', alt: 'Tavoli con tovaglie a quadretti rossi apparecchiati', time: '11:50', caption: 'Tovaglie a quadretti, tavoli pronti. Per prenotare scrivete su WhatsApp: rispondiamo davvero noi.' },
	{ img: 'sera.jpg', alt: 'Bancone con candela e bottiglia di vino a fine serata', time: '21:50', caption: 'Ultimo giro di rosso, la candela ancora accesa. Domani si ricomincia alle 7.' },
];
---

<html lang="it">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Trattoria del Borgo — Ristorazione Autentica</title>
		<meta
			name="description"
			content="Trattoria di provincia. Pasta fatta in casa, piatti di stagione, prezzi onesti. Qualità senza pretese."
		/>
	</head>
	<body>
		<!-- Navbar sticky con theme switcher -->
		<nav class="navbar" aria-label="Navigazione principale">
			<div class="navbar__container">
				<a href="#" class="navbar__logo">Trattoria del Borgo</a>
				<ul class="navbar__menu">
					<li><a href="#hero" class="navbar__link">Home</a></li>
					<li><a href="#menu" class="navbar__link">Menu</a></li>
					<li><a href="#reviews" class="navbar__link">Recensioni</a></li>
					<li><a href="#info" class="navbar__link">Contatti</a></li>
				</ul>
				<button class="theme-switcher" aria-label="Cambia tema" title="Cambia tema">
					<span class="theme-switcher__icon">🌙</span>
				</button>
			</div>
		</nav>

		<main>
			<!-- Video Hero Section -->
			<section id="hero" class="hero-video">
				<div class="hero-video__container">
					<div class="hero-video__content">
						<h1 class="hero-video__title">Trattoria del Borgo</h1>
						<p class="hero-video__subtitle">Ristorazione autentica. Rimodernizzata.</p>
						<p class="hero-video__description">
							Una trattoria nata negli anni '80, riaperta da ragazzi che credono nella qualità.
							Pasta fatta in casa, ingredienti di stagione, prezzi onesti.
						</p>
					</div>
					<div class="hero-video__frame">
						<video class="hero-video__iframe" autoplay muted loop playsinline>
							<source src="/vetrine/videos/trattoria-hero.f616.mp4" type="video/mp4" />
							Il tuo browser non supporta il tag video.
						</video>
					</div>
				</div>
			</section>

			<!-- Piatti del Giorno Carousel -->
			<section class="piatti-carousel">
				<div class="container">
					<h2 class="section-title">Piatti del Giorno</h2>
					<div class="carousel-wrapper">
						<div class="carousel">
								{[0, 1].map((copy) => (
									<div class="carousel__set" aria-hidden={copy === 1 ? 'true' : undefined}>
										{piatti.map((piatto) => (
											<Image src={carouselImg(piatto.img)} alt={copy === 1 ? '' : piatto.alt} width={600} height={400} densities={[1, 2]} class="carousel__img" />
										))}
									</div>
								))}
							</div>
					</div>
				</div>
			</section>

			<!-- Diario dalla cucina (angolo social) -->
				<section class="social-feed">
					<div class="container">
						<div class="feed-header">
							<h2 class="section-title">Dalla cucina</h2>
							<p class="feed-handle">Una giornata qui, raccontata da noi su Instagram <span>@trattoriadelborgo</span></p>
						</div>
						<div class="feed-grid">
							{diario.map((post) => (
								<figure class="feed-card">
									<Image src={feedImg(post.img)} alt={post.alt} width={400} height={400} densities={[1, 2]} class="feed-card__image" />
									<figcaption class="feed-card__content">
										<p class="feed-card__caption">{post.caption}</p>
										<p class="feed-card__meta">Oggi · {post.time}</p>
									</figcaption>
								</figure>
							))}
						</div>
					</div>
				</section>

				<!-- Menu Section -->
			<section id="menu" class="menu-section">
				<div class="container">
					<h2 class="section-title">Menu</h2>

					<div class="menu-grid">
						<article class="menu-category">
							<h3 class="menu-category__title">Piatti Tipici</h3>
							<div class="menu-items">
								<div class="menu-item">
									<div class="menu-item__header">
										<h4 class="menu-item__name">Pasta all'Uovo</h4>
										<span class="menu-item__price">8€</span>
									</div>
									<p class="menu-item__desc">Con ragù di carne locale</p>
								</div>
								<div class="menu-item">
									<div class="menu-item__header">
										<h4 class="menu-item__name">Brasato di Stagione</h4>
										<span class="menu-item__price">14€</span>
									</div>
									<p class="menu-item__desc">Con verdure dell'orto</p>
								</div>
								<div class="menu-item">
									<div class="menu-item__header">
										<h4 class="menu-item__name">Risotto ai Funghi</h4>
										<span class="menu-item__price">12€</span>
									</div>
									<p class="menu-item__desc">Funghi di stagione</p>
								</div>
							</div>
						</article>

						<article class="menu-category">
							<h3 class="menu-category__title">Contorni & Insalate</h3>
							<div class="menu-items">
								<div class="menu-item">
									<div class="menu-item__header">
										<h4 class="menu-item__name">Verdure Grigliate</h4>
										<span class="menu-item__price">5€</span>
									</div>
									<p class="menu-item__desc">Di stagione</p>
								</div>
								<div class="menu-item">
									<div class="menu-item__header">
										<h4 class="menu-item__name">Insalata Mista</h4>
										<span class="menu-item__price">4€</span>
									</div>
									<p class="menu-item__desc">Verdure fresche</p>
								</div>
								<div class="menu-item">
									<div class="menu-item__header">
										<h4 class="menu-item__name">Patate al Forno</h4>
										<span class="menu-item__price">3€</span>
									</div>
								</div>
							</div>
						</article>

						<article class="menu-category">
							<h3 class="menu-category__title">Dolci</h3>
							<div class="menu-items">
								<div class="menu-item">
									<div class="menu-item__header">
										<h4 class="menu-item__name">Tiramisu</h4>
										<span class="menu-item__price">6€</span>
									</div>
									<p class="menu-item__desc">Fatto in casa</p>
								</div>
								<div class="menu-item">
									<div class="menu-item__header">
										<h4 class="menu-item__name">Panna Cotta</h4>
										<span class="menu-item__price">5€</span>
									</div>
									<p class="menu-item__desc">Frutta di stagione</p>
								</div>
							</div>
						</article>
					</div>
				</div>
			</section>

			<!-- Reviews Section (Loop Studio Style) -->
			<section id="reviews" class="reviews-section">
				<div class="container">
					<h2 class="section-title">Cosa Dicono</h2>
					<div class="reviews-grid">
						<article class="review-card">
							<div class="review-card__header">
								<div class="review-card__avatar">👤</div>
								<div class="review-card__meta">
									<h3 class="review-card__author">Marco R.</h3>
									<div class="review-card__rating">⭐⭐⭐⭐⭐</div>
								</div>
							</div>
							<p class="review-card__text">
								"Finalmente un posto dove la qualità non è negoziata. Pasta fatta come si deve, vini locali curati, e il gestore che conosce ogni cliente. Questo è il futuro della ristorazione di provincia."
							</p>
							<p class="review-card__date">2 settimane fa</p>
						</article>

						<article class="review-card">
							<div class="review-card__header">
								<div class="review-card__avatar">👤</div>
								<div class="review-card__meta">
									<h3 class="review-card__author">Lucia M.</h3>
									<div class="review-card__rating">⭐⭐⭐⭐⭐</div>
								</div>
							</div>
							<p class="review-card__text">
								"Ingredienti di stagione, prezzi onesti, e uno staff che capisce quello che fa. Non è un ristorante, è una comunità. Torniamo ogni weekend."
							</p>
							<p class="review-card__date">1 mese fa</p>
						</article>

						<article class="review-card">
							<div class="review-card__header">
								<div class="review-card__avatar">👤</div>
								<div class="review-card__meta">
									<h3 class="review-card__author">Andrea T.</h3>
									<div class="review-card__rating">⭐⭐⭐⭐⭐</div>
								</div>
							</div>
							<p class="review-card__text">
								"Ristorazione autentica. Il brasato della nonna, rivisitato con consapevolezza moderna. Questo è quello che cercavamo."
							</p>
							<p class="review-card__date">3 settimane fa</p>
						</article>
					</div>
				</div>
			</section>

			<!-- Info Section -->
			<section id="info" class="info-section">
				<div class="container">
					<h2 class="section-title">Informazioni</h2>
					<div class="info-grid">
						<div class="info-card">
							<h3>Orari</h3>
							<p>
								Lunedì - Domenica<br />
								12:00 - 14:30<br />
								19:00 - 22:00<br />
								<em>Chiuso un giorno a settimana</em>
							</p>
						</div>
						<div class="info-card">
							<h3>Contatti</h3>
							<p>
								Via del Borgo, 42<br />
								<a href="tel:+390321234567">+39 0321 234567</a><br />
								<a href="mailto:info@trattoriadelborgo.it">info@trattoriadelborgo.it</a>
							</p>
						</div>
						<div class="info-card">
							<h3>Prenotazioni</h3>
							<p>
								Consigliato per gruppi<br />
								Disponibile anche al banco<br />
								Weekend sempre prenotato
							</p>
						</div>
					</div>
				</div>
			</section>
		</main>

		<!-- Footer -->
		<footer class="footer">
			<div class="container">
				<p>&copy; 2026 Trattoria del Borgo. Sito di presentazione Loop Studio.</p>
			</div>
		</footer>
	</body>
</html>

<style>
	:root {
		--font-display: 'Newsreader', Georgia, 'Times New Roman', serif;
		--font-editorial: 'Newsreader', -apple-system, BlinkMacSystemFont, 'Segoe UI', serif;
		--font-body: 'Space Grotesk Variable', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;

		/* Light theme */
		--bg-main: #f6f0e6;
		--bg-secondary: #fbf7ef;
		--bg-tertiary: #ece3d3;
		--text-primary: #2a1f1a;
		--text-secondary: #5c4d43;
		--text-muted: #7d6e61;
		--accent-primary: #b5412a;
		--accent-secondary: #6b7a3a;
		--accent-tertiary: #c8963e;
		--accent-rgb: 181, 65, 42;
		--border-color: #ddd0bb;
		--glass-bg: rgba(246, 240, 230, 0.7);
		--glass-backdrop: rgba(246, 240, 230, 0.95);
	}

	html[data-theme="dark"] {
		--bg-main: #17120f;
		--bg-secondary: #211a15;
		--bg-tertiary: #2b221c;
		--text-primary: #f3ece0;
		--text-secondary: #cfc3b3;
		--text-muted: #9a8c7c;
		--accent-primary: #e0694d;
		--accent-secondary: #a5b36a;
		--accent-tertiary: #d9a74e;
		--accent-rgb: 224, 105, 77;
		--border-color: #3a2f27;
		--glass-bg: rgba(33, 26, 21, 0.7);
		--glass-backdrop: rgba(23, 18, 15, 0.95);
	}

	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		font-family: var(--font-body);
		background: var(--bg-main);
		color: var(--text-primary);
		line-height: 1.6;
		font-weight: 400;
		font-size: 16px;
		transition: background-color 0.3s, color 0.3s;
	}

	/* Navbar */
	.navbar {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 1000;
		background: transparent;
		backdrop-filter: blur(0px);
		-webkit-backdrop-filter: blur(0px);
		transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
		border-bottom: 1px solid transparent;
	}

	.navbar.scrolled {
		background: var(--glass-backdrop);
		border-bottom-color: var(--border-color);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
	}

	.navbar.scrolled .navbar__logo,
	.navbar.scrolled .navbar__link {
		color: var(--text-primary);
	}

	.navbar__container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 16px 24px;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 24px;
	}

	.navbar__logo {
		font-family: var(--font-display);
		font-size: 18px;
		font-weight: 600;
		color: var(--text-primary);
		text-decoration: none;
		letter-spacing: -0.5px;
		transition: color 0.2s;
	}

	.navbar__logo:hover {
		color: var(--accent-primary);
	}

	.navbar__menu {
		list-style: none;
		display: flex;
		gap: 40px;
		flex: 1;
		justify-content: center;
	}

	.navbar__link {
		font-size: 14px;
		font-weight: 500;
		color: var(--text-secondary);
		text-decoration: none;
		transition: color 0.2s;
		position: relative;
	}

	.navbar__link:hover {
		color: var(--text-primary);
	}

	.navbar__link::after {
		content: '';
		position: absolute;
		bottom: -4px;
		left: 0;
		width: 0;
		height: 2px;
		background: var(--accent-primary);
		transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.navbar__link:hover::after {
		width: 100%;
	}

	/* Theme Switcher */
	.theme-switcher {
		background: var(--bg-secondary);
		border: 1px solid var(--border-color);
		border-radius: 8px;
		padding: 8px 12px;
		cursor: pointer;
		font-size: 18px;
		transition: all 0.3s ease;
		color: var(--text-primary);
	}

	.theme-switcher:hover {
		background: var(--accent-primary);
		color: var(--bg-main);
		border-color: var(--accent-primary);
	}

	.theme-switcher__icon {
		display: inline-block;
		transition: transform 0.3s ease;
	}

	/* Container */
	.container {
		max-width: 1000px;
		margin: 0 auto;
		padding: 0 32px;
	}

	main {
		position: relative;
		z-index: 100;
	}

	/* Hero Video Section */
	.hero-video {
		position: relative;
		height: 100vh;
		overflow: hidden;
	}

	.hero-video__container {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		z-index: 10;
	}

	.hero-video__content {
		text-align: center;
		max-width: 600px;
		animation: fadeInUp 0.8s ease-out;
		position: relative;
		z-index: 20;
		padding: 48px;
		background: rgba(23, 18, 15, 0.78);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border-radius: 16px;
		border: 1px solid rgba(var(--accent-rgb), 0.35);
		box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
	}

	.hero-video__title {
		font-family: var(--font-display);
		font-size: 72px;
		font-weight: 700;
		line-height: 1.05;
		margin-bottom: 20px;
		letter-spacing: -0.5px;
		color: white;
		text-shadow: 0 4px 12px rgba(0, 0, 0, 0.5);
	}

	.hero-video__subtitle {
		font-family: var(--font-editorial);
		font-size: 24px;
		color: rgba(255, 255, 255, 0.9);
		margin-bottom: 24px;
		font-weight: 400;
		font-style: italic;
		text-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
	}

	.hero-video__description {
		font-size: 18px;
		line-height: 1.7;
		color: rgba(255, 255, 255, 0.85);
		text-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
	}

	.hero-video__frame {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 100vw;
		height: 100vh;
		z-index: 1;
	}

	.hero-video__iframe {
		width: 100%;
		height: 100%;
		border: none;
		object-fit: cover;
	}

	.hero-video::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: linear-gradient(180deg, rgba(0, 0, 0, 0.5) 0%, rgba(0, 0, 0, 0.6) 50%, rgba(0, 0, 0, 0.8) 100%);
		z-index: 5;
	}

	/* Piatti Carousel */
	.piatti-carousel {
		padding: 100px 0;
		background: var(--bg-main);
	}

	.carousel-wrapper {
		overflow: hidden;
		border-radius: 16px;
	}

	.carousel {
		display: flex;
		width: max-content;
		animation: carousel-scroll 70s linear infinite;
	}

	.carousel__set {
		display: flex;
		flex-shrink: 0;
	}

	.carousel__img {
		width: 600px;
		height: 400px;
		object-fit: cover;
		border-radius: 12px;
		flex-shrink: 0;
		margin-right: 8px;
	}

	@keyframes carousel-scroll {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}

	.carousel-wrapper:hover .carousel {
		animation-play-state: paused;
	}

	/* Social Feed */
	.social-feed {
		padding: 100px 0;
		background: var(--bg-secondary);
		border-top: 1px solid var(--border-color);
		border-bottom: 1px solid var(--border-color);
	}

	.feed-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
	}

	.feed-card {
		margin: 0;
		background: var(--bg-main);
		border: 1px solid var(--border-color);
		border-radius: 12px;
		overflow: hidden;
		transition: all 0.3s ease;
		animation: fadeInUp 0.6s ease-out backwards;
	}

	.feed-card:nth-child(1) { animation-delay: 0.1s; }
	.feed-card:nth-child(2) { animation-delay: 0.2s; }
	.feed-card:nth-child(3) { animation-delay: 0.3s; }
	.feed-card:nth-child(4) { animation-delay: 0.4s; }
	.feed-card:nth-child(5) { animation-delay: 0.5s; }

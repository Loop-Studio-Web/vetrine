---
import '@fontsource-variable/space-grotesk';
import '@fontsource/newsreader/400.css';
import '@fontsource/newsreader/400-italic.css';
import '@fontsource/newsreader/700.css';

const base = import.meta.env.BASE_URL;
---

<html lang="it">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Trattoria del Borgo — Ristorazione Autentica</title>
		<meta
			name="description"
			content="Trattoria di provincia. Pasta fatta in casa, piatti di stagione, prezzi onesti. Qualità senza pretese."
		/>
	</head>
	<body>
		<!-- Navbar sticky con theme switcher -->
		<nav class="navbar" aria-label="Navigazione principale">
			<div class="navbar__container">
				<a href="#" class="navbar__logo">Trattoria del Borgo</a>
				<ul class="navbar__menu">
					<li><a href="#hero" class="navbar__link">Home</a></li>
					<li><a href="#menu" class="navbar__link">Menu</a></li>
					<li><a href="#reviews" class="navbar__link">Recensioni</a></li>
					<li><a href="#info" class="navbar__link">Contatti</a></li>
				</ul>
				<button class="theme-switcher" aria-label="Cambia tema" title="Cambia tema">
					<span class="theme-switcher__icon">🌙</span>
				</button>
			</div>
		</nav>

		<main>
			<!-- Video Hero Section -->
			<section id="hero" class="hero-video">
				<div class="hero-video__container">
					<div class="hero-video__content">
						<h1 class="hero-video__title">Trattoria del Borgo</h1>
						<p class="hero-video__subtitle">Ristorazione autentica. Rimodernizzata.</p>
						<p class="hero-video__description">
							Una trattoria nata negli anni '80, riaperta da ragazzi che credono nella qualità.
							Pasta fatta in casa, ingredienti di stagione, prezzi onesti.
						</p>
					</div>
					<div class="hero-video__frame">
						<video class="hero-video__iframe" autoplay muted loop playsinline>
							<source src="/vetrine/videos/trattoria-hero.f616.mp4" type="video/mp4" />
							Il tuo browser non supporta il tag video.
						</video>
					</div>
				</div>
			</section>

			<!-- Piatti del Giorno Carousel -->
			<section class="piatti-carousel">
				<div class="container">
					<h2 class="section-title">Piatti del Giorno</h2>
					<div class="carousel-wrapper">
						<div class="carousel">
							<img src="https://images.unsplash.com/photo-1621996346565-e3dbc646d9a9?w=600&h=400&fit=crop" alt="Pasta fresca" class="carousel__img" />
							<img src="https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=600&h=400&fit=crop" alt="Brasato di stagione" class="carousel__img" />
							<img src="https://images.unsplash.com/photo-1559827260-dc66d52bef19?w=600&h=400&fit=crop" alt="Risotto ai funghi" class="carousel__img" />
							<img src="https://images.unsplash.com/photo-1625521372841-35c51e5f9d4e?w=600&h=400&fit=crop" alt="Ravioli" class="carousel__img" />
							<img src="https://images.unsplash.com/photo-1540189549336-e6e99c3679fe?w=600&h=400&fit=crop" alt="Carpaccio" class="carousel__img" />
							<img src="https://images.unsplash.com/photo-1560448204-e02f7cbb8f0c?w=600&h=400&fit=crop" alt="Pane e olio" class="carousel__img" />
							<img src="https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=600&h=400&fit=crop" alt="Stracotto" class="carousel__img" />
							<img src="https://images.unsplash.com/photo-1535521066927-ab7c9ab60908?w=600&h=400&fit=crop" alt="Pasta al pomodoro" class="carousel__img" />
							<img src="https://images.unsplash.com/photo-1571407614614-c31a01e91ffe?w=600&h=400&fit=crop" alt="Orecchiette" class="carousel__img" />
							<img src="https://images.unsplash.com/photo-1621996346565-e3dbc646d9a9?w=600&h=400&fit=crop" alt="Tagliatelle" class="carousel__img" />
						</div>
					</div>
				</div>
			</section>

			<!-- Social Feed Mockup -->
			<section class="social-feed">
				<div class="container">
					<h2 class="section-title">Dal Nostro Feed</h2>
					<div class="feed-grid">
						<div class="feed-card">
							<img src="https://images.unsplash.com/photo-1621996346565-e3dbc646d9a9?w=500&h=500&fit=crop" alt="Pasta fresca" class="feed-card__image" />
							<div class="feed-card__content">
								<p class="feed-card__caption">Pasta all'uovo fatta stamattina. Ogni giorno, dalle 9.</p>
								<p class="feed-card__meta">❤️ 234 • 💬 12</p>
							</div>
						</div>

						<div class="feed-card">
							<img src="https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=500&h=500&fit=crop" alt="Brasato di stagione" class="feed-card__image" />
							<div class="feed-card__content">
								<p class="feed-card__caption">Brasato di stagione con verdure dell'orto. Ricetta di famiglia.</p>
								<p class="feed-card__meta">❤️ 189 • 💬 8</p>
							</div>
						</div>

						<div class="feed-card">
							<img src="https://images.unsplash.com/photo-1625521372841-35c51e5f9d4e?w=500&h=500&fit=crop" alt="Ravioli fatti in casa" class="feed-card__image" />
							<div class="feed-card__content">
								<p class="feed-card__caption">Ravioli fatti in casa con ripieno di ricotta e spinaci. Salsa di burro salvia.</p>
								<p class="feed-card__meta">❤️ 156 • 💬 5</p>
							</div>
						</div>

						<div class="feed-card">
							<img src="https://images.unsplash.com/photo-1540189549336-e6e99c3679fe?w=500&h=500&fit=crop" alt="Carpaccio di manzo" class="feed-card__image" />
							<div class="feed-card__content">
								<p class="feed-card__caption">Carpaccio di manzo con rucola fresca e scaglie di parmigiano. Qualità d'eccellenza.</p>
								<p class="feed-card__meta">❤️ 412 • 💬 24</p>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- Menu Section -->
			<section id="menu" class="menu-section">
				<div class="container">
					<h2 class="section-title">Menu</h2>

					<div class="menu-grid">
						<article class="menu-category">
							<h3 class="menu-category__title">Piatti Tipici</h3>
							<div class="menu-items">
								<div class="menu-item">
									<div class="menu-item__header">
										<h4 class="menu-item__name">Pasta all'Uovo</h4>
										<span class="menu-item__price">8€</span>
									</div>
									<p class="menu-item__desc">Con ragù di carne locale</p>
								</div>
								<div class="menu-item">
									<div class="menu-item__header">
										<h4 class="menu-item__name">Brasato di Stagione</h4>
										<span class="menu-item__price">14€</span>
									</div>
									<p class="menu-item__desc">Con verdure dell'orto</p>
								</div>
								<div class="menu-item">
									<div class="menu-item__header">
										<h4 class="menu-item__name">Risotto ai Funghi</h4>
										<span class="menu-item__price">12€</span>
									</div>
									<p class="menu-item__desc">Funghi di stagione</p>
								</div>
							</div>
						</article>

						<article class="menu-category">
							<h3 class="menu-category__title">Contorni & Insalate</h3>
							<div class="menu-items">
								<div class="menu-item">
									<div class="menu-item__header">
										<h4 class="menu-item__name">Verdure Grigliate</h4>
										<span class="menu-item__price">5€</span>
									</div>
									<p class="menu-item__desc">Di stagione</p>
								</div>
								<div class="menu-item">
									<div class="menu-item__header">
										<h4 class="menu-item__name">Insalata Mista</h4>
										<span class="menu-item__price">4€</span>
									</div>
									<p class="menu-item__desc">Verdure fresche</p>
								</div>
								<div class="menu-item">
									<div class="menu-item__header">
										<h4 class="menu-item__name">Patate al Forno</h4>
										<span class="menu-item__price">3€</span>
									</div>
								</div>
							</div>
						</article>

						<article class="menu-category">
							<h3 class="menu-category__title">Dolci</h3>
							<div class="menu-items">
								<div class="menu-item">
									<div class="menu-item__header">
										<h4 class="menu-item__name">Tiramisu</h4>
										<span class="menu-item__price">6€</span>
									</div>
									<p class="menu-item__desc">Fatto in casa</p>
								</div>
								<div class="menu-item">
									<div class="menu-item__header">
										<h4 class="menu-item__name">Panna Cotta</h4>
										<span class="menu-item__price">5€</span>
									</div>
									<p class="menu-item__desc">Frutta di stagione</p>
								</div>
							</div>
						</article>
					</div>
				</div>
			</section>

			<!-- Reviews Section (Loop Studio Style) -->
			<section id="reviews" class="reviews-section">
				<div class="container">
					<h2 class="section-title">Cosa Dicono</h2>
					<div class="reviews-grid">
						<article class="review-card">
							<div class="review-card__header">
								<div class="review-card__avatar">👤</div>
								<div class="review-card__meta">
									<h3 class="review-card__author">Marco R.</h3>
									<div class="review-card__rating">⭐⭐⭐⭐⭐</div>
								</div>
							</div>
							<p class="review-card__text">
								"Finalmente un posto dove la qualità non è negoziata. Pasta fatta come si deve, vini locali curati, e il gestore che conosce ogni cliente. Questo è il futuro della ristorazione di provincia."
							</p>
							<p class="review-card__date">2 settimane fa</p>
						</article>

						<article class="review-card">
							<div class="review-card__header">
								<div class="review-card__avatar">👤</div>
								<div class="review-card__meta">
									<h3 class="review-card__author">Lucia M.</h3>
									<div class="review-card__rating">⭐⭐⭐⭐⭐</div>
								</div>
							</div>
							<p class="review-card__text">
								"Ingredienti di stagione, prezzi onesti, e uno staff che capisce quello che fa. Non è un ristorante, è una comunità. Torniamo ogni weekend."
							</p>
							<p class="review-card__date">1 mese fa</p>
						</article>

						<article class="review-card">
							<div class="review-card__header">
								<div class="review-card__avatar">👤</div>
								<div class="review-card__meta">
									<h3 class="review-card__author">Andrea T.</h3>
									<div class="review-card__rating">⭐⭐⭐⭐⭐</div>
								</div>
							</div>
							<p class="review-card__text">
								"Ristorazione autentica. Il brasato della nonna, rivisitato con consapevolezza moderna. Questo è quello che cercavamo."
							</p>
							<p class="review-card__date">3 settimane fa</p>
						</article>
					</div>
				</div>
			</section>

			<!-- Info Section -->
			<section id="info" class="info-section">
				<div class="container">
					<h2 class="section-title">Informazioni</h2>
					<div class="info-grid">
						<div class="info-card">
							<h3>Orari</h3>
							<p>
								Lunedì - Domenica<br />
								12:00 - 14:30<br />
								19:00 - 22:00<br />
								<em>Chiuso un giorno a settimana</em>
							</p>
						</div>
						<div class="info-card">
							<h3>Contatti</h3>
							<p>
								Via del Borgo, 42<br />
								<a href="tel:+390321234567">+39 0321 234567</a><br />
								<a href="mailto:info@trattoriadelborgo.it">info@trattoriadelborgo.it</a>
							</p>
						</div>
						<div class="info-card">
							<h3>Prenotazioni</h3>
							<p>
								Consigliato per gruppi<br />
								Disponibile anche al banco<br />
								Weekend sempre prenotato
							</p>
						</div>
					</div>
				</div>
			</section>
		</main>

		<!-- Footer -->
		<footer class="footer">
			<div class="container">
				<p>&copy; 2026 Trattoria del Borgo. Sito di presentazione Loop Studio.</p>
			</div>
		</footer>
	</body>
</html>

<style>
	:root {
		--font-display: 'Space Grotesk Variable', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
		--font-editorial: 'Newsreader', -apple-system, BlinkMacSystemFont, 'Segoe UI', serif;
		--font-body: 'Space Grotesk Variable', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;

		/* Light theme */
		--bg-main: #f8f7f5;
		--bg-secondary: #fefdfb;
		--bg-tertiary: #f0ede8;
		--text-primary: #1a1a1a;
		--text-secondary: #555555;
		--text-muted: #888888;
		--accent-primary: #00d9ff;
		--accent-secondary: #7fff00;
		--accent-tertiary: #ff6b35;
		--border-color: #e0dbd5;
		--glass-bg: rgba(255, 255, 255, 0.7);
		--glass-backdrop: rgba(255, 255, 255, 0.95);
	}

	html[data-theme="dark"] {
		--bg-main: #0a0a0a;
		--bg-secondary: #1a1a1a;
		--bg-tertiary: #252525;
		--text-primary: #ffffff;
		--text-secondary: #cccccc;
		--text-muted: #999999;
		--accent-primary: #00d9ff;
		--accent-secondary: #7fff00;
		--accent-tertiary: #ff6b35;
		--border-color: #333333;
		--glass-bg: rgba(20, 20, 20, 0.7);
		--glass-backdrop: rgba(10, 10, 10, 0.95);
	}

	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		font-family: var(--font-body);
		background: var(--bg-main);
		color: var(--text-primary);
		line-height: 1.6;
		font-weight: 400;
		font-size: 16px;
		transition: background-color 0.3s, color 0.3s;
	}

	/* Navbar */
	.navbar {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 1000;
		background: transparent;
		backdrop-filter: blur(0px);
		-webkit-backdrop-filter: blur(0px);
		transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
		border-bottom: 1px solid transparent;
	}

	.navbar.scrolled {
		background: var(--glass-backdrop);
		border-bottom-color: var(--border-color);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
	}

	.navbar.scrolled .navbar__logo,
	.navbar.scrolled .navbar__link {
		color: var(--text-primary);
	}

	.navbar__container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 16px 24px;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 24px;
	}

	.navbar__logo {
		font-family: var(--font-display);
		font-size: 18px;
		font-weight: 600;
		color: var(--text-primary);
		text-decoration: none;
		letter-spacing: -0.5px;
		transition: color 0.2s;
	}

	.navbar__logo:hover {
		color: var(--accent-primary);
	}

	.navbar__menu {
		list-style: none;
		display: flex;
		gap: 40px;
		flex: 1;
		justify-content: center;
	}

	.navbar__link {
		font-size: 14px;
		font-weight: 500;
		color: var(--text-secondary);
		text-decoration: none;
		transition: color 0.2s;
		position: relative;
	}

	.navbar__link:hover {
		color: var(--text-primary);
	}

	.navbar__link::after {
		content: '';
		position: absolute;
		bottom: -4px;
		left: 0;
		width: 0;
		height: 2px;
		background: var(--accent-primary);
		transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.navbar__link:hover::after {
		width: 100%;
	}

	/* Theme Switcher */
	.theme-switcher {
		background: var(--bg-secondary);
		border: 1px solid var(--border-color);
		border-radius: 8px;
		padding: 8px 12px;
		cursor: pointer;
		font-size: 18px;
		transition: all 0.3s ease;
		color: var(--text-primary);
	}

	.theme-switcher:hover {
		background: var(--accent-primary);
		color: var(--bg-main);
		border-color: var(--accent-primary);
	}

	.theme-switcher__icon {
		display: inline-block;
		transition: transform 0.3s ease;
	}

	/* Container */
	.container {
		max-width: 1000px;
		margin: 0 auto;
		padding: 0 32px;
	}

	main {
		position: relative;
		z-index: 100;
	}

	/* Hero Video Section */
	.hero-video {
		position: relative;
		height: 100vh;
		overflow: hidden;
	}

	.hero-video__container {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		z-index: 10;
	}

	.hero-video__content {
		text-align: center;
		max-width: 600px;
		animation: fadeInUp 0.8s ease-out;
		position: relative;
		z-index: 20;
		padding: 48px;
		background: rgba(10, 10, 10, 0.75);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border-radius: 16px;
		border: 1px solid rgba(0, 217, 255, 0.2);
		box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
	}

	.hero-video__title {
		font-family: var(--font-display);
		font-size: 72px;
		font-weight: 700;
		line-height: 1.1;
		margin-bottom: 20px;
		letter-spacing: -1px;
		color: white;
		text-shadow: 0 4px 12px rgba(0, 0, 0, 0.5);
	}

	.hero-video__subtitle {
		font-family: var(--font-editorial);
		font-size: 24px;
		color: rgba(255, 255, 255, 0.9);
		margin-bottom: 24px;
		font-weight: 400;
		font-style: italic;
		text-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
	}

	.hero-video__description {
		font-size: 18px;
		line-height: 1.7;
		color: rgba(255, 255, 255, 0.85);
		text-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
	}

	.hero-video__frame {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 100vw;
		height: 100vh;
		z-index: 1;
	}

	.hero-video__iframe {
		width: 100%;
		height: 100%;
		border: none;
		object-fit: cover;
	}

	.hero-video::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: linear-gradient(180deg, rgba(0, 0, 0, 0.5) 0%, rgba(0, 0, 0, 0.6) 50%, rgba(0, 0, 0, 0.8) 100%);
		z-index: 5;
	}

	/* Piatti Carousel */
	.piatti-carousel {
		padding: 100px 0;
		background: var(--bg-main);
	}

	.carousel-wrapper {
		overflow: hidden;
		border-radius: 16px;
	}

	.carousel {
		display: flex;
		animation: carousel-scroll 20s linear infinite;
		gap: 8px;
	}

	.carousel__img {
		width: 600px;
		height: 400px;
		object-fit: cover;
		border-radius: 12px;
		flex-shrink: 0;
	}

	@keyframes carousel-scroll {
		0% {
			transform: translateX(0);
		}
		100% {
			transform: translateX(calc(-600px * 4 - 8px * 4));
		}
	}

	.carousel {
		animation-play-state: running;
	}

	.carousel-wrapper:hover .carousel {
		animation-play-state: paused;
	}

	/* Social Feed */
	.social-feed {
		padding: 100px 0;
		background: var(--bg-secondary);
		border-top: 1px solid var(--border-color);
		border-bottom: 1px solid var(--border-color);
	}

	.feed-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 24px;
	}

	.feed-card {
		background: var(--bg-main);
		border: 1px solid var(--border-color);
		border-radius: 12px;
		overflow: hidden;
		transition: all 0.3s ease;
		animation: fadeInUp 0.6s ease-out backwards;
	}

	.feed-card:nth-child(1) { animation-delay: 0.1s; }
	.feed-card:nth-child(2) { animation-delay: 0.2s; }
	.feed-card:nth-child(3) { animation-delay: 0.3s; }
	.feed-card:nth-child(4) { animation-delay: 0.4s; }

	.feed-card:hover {
		border-color: var(--accent-primary);
		box-shadow: 0 0 20px rgba(0, 217, 255, 0.15);

---
import '@fontsource-variable/space-grotesk';
import '@fontsource/newsreader/400.css';
import '@fontsource/newsreader/400-italic.css';
import '@fontsource/newsreader/700.css';
import { Image } from 'astro:assets';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const feedImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/trattoria/feed/*.jpg', { eager: true });
const feedImg = (file: string) => feedImages[`/src/assets/trattoria/feed/${file}`].default;

const recensioni = [
	{ name: 'Marco R.', stars: 5, time: '2 settimane fa', text: 'Tagliatelle al ragù come non le mangiavo da anni. Il ragazzo in sala ci ha consigliato il vino giusto senza farci sentire in un posto "da carta lunga". Abbiamo già prenotato per sabato prossimo.' },
	{ name: 'Lucia M.', stars: 5, time: '1 mese fa', text: 'Locale piccolo, tavoli a quadretti, prezzi onesti. Abbiamo diviso brasato e ravioli e chiuso con il tiramisù. Si sente che è tutto fatto lì.' },
	{ name: 'Andrea T.', stars: 4, time: '3 settimane fa', text: "Cucina davvero buona. Il sabato sera c'è un po' di attesa, ma si capisce: è sempre pieno. Meglio prenotare." },
	{ name: 'Giulia P.', stars: 5, time: '2 mesi fa', text: 'Siamo venuti in sei per un compleanno. Ci hanno accolti come amici e la panna cotta è finita in dieci minuti.' },
	{ name: 'Davide S.', stars: 5, time: '3 mesi fa', text: 'Pranzo veloce in settimana: risotto del giorno e caffè. Spesa onesta, servizio rapido, nessuna fretta di farti alzare.' },
	{ name: 'Elena F.', stars: 5, time: '4 mesi fa', text: 'Ho portato i miei genitori, che di trattorie se ne intendono. Hanno chiesto il bis dei ravioli e il numero per prenotare.' },
];
const mediaVoti = recensioni.reduce((t, r) => t + r.stars, 0) / recensioni.length;
const starPath = 'M10 1.5l2.5 5.3 5.8.8-4.2 4.1 1 5.8L10 14.7 4.9 17.5l1-5.8L1.7 7.6l5.8-.8z';

const piatti = [
	{ img: 'pizza.jpg', alt: 'Pizza con pomodoro, mozzarella e basilico' },
	{ img: 'pappardelle-ragu.jpg', alt: 'Pappardelle al ragù con salsiccia e parmigiano' },
	{ img: 'antipasto-rustico.jpg', alt: 'Tagliere rustico con pane, prosciutto, olive e formaggio' },
	{ img: 'brasato.jpg', alt: 'Brasato con patate e carote' },
	{ img: 'ravioli.jpg', alt: 'Ravioli fatti in casa' },
	{ img: 'risotto.jpg', alt: 'Risotto ai frutti di mare' },
	{ img: 'tagliata.jpg', alt: 'Tagliata di carne alla griglia' },
	{ img: 'panna-cotta.jpg', alt: 'Panna cotta con frutti rossi e crumble' },
	{ img: 'pesce.jpg', alt: 'Pesce al forno con limone' },
	{ img: 'tiramisu.jpg', alt: 'Tiramisù' },
	{ img: 'sfoglie-frutti-di-bosco.jpg', alt: 'Sfoglie con crema e frutti di bosco' },
];
const carouselImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/trattoria/carousel/*.jpg', { eager: true });
const carouselImg = (file: string) => carouselImages[`/src/assets/trattoria/carousel/${file}`].default;

const diario = [
	{ img: 'verdure.jpg', alt: 'Cassette di verdure di stagione dal contadino', time: '7:40', caption: 'Spesa dal contadino di Via Vecchia. Quello che troviamo stamattina è quello che trovate nel piatto.' },
	{ img: 'pasta.jpg', alt: 'Sfoglia tirata con la macchinetta a mano', time: '9:12', caption: 'Si tira la sfoglia come ci ha insegnato la nonna. La macchinetta è la sua, il resto lo facciamo a mano.' },
	{ img: 'pane.jpg', alt: 'Pane a lievitazione lunga appena sfornato', time: '10:30', caption: 'Pane a lievitazione lunga, 24 ore di attesa. Appena sfornato, finito entro stasera.' },
	{ img: 'cucina.jpg', alt: 'Il cuoco al lavoro in cucina prima del servizio', time: '11:15', caption: 'Prima del servizio ognuno al suo posto. Il menu del giorno va in lavagna alle 12.' },
	{ img: 'sala.jpg', alt: 'Tavoli con tovaglie a quadretti rossi apparecchiati', time: '11:50', caption: 'Tovaglie a quadretti, tavoli pronti. Prenotate dal sito o chiamateci: rispondiamo davvero noi.' },
	{ img: 'sera.jpg', alt: 'Bancone con candela e bottiglia di vino a fine serata', time: '21:50', caption: 'Ultimo giro di rosso, la candela ancora accesa. Domani si ricomincia alle 7.' },
];
---

<html lang="it">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Trattoria del Borgo — Ristorazione Autentica</title>
		<meta
			name="description"
			content="Trattoria di provincia. Pasta fatta in casa, piatti di stagione, prezzi onesti. Qualità senza pretese."
		/>
	</head>
	<body>
		<!-- Navbar sticky con theme switcher -->
		<nav class="navbar" aria-label="Navigazione principale">
			<div class="navbar__container">
				<a href="#" class="navbar__logo">Trattoria del Borgo</a>
				<ul class="navbar__menu">
					<li><a href="#hero" class="navbar__link">Home</a></li>
					<li><a href="#menu" class="navbar__link">Menu</a></li>
					<li><a href="#reviews" class="navbar__link">Recensioni</a></li>
					<li><a href="#info" class="navbar__link">Contatti</a></li>
				</ul>
				<div class="navbar__actions">
					<a href="#prenota" class="navbar__cta">Prenota</a>
					<button class="theme-switcher" aria-label="Cambia tema" title="Cambia tema">
						<span class="theme-switcher__icon">🌙</span>
					</button>
				</div>
			</div>
		</nav>

		<main>
			<!-- Video Hero Section -->
			<section id="hero" class="hero-video">
				<div class="hero-video__container">
					<div class="hero-video__content">
						<h1 class="hero-video__title">Trattoria del Borgo</h1>
						<p class="hero-video__subtitle">Ristorazione autentica. Rimodernizzata.</p>
						<p class="hero-video__description">
							Una trattoria nata negli anni '80, riaperta da ragazzi che credono nella qualità.
							Pasta fatta in casa, ingredienti di stagione, prezzi onesti.
						</p>
						<div class="hero-video__actions">
							<a href="#prenota" class="btn btn--primary">Prenota un tavolo</a>
							<a href="#menu" class="btn btn--ghost">Guarda il menu</a>
						</div>
					</div>
					<div class="hero-video__frame">
						<video class="hero-video__iframe" autoplay muted loop playsinline>
							<source src={`${base}/videos/trattoria-hero.f251.webm`} type="video/webm" />
								<source src={`${base}/videos/trattoria-hero.f616.mp4`} type="video/mp4" />
							Il tuo browser non supporta il tag video.
						</video>
					</div>
				</div>
			</section>

			<!-- Piatti del Giorno Carousel -->
			<section class="piatti-carousel">
				<div class="container">
					<h2 class="section-title">Piatti del Giorno</h2>
					<div class="carousel-wrapper">
						<div class="carousel">
								{[0, 1].map((copy) => (
									<div class="carousel__set" aria-hidden={copy === 1 ? 'true' : undefined}>
										{piatti.map((piatto) => (
											<Image src={carouselImg(piatto.img)} alt={copy === 1 ? '' : piatto.alt} width={600} height={400} densities={[1, 2]} class="carousel__img" />
										))}
									</div>
								))}
							</div>
					</div>
				</div>
			</section>

			<!-- Diario dalla cucina (angolo social) -->
				<section class="social-feed">
					<div class="container">
						<div class="feed-header">
							<h2 class="section-title">Dalla cucina</h2>
							<p class="feed-handle">Una giornata qui, raccontata da noi su Instagram <span>@trattoriadelborgo</span></p>
						</div>
						<div class="feed-grid">
							{diario.map((post) => (
								<figure class="feed-card">
									<Image src={feedImg(post.img)} alt={post.alt} width={400} height={400} densities={[1, 2]} class="feed-card__image" />
									<figcaption class="feed-card__content">
										<p class="feed-card__caption">{post.caption}</p>
										<p class="feed-card__meta">Oggi · {post.time}</p>
									</figcaption>
								</figure>
							))}
						</div>
					</div>
				</section>

				<!-- Menu Section -->
			<section id="menu" class="menu-section">
				<div class="container">
					<h2 class="section-title">Menu</h2>

					<div class="menu-grid">
						<article class="menu-category">
							<h3 class="menu-category__title">Piatti Tipici</h3>
							<div class="menu-items">
								<div class="menu-item">
									<div class="menu-item__header">
										<h4 class="menu-item__name">Pasta all'Uovo</h4>
										<span class="menu-item__price">8€</span>
									</div>
									<p class="menu-item__desc">Con ragù di carne locale</p>
								</div>
								<div class="menu-item">
									<div class="menu-item__header">
										<h4 class="menu-item__name">Brasato di Stagione</h4>
										<span class="menu-item__price">14€</span>
									</div>
									<p class="menu-item__desc">Con verdure dell'orto</p>
								</div>
								<div class="menu-item">
									<div class="menu-item__header">
										<h4 class="menu-item__name">Risotto ai Frutti di Mare</h4>
										<span class="menu-item__price">14€</span>
									</div>
									<p class="menu-item__desc">Cozze e gamberi del giorno</p>
								</div>
							</div>
						</article>

						<article class="menu-category">
							<h3 class="menu-category__title">Contorni & Insalate</h3>
							<div class="menu-items">
								<div class="menu-item">
									<div class="menu-item__header">
										<h4 class="menu-item__name">Verdure Grigliate</h4>
										<span class="menu-item__price">5€</span>
									</div>
									<p class="menu-item__desc">Di stagione</p>
								</div>
								<div class="menu-item">
									<div class="menu-item__header">
										<h4 class="menu-item__name">Insalata Mista</h4>
										<span class="menu-item__price">4€</span>
									</div>
									<p class="menu-item__desc">Verdure fresche</p>
								</div>
								<div class="menu-item">
									<div class="menu-item__header">
										<h4 class="menu-item__name">Patate al Forno</h4>
										<span class="menu-item__price">3€</span>
									</div>
								</div>
							</div>
						</article>

						<article class="menu-category">
							<h3 class="menu-category__title">Dolci</h3>
							<div class="menu-items">
								<div class="menu-item">
									<div class="menu-item__header">
										<h4 class="menu-item__name">Tiramisu</h4>
										<span class="menu-item__price">6€</span>
									</div>
									<p class="menu-item__desc">Fatto in casa</p>
								</div>
								<div class="menu-item">
									<div class="menu-item__header">
										<h4 class="menu-item__name">Panna Cotta</h4>
										<span class="menu-item__price">5€</span>
									</div>
									<p class="menu-item__desc">Frutta di stagione</p>
								</div>
							</div>
						</article>
					</div>
				</div>
			</section>

			<!-- Recensioni -->
				<section id="reviews" class="reviews-section">
					<div class="container">
						<h2 class="section-title">Cosa dicono</h2>
						<div class="reviews-widget">
							<div class="reviews-widget__head">
								<div>
									<h3 class="reviews-widget__title">Recensioni dei clienti</h3>
									<span class="reviews-widget__sub">Trattoria del Borgo</span>
								</div>
								<span class="reviews-widget__badge">Recensioni di esempio</span>
							</div>
							<div class="rating-summary">
								<span class="rating-summary__number">{mediaVoti.toFixed(1).replace('.', ',')}</span>
								<span class="rating-summary__stars" role="img" aria-label={`${mediaVoti.toFixed(1)} stelle su 5`} style={`--fill: ${(mediaVoti / 5) * 100}%`}>
									<span class="rating-summary__row rating-summary__row--bg" aria-hidden="true">
										{[0, 1, 2, 3, 4].map(() => <svg viewBox="0 0 20 20" width="18" height="18"><path d={starPath} /></svg>)}
									</span>
									<span class="rating-summary__row rating-summary__row--fg" aria-hidden="true">
										{[0, 1, 2, 3, 4].map(() => <svg viewBox="0 0 20 20" width="18" height="18"><path d={starPath} /></svg>)}
									</span>
								</span>
								<span class="rating-summary__count">126 recensioni</span>
							</div>
							<div class="reviews-grid">
								{recensioni.map((r) => (
									<article class="review-card">
										<div class="review-card__header">
											<div class="review-card__avatar" aria-hidden="true">{r.name[0]}</div>
											<div class="review-card__meta">
												<h3 class="review-card__author">{r.name}</h3>
												<div class="review-card__sub">
													<span class="stars" role="img" aria-label={`${r.stars} stelle su 5`}>
														{[1, 2, 3, 4, 5].map((n) => <svg viewBox="0 0 20 20" width="13" height="13" class={n <= r.stars ? 'star star--on' : 'star'}><path d={starPath} /></svg>)}
													</span>
													<span class="review-card__date">{r.time}</span>
												</div>
											</div>
										</div>
										<p class="review-card__text">{r.text}</p>
									</article>
								))}
							</div>
						</div>
					</div>
				</section>

				<!-- Prenotazione tavolo -->
				<section id="prenota" class="booking-section">
					<div class="container">
						<h2 class="section-title">Prenota un tavolo</h2>
						<p class="booking-lead">Scegli quanti siete, il giorno e l'orario. Conferma immediata, senza telefonare.</p>
						<div class="booking" id="booking">
							<ol class="booking__steps" aria-label="Fasi della prenotazione">
								<li class="booking__step" data-step="1"><span class="booking__bullet">1</span><span class="booking__label">Persone</span></li>
								<li class="booking__step" data-step="2"><span class="booking__bullet">2</span><span class="booking__label">Giorno</span></li>
								<li class="booking__step" data-step="3"><span class="booking__bullet">3</span><span class="booking__label">Orario</span></li>
								<li class="booking__step" data-step="4"><span class="booking__bullet">4</span><span class="booking__label">I tuoi dati</span></li>
							</ol>
							<div class="booking__panel" aria-live="polite"></div>
							<button type="button" class="booking__back" hidden>← Indietro</button>
						</div>
					</div>
				</section>

				<!-- Info Section -->
			<section id="info" class="info-section">
				<div class="container">
					<h2 class="section-title">Informazioni</h2>
					<div class="info-grid">
						<div class="info-card">
							<h3>Orari</h3>
							<p>
								Martedì - Domenica<br />
								12:00 - 14:30<br />
								19:00 - 22:00<br />
								<em>Chiuso il lunedì</em>
							</p>
						</div>
						<div class="info-card">
							<h3>Contatti</h3>
							<p>
								Via del Borgo, 42<br />
								<a href="tel:+390321234567">+39 0321 234567</a><br />
								<a href="mailto:info@trattoriadelborgo.it">info@trattoriadelborgo.it</a>
							</p>
						</div>
						<div class="info-card">
							<h3>Prenotazioni</h3>
							<p>
								<a href="#prenota">Prenota online</a><br />
								Oltre 8 persone: chiamaci<br />
								Il banco è senza prenotazione
							</p>
						</div>
					</div>
				</div>
			</section>
		</main>

		<!-- Footer -->
		<footer class="footer">
			<div class="container">
				<p>&copy; 2026 Trattoria del Borgo. Sito di presentazione Loop Studio.</p>
			</div>
		</footer>
	</body>
</html>

<style>
	:root {
		--font-display: 'Newsreader', Georgia, 'Times New Roman', serif;
		--font-editorial: 'Newsreader', -apple-system, BlinkMacSystemFont, 'Segoe UI', serif;
		--font-body: 'Space Grotesk Variable', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;

		/* Light theme */
		--bg-main: #f6f0e6;
		--bg-secondary: #fbf7ef;
		--bg-tertiary: #ece3d3;
		--text-primary: #2a1f1a;
		--text-secondary: #5c4d43;
		--text-muted: #7d6e61;
		--accent-primary: #b5412a;
		--accent-secondary: #6b7a3a;
		--accent-tertiary: #c8963e;
		--accent-rgb: 181, 65, 42;
		--border-color: #ddd0bb;
		--glass-bg: rgba(246, 240, 230, 0.7);
		--glass-backdrop: rgba(246, 240, 230, 0.95);
	}

	html[data-theme="dark"] {
		--bg-main: #17120f;
		--bg-secondary: #211a15;
		--bg-tertiary: #2b221c;
		--text-primary: #f3ece0;
		--text-secondary: #cfc3b3;
		--text-muted: #9a8c7c;
		--accent-primary: #e0694d;
		--accent-secondary: #a5b36a;
		--accent-tertiary: #d9a74e;
		--accent-rgb: 224, 105, 77;
		--border-color: #3a2f27;
		--glass-bg: rgba(33, 26, 21, 0.7);
		--glass-backdrop: rgba(23, 18, 15, 0.95);
	}

	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		font-family: var(--font-body);
		background: var(--bg-main);
		color: var(--text-primary);
		line-height: 1.6;
		font-weight: 400;
		font-size: 16px;
		transition: background-color 0.3s, color 0.3s;
	}

	/* Navbar */
	.navbar {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 1000;
		background: transparent;
		backdrop-filter: blur(0px);
		-webkit-backdrop-filter: blur(0px);
		transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
		border-bottom: 1px solid transparent;
	}

	.navbar.scrolled {
		background: var(--glass-backdrop);
		border-bottom-color: var(--border-color);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
	}

	.navbar:not(.scrolled) .navbar__logo,
	.navbar:not(.scrolled) .navbar__link {
		color: rgba(255, 255, 255, 0.92);
	}

	.navbar.scrolled .navbar__logo,
	.navbar.scrolled .navbar__link {
		color: var(--text-primary);
	}

	.navbar__container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 16px 24px;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 24px;
	}

	.navbar__logo {
		font-family: var(--font-display);
		font-size: 18px;
		font-weight: 600;
		color: var(--text-primary);
		text-decoration: none;
		letter-spacing: -0.5px;
		transition: color 0.2s;
	}

	.navbar__logo:hover {
		color: var(--accent-primary);
	}

	.navbar__menu {
		list-style: none;
		display: flex;
		gap: 40px;
		flex: 1;
		justify-content: center;
	}

	.navbar__link {
		font-size: 14px;
		font-weight: 500;
		color: var(--text-secondary);
		text-decoration: none;
		transition: color 0.2s;
		position: relative;
	}

	.navbar__link:hover {
		color: var(--text-primary);
	}

	.navbar__link::after {
		content: '';
		position: absolute;
		bottom: -4px;
		left: 0;
		width: 0;
		height: 2px;
		background: var(--accent-primary);
		transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.navbar__link:hover::after {
		width: 100%;
	}

	.navbar__actions {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.navbar__cta {
		background: var(--accent-primary);
		color: #fff;
		font-size: 14px;
		font-weight: 600;
		text-decoration: none;
		padding: 9px 18px;
		border-radius: 8px;
		transition: transform 0.2s, filter 0.2s;
	}

	.navbar__cta:hover {
		transform: translateY(-1px);
		filter: brightness(1.08);
	}

	/* Theme Switcher */
	.theme-switcher {
		background: var(--bg-secondary);
		border: 1px solid var(--border-color);
		border-radius: 8px;
		padding: 8px 12px;
		cursor: pointer;
		font-size: 18px;
		transition: all 0.3s ease;
		color: var(--text-primary);
	}

	.theme-switcher:hover {
		background: var(--accent-primary);
		color: var(--bg-main);
		border-color: var(--accent-primary);
	}

	.theme-switcher__icon {
		display: inline-block;
		transition: transform 0.3s ease;
	}

	/* Container */
	.container {
		max-width: 1000px;
		margin: 0 auto;
		padding: 0 32px;
	}

	main {
		position: relative;
		z-index: 100;
	}

	/* Hero Video Section */
	.hero-video {
		position: relative;
		height: 100vh;
		overflow: hidden;
	}

	.hero-video__container {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;

	@keyframes booking-fade {
		from { opacity: 0; transform: translateY(-4px); }
		to { opacity: 1; transform: translateY(0); }
	}

	.cal-nav {
		width: 34px;
		height: 34px;
		border-radius: 50%;
		background: none;
		border: 1px solid var(--border-color);
		color: var(--text-primary);
		font-size: 18px;
		line-height: 1;
		cursor: pointer;
		transition: border-color 0.2s, color 0.2s;
	}

	.cal-nav:hover:not(:disabled) {
		border-color: var(--accent-primary);
		color: var(--accent-primary);
	}

	.cal-nav:disabled {
		opacity: 0.3;
		cursor: not-allowed;
	}

	.cal-weekdays,
	.cal-grid {
		display: grid;
		grid-template-columns: repeat(7, 1fr);
		gap: 5px;
	}

	.cal-weekdays {
		text-align: center;
		font-size: 12px;
		color: var(--text-muted);
		margin-bottom: 6px;
	}

	.cal-cell {
		aspect-ratio: 1;
		border-radius: 8px;
		font-size: 14px;
		animation: booking-pop 0.3s backwards;
		animation-delay: var(--pop, 0s);
	}

	@keyframes booking-pop {
		from { opacity: 0; transform: scale(0.7); }
		to { opacity: 1; transform: scale(1); }
	}

	.cal-cell--empty {
		visibility: hidden;
		animation: none;
	}

	.cal-cell:disabled {
		color: var(--text-muted);
		opacity: 0.4;
		cursor: not-allowed;
		animation: none;
	}

	.cal-legend {
		margin-top: 14px;
		font-size: 13px;
		color: var(--text-muted);
	}

	/* Orari */
	.time-group + .time-group {
		margin-top: 18px;
	}

	.time-group__label {
		font-size: 12px;
		letter-spacing: 1px;
		text-transform: uppercase;
		color: var(--text-muted);
		margin-bottom: 8px;
	}

	.time-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(84px, 1fr));
		gap: 10px;
	}

	.time-slot {
		border-radius: 10px;
		padding: 11px 6px;
		font-size: 15px;
		animation: booking-pop 0.3s backwards;
		animation-delay: var(--pop, 0s);
	}

	.time-slot:disabled {
		opacity: 0.4;
		cursor: not-allowed;
		text-decoration: line-through;
		animation: none;
	}

	/* Dati */
	.field {
		display: flex;
		flex-direction: column;
		gap: 6px;
		margin-bottom: 16px;
		font-size: 14px;
		color: var(--text-secondary);
	}

	.field input,
	.field textarea {
		font: inherit;
		color: var(--text-primary);
		background: var(--bg-main);
		border: 1px solid var(--border-color);
		border-radius: 10px;
		padding: 11px 13px;
		resize: vertical;
		transition: border-color 0.2s;
	}

	.field input:focus,
	.field textarea:focus {
		border-color: var(--accent-primary);
		outline: none;
	}

	.booking-submit {
		width: 100%;
		font: inherit;
		font-weight: 700;
		color: #fff;
		background: var(--accent-primary);
		border: none;
		border-radius: 10px;
		padding: 14px;
		cursor: pointer;
		transition: transform 0.15s, opacity 0.2s, filter 0.2s;
	}

	.booking-submit:hover:not(:disabled) {
		transform: translateY(-1px);
		filter: brightness(1.08);
	}

	.booking-submit:disabled {
		opacity: 0.45;
		cursor: not-allowed;
	}

	.booking-submit--ghost {
		background: none;
		color: var(--accent-primary);
		border: 1px solid var(--accent-primary);
		margin-top: 8px;
	}

	/* Conferma */
	.booking-done {
		text-align: center;
		position: relative;
	}

	.booking-done__check {
		width: 72px;
		height: 72px;
		margin: 0 auto 14px;
		display: block;
	}

	.booking-done__circle,
	.booking-done__mark {
		fill: none;
		stroke: var(--accent-secondary);
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.booking-done__circle {
		stroke-width: 2;
		stroke-dasharray: 151;
		stroke-dashoffset: 151;
		animation: booking-draw 0.5s forwards;
	}

	.booking-done__mark {
		stroke-width: 3;
		stroke-dasharray: 40;
		stroke-dashoffset: 40;
		animation: booking-draw 0.35s 0.45s forwards;
	}

	@keyframes booking-draw {
		to { stroke-dashoffset: 0; }
	}

	.booking-summary {
		text-align: left;
		display: grid;
		gap: 10px;
		margin: 20px 0;
		padding: 16px 18px;
		background: var(--bg-main);
		border: 1px solid var(--border-color);
		border-radius: 12px;
	}

	.booking-summary div {
		display: flex;
		justify-content: space-between;
		gap: 16px;
		font-size: 14px;
	}

	.booking-summary dt {
		color: var(--text-muted);
	}

	.booking-summary dd {
		margin: 0;
		font-weight: 600;
		text-align: right;
	}

	.confetti {
		position: absolute;
		inset: -8px 0 auto;
		height: 0;
		pointer-events: none;
		overflow: visible;
	}

	.confetti span {
		position: absolute;
		top: 0;
		opacity: 0;
		border-radius: 1px;
		animation: booking-confetti var(--dur, 1.2s) ease-in var(--delay, 0s) forwards;
	}

	@keyframes booking-confetti {
		0% { opacity: 1; transform: translateY(0) rotate(0); }
		100% { opacity: 0; transform: translateY(150px) rotate(var(--rot, 180deg)); }
	}

	@media (max-width: 480px) {
		.booking {
			padding: 20px;
		}

		.booking__label {
			display: none;
		}

		.guest-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.booking__panel,
		.cal-cell,
		.time-slot,
		.confetti span {
			animation: none;
		}

		.confetti {
			display: none;
		}
	}
</style>

<script>
	// Widget prenotazione tavolo (demo: nessun dato viene inviato)
	const booking = document.getElementById('booking');

	if (booking) {
		const panel = booking.querySelector<HTMLElement>('.booking__panel')!;
		const backBtn = booking.querySelector<HTMLButtonElement>('.booking__back')!;
		const stepEls = booking.querySelectorAll<HTMLElement>('.booking__step');

		const MAX_GUESTS = 8;
		const CLOSED_DAY = 1; // lunedì
		const BOOKABLE_DAYS = 60;
		const SLOTS = {
			Pranzo: ['12:00', '12:30', '13:00', '13:30', '14:00'],
			Cena: ['19:00', '19:30', '20:00', '20:30', '21:00', '21:30'],
		};
		const CONFETTI_COLORS = ['#b5412a', '#6b7a3a', '#c8963e', '#e0694d'];
		const WEEKDAYS = ['Lun', 'Mar', 'Mer', 'Gio', 'Ven', 'Sab', 'Dom'];

		const startOfDay = (d: Date) => new Date(d.getFullYear(), d.getMonth(), d.getDate());
		const today = startOfDay(new Date());
		const lastDay = new Date(today.getTime() + BOOKABLE_DAYS * 86400000);
		const sameDay = (a: Date, b: Date) => a.getTime() === b.getTime();
		const fmtLong = (d: Date) => {
			const t = d.toLocaleDateString('it-IT', { weekday: 'long', day: 'numeric', month: 'long' });
			return t.charAt(0).toUpperCase() + t.slice(1);
		};

		const state = {
			step: 1,
			guests: null as number | null,
			date: null as Date | null,
			time: null as string | null,
			name: '',
			phone: '',
			notes: '',
			view: new Date(today.getFullYear(), today.getMonth(), 1),
			submitting: false,
			done: false,
		};

		// Disponibilità fittizia ma stabile: dipende solo da giorno e orario
		const isBooked = (date: Date, time: string) => {
			const [h, m] = time.split(':').map(Number);
			if (sameDay(date, today)) {
				const now = new Date();
				if (h * 60 + m <= now.getHours() * 60 + now.getMinutes() + 30) return true;
			}
			const seed = date.getDate() * 31 + date.getMonth() * 17 + h * 7 + m;
			const weekend = [5, 6, 0].includes(date.getDay()) && h >= 19;
			return seed % 6 === 0 || (weekend && seed % 4 === 0);
		};

		const isDayDisabled = (d: Date) => d < today || d > lastDay || d.getDay() === CLOSED_DAY;

		function renderSteps() {
			stepEls.forEach((el) => {
				const n = Number(el.dataset.step);
				el.classList.toggle('booking__step--active', !state.done && n === state.step);
				el.classList.toggle('booking__step--done', state.done || n < state.step);
			});
			backBtn.hidden = state.done || state.step === 1;
		}

		function renderGuests() {
			const buttons = Array.from({ length: MAX_GUESTS }, (_, i) => {
				const n = i + 1;
				const sel = state.guests === n ? ' guest-btn--selected' : '';
				return `<button type="button" class="guest-btn${sel}" data-guests="${n}"><strong>${n}</strong><span>${n === 1 ? 'persona' : 'persone'}</span></button>`;
			}).join('');
			return `<h3 class="booking__title" tabindex="-1">Quanti siete?</h3>
				<p class="booking__hint">Scegli il numero di persone al tavolo.</p>
				<div class="guest-grid">${buttons}</div>
				<p class="booking__note">Più di ${MAX_GUESTS} persone? Chiamaci al <a href="tel:+390321234567">0321 234567</a>.</p>`;
		}

		function renderCalendar() {
			const v = state.view;
			const first = new Date(v.getFullYear(), v.getMonth(), 1);
			const daysInMonth = new Date(v.getFullYear(), v.getMonth() + 1, 0).getDate();
			const lead = (first.getDay() + 6) % 7;
			const canPrev = first > new Date(today.getFullYear(), today.getMonth(), 1);
			const canNext = new Date(v.getFullYear(), v.getMonth() + 1, 1) <= lastDay;
			let cells = '';
			for (let i = 0; i < lead; i++) cells += '<span class="cal-cell cal-cell--empty" aria-hidden="true"></span>';
			for (let day = 1; day <= daysInMonth; day++) {
				const d = new Date(v.getFullYear(), v.getMonth(), day);
				const sel = state.date && sameDay(d, state.date) ? ' cal-cell--selected' : '';
				const off = isDayDisabled(d) ? ' disabled' : '';
				cells += `<button type="button" class="cal-cell${sel}" data-date="${d.getTime()}" style="--pop:${(lead + day) * 10}ms"${off}>${day}</button>`;
			}
			const monthLabel = first.toLocaleDateString('it-IT', { month: 'long', year: 'numeric' });
			return `<h3 class="booking__title" tabindex="-1">Che giorno?</h3>
				<p class="booking__hint">Tavolo per ${state.guests} ${state.guests === 1 ? 'persona' : 'persone'}.</p>
				<div class="cal-head">
					<button type="button" class="cal-nav" data-nav="-1" aria-label="Mese precedente"${canPrev ? '' : ' disabled'}>‹</button>
					<span class="cal-month">${monthLabel}</span>
					<button type="button" class="cal-nav" data-nav="1" aria-label="Mese successivo"${canNext ? '' : ' disabled'}>›</button>
				</div>
				<div class="cal-weekdays">${WEEKDAYS.map((w) => `<span>${w}</span>`).join('')}</div>
				<div class="cal-grid">${cells}</div>
				<p class="cal-legend">Chiusi il lunedì.</p>`;
		}

		function renderTimes() {
			const date = state.date!;
			let i = 0;
			const groups = Object.entries(SLOTS)
				.map(([label, times]) => {
					const buttons = times
						.map((t) => {
							const booked = isBooked(date, t);
							const sel = state.time === t ? ' time-slot--selected' : '';
							return `<button type="button" class="time-slot${sel}" data-time="${t}" style="--pop:${i++ * 25}ms"${booked ? ' disabled' : ''}>${t}</button>`;
						})
						.join('');
					return `<div class="time-group"><p class="time-group__label">${label}</p><div class="time-grid">${buttons}</div></div>`;
				})
				.join('');
			return `<h3 class="booking__title" tabindex="-1">A che ora?</h3>
				<p class="booking__hint">${fmtLong(date)}</p>${groups}
				<p class="booking__note">Gli orari barrati sono già al completo.</p>`;
		}

		function renderForm() {
			return `<form class="booking-form" novalidate>
				<h3 class="booking__title" tabindex="-1">I tuoi dati</h3>
				<p class="booking__hint">Ti servono solo per confermare il tavolo.</p>
				<label class="field"><span>Nome e cognome</span><input type="text" name="name" autocomplete="name" placeholder="Mario Rossi" required /></label>
				<label class="field"><span>Telefono</span><input type="tel" name="phone" autocomplete="tel" placeholder="333 1234567" required /></label>
				<label class="field"><span>Note (facoltativo)</span><textarea name="notes" rows="3" placeholder="Allergie, seggiolone, ricorrenze…"></textarea></label>
				<button type="submit" class="booking-submit" disabled>Conferma prenotazione</button>
			</form>`;
		}

		function renderDone() {
			const pieces = Array.from({ length: 26 }, (_, i) => {
				const w = 5 + Math.random() * 5;
				return `<span style="left:${Math.random() * 100}%;width:${w}px;height:${w * 0.4}px;background:${CONFETTI_COLORS[i % CONFETTI_COLORS.length]};--delay:${Math.round(Math.random() * 250)}ms;--dur:${Math.round(900 + Math.random() * 700)}ms;--rot:${Math.round(Math.random() * 360)}deg"></span>`;
			}).join('');
			return `<div class="booking-done">
				<div class="confetti" aria-hidden="true">${pieces}</div>
				<svg class="booking-done__check" viewBox="0 0 52 52" aria-hidden="true"><circle class="booking-done__circle" cx="26" cy="26" r="24"/><path class="booking-done__mark" d="M14 27l7 7 17-17"/></svg>
				<h3 class="booking__title" tabindex="-1">Tavolo prenotato</h3>
				<p class="booking__hint">Riepilogo di esempio: è una demo, nessuna prenotazione è stata inviata davvero.</p>
				<dl class="booking-summary">
					<div><dt>Persone</dt><dd>${state.guests}</dd></div>
					<div><dt>Giorno</dt><dd>${fmtLong(state.date!)}</dd></div>
					<div><dt>Orario</dt><dd>${state.time}</dd></div>
					<div><dt>A nome di</dt><dd class="booking-summary__free" data-name></dd></div>
				</dl>
				<button type="button" class="booking-submit booking-submit--ghost" data-reset>Nuova prenotazione</button>
			</div>`;
		}

		function render(focus = false) {
			renderSteps();
			panel.style.animation = 'none';
			void panel.offsetWidth;
			panel.style.animation = '';
			if (state.done) panel.innerHTML = renderDone();
			else if (state.step === 1) panel.innerHTML = renderGuests();
			else if (state.step === 2) panel.innerHTML = renderCalendar();
			else if (state.step === 3) panel.innerHTML = renderTimes();
			else panel.innerHTML = renderForm();

			if (state.done) {
				const nameEl = panel.querySelector<HTMLElement>('[data-name]');
				if (nameEl) nameEl.textContent = state.name; // textContent: nessun HTML dall'utente
			} else if (state.step === 4) {
				const form = panel.querySelector<HTMLFormElement>('.booking-form')!;
				const submit = form.querySelector<HTMLButtonElement>('.booking-submit')!;
				const nameInput = form.elements.namedItem('name') as HTMLInputElement;
				const phoneInput = form.elements.namedItem('phone') as HTMLInputElement;
				const notesInput = form.elements.namedItem('notes') as HTMLTextAreaElement;
				nameInput.value = state.name;
				phoneInput.value = state.phone;
				notesInput.value = state.notes;
				const validate = () => {
					state.name = nameInput.value;
					state.phone = phoneInput.value;
					state.notes = notesInput.value;
					const phoneOk = state.phone.replace(/\D/g, '').length >= 6;
					submit.disabled = !(state.name.trim().length > 1 && phoneOk) || state.submitting;
				};
				form.addEventListener('input', validate);
				form.addEventListener('submit', (e) => {
					e.preventDefault();
					validate();
					if (submit.disabled) return;
					state.submitting = true;
					submit.disabled = true;
					submit.textContent = 'Invio in corso…';
					setTimeout(() => {
						state.submitting = false;
						state.done = true;
						render(true);
					}, 900);
				});
				validate();
			}
			if (focus) panel.querySelector<HTMLElement>('.booking__title')?.focus({ preventScroll: true });
		}

		function go(step: number) {
			state.step = Math.max(1, Math.min(4, step));
			render(true);
		}

		panel.addEventListener('click', (e) => {
			const t = (e.target as HTMLElement).closest<HTMLElement>('button');
			if (!t) return;
			if (t.dataset.guests) {
				state.guests = Number(t.dataset.guests);
				go(2);
			} else if (t.dataset.date) {
				const d = new Date(Number(t.dataset.date));
				if (!state.date || !sameDay(state.date, d)) state.time = null;
				state.date = d;
				go(3);
			} else if (t.dataset.time) {
				state.time = t.dataset.time;
				go(4);
			} else if (t.dataset.nav) {
				state.view = new Date(state.view.getFullYear(), state.view.getMonth() + Number(t.dataset.nav), 1);
				render();
			} else if (t.hasAttribute('data-reset')) {
				Object.assign(state, { step: 1, guests: null, date: null, time: null, name: '', phone: '', notes: '', done: false, view: new Date(today.getFullYear(), today.getMonth(), 1) });
				render(true);
			}
		});

		backBtn.addEventListener('click', () => go(state.step - 1));

		render();
	}
</script>

<script>
	// Theme switcher
	const themeSwitcher = document.querySelector('.theme-switcher') as HTMLButtonElement;
	const html = document.documentElement;
	const icon = themeSwitcher?.querySelector('.theme-switcher__icon') as HTMLElement;

	// Leggi il tema salvato o usa il preferito di sistema
	const savedTheme = localStorage.getItem('theme');
	const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
	const initialTheme = savedTheme || (prefersDark ? 'dark' : 'light');

	// Applica il tema iniziale
	if (initialTheme === 'dark') {
		html.setAttribute('data-theme', 'dark');
		if (icon) icon.textContent = '☀️';
	}

	// Toggle tema
	themeSwitcher?.addEventListener('click', () => {
		const currentTheme = html.getAttribute('data-theme');
		const newTheme = currentTheme === 'dark' ? 'light' : 'dark';

		html.setAttribute('data-theme', newTheme);
		localStorage.setItem('theme', newTheme);

		if (icon) {
			icon.textContent = newTheme === 'dark' ? '☀️' : '🌙';
		}
	});

	// Navbar scroll effect
	const navbar = document.querySelector('.navbar') as HTMLElement;

	window.addEventListener('scroll', () => {
		if (window.scrollY > 10) {
			navbar.classList.add('scrolled');
		} else {
			navbar.classList.remove('scrolled');
		}
	});

	// Smooth scroll per navbar links
	document.querySelectorAll<HTMLAnchorElement>('.navbar__link').forEach(link => {
		link.addEventListener('click', (e) => {
			const href = link.getAttribute('href');
			if (href && href.startsWith('#')) {
				e.preventDefault();
				const target = document.querySelector(href);
				if (target) {
					target.scrollIntoView({ behavior: 'smooth' });
				}
			}
		});
	});
</script>

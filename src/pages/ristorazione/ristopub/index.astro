---
import '@fontsource-variable/big-shoulders-display';
import '@fontsource-variable/archivo';
import '../../../concepts/ristopub/base.css';
import Navbar from '../../../concepts/ristopub/Navbar.astro';
import Ingresso from '../../../concepts/ristopub/Ingresso.astro';
import Spine from '../../../concepts/ristopub/Spine.astro';
import Cucina from '../../../concepts/ristopub/Cucina.astro';
import Palco from '../../../concepts/ristopub/Palco.astro';
import Birrificio from '../../../concepts/ristopub/Birrificio.astro';
import Booking from '../../../concepts/ristopub/Booking.astro';
import Info from '../../../concepts/ristopub/Info.astro';
import Footer from '../../../concepts/ristopub/Footer.astro';
import Fascia from '../../../concepts/ristopub/Fascia.astro';
import Intro from '../../../concepts/ristopub/Intro.astro';
import Cursore from '../../../concepts/ristopub/Cursore.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = 'Luppolo & Watt — Birrificio, pub e palco';
const description = 'Birrificio-pub di fantasia: otto spine fatte in casa, panini da mangiare con le mani e musica dal vivo. Vetrina dimostrativa.';
const ogImage = new URL(`${base}/images/ristopub/og.jpg`, Astro.site).href;
const pageUrl = new URL(`${base}/ristorazione/ristopub/`, Astro.site).href;
---

<html lang="it">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${base}/images/ristopub/favicon.svg`} />
		<link rel="icon" type="image/png" href={`${base}/images/ristopub/favicon.png`} />
		<link rel="apple-touch-icon" href={`${base}/images/ristopub/apple-touch-icon.png`} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="theme-color" content="#e8921a" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="it_IT" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<script is:inline>
			document.documentElement.classList.add('js');
			// l'intro si vede una sola volta per sessione
			try {
				if (sessionStorage.getItem('lw-intro')) document.documentElement.classList.add('no-intro');
				else sessionStorage.setItem('lw-intro', '1');
			} catch (e) {}
		</script>
	</head>
	<body>
		<Intro />
		<a href="#main" class="skip-link">Vai al contenuto</a>
		<Fascia />
		<Navbar />
		<main id="main">
			<Ingresso />
			<Spine />
			<Cucina />
			<Palco />
			<Birrificio />
			<Booking />
			<Info />
		</main>
		<Footer />
		<Cursore />
		<script>
			// Rivela gli elementi quando entrano in vista
			const els = document.querySelectorAll('[data-reveal]');
			const io = new IntersectionObserver(
				(entries) => {
					for (const e of entries) {
						if (e.isIntersecting) {
							e.target.classList.add('is-visible');
							io.unobserve(e.target);
						}
					}
				},
				{ threshold: 0.12 },
			);
			els.forEach((el) => io.observe(el));
		</script>
	</body>
</html>

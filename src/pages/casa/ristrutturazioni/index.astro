---
import '@fontsource/young-serif/latin-400.css';
import '@fontsource-variable/onest/index.css';
import '@fontsource-variable/anybody/standard.css';
import '@fontsource/covered-by-your-grace/latin-400.css';
import '../../../concepts/obrafina/base.css';
import titulosUrl from '@fontsource/young-serif/files/young-serif-latin-400-normal.woff2?url';
import textoUrl from '@fontsource-variable/onest/files/onest-latin-wght-normal.woff2?url';
import Fascia from '../../../concepts/obrafina/Fascia.astro';
import Navbar from '../../../concepts/obrafina/Navbar.astro';
import Entrada from '../../../concepts/obrafina/Entrada.astro';
import Casa from '../../../concepts/obrafina/Casa.astro';
import Calendario from '../../../concepts/obrafina/Calendario.astro';
import Muestrario from '../../../concepts/obrafina/Muestrario.astro';
import Obras from '../../../concepts/obrafina/Obras.astro';
import Garantias from '../../../concepts/obrafina/Garantias.astro';
import Visita from '../../../concepts/obrafina/Visita.astro';
import Barra from '../../../concepts/obrafina/Barra.astro';
import Footer from '../../../concepts/obrafina/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = 'Obra Fina — Reformas integrales en Valencia';
const description = 'Empresa de reformas de fantasía: presupuestador estancia a estancia, calendario semana a semana, muestrario de baldosas hidráulicas y visita gratuita. Vetrina dimostrativa.';
const ogImage = new URL(`${base}/images/obrafina/og.jpg`, Astro.site).href;
const pageUrl = new URL(`${base}/casa/ristrutturazioni/`, Astro.site).href;
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href={`${base}/images/obrafina/favicon.png`} />
		<link rel="apple-touch-icon" href={`${base}/images/obrafina/apple-touch-icon.png`} />
		<link rel="preload" as="font" type="font/woff2" href={titulosUrl} crossorigin />
		<link rel="preload" as="font" type="font/woff2" href={textoUrl} crossorigin />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="theme-color" content="#d9e3f1" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>
	</head>
	<body>
		<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false"><filter id="of-ruvido" x="-4%" y="-4%" width="108%" height="108%"><feTurbulence type="fractalNoise" baseFrequency="0.05 0.08" numOctaves="3" seed="9" result="n"/><feDisplacementMap in="SourceGraphic" in2="n" scale="5"/></filter></svg>
		<a href="#main" class="skip-link">Ir al contenido</a>
		<Fascia />
		<Navbar />
		<main id="main">
			<Entrada />
			<Casa />
			<Calendario />
			<Muestrario />
			<Obras />
			<Garantias />
			<Visita />
		</main>
		<Footer />
		<Barra />
		<script>
			// Los anclajes internos se desplazan por script: en Safari/iPhone el nativo puede aterrizar torcido si la página cambia de altura.
			document.addEventListener('click', (e) => {
				const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="#"]');
				if (!a || e.defaultPrevented || e.metaKey || e.ctrlKey || e.shiftKey) return;
				const id = a.getAttribute('href')!.slice(1);
				const el = id ? document.getElementById(id) : document.documentElement;
				if (!el) return;
				e.preventDefault();
				const reducido = matchMedia('(prefers-reduced-motion: reduce)').matches;
				requestAnimationFrame(() => el.scrollIntoView({ behavior: reducido ? 'auto' : 'smooth', block: 'start' }));
				if (id) history.replaceState(null, '', `#${id}`);
			});
		</script>
		<script>
			// Revela los elementos al entrar en vista
			const io = new IntersectionObserver(
				(entradas) => {
					for (const e of entradas) {
						if (e.isIntersecting) {
							e.target.classList.add('visto');
							io.unobserve(e.target);
						}
					}
				},
				{ threshold: 0.12 },
			);
			document.querySelectorAll('[data-rev]').forEach((el) => io.observe(el));
		</script>
	</body>
</html>

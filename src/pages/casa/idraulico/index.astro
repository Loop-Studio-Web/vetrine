---
import '@fontsource/gloock/400.css';
import '@fontsource/karla/400.css';
import '@fontsource/karla/600.css';
import '@fontsource/karla/700.css';
import '../../../concepts/sifone/base.css';
import titoliUrl from '@fontsource/gloock/files/gloock-latin-400-normal.woff2?url';
import testoUrl from '@fontsource/karla/files/karla-latin-400-normal.woff2?url';
import Fascia from '../../../concepts/sifone/Fascia.astro';
import Navbar from '../../../concepts/sifone/Navbar.astro';
import Impianto from '../../../concepts/sifone/Impianto.astro';
import Ingresso from '../../../concepts/sifone/Ingresso.astro';
import Problemi from '../../../concepts/sifone/Problemi.astro';
import Zone from '../../../concepts/sifone/Zone.astro';
import Tariffe from '../../../concepts/sifone/Tariffe.astro';
import Bottega from '../../../concepts/sifone/Bottega.astro';
import Fiducia from '../../../concepts/sifone/Fiducia.astro';
import Richiesta from '../../../concepts/sifone/Richiesta.astro';
import Barra from '../../../concepts/sifone/Barra.astro';
import Footer from '../../../concepts/sifone/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = 'Sifone — Pronto intervento idraulico 24 ore';
const description = 'Idraulico di fantasia, pronto intervento 24 ore su 24: cosa fare subito, tempi per zona, tariffe in chiaro e richiesta di intervento. Vetrina dimostrativa.';
const ogImage = new URL(`${base}/images/sifone/og.jpg`, Astro.site).href;
const pageUrl = new URL(`${base}/casa/idraulico/`, Astro.site).href;
---

<html lang="it">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${base}/images/sifone/favicon.svg`} />
		<link rel="icon" type="image/png" href={`${base}/images/sifone/favicon.png`} />
		<link rel="apple-touch-icon" href={`${base}/images/sifone/apple-touch-icon.png`} />
		<link rel="preload" as="font" type="font/woff2" href={titoliUrl} crossorigin />
		<link rel="preload" as="font" type="font/woff2" href={testoUrl} crossorigin />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="theme-color" content="#0f3a3f" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="it_IT" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>
	</head>
	<body>
		<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false"><filter id="sifone-ruvido" x="-5%" y="-20%" width="110%" height="140%"><feTurbulence type="fractalNoise" baseFrequency="0.04 0.9" numOctaves="2" seed="4" result="n"/><feDisplacementMap in="SourceGraphic" in2="n" scale="3.2"/></filter></svg>
		<a href="#main" class="skip-link">Vai al contenuto</a>
		<Fascia />
		<Navbar />
		<Impianto />
		<main id="main">
			<Ingresso />
			<Problemi />
			<Zone />
			<Tariffe />
			<Bottega />
			<Fiducia />
			<Richiesta />
		</main>
		<Footer />
		<Barra />
		<script>
			// Le ancore interne scorrono via script: su Safari/iPhone l'ancora nativa può atterrare storta se la pagina cambia altezza.
			document.addEventListener('click', (e) => {
				const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="#"]');
				if (!a || e.defaultPrevented || e.metaKey || e.ctrlKey || e.shiftKey) return;
				const id = a.getAttribute('href')!.slice(1);
				const el = id ? document.getElementById(id) : document.documentElement;
				if (!el) return;
				e.preventDefault();
				const ridotto = matchMedia('(prefers-reduced-motion: reduce)').matches;
				requestAnimationFrame(() => el.scrollIntoView({ behavior: ridotto ? 'auto' : 'smooth', block: 'start' }));
				if (id) history.replaceState(null, '', `#${id}`);
			});
		</script>
		<script>
			// Rivela gli elementi quando entrano in vista
			const io = new IntersectionObserver(
				(entries) => {
					for (const e of entries) {
						if (e.isIntersecting) {
							e.target.classList.add('is-visible');
							io.unobserve(e.target);
						}
					}
				},
				{ threshold: 0.12 },
			);
			document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
		</script>
	</body>
</html>

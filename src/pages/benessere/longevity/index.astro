---
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/montserrat';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource/cinzel/500.css';
import '../../../concepts/aeterna/base.css';
import Fascia from '../../../concepts/aeterna/Fascia.astro';
import Navbar from '../../../concepts/aeterna/Navbar.astro';
import Cursore from '../../../concepts/aeterna/Cursore.astro';
import Ingresso from '../../../concepts/aeterna/Ingresso.astro';
import Metriche from '../../../concepts/aeterna/Metriche.astro';
import Trattamenti from '../../../concepts/aeterna/Trattamenti.astro';
import Metodo from '../../../concepts/aeterna/Metodo.astro';
import Assessment from '../../../concepts/aeterna/Assessment.astro';
import Scanner from '../../../concepts/aeterna/Scanner.astro';
import Suite from '../../../concepts/aeterna/Suite.astro';
import Info from '../../../concepts/aeterna/Info.astro';
import Footer from '../../../concepts/aeterna/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = 'Aeterna — Biohacking & Longevity Clinic';
const description =
	'Clinica di longevità di fantasia: elica di DNA in WebGL, protocolli a scorrimento orizzontale, Bio-Assessment con grafico radar, scanner cellulare e prenotazione della suite. Vetrina dimostrativa.';
const ogImage = new URL(`${base}/images/aeterna/og.jpg`, Astro.site).href;
const pageUrl = new URL(`${base}/benessere/longevity/`, Astro.site).href;
---

<html lang="it">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${base}/images/aeterna/favicon.svg`} />
		<link rel="icon" type="image/png" href={`${base}/images/aeterna/favicon.png`} />
		<link rel="apple-touch-icon" href={`${base}/images/aeterna/apple-touch-icon.png`} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="theme-color" content="#060b14" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="it_IT" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<script is:inline>
			(function () {
				var h = document.documentElement;
				h.classList.add('js');
				if (matchMedia('(prefers-reduced-motion: reduce)').matches) h.classList.add('ridotto');
				try {
					if (sessionStorage.getItem('aeterna-intro')) h.classList.add('senza-intro');
				} catch (e) {}
				// l'intro nasconde la pagina: si apre sempre dall'alto
				if (!h.classList.contains('senza-intro') && !h.classList.contains('ridotto') && 'scrollRestoration' in history) history.scrollRestoration = 'manual';
			})();
		</script>
	</head>
	<body>
		<a href="#main" class="skip-link">Vai al contenuto</a>
		<Fascia />
		<Navbar />
		<Cursore />
		<main id="main">
			<Ingresso />
			<Metriche />
			<Trattamenti />
			<Metodo />
			<Assessment />
			<Scanner />
			<Suite />
			<Info />
		</main>
		<Footer />
		<script>
			import { ScrollTrigger } from '../../../concepts/aeterna/motore';
			// i font cambiano le altezze: si ricalcolano le posizioni dei trigger
			document.fonts.ready.then(() => ScrollTrigger.refresh());
			addEventListener('load', () => ScrollTrigger.refresh());
		</script>
	</body>
</html>

---
import '@fontsource-variable/cormorant';
import '@fontsource-variable/cormorant/wght-italic.css';
import '@fontsource-variable/dm-sans';
import '../../../concepts/lumen/base.css';
import Fascia from '../../../concepts/lumen/Fascia.astro';
import Navbar from '../../../concepts/lumen/Navbar.astro';
import Meridiana from '../../../concepts/lumen/Meridiana.astro';
import Ingresso from '../../../concepts/lumen/Ingresso.astro';
import Rituali from '../../../concepts/lumen/Rituali.astro';
import SuMisura from '../../../concepts/lumen/SuMisura.astro';
import Cabine from '../../../concepts/lumen/Cabine.astro';
import Boutique from '../../../concepts/lumen/Boutique.astro';
import Prenota from '../../../concepts/lumen/Prenota.astro';
import Info from '../../../concepts/lumen/Info.astro';
import Footer from '../../../concepts/lumen/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = 'Atelier Lumen — Centro estetico';
const description = 'Centro estetico di fantasia: trattamenti viso e corpo, rituale su misura, tre cabine e prenotazione per fasce di luce. Vetrina dimostrativa.';
const ogImage = new URL(`${base}/images/lumen/og.jpg`, Astro.site).href;
const pageUrl = new URL(`${base}/benessere/estetica/`, Astro.site).href;
---

<html lang="it">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${base}/images/lumen/favicon.svg`} />
		<link rel="icon" type="image/png" href={`${base}/images/lumen/favicon.png`} />
		<link rel="apple-touch-icon" href={`${base}/images/lumen/apple-touch-icon.png`} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="theme-color" content="#241619" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="it_IT" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>
	</head>
	<body>
		<a href="#main" class="skip-link">Vai al contenuto</a>
		<Fascia />
		<Navbar />
		<Meridiana />
		<main id="main">
			<Ingresso />
			<Rituali />
			<SuMisura />
			<Cabine />
			<Boutique />
			<Prenota />
			<Info />
		</main>
		<Footer />
		<script>
			// Le ancore interne scorrono via script e non con l'ancora nativa: su Safari/iPhone l'ancora con scorrimento
			// morbido può partire dall'alto e atterrare storta quando la pagina cambia altezza mentre scorre.
			document.addEventListener('click', (e) => {
				const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="#"]');
				if (!a || e.defaultPrevented || e.metaKey || e.ctrlKey || e.shiftKey) return;
				const id = a.getAttribute('href')!.slice(1);
				const el = id ? document.getElementById(id) : document.documentElement;
				if (!el) return;
				e.preventDefault();
				const ridotto = matchMedia('(prefers-reduced-motion: reduce)').matches;
				requestAnimationFrame(() => el.scrollIntoView({ behavior: ridotto ? 'auto' : 'smooth', block: 'start' }));
				if (id) history.replaceState(null, '', `#${id}`);
			});
		</script>
		<script>
			// Rivela gli elementi quando entrano in vista
			const els = document.querySelectorAll('[data-reveal]');
			const io = new IntersectionObserver(
				(entries) => {
					for (const e of entries) {
						if (e.isIntersecting) {
							e.target.classList.add('is-visible');
							io.unobserve(e.target);
						}
					}
				},
				{ threshold: 0.12 },
			);
			els.forEach((el) => io.observe(el));
		</script>
	</body>
</html>

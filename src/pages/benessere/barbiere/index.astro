---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/figtree';
import '../../../concepts/barbiere/base.css';
import Fascia from '../../../concepts/barbiere/Fascia.astro';
import Navbar from '../../../concepts/barbiere/Navbar.astro';
import Ingresso from '../../../concepts/barbiere/Ingresso.astro';
import Listino from '../../../concepts/barbiere/Listino.astro';
import Sedie from '../../../concepts/barbiere/Sedie.astro';
import Turno from '../../../concepts/barbiere/Turno.astro';
import Info from '../../../concepts/barbiere/Info.astro';
import Footer from '../../../concepts/barbiere/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = 'Bottega Tre Rasoi — Barbiere di quartiere';
const description = 'Barbiere di quartiere di fantasia: taglio, barba e rasoio, tre sedie e prenotazione a turno. Vetrina dimostrativa.';
const ogImage = new URL(`${base}/images/barbiere/og.jpg`, Astro.site).href;
const pageUrl = new URL(`${base}/benessere/barbiere/`, Astro.site).href;
---

<html lang="it">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${base}/images/barbiere/favicon.svg`} />
		<link rel="icon" type="image/png" href={`${base}/images/barbiere/favicon.png`} />
		<link rel="apple-touch-icon" href={`${base}/images/barbiere/apple-touch-icon.png`} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="theme-color" content="#1f4d3a" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="it_IT" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<script is:inline>
			document.documentElement.classList.add('js');
			// tema ricordato: evita il lampo di chiaro quando si è scelta la chiusura serale
			try {
				if (localStorage.getItem('trr-tema') === 'scuro') document.documentElement.dataset.tema = 'scuro';
			} catch (e) {}
		</script>
	</head>
	<body>
		<a href="#main" class="skip-link">Vai al contenuto</a>
		<Fascia />
		<Navbar />
		<main id="main">
			<Ingresso />
			<Listino />
			<Sedie />
			<Turno />
			<Info />
		</main>
		<Footer />
		<script>
			// Rivela gli elementi quando entrano in vista
			const els = document.querySelectorAll('[data-reveal]');
			const io = new IntersectionObserver(
				(entries) => {
					for (const e of entries) {
						if (e.isIntersecting) {
							e.target.classList.add('is-visible');
							io.unobserve(e.target);
						}
					}
				},
				{ threshold: 0.12 },
			);
			els.forEach((el) => io.observe(el));
		</script>
	</body>
</html>

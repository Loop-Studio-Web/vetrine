---
import '@fontsource/caprasimo';
import '@fontsource/permanent-marker';
import '@fontsource-variable/familjen-grotesk';
import '../../../concepts/malahierba/base.css';
import capUrl from '@fontsource/caprasimo/files/caprasimo-latin-400-normal.woff2?url';
import famUrl from '@fontsource-variable/familjen-grotesk/files/familjen-grotesk-latin-wght-normal.woff2?url';
import Fascia from '../../../concepts/malahierba/Fascia.astro';
import Navbar from '../../../concepts/malahierba/Navbar.astro';
import Entrada from '../../../concepts/malahierba/Entrada.astro';
import Muertos from '../../../concepts/malahierba/Muertos.astro';
import Ocasiones from '../../../concepts/malahierba/Ocasiones.astro';
import Arma from '../../../concepts/malahierba/Arma.astro';
import Montajes from '../../../concepts/malahierba/Montajes.astro';
import Pedir from '../../../concepts/malahierba/Pedir.astro';
import Resenas from '../../../concepts/malahierba/Resenas.astro';
import Visita from '../../../concepts/malahierba/Visita.astro';
import Barra from '../../../concepts/malahierba/Barra.astro';
import Footer from '../../../concepts/malahierba/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = 'Mala Hierba Flores — Florería en Guadalajara';
const description = 'Florería de fantasía en Guadalajara: arma tu ramo y mira cómo queda, cempasúchil para Día de Muertos, arcos y centros de mesa. Vetrina dimostrativa.';
const ogImage = new URL(`${base}/images/malahierba/og.jpg`, Astro.site).href;
const pageUrl = new URL(`${base}/eventi/fiorista/`, Astro.site).href;
---

<html lang="es-MX">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${base}/images/malahierba/favicon.svg`} />
		<link rel="preload" as="font" type="font/woff2" href={capUrl} crossorigin />
		<link rel="preload" as="font" type="font/woff2" href={famUrl} crossorigin />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="theme-color" content="#d10d69" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_MX" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>
	</head>
	<body>
		<a href="#main" class="skip-link">Ir al contenido</a>
		<Fascia />
		<Navbar />
		<main id="main">
			<Entrada />
			<Muertos />
			<Ocasiones />
			<Arma />
			<Montajes />
			<Pedir />
			<Resenas />
			<Visita />
		</main>
		<Footer />
		<Barra />
		<script>
			// Las anclas internas se mueven por script: en Safari/iPhone el scroll suave nativo puede aterrizar torcido.
			document.addEventListener('click', (e) => {
				const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="#"]');
				if (!a || e.defaultPrevented || e.metaKey || e.ctrlKey || e.shiftKey) return;
				const id = a.getAttribute('href')!.slice(1);
				const el = id && id !== 'top' ? document.getElementById(id) : document.documentElement;
				if (!el) return;
				e.preventDefault();
				const reducido = matchMedia('(prefers-reduced-motion: reduce)').matches;
				requestAnimationFrame(() => el.scrollIntoView({ behavior: reducido ? 'auto' : 'smooth', block: 'start' }));
				if (id) history.replaceState(null, '', `#${id}`);
			});
		</script>
	</body>
</html>

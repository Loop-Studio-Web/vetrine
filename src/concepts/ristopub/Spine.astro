---
import { birre, gruppi } from './birre';
---

<section class="sezione spine" id="spine" aria-labelledby="spine-titolo">
	<div class="sezione__in">
		<header class="spine__testa" data-reveal>
			<p class="etichetta">La lavagna</p>
			<h2 class="titolo" id="spine-titolo">Otto spine,<br />nessuna <em>uguale</em>.</h2>
			<p class="spine__lead">
				Cambiano con le stagioni e con l’umore del mastro birraio. Tocca una birra per sapere com’è fatta e con che cosa
				va d’accordo.
			</p>
		</header>

		<div class="spine__filtri" role="group" aria-label="Filtra per tipo di birra" data-reveal>
			{
				gruppi.map((g, i) => (
					<button type="button" class="chip" aria-pressed={i === 0 ? 'true' : 'false'} data-filtro={g.id}>
						{g.nome}
					</button>
				))
			}
			<p class="spine__conto" aria-live="polite" data-conto>8 birre</p>
		</div>

		<ul class="spine__lista">
			{
				birre.map((b) => (
					<li class="tap" data-gruppo={b.gruppo} data-id={b.id} data-reveal style={`--liquido:${b.colore};--num:${b.ebc >= 50 ? '#f1e8d4' : '#1a1815'}`}>
						<h3 class="tap__h">
							<button
								type="button"
								class="tap__riga"
								aria-expanded="false"
								aria-controls={`pannello-${b.id}`}
								id={`riga-${b.id}`}
							>
								<span class="tap__num" aria-hidden="true">{b.spina}</span>
								<span class="tap__nome">
									{b.nome}
									<small>{b.stile}</small>
								</span>
								<span class="tap__gradi">
									{String(b.gradi).replace('.', ',')}
									<small>% vol</small>
								</span>
								<span class={`tap__stato tap__stato--${b.stato.replace(' ', '-')}`}>{b.stato}</span>
								<span class="tap__piu" aria-hidden="true"></span>
							</button>
						</h3>
						<div class="tap__corpo" id={`pannello-${b.id}`} role="region" aria-labelledby={`riga-${b.id}`}>
							<div class="tap__corpo-in">
								<svg class="tap__bicchiere" viewBox="0 0 80 120" aria-hidden="true">
									<defs>
										<clipPath id={`clip-${b.id}`}>
											<path d="M12 12h56l-6 98a6 6 0 0 1-6 6H24a6 6 0 0 1-6-6z" />
										</clipPath>
									</defs>
									<g clip-path={`url(#clip-${b.id})`}>
										<rect class="tap__liquido" x="0" y="0" width="80" height="120" fill={b.colore} />
										<rect class="tap__schiuma" x="0" y="0" width="80" height="16" fill="#fbf3df" />
									</g>
									<path
										d="M12 12h56l-6 98a6 6 0 0 1-6 6H24a6 6 0 0 1-6-6z"
										fill="none"
										stroke="#1a1815"
										stroke-width="4"
										stroke-linejoin="round"
									/>
								</svg>
								<div class="tap__testo">
									<p class="tap__note">{b.note}</p>
									<p class="tap__profumo"><span>Al naso</span> {b.profumo}</p>
									<dl class="tap__misure">
										<div>
											<dt>Amaro</dt>
											<dd>
												<span class="barra"><i style={`--v:${b.ibu / 80}`}></i></span>
												{b.ibu} IBU
											</dd>
										</div>
										<div>
											<dt>Grado</dt>
											<dd>
												<span class="barra"><i style={`--v:${b.gradi / 10}`}></i></span>
												{String(b.gradi).replace('.', ',')} %
											</dd>
										</div>
										<div>
											<dt>Colore</dt>
											<dd>
												<span class="tap__goccia" style={`background:${b.colore}`}></span>
												{b.ebc} EBC
											</dd>
										</div>
									</dl>
									<p class="tap__prezzo">
										<span>0,2 l <b>{b.prezzo[0]} €</b></span>
										<span>0,4 l <b>{b.prezzo[1]} €</b></span>
									</p>
								</div>
							</div>
						</div>
					</li>
				))
			}
		</ul>
		<p class="spine__nota">Prezzi e birre di esempio: il locale è di fantasia.</p>
	</div>
</section>

<style>
	.spine__testa {
		display: grid;
		gap: 4px;
	}
	.spine__lead {
		max-width: 36em;
		margin-top: 18px;
		font-size: 1.15rem;
	}
	.titolo em {
		font-style: normal;
		color: var(--rosso);
	}

	.spine__filtri {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 10px;
		margin: 40px 0 24px;
	}
	.chip {
		font-family: var(--display);
		font-weight: 800;
		font-size: 1.15rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		background: transparent;
		border: var(--bordo);
		padding: 6px 16px 4px;
		transition: background 0.15s;
	}
	.chip:hover {
		background: var(--carta-2);
	}
	.chip[aria-pressed='true'] {
		background: var(--inchiostro);
		color: var(--carta);
	}
	.spine__conto {
		margin-left: auto;
		font-family: var(--display);
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.spine__lista {
		list-style: none;
		border-top: var(--bordo);
	}
	.tap {
		border-bottom: var(--bordo);
	}
	.tap[hidden] {
		display: none;
	}
	.tap__h {
		font: inherit;
	}
	.tap__riga {
		width: 100%;
		display: grid;
		grid-template-columns: 56px 1fr auto 150px 34px;
		align-items: center;
		gap: 18px;
		text-align: left;
		background: transparent;
		border: 0;
		padding: 18px 8px;
		transition: background 0.15s;
	}
	.tap__riga:hover {
		background: var(--carta-2);
	}
	.tap__num {
		display: grid;
		place-items: center;
		width: 48px;
		height: 48px;
		border-radius: 50%;
		border: var(--bordo);
		font-family: var(--display);
		font-weight: 900;
		font-size: 1.7rem;
		padding-top: 3px;
		background: var(--liquido);
		color: var(--num);
	}
	.tap__nome {
		font-family: var(--display);
		font-weight: 900;
		text-transform: uppercase;
		font-size: clamp(2rem, 5vw, 3.2rem);
		line-height: 0.95;
	}
	.tap__nome small {
		display: block;
		font-family: var(--testo);
		font-weight: 600;
		font-size: 0.95rem;
		letter-spacing: 0.02em;
		text-transform: none;
		color: var(--inchiostro-2);
		margin-top: 4px;
	}
	.tap__gradi {
		font-family: var(--display);
		font-weight: 800;
		font-size: 2rem;
		line-height: 1;
	}
	.tap__gradi small {
		font-size: 0.9rem;
		margin-left: 3px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	.tap__stato {
		justify-self: start;
		font-family: var(--display);
		font-weight: 800;
		font-size: 1rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		border: 2px solid currentColor;
		padding: 2px 10px 0;
	}
	.tap__stato--alla-spina {
		color: var(--luppolo);
	}
	.tap__stato--ultimi-litri {
		color: var(--rosso);
	}
	.tap__stato--in-arrivo {
		color: var(--inchiostro-2);
		border-style: dashed;
	}
	.tap__piu {
		position: relative;
		width: 26px;
		height: 26px;
	}
	.tap__piu::before,
	.tap__piu::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		top: 11px;
		height: 4px;
		background: var(--inchiostro);
		transition: transform 0.3s;
	}
	.tap__piu::after {
		transform: rotate(90deg);
	}
	.tap__riga[aria-expanded='true'] .tap__piu::after {
		transform: rotate(0);
	}

	/* Pannello: si apre senza saltare */
	.tap__corpo {
		display: grid;
		grid-template-rows: 0fr;
		transition: grid-template-rows 0.45s ease;
	}
	.tap__corpo-in {
		overflow: hidden;
		min-height: 0;
		display: grid;
		grid-template-columns: 150px 1fr;
		gap: 34px;
		padding: 0 8px 0 82px;
		visibility: hidden;
		transition:
			visibility 0s linear 0.45s,
			padding 0.45s;
	}
	.tap.is-aperta .tap__corpo {
		grid-template-rows: 1fr;
	}
	.tap.is-aperta .tap__corpo-in {
		visibility: visible;
		padding-bottom: 32px;
		transition-delay: 0s;
	}
	.tap__bicchiere {
		width: 130px;
		justify-self: center;
		align-self: start;
	}
	.tap__liquido,
	.tap__schiuma {
		transform: translateY(124px);
		transition: transform 1.6s cubic-bezier(0.3, 0.6, 0.2, 1) 0.15s;
	}
	.tap__liquido {
		transform-origin: 0 0;
	}
	.tap.is-aperta .tap__liquido {
		transform: translateY(18px);
	}
	.tap.is-aperta .tap__schiuma {
		transform: translateY(6px);
	}
	.tap__note {
		font-size: 1.15rem;
		max-width: 38em;
	}
	.tap__profumo {
		margin-top: 12px;
		font-weight: 600;
	}
	.tap__profumo span {
		font-family: var(--display);
		font-weight: 800;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--rosso);
		margin-right: 8px;
	}
	.tap__misure {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 20px;
		margin-top: 22px;
		max-width: 620px;
	}
	.tap__misure dt {
		font-family: var(--display);
		font-weight: 800;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		font-size: 0.95rem;
	}
	.tap__misure dd {
		font-weight: 700;
		display: grid;
		gap: 6px;
		margin-top: 4px;
	}
	.barra {
		display: block;
		height: 10px;
		border: 2px solid var(--inchiostro);
		background: var(--carta);
	}
	.barra i {
		display: block;
		height: 100%;
		background: var(--inchiostro);
		transform-origin: 0 0;
		transform: scaleX(0);
		transition: transform 1s ease 0.3s;
	}
	.tap.is-aperta .barra i {
		transform: scaleX(var(--v));
	}
	.tap__goccia {
		width: 22px;
		height: 22px;
		border-radius: 50%;
		border: 2px solid var(--inchiostro);
	}
	.tap__prezzo {
		display: flex;
		gap: 12px;
		margin-top: 22px;
	}
	.tap__prezzo span {
		border: 2px solid var(--inchiostro);
		padding: 4px 14px;
		font-weight: 600;
	}
	.tap__prezzo b {
		font-family: var(--display);
		font-size: 1.4rem;
		margin-left: 6px;
	}
	.spine__nota {
		margin-top: 20px;
		font-size: 0.9rem;
		color: var(--inchiostro-2);
	}

	@media (max-width: 760px) {
		.tap__riga {
			grid-template-columns: 44px 1fr 28px;
			grid-template-areas:
				'num nome piu'
				'num meta piu';
			gap: 4px 14px;
			padding: 16px 0;
		}
		.tap__num {
			grid-area: num;
			width: 42px;
			height: 42px;
			font-size: 1.4rem;
		}
		.tap__nome {
			grid-area: nome;
		}
		.tap__gradi,
		.tap__stato {
			grid-area: meta;
		}
		.tap__gradi {
			justify-self: start;
			font-size: 1.3rem;
		}
		.tap__stato {
			justify-self: end;
			font-size: 0.85rem;
			align-self: center;
			margin-right: 0;
		}
		.tap__piu {
			grid-area: piu;
		}
		.tap__corpo-in {
			grid-template-columns: 1fr;
			gap: 14px;
			padding: 0;
		}
		.tap__bicchiere {
			width: 96px;
			justify-self: start;
		}
		.tap__misure {
			grid-template-columns: 1fr;
			gap: 14px;
		}
	}
</style>

<script>
	import { birre } from './birre';
	const sez = document.querySelector<HTMLElement>('#spine')!;
	const taps = [...sez.querySelectorAll<HTMLElement>('.tap')];
	const chips = [...sez.querySelectorAll<HTMLButtonElement>('[data-filtro]')];
	const conto = sez.querySelector<HTMLElement>('[data-conto]')!;

	const apri = (tap: HTMLElement, aperta: boolean) => {
		tap.classList.toggle('is-aperta', aperta);
		tap.querySelector('.tap__riga')!.setAttribute('aria-expanded', String(aperta));
	};

	taps.forEach((tap) => {
		tap.querySelector('.tap__riga')!.addEventListener('click', () => {
			const era = tap.classList.contains('is-aperta');
			taps.forEach((t) => apri(t, false));
			apri(tap, !era);
		});
	});

	const filtra = (id: string) => {
		chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.filtro === id)));
		let n = 0;
		taps.forEach((t) => {
			const ok = id === 'tutte' || t.dataset.gruppo === id;
			t.hidden = !ok;
			if (ok) n++;
			else apri(t, false);
		});
		conto.textContent = `${n} ${n === 1 ? 'birra' : 'birre'}`;
	};
	chips.forEach((c) => c.addEventListener('click', () => filtra(c.dataset.filtro!)));

	// dalla cucina: "in coppia con…" apre la birra giusta
	document.addEventListener('apri-birra', (e) => {
		const id = (e as CustomEvent<string>).detail;
		if (!birre.some((b) => b.id === id)) return;
		filtra('tutte');
		const tap = taps.find((t) => t.dataset.id === id)!;
		taps.forEach((t) => apri(t, false));
		tap.scrollIntoView({ behavior: 'smooth', block: 'center' });
		setTimeout(() => apri(tap, true), 450);
	});
</script>

---
// L'ingresso dell'enfilade: titolo su una foto a tutta pagina che si tesse, e l'invito a scorrere.
import Fondo from './Fondo.astro';
import { ingresso } from './dati';
---

<section class="ingresso" id="ingresso" data-sala data-con-foto data-hero data-tinta="pompeiano" data-disp="a" data-nome="" aria-labelledby="ingresso-t">
	<Fondo scatti={[ingresso]} eager />
	<span class="sala__filo" aria-hidden="true"></span>
	<div class="ingresso__in">
		<div class="ingresso__testo">
			<h1 class="titolo" id="ingresso-t">Start with the room, not the checklist.</h1>
			<p class="corpo">
				Marrow &amp; Knot plans weddings in Italy: five places we know by heart, one team from the first visit to the last dance.
			</p>
			<div class="ingresso__azioni">
				<a class="btn btn--pieno" href="#como" data-vai="como">Walk through</a>
				<a class="btn" href="#scrivici">Ask about a date</a>
			</div>
		</div>
		<p class="ingresso__invito" aria-hidden="true">
			<span class="ingresso__freccia"></span>
		</p>
	</div>
	<div class="didascalia" aria-hidden="true" data-cap>
		<p class="didascalia__testo">{ingresso.cap}</p>
	</div>
</section>

<style is:global>
	.ingresso {
		position: relative;
		overflow: hidden;
		display: flex;
		flex-direction: column;
	}
	.ingresso .fondo {
		order: 2;
	}
	.ingresso__in {
		position: relative;
		z-index: 2;
		order: 1;
		padding: calc(var(--fascia-h) + var(--nav-h) + 36px) var(--gutter) 40px;
	}
	.ingresso .didascalia {
		order: 3;
		padding-top: 14px;
	}
	.ingresso__testo {
		display: grid;
		gap: 26px;
		justify-items: start;
	}
	.ingresso__testo .titolo {
		font-size: clamp(2.8rem, 8.2vw, 7.2rem);
		max-width: 11ch;
	}
	.ingresso__azioni {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin-top: 6px;
	}
	.ingresso__invito {
		display: none;
	}

	html.h .ingresso {
		display: block;
		flex: none;
		width: 112vw;
		height: 100svh;
	}
	html.h .ingresso__in {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		padding: calc(var(--fascia-h) + var(--nav-h) + 2svh) 0 9svh 8vw;
	}
	html.h .ingresso__testo {
		width: min(52vw, 820px);
	}
	html.h .ingresso__testo .titolo {
		font-size: min(8.4vw, 17svh);
	}
	html.h .ingresso__invito {
		display: block;
		position: absolute;
		right: 6vw;
		bottom: 8svh;
	}
	html.h .ingresso .didascalia {
		position: absolute;
		left: 8vw;
		bottom: 8svh;
		padding: 0;
		width: 16rem;
		transform: translate3d(var(--cx, 0px), 0, 0);
		color: var(--testo);
	}
	.ingresso__freccia {
		display: block;
		width: 96px;
		height: 1.5px;
		background: var(--filo-c);
		position: relative;
		transform-origin: 0 50%;
		animation: freccia 2.4s cubic-bezier(0.6, 0, 0.2, 1) infinite;
	}
	.ingresso__freccia::after {
		content: '';
		position: absolute;
		right: 0;
		top: -4px;
		width: 9px;
		height: 9px;
		border-top: 1.5px solid var(--filo-c);
		border-right: 1.5px solid var(--filo-c);
		transform: rotate(45deg);
	}
	@keyframes freccia {
		0% {
			transform: scaleX(0.2);
			opacity: 0;
		}
		40% {
			opacity: 1;
		}
		100% {
			transform: scaleX(1);
			opacity: 0;
		}
	}
</style>

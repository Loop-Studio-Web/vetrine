---
// L'ingresso dell'enfilade: titolo su una foto a tutta pagina che si tesse, e l'invito a scorrere.
import Fondo from './Fondo.astro';
import { ingresso } from './dati';
---

<section class="ingresso" id="ingresso" data-sala data-con-foto data-hero data-tinta="pompeiano" data-tono-nav="chiaro" data-disp="a" data-nome="" aria-labelledby="ingresso-t">
	<Fondo scatti={[ingresso]} eager velo />
	<span class="sala__filo" aria-hidden="true"></span>
	<div class="ingresso__in">
		<div class="ingresso__testo">
			<h1 class="titolo ingresso__h1" id="ingresso-t">Start with the room, not the checklist.</h1>
			<p class="corpo">
				Marrow &amp; Knot plans weddings in Italy: five places we know by heart, one team from the first visit to the last dance.
			</p>
			<div class="ingresso__azioni">
				<a class="btn btn--pieno" href="#como" data-vai="como">Walk through</a>
				<a class="btn" href="#scrivici">Ask about a date</a>
			</div>
		</div>
		<p class="ingresso__invito" aria-hidden="true">
			<span class="ingresso__freccia"></span>
		</p>
	</div>
	<div class="didascalia" aria-hidden="true" data-cap>
		<p class="didascalia__testo">{ingresso.cap}</p>
	</div>
</section>

<style is:global>
	/* pila (telefono): la foto verticale sta ferma a tutto schermo (sticky, come nelle sale) e il testo le scorre sopra */
	.ingresso {
		position: relative;
		overflow: clip;
	}
	.ingresso .fondo {
		position: sticky;
		top: 0;
		z-index: 0;
		height: 100lvh; /* lvh: quando la barra di Safari si ritrae la foto copre anche la fascia liberata */
		aspect-ratio: auto;
		margin-bottom: -100lvh;
	}
	/* con la tela accesa l'<img> dell'ingresso resta visibile (non è disegnata dalla tela) */
	html.gl:not(.h) .ingresso .fondo__img--on {
		opacity: 1;
	}
	html:not(.h) .ingresso .velo {
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgb(10 10 10 / 0.8) 0%, rgb(10 10 10 / 0.6) 40%, rgb(10 10 10 / 0.34) 66%, rgb(10 10 10 / 0.1) 100%);
	}
	.ingresso__in {
		position: relative;
		z-index: 2;
		min-height: 100svh;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 28px;
		padding: calc(var(--fascia-h) + var(--nav-h) + 28px) var(--gutter) 9svh;
	}
	.ingresso .didascalia {
		display: none;
	}
	.ingresso__testo {
		display: grid;
		gap: 26px;
		justify-items: start;
	}
	/* il titolone di impatto è in Great Vibes; le aste sporgono, quindi un po' di respiro a destra */
	.ingresso__testo .ingresso__h1 {
		font-family: var(--script);
		color: var(--inchiostro); /* nero: stacca dal resto del testo, che è bianco */
		font-size: clamp(3.4rem, 15vw, 7rem);
		line-height: 1.02;
		letter-spacing: 0;
		padding-right: 0.15em;
		text-shadow: 0 0 12px rgb(255 255 255 / 0.5), 0 0 2px rgb(255 255 255 / 0.45);
	}
	.ingresso__azioni {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-top: 6px;
	}
	.ingresso__azioni .btn {
		padding: 0 18px;
		font-size: 0.94rem;
	}
	.ingresso .btn--pieno {
		color: var(--inchiostro);
	}
	/* il pulsante a filo può cadere su una zona scura della foto (la cupola): un fondo scuro semitrasparente lo tiene leggibile */
	.ingresso .btn:not(.btn--pieno) {
		background: rgb(10 10 10 / 0.5);
		-webkit-backdrop-filter: blur(6px);
		backdrop-filter: blur(6px);
		color: var(--marmo);
	}
	@media (hover: hover) {
		.ingresso .btn:not(.btn--pieno):hover {
			color: var(--inchiostro);
		}
		.ingresso .btn--pieno:hover {
			color: var(--marmo);
		}
	}
	.ingresso__testo .corpo {
		color: var(--marmo);
		text-shadow: 0 0 14px rgb(0 0 0 / 0.85), 0 1px 3px rgb(0 0 0 / 0.6);
	}
	/* titolo in alto sul cielo, testo e pulsanti in basso */
	html:not(.h) .ingresso__testo {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		flex: 1;
		gap: 22px;
	}
	html:not(.h) .ingresso__testo .corpo {
		margin-top: auto;
	}
	.ingresso__invito {
		display: none;
	}

	/* con WebGL l'ingresso è trasparente (la foto sta sulla tela dietro): in pila il testo tiene il suo colore */
	html.gl .ingresso {
		background: transparent;
	}
	html.h .ingresso .fondo {
		height: auto;
		margin: 0;
	}
	html.h .ingresso {
		overflow: hidden;
		display: block;
		flex: none;
		width: 112vw;
		height: 100svh;
	}
	html.h .ingresso__in {
		position: absolute;
		inset: 0;
		min-height: 0;
		justify-content: flex-start;
		display: flex;
		flex-direction: row; /* la base è una colonna (pila): lì align-items: center centrerebbe il testo in orizzontale */
		align-items: center;
		padding: calc(var(--fascia-h) + var(--nav-h) + 2svh) 0 9svh 8vw;
	}
	html.h .ingresso__testo {
		width: min(52vw, 820px);
	}
	html.h .ingresso__testo .ingresso__h1 {
		font-size: min(7.6vw, 16svh);
	}
	html.h .ingresso__invito {
		display: block;
		position: absolute;
		right: 6vw;
		bottom: 8svh;
	}
	html.h .ingresso .didascalia {
		display: block;
		position: absolute;
		left: 8vw;
		bottom: 8svh;
		padding: 0;
		width: 16rem;
		transform: translate3d(var(--cx, 0px), 0, 0);
		color: var(--testo);
	}
	.ingresso__freccia {
		display: block;
		width: 96px;
		height: 1.5px;
		background: var(--marmo);
		position: relative;
		transform-origin: 0 50%;
		animation: freccia 2.4s cubic-bezier(0.6, 0, 0.2, 1) infinite;
	}
	.ingresso__freccia::after {
		content: '';
		position: absolute;
		right: 0;
		top: -4px;
		width: 9px;
		height: 9px;
		border-top: 1.5px solid var(--marmo);
		border-right: 1.5px solid var(--marmo);
		transform: rotate(45deg);
	}
	@keyframes freccia {
		0% {
			transform: scaleX(0.2);
			opacity: 0;
		}
		40% {
			opacity: 1;
		}
		100% {
			transform: scaleX(1);
			opacity: 0;
		}
	}
</style>

---
// Fascia di ritorno: dice che è una vetrina dimostrativa e porta all'hub o ai contatti. Non è fissa:
// scorre via e la navbar, che le sta sotto, risale (lo script della Navbar aggiorna --fascia).
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<aside class="fascia" data-fascia aria-label="Informazioni su questa vetrina">
	<p class="fascia__testo">Vetrina dimostrativa · <span class="fascia__studio">concept di Loop Studio</span></p>
	<nav class="fascia__link" aria-label="Vetrine">
		<a href={`${base}/`}><span aria-hidden="true">←</span> Tutte le vetrine</a>
		<a href="https://theloopstudio.org/contatti/?concept=wedding" class="fascia__cta">Ne voglio una così <span aria-hidden="true">→</span></a>
	</nav>
</aside>

<style>
	.fascia {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		z-index: 250;
		height: var(--fascia-h);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding: 0 var(--gutter);
		background: #0a0a0a;
		color: #e9d5d9;
		font: 500 0.8rem/1 var(--sans);
		white-space: nowrap;
	}
	.fascia__link {
		display: flex;
		gap: 22px;
	}
	.fascia a {
		color: inherit;
		text-decoration: none;
		display: inline-flex;
		align-items: center;
		min-height: 24px;
	}
	.fascia__cta {
		color: var(--filo);
		font-weight: 600;
	}
	@media (hover: hover) {
		.fascia a:hover {
			text-decoration: underline;
			text-underline-offset: 3px;
		}
	}
	@media (max-width: 640px) {
		.fascia__studio {
			display: none;
		}
		.fascia__link {
			gap: 14px;
		}
		.fascia {
			font-size: 0.74rem;
		}
	}
	@media (max-width: 400px) {
		.fascia__testo {
			display: none;
		}
		.fascia {
			justify-content: center;
		}
	}
</style>

---
// Lo sfondo fotografico di una sala: una pila di scatti che si danno il cambio tessendosi.
// Nel markup resta un <img> (il primo scatto: ripiego senza WebGL, reduced-motion, LCP mai). Gli altri scatti
// sono solo dati (data-scatti): li carica e li disegna la tela WebGL (`arazzo.ts`).
import { Image, getImage } from 'astro:assets';
import type { Scatto } from './dati';

interface Props {
	scatti: Scatto[];
	eager?: boolean;
}
const { scatti, eager = false } = Astro.props;

const tutte = import.meta.glob<{ default: ImageMetadata }>('../../assets/marrowknot/foto/*.jpg', { eager: true });
const meta = (f: string) => {
	const m = tutte[`../../assets/marrowknot/foto/${f}.jpg`]?.default;
	if (!m) throw new Error(`Foto mancante: ${f}`);
	return m;
};
// due misure per la tela: grande per il corridoio, media per i pannelli in pila
const dati = await Promise.all(
	scatti.map(async (s) => {
		const src = meta(s.file);
		const [g, m] = await Promise.all([
			getImage({ src, width: 2200, format: 'webp', quality: 72 }),
			getImage({ src, width: 1200, format: 'webp', quality: 72 }),
		]);
		return { g: g.src, m: m.src, cap: s.cap, w: src.width, h: src.height };
	}),
);
const primo = meta(scatti[0].file);
---

<div class="fondo" data-fondo data-scatti={JSON.stringify(dati)}>
	<Image
		src={primo}
		alt={scatti[0].alt}
		widths={[640, 1100, 1600, 2200]}
		sizes="(min-width: 900px) 142vw, 100vw"
		format="webp"
		quality={72}
		loading={eager ? 'eager' : 'lazy'}
		decoding="async"
		class="fondo__img"
	/>
</div>

<style is:global>
	/* pila: un pannello in cima alla sala */
	.fondo {
		position: relative;
		aspect-ratio: 4 / 3;
		width: 100%;
		overflow: hidden;
		background: var(--fantasma, #00000022);
	}
	.fondo__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	@media (min-width: 640px) {
		.fondo {
			aspect-ratio: 16 / 9;
		}
	}
	/* con WebGL pronto l'immagine lascia il posto alla tela */
	html.gl .fondo__img {
		opacity: 0;
	}

	/* corridoio: il fondo è l'intera sala, dietro al testo; senza WebGL la foto sta sotto un velo di colore */
	html.h .fondo {
		position: absolute;
		inset: 0;
		z-index: 0;
		aspect-ratio: auto;
		width: auto;
	}
	html.h .fondo::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(90deg, color-mix(in srgb, var(--fondo) 92%, transparent) 0%, color-mix(in srgb, var(--fondo) 70%, transparent) 38%, transparent 72%);
	}
	html.h [data-disp='b'] .fondo::after {
		background: linear-gradient(270deg, color-mix(in srgb, var(--fondo) 92%, transparent) 0%, color-mix(in srgb, var(--fondo) 70%, transparent) 38%, transparent 72%);
	}
	html.h.gl .fondo {
		background: transparent;
	}
	html.h.gl .fondo::after {
		display: none; /* il velo lo disegna lo shader */
	}
</style>

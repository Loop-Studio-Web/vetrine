---
// Lo sfondo fotografico di una sala: una pila di scatti che si danno il cambio tessendosi.
// Nel markup restano gli <img> di tutti gli scatti (ripiego senza WebGL e con reduced-motion: si danno il cambio con
// una dissolvenza, `fondo__img--on` la mette il motore). Con WebGL li nasconde la tela (`arazzo.ts`), che li disegna
// tessendoli; nel corridoio gli scatti dopo il primo non si scaricano affatto (display: none).
import { Image, getImage } from 'astro:assets';
import type { Scatto } from './dati';

interface Props {
	scatti: Scatto[];
	eager?: boolean;
	/** un velo di colore sopra le foto (nelle sale: il testo ci sta sopra) */
	velo?: boolean;
}
const { scatti, eager = false, velo = false } = Astro.props;

const tutte = import.meta.glob<{ default: ImageMetadata }>('../../assets/marrowknot/foto/*.jpg', { eager: true });
const meta = (f: string) => {
	const m = tutte[`../../assets/marrowknot/foto/${f}.jpg`]?.default;
	if (!m) throw new Error(`Foto mancante: ${f}`);
	return m;
};
// due misure per la tela: grande per il corridoio, media per i pannelli in pila
const dati = await Promise.all(
	scatti.map(async (s) => {
		const src = meta(s.file);
		const [g, m] = await Promise.all([
			getImage({ src, width: 2200, format: 'webp', quality: 72 }),
			getImage({ src, width: 1200, format: 'webp', quality: 72 }),
		]);
		// foto verticale per il telefono (se c'è): la usa la tela in pila sotto i 900 px
		const v = s.mobile ? await getImage({ src: meta(s.mobile), width: 1200, format: 'webp', quality: 74 }) : null;
		return { g: g.src, m: m.src, v: v?.src, cap: s.cap, w: src.width, h: src.height };
	}),
);
const foto = await Promise.all(
	scatti.map(async (x) => {
		const mob = x.mobile
			? await Promise.all([750, 1125].map((width) => getImage({ src: meta(x.mobile!), width, format: 'webp', quality: 74 })))
			: null;
		return { src: meta(x.file), alt: x.alt, mob: mob ? mob.map((i, k) => `${i.src} ${[750, 1125][k]}w`).join(', ') : null };
	}),
);
---

<div class="fondo" data-fondo data-scatti={JSON.stringify(dati)}>
	{
		foto.map((f, k) => {
			const img = (
				<Image
					src={f.src}
					alt={k === 0 ? f.alt : ''}
					widths={[640, 1100, 1600, 2200]}
					sizes="100vw"
					format="webp"
					quality={72}
					loading={eager && k === 0 ? 'eager' : 'lazy'}
					decoding="async"
					class:list={['fondo__img', { 'fondo__img--on': k === 0 }]}
					data-k={k}
					aria-hidden={k === 0 ? undefined : 'true'}
				/>
			);
			// sotto i 900 px una foto verticale (<source> prima dell'<img>)
			return f.mob ? (
				<picture>
					<source media="(max-width: 899px)" srcset={f.mob} sizes="100vw" />
					{img}
				</picture>
			) : (
				img
			);
		})
	}
	{velo && <span class="velo" aria-hidden="true" />}
</div>

<style is:global>
	/* pannello (ingresso in pila); nelle sale è sticky a tutto schermo (vedi Sala.astro) */
	.fondo {
		position: relative;
		aspect-ratio: 4 / 3;
		width: 100%;
		overflow: hidden;
		background: var(--fantasma, #00000022);
	}
	@media (min-width: 640px) {
		.fondo {
			aspect-ratio: 16 / 9;
		}
	}
	.fondo__img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0;
		transition: opacity 0.7s ease;
	}
	.fondo__img--on {
		opacity: 1;
	}
	/* con WebGL pronto gli <img> lasciano il posto alla tela */
	html.gl .fondo__img {
		opacity: 0;
		transition: none;
	}

	/* corridoio: il fondo è l'intera sala, dietro al testo; senza WebGL la foto sta sotto un velo di colore */
	html.h .fondo {
		position: absolute;
		inset: 0;
		z-index: 0;
		aspect-ratio: auto;
		width: auto;
	}
	/* nel corridoio gli scatti dopo il primo si vedono solo senza WebGL: con WebGL non si scaricano */
	html.h.gl .fondo__img:not([data-k='0']) {
		display: none;
	}
	html.h .velo {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(90deg, color-mix(in srgb, var(--fondo) 90%, transparent) 0%, color-mix(in srgb, var(--fondo) 62%, transparent) 36%, transparent 66%);
	}
	html.h [data-disp='b'] .velo {
		background: linear-gradient(270deg, color-mix(in srgb, var(--fondo) 90%, transparent) 0%, color-mix(in srgb, var(--fondo) 62%, transparent) 36%, transparent 66%);
	}
	html.gl .fondo {
		background: transparent;
	}
	html.h.gl .velo {
		display: none; /* il velo lo disegna lo shader */
	}
</style>

---
// Navbar: marchio, le cinque sale, richiesta. Prende la tinta della sala in cui ci si trova (data-tinta, lo script del motore).
// Su telefono il menù è un arco di marmo che sale dal basso (.menu sta FUORI dall'header).
import Simbolo from './Simbolo.astro';
import { sale } from './dati';
---

<header class="nav" data-nav data-tinta="pompeiano">
	<a class="nav__marca" href="#ingresso" data-vai="ingresso" aria-label="Marrow &amp; Knot, back to the start">
		<Simbolo tam={30} id="nav" />
		<span>Marrow &amp; Knot</span>
	</a>
	<nav class="nav__sale" aria-label="Places">
		{sale.map((s) => <a href={`#${s.id}`} data-vai={s.id}>{s.breve}</a>)}
	</nav>
	<a class="btn nav__cta" href="#scrivici" data-vai="scrivici">Plan my wedding</a>
	<button class="nav__burger" type="button" aria-expanded="false" aria-controls="menu" data-apri>
		<span class="sr-only">Menu</span>
		<span class="nav__burger-i" aria-hidden="true"></span>
	</button>
</header>

<div class="menu" id="menu" data-menu data-tinta="marmo" role="dialog" aria-modal="true" aria-label="Menu" aria-hidden="true" inert>
	<div class="menu__testa">
		<span class="menu__marca"><Simbolo tam={28} id="menu" /> Marrow &amp; Knot</span>
		<button class="menu__x" type="button" data-chiudi aria-label="Close menu"><span aria-hidden="true"></span></button>
	</div>
	<nav class="menu__voci" aria-label="Places">
		{sale.map((s) => <a href={`#${s.id}`} data-vai={s.id}>{s.nome}</a>)}
	</nav>
	<a class="btn btn--pieno menu__cta" href="#scrivici" data-vai="scrivici">Plan my wedding</a>
</div>

<style is:global>
	.nav {
		position: fixed;
		top: var(--fascia, 0px);
		left: 0;
		right: 0;
		z-index: 200;
		height: var(--nav-h);
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 24px;
		padding: 0 var(--gutter);
		background: color-mix(in srgb, var(--fondo) 90%, transparent);
		-webkit-backdrop-filter: blur(10px);
		backdrop-filter: blur(10px);
		color: var(--testo);
		transition:
			background-color 0.6s,
			color 0.6s;
	}
	.nav__marca {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		text-decoration: none;
		font-family: var(--serif);
		font-size: 1.5rem;
		letter-spacing: 0.005em;
		white-space: nowrap;
	}
	.nav__sale {
		display: none;
		justify-content: center;
		gap: 2px;
	}
	.nav__sale a {
		position: relative;
		padding: 10px 16px;
		text-decoration: none;
		font-weight: 500;
		font-size: 0.96rem;
	}
	/* il filo che si disegna sotto la sala attiva */
	.nav__sale a::after {
		content: '';
		position: absolute;
		left: 16px;
		right: 16px;
		bottom: 4px;
		height: 1.5px;
		background: currentColor;
		transform: scaleX(0);
		transform-origin: 0 50%;
		transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
	}
	.nav__sale a[aria-current='true']::after {
		transform: none;
	}
	@media (hover: hover) {
		.nav__sale a:hover::after {
			transform: none;
		}
	}
	.nav__cta {
		display: none;
		min-height: 44px;
		padding: 0 22px;
		font-size: 0.92rem;
	}
	.nav__burger {
		justify-self: end;
		width: 48px;
		height: 48px;
		background: none;
		border: 0;
		color: inherit;
		cursor: pointer;
		display: grid;
		place-items: center;
	}
	.nav__burger-i,
	.nav__burger-i::before {
		display: block;
		width: 26px;
		height: 1.5px;
		background: currentColor;
		position: relative;
	}
	.nav__burger-i::before {
		content: '';
		position: absolute;
		left: 0;
		top: -8px;
		width: 18px;
	}
	html.h .nav {
		background: transparent;
		-webkit-backdrop-filter: none;
		backdrop-filter: none;
	}
	@media (min-width: 900px) {
		.nav__sale {
			display: flex;
		}
		.nav__cta {
			display: inline-flex;
		}
		.nav__burger {
			display: none;
		}
	}

	/* menù: arco di marmo che sale dal basso */
	.menu {
		position: fixed;
		inset: 0;
		z-index: 300;
		height: 100lvh;
		display: grid;
		grid-template-rows: auto 1fr auto;
		padding: 18px var(--gutter) calc(28px + env(safe-area-inset-bottom, 0px));
		background: var(--marmo);
		color: var(--inchiostro);
		visibility: hidden;
		clip-path: inset(100% 0 0 0 round 50vw 50vw 0 0);
		transition:
			clip-path 0.7s cubic-bezier(0.7, 0, 0.2, 1),
			visibility 0s 0.7s;
	}
	.menu.aperto {
		visibility: visible;
		clip-path: inset(0 0 0 0 round 0);
		transition:
			clip-path 0.7s cubic-bezier(0.7, 0, 0.2, 1),
			visibility 0s;
	}
	.menu__testa {
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: 56px;
		color: var(--pompeiano);
	}
	.menu__marca {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		font-family: var(--serif);
		font-size: 1.4rem;
	}
	.menu__x {
		width: 48px;
		height: 48px;
		background: none;
		border: 0;
		color: inherit;
		cursor: pointer;
		position: relative;
	}
	.menu__x span::before,
	.menu__x span::after {
		content: '';
		position: absolute;
		left: 11px;
		right: 11px;
		top: 50%;
		height: 1.5px;
		background: currentColor;
		transform: rotate(45deg);
	}
	.menu__x span::after {
		transform: rotate(-45deg);
	}
	.menu__voci {
		display: grid;
		align-content: center;
		gap: 2px;
	}
	.menu__voci a {
		font-family: var(--serif);
		font-size: clamp(3.4rem, 18vw, 6rem);
		line-height: 1.12;
		text-decoration: none;
		color: var(--pompeiano);
		opacity: 0;
		transform: translateY(24px);
		transition:
			opacity 0.4s,
			transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
	}
	.menu.aperto .menu__voci a {
		opacity: 1;
		transform: none;
		transition-delay: calc(0.28s + var(--i, 0) * 0.06s);
	}
	.menu__cta {
		justify-self: stretch;
		color: var(--marmo);
		background: var(--pompeiano);
		border-color: var(--pompeiano);
	}
</style>

<script>
	const nav = document.querySelector<HTMLElement>('[data-nav]')!;
	const menu = document.querySelector<HTMLElement>('[data-menu]')!;
	const burger = nav.querySelector<HTMLButtonElement>('[data-apri]')!;
	const chiudi = menu.querySelector<HTMLButtonElement>('[data-chiudi]')!;
	const fascia = document.querySelector<HTMLElement>('[data-fascia]');

	menu.querySelectorAll<HTMLElement>('.menu__voci a').forEach((a, i) => a.style.setProperty('--i', String(i)));

	// la navbar sta sotto la fascia e risale quando la fascia scorre via
	function sotto() {
		const h = fascia ? Math.max(0, fascia.offsetHeight - scrollY) : 0;
		document.documentElement.style.setProperty('--fascia', h + 'px');
	}
	addEventListener('scroll', sotto, { passive: true });
	sotto();

	function apri(v: boolean) {
		menu.classList.toggle('aperto', v);
		menu.toggleAttribute('inert', !v);
		menu.setAttribute('aria-hidden', String(!v));
		burger.setAttribute('aria-expanded', String(v));
		document.documentElement.style.overflow = v ? 'hidden' : '';
		(v ? chiudi : burger).focus({ preventScroll: true });
	}
	burger.addEventListener('click', () => apri(true));
	chiudi.addEventListener('click', () => apri(false));
	addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && menu.classList.contains('aperto')) apri(false);
	});
	menu.addEventListener('click', (e) => {
		if ((e.target as HTMLElement).closest('a')) apri(false);
	});
</script>

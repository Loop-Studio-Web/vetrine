---
// La striscia degli avvisi sopra la testata, come nei negozi veri: spedizione, resi, e la dichiarazione di vetrina.
import { SOGLIA_SPEDIZIONE } from './dati';
---

<div class="annunci">
	<p>Free shipping over €{SOGLIA_SPEDIZIONE}</p>
	<p>30 days to change your mind</p>
	<p class="annunci__demo">Demo store: nothing here is for sale</p>
</div>

<style>
	.annunci {
		display: flex;
		justify-content: center;
		gap: clamp(16px, 4vw, 56px);
		padding: 9px var(--gutter);
		background: var(--mandarino);
		color: var(--ink);
		font-size: 0.875rem;
		font-weight: 600;
		text-align: center;
	}
	@media (max-width: 760px) {
		.annunci p:nth-child(2) {
			display: none;
		}
	}
	@media (max-width: 520px) {
		.annunci__demo {
			display: none;
		}
	}
</style>

---
// Le icone del negozio: tratto pieno 2,2 px a punte tonde, tutte sulla stessa griglia 24 × 24. Il cuore si riempie
// da solo quando il pulsante che lo contiene è "premuto" (aria-pressed="true").
interface Props {
	nome: 'carrello' | 'cuore' | 'cerca' | 'utente' | 'filtri' | 'menu' | 'chiudi' | 'piu' | 'freccia';
	class?: string;
}
const { nome, class: cls = '' } = Astro.props;
const forme: Record<string, string> = {
	carrello:
		'<path d="M2.8 4.2h2.5l2.2 10.3a1.7 1.7 0 0 0 1.7 1.3h8.1a1.7 1.7 0 0 0 1.7-1.3l1.4-6.4H6.2"/><circle cx="9.7" cy="19.6" r="1.4"/><circle cx="17" cy="19.6" r="1.4"/>',
	cuore:
		'<path class="cuore" d="M12 20.6s-7.6-4.7-9.1-9.6C1.9 7.8 3.9 5 6.9 5c1.9 0 3.5 1 5.1 3 1.6-2 3.2-3 5.1-3 3 0 5 2.8 4 6-1.5 4.9-9.1 9.6-9.1 9.6z"/>',
	cerca: '<circle cx="10.5" cy="10.5" r="6.6"/><path d="M15.4 15.4 21 21"/>',
	utente: '<circle cx="12" cy="8" r="4.2"/><path d="M4 21c.7-4.3 4-6.2 8-6.2s7.3 1.9 8 6.2"/>',
	filtri: '<path d="M3 7h11M18 7h3M3 17h3M10 17h11"/><circle cx="16" cy="7" r="2.2"/><circle cx="8" cy="17" r="2.2"/>',
	menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
	chiudi: '<path d="M6 6l12 12M18 6 6 18"/>',
	piu: '<path d="M12 5v14M5 12h14"/>',
	freccia: '<path d="M5 12h14M13 6l6 6-6 6"/>',
};
---

<svg
	class={`icona icona--${nome} ${cls}`}
	viewBox="0 0 24 24"
	width="24"
	height="24"
	fill="none"
	stroke="currentColor"
	stroke-width="2.2"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
	set:html={forme[nome]}
/>

<style is:global>
	.icona {
		flex: none;
		width: 1.5rem;
		height: 1.5rem;
	}
	[aria-pressed='true'] > .icona--cuore .cuore,
	.icona--cuore.piena .cuore {
		fill: currentColor;
	}
</style>

---
// Il catalogo: barra di filtri appiccicata, griglia irregolare di tessere. Ogni tessera è un campo di colore con una
// finestra dalla forma diversa (pillola, arco, ovale, goccia, foglia) che mostra un ritaglio estremo del capo: al
// passaggio del mouse, al fuoco da tastiera o, sul telefono, quando la tessera passa a metà schermo, la finestra si
// allarga e rivela il capo intero. Un tocco apre la scheda rapida.
import { Image, getImage } from 'astro:assets';
import { PRODOTTI, CATEGORIE, COLORI, EURO } from './dati';
import Icona from './Icona.astro';
import Filtri from './Filtri.astro';
import type { Prodotto } from './dati';

const foto = import.meta.glob('../../assets/softriot/foto/*.jpg', { eager: true, import: 'default' }) as Record<string, ImageMetadata>;
const brand = import.meta.glob('../../assets/softriot/brand/*.webp', { eager: true, import: 'default' }) as Record<string, ImageMetadata>;
// la tessera usa l'immagine "a quadro" (il pezzo già centrato nella misura della tessera); scheda e borsa l'originale
const sorgente = (p: Prodotto, quadro = false) =>
	p.originale
		? brand[`../../assets/softriot/brand/${p.immagine}${quadro ? '-quadro' : ''}.webp`]
		: foto[`../../assets/softriot/foto/${p.immagine}.jpg`];

// "XS–L" dalla prima all'ultima taglia; i pezzi a taglia unica dicono "One size"
const misure = (p: Prodotto) =>
	p.taglie.length === 1 ? p.taglie[0] : p.taglie.some((t) => t.includes('/')) ? p.taglie.join(' · ') : `${p.taglie[0]}–${p.taglie[p.taglie.length - 1]}`;

const campoCss = (p: Prodotto) => `linear-gradient(135deg, var(--${p.campo[0]}), var(--${p.campo[1]}))`;
const angoli = [128, 152, 112, 168, 100, 140];

const dati = await Promise.all(
	PRODOTTI.map(async (p) => {
		const piccola = await getImage({ src: sorgente(p, true), width: 640, format: 'webp', quality: 74 });
		const grande = await getImage({ src: sorgente(p), width: 1000, format: 'webp', quality: 78 });
		return {
			id: p.id,
			nome: p.nome,
			prezzo: p.prezzo,
			categoria: p.categoria,
			colori: p.colori.map((c) => ({ chiave: c, ...COLORI[c] })),
			taglie: p.taglie,
			testo: p.testo,
			piccola: piccola.src,
			grande: grande.src,
			originale: !!p.originale,
			campo: campoCss(p),
		};
	}),
);
const json = JSON.stringify(dati).replace(/</g, '\\u003c');
---

<section class="catalogo" id="shop" aria-labelledby="catalogo-titolo">
	<div class="catalogo__in">
		<div class="catalogo__testa">
			<h2 id="catalogo-titolo" class="catalogo__titolo">All the pieces</h2>
			<p class="catalogo__conta" aria-live="polite" data-conta>{PRODOTTI.length} pieces</p>
		</div>
	</div>

	<div class="filtri" data-filtri>
		<div class="filtri__in">
			<div class="chips" role="group" aria-label="Category">
				<button type="button" class="chip" data-barra-cat="" aria-pressed="true">All</button>
				{CATEGORIE.map((c) => <button type="button" class="chip" data-barra-cat={c.chiave} aria-pressed="false">{c.nome}</button>)}
			</div>
			<div class="filtri__destra">
				<div class="vista" role="group" aria-label="Grid size" data-vista data-v="mix">
					<span class="vista__pomo" aria-hidden="true"></span>
					<button type="button" class="vista__b vista__b--fitta" data-v-scelta="compact" aria-pressed="false" aria-label="More pieces, smaller">
						<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="2" y="2" width="5.6" height="5.6" rx="1.6"/><rect x="9.2" y="2" width="5.6" height="5.6" rx="1.6"/><rect x="16.4" y="2" width="5.6" height="5.6" rx="1.6"/><rect x="2" y="9.2" width="5.6" height="5.6" rx="1.6"/><rect x="9.2" y="9.2" width="5.6" height="5.6" rx="1.6"/><rect x="16.4" y="9.2" width="5.6" height="5.6" rx="1.6"/><rect x="2" y="16.4" width="5.6" height="5.6" rx="1.6"/><rect x="9.2" y="16.4" width="5.6" height="5.6" rx="1.6"/><rect x="16.4" y="16.4" width="5.6" height="5.6" rx="1.6"/></svg>
					</button>
					<button type="button" class="vista__b" data-v-scelta="mix" aria-pressed="true" aria-label="Our mix">
						<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="2" y="2" width="9" height="11" rx="2.6"/><rect x="13" y="2" width="9" height="7" rx="2.6"/><rect x="2" y="15" width="9" height="7" rx="2.6"/><rect x="13" y="11" width="9" height="11" rx="2.6"/></svg>
					</button>
					<button type="button" class="vista__b" data-v-scelta="big" aria-pressed="false" aria-label="Bigger pieces">
						<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="2.5" width="18" height="19" rx="4.4"/></svg>
					</button>
				</div>
				<label class="ordina">
					<span class="sr-only">Sort by</span>
					<select data-ordina>
						<option value="">Our order</option>
						<option value="su">Price, low to high</option>
						<option value="giu">Price, high to low</option>
					</select>
				</label>
				<button type="button" class="filtro-tasto" data-apri-filtri aria-haspopup="dialog">
					<Icona nome="filtri" /><span>Filter</span><span class="filtro-tasto__n" data-filtri-n hidden>0</span>
				</button>
			</div>
		</div>
	</div>

	<div class="catalogo__in">
		<ul class="attivi" data-attivi aria-label="Active filters" hidden></ul>
		<div class="caja">
		<ul class="griglia" data-griglia data-v="mix">
			{
				PRODOTTI.map((p, i) => {
					const src = sorgente(p, true);
					return (
						<li
							class:list={['tessera', `tessera--${p.misura}`, `p-${p.posto ?? 'sx'}`, `f-${p.forma}`, p.originale && 'tessera--orig']}
							style={`--a:var(--${p.campo[0]});--b:var(--${p.campo[1]});--ang:${angoli[i % angoli.length]}deg;--x:${p.taglio.x}%;--y:${p.taglio.y}%;--z:${p.taglio.zoom};--ordine:${i}`}
							data-prodotto={p.id}
							data-cat={p.categoria}
							data-colori={p.colori.join(' ')}
							data-taglie={p.taglie.join('|')}
							data-prezzo={p.prezzo}
							data-orig={p.originale ? '1' : undefined}
							data-nome={p.nome.toLowerCase()}
						>
							<button type="button" class="tessera__tasto" data-apri={p.id} aria-haspopup="dialog">
								<span class="sr-only">Quick view: {p.nome}, {EURO(p.prezzo)}</span>
								<span class="finestra" aria-hidden="true">
									<Image
										src={src}
										alt=""
										widths={[360, 480, 720, 1000]}
										sizes="(max-width: 700px) 56vw, (max-width: 1100px) 50vw, 34vw"
										quality={70}
										loading={i < 4 ? 'eager' : 'lazy'}
										decoding="async"
										class:list={[p.originale && 'finestra__brand']}
									/>
								</span>
								<span class="etichetta" aria-hidden="true">
									<span class="invito">
										<Icona nome="piu" />
										<span class="invito__mouse">Click to see details</span>
										<span class="invito__dito">Tap to see details</span>
									</span>
									<span class="etichetta__testo">
										<span class="etichetta__nome">{p.nome}</span>
										<span class="etichetta__meta">
											<span class="pallini">{p.colori.map((c) => <i style={`background:${COLORI[c].hex}`} />)}</span>
											<span class="etichetta__taglie">{misure(p)}</span>
										</span>
									</span>
									<span class="etichetta__prezzo">{EURO(p.prezzo)}</span>
								</span>
							</button>
							<div class="tessera__azioni">
								<button type="button" class="azione" data-cuore={p.id} aria-pressed="false" aria-label={`Save ${p.nome}`}>
									<Icona nome="cuore" />
								</button>
								<button type="button" class="azione" data-rapido={p.id} aria-label={p.taglie.length === 1 ? `Add ${p.nome} to bag` : `Choose a size for ${p.nome}`}>
									<Icona nome="carrello" />
								</button>
							</div>
						</li>
					);
				})
			}
		</ul>
		</div>
		<div class="vuoto" data-vuoto hidden>
			<p class="vuoto__titolo" data-vuoto-titolo>Nothing in that mix.</p>
			<p data-vuoto-testo>Try fewer filters, or start again from all the pieces.</p>
			<button type="button" class="btn" data-azzera>Clear filters</button>
		</div>
	</div>

	<script type="application/json" id="sr-dati" set:html={json} />
</section>

<Filtri />

<style>
	.catalogo {
		padding-block: clamp(48px, 7vw, 96px) clamp(56px, 8vw, 110px);
		background: var(--nebbia);
	}
	.catalogo__in {
		max-width: var(--max);
		margin-inline: auto;
		padding-inline: var(--gutter);
	}
	.catalogo__testa {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 20px;
		margin-bottom: 28px;
	}
	.catalogo__titolo {
		font-family: var(--titoli);
		font-weight: 400;
		font-size: clamp(2.8rem, 7.4vw, 6.4rem);
		line-height: 0.92;
		letter-spacing: -0.015em;
	}
	.catalogo__conta {
		font-weight: 600;
		padding-bottom: 8px;
	}

	/* barra dei filtri: appiccicata sotto la testata. Le categorie restano a portata di dito; "Filter" apre il cassetto */
	.filtri {
		position: sticky;
		top: calc(var(--testata-h) + var(--sotto, 0px));
		z-index: 40;
		background: var(--nebbia);
		border-block: 2px solid var(--ink);
		transition: top 0.22s var(--ease-out);
	}
	.filtri__in {
		display: flex;
		align-items: center;
		gap: 14px;
		max-width: var(--max);
		margin-inline: auto;
		padding: 10px var(--gutter);
	}
	.chips {
		flex: 1;
		min-width: 0;
		display: flex;
		gap: 8px;
		overflow-x: auto;
		scrollbar-width: none;
		padding: 4px 4px 4px 0;
		margin: -4px 0;
	}
	.chips::-webkit-scrollbar {
		display: none;
	}
	.filtri__destra {
		flex: none;
		display: flex;
		align-items: center;
		gap: 10px;
	}
	.ordina select {
		min-height: 46px;
		padding: 0 14px;
		border: 2px solid var(--ink);
		border-radius: 999px;
		background: var(--bianco);
		font-size: 0.9375rem;
		font-weight: 600;
	}
	.filtro-tasto {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		min-height: 46px;
		padding: 0 20px 0 16px;
		border: 2px solid var(--ink);
		border-radius: 999px;
		background: var(--ink);
		color: var(--nebbia);
		font-family: var(--titoli-testo);
		font-size: 1.0625rem;
		transition:
			background-color 0.16s ease,
			transform 0.16s var(--ease-out);
	}
	.filtro-tasto:active {
		transform: scale(0.96);
	}
	@media (hover: hover) and (pointer: fine) {
		.filtro-tasto:hover {
			background: var(--ink2);
		}
	}
	.filtro-tasto:focus-visible {
		outline-color: var(--ink);
	}
	.filtro-tasto__n {
		display: grid;
		place-items: center;
		min-width: 26px;
		height: 26px;
		padding: 0 7px;
		border-radius: 999px;
		background: var(--mandarino);
		color: var(--ink);
		font-family: var(--testo);
		font-size: 0.8125rem;
		font-weight: 700;
	}
	.filtro-tasto__n[hidden] {
		display: none;
	}

	/* l'interruttore della griglia: tre mattoncini presi dalla stessa famiglia di forme delle tessere; il pomo mandarino scivola sulla vista scelta */
	.vista {
		--i: 1;
		position: relative;
		display: flex;
		padding: 2px;
		border: 2px solid var(--ink);
		border-radius: 999px;
		background: var(--bianco);
	}
	.vista[data-v='compact'] {
		--i: 0;
	}
	.vista[data-v='big'] {
		--i: 2;
	}
	.vista__pomo {
		position: absolute;
		top: 2px;
		bottom: 2px;
		left: 2px;
		width: 46px;
		border-radius: 999px;
		background: var(--mandarino);
		transform: translateX(calc(var(--i) * 46px));
		transition: transform 0.34s var(--ease-out);
	}
	.vista__b {
		position: relative;
		display: grid;
		place-items: center;
		width: 46px;
		height: 38px;
		padding: 0;
		border: 0;
		border-radius: 999px;
		background: none;
		color: var(--ink);
		-webkit-tap-highlight-color: transparent;
	}
	.vista__b svg {
		width: 20px;
		height: 20px;
		fill: currentColor;
		opacity: 0.5;
		transition:
			opacity 0.2s ease,
			transform 0.2s var(--ease-out);
	}
	.vista__b[aria-pressed='true'] svg {
		opacity: 1;
	}
	.vista__b:active svg {
		transform: scale(0.88);
	}
	@media (hover: hover) and (pointer: fine) {
		.vista__b:hover svg {
			opacity: 1;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.vista__pomo {
			transition-duration: 0.01ms;
		}
	}

	/* l'invito: quando la finestra si apre compare un'etichetta "clicca/tocca per i dettagli" sopra il nome */
	.invito {
		position: absolute;
		left: 50%;
		bottom: calc(100% + 8px);
		display: inline-flex;
		align-items: center;
		gap: 7px;
		padding: 5px 13px 5px 6px;
		border-radius: 999px;
		background: var(--ink);
		color: var(--nebbia);
		font-family: var(--titoli-testo);
		font-size: 0.9375rem;
		line-height: 1.2;
		white-space: nowrap;
		opacity: 0;
		translate: -50% 8px;
		pointer-events: none;
		transition:
			opacity 0.2s ease,
			translate 0.3s var(--ease-out);
	}
	.invito :global(.icona) {
		width: 22px;
		height: 22px;
		padding: 4px;
		border-radius: 50%;
		background: var(--mandarino);
		color: var(--ink);
		stroke-width: 3;
	}
	.invito__mouse {
		display: none;
	}
	@media (hover: hover) and (pointer: fine) {
		.invito__mouse {
			display: inline;
		}
		.invito__dito {
			display: none;
		}
	}
	.tessera__tasto:focus-visible .invito,
	.tessera.invitata .invito {
		opacity: 1;
		translate: -50% 0;
		transition-delay: 0.16s;
	}
	@media (hover: hover) and (pointer: fine) {
		.tessera__tasto:hover .invito {
			opacity: 1;
			translate: -50% 0;
			transition-delay: 0.16s;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.invito {
			transition-duration: 0.01ms;
			transition-delay: 0s !important;
		}
	}

	/* i filtri attivi, ognuno si toglie con un tocco */
	.attivi {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 22px;
	}
	.attivi[hidden] {
		display: none;
	}
	/* la griglia irregolare: dodici colonne, la tessera ne occupa --sp, la larga --spl; i buchi li chiude "dense".
	   --n = tessere per riga, --f = quanto è alta una riga rispetto alla larghezza di una tessera: l'unità --u
	   segue la larghezza del contenitore, così cambiando vista (interruttore) le proporzioni restano buone */
	.caja {
		container-type: inline-size;
		margin-top: 28px;
	}
	.griglia {
		--gap: clamp(10px, 1.4vw, 18px);
		--n: 3;
		--f: 0.3;
		--sp: 4;
		--spl: 8;
		--u: calc((100cqw - (var(--n) - 1) * var(--gap)) / var(--n) * var(--f));
		display: grid;
		grid-template-columns: repeat(12, 1fr);
		grid-auto-rows: var(--u);
		grid-auto-flow: dense;
		gap: var(--gap);
	}
	.griglia[data-v='compact'] {
		--n: 4;
		--sp: 3;
		--spl: 6;
	}
	.griglia[data-v='big'] {
		--n: 2;
		--f: 0.22;
		--sp: 6;
		--spl: 12;
	}
	.tessera {
		position: relative;
		grid-column: span var(--sp);
		grid-row: span 5;
		min-width: 0;
		border-radius: 22px;
		overflow: clip;
		background:
			var(--grana),
			linear-gradient(var(--ang), var(--a), var(--b));
		order: var(--ordine);
	}
	.griglia[hidden],
	.tessera[hidden] {
		display: none;
	}
	.tessera--s {
		grid-row: span 4;
	}
	.tessera--m {
		grid-row: span 5;
	}
	.tessera--t {
		grid-row: span 6;
	}
	.tessera--l {
		grid-column: span var(--spl);
		grid-row: span 4;
	}
	.tessera__tasto {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		padding: 0;
		border: 0;
		background: none;
		text-align: left;
		-webkit-tap-highlight-color: transparent;
	}
	.tessera__tasto:focus-visible {
		outline-offset: -5px;
	}

	/* dove sta la finestra a riposo e che forma ha */
	.p-sx {
		--is: 6%;
		--id: 34%;
		--cx: 36%;
	}
	.p-cx {
		--is: 20%;
		--id: 20%;
		--cx: 50%;
	}
	.p-dx {
		--is: 34%;
		--id: 6%;
		--cx: 64%;
	}
	.f-pillola {
		--ir: 999px;
		--it: 7%;
		--ib: 18%;
		--cy: 44.5%;
	}
	.f-arco {
		--ir: 999px 999px 22px 22px;
		--it: 5%;
		--ib: 17%;
		--cy: 44%;
	}
	.f-ovale {
		--ir: 50%;
		--it: 8%;
		--ib: 20%;
		--cy: 44%;
	}
	.f-goccia {
		--ir: 64% 36% 58% 42% / 54% 60% 40% 46%;
		--it: 7%;
		--ib: 18%;
		--cy: 44.5%;
	}
	.f-foglia {
		--ir: 78% 10% 78% 10%;
		--it: 7%;
		--ib: 18%;
		--cy: 44.5%;
	}
	.finestra {
		position: absolute;
		inset: 0;
		clip-path: inset(var(--it) var(--id) var(--ib) var(--is) round var(--ir));
		transition: clip-path 0.36s var(--ease-out);
	}
	.finestra img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transform-origin: var(--x) var(--y);
		transform: translate(calc(var(--cx) - var(--x)), calc(var(--cy) - var(--y))) scale(var(--z));
		transition: transform 0.36s var(--ease-out);
	}
	.finestra img.finestra__brand {
		filter: drop-shadow(0 16px 18px rgb(29 16 51 / 0.32));
	}
	/* sui pezzi di brand (ritagliati, senza sfondo) la finestra ha un fondo suo: senza, la forma non si leggerebbe */
	.tessera--orig .finestra {
		background: var(--nebbia);
	}
	/* cuore e carrello su ogni tessera: bottoni propri sopra il bottone grande che apre la scheda */
	.tessera__azioni {
		position: absolute;
		top: 10px;
		right: 10px;
		z-index: 3;
		display: flex;
		gap: 6px;
	}
	.azione {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		padding: 0;
		border: 2px solid var(--ink);
		border-radius: 50%;
		background: var(--nebbia);
		color: var(--ink);
		transition:
			background-color 0.14s ease,
			transform 0.14s var(--ease-out);
	}
	.azione:active {
		transform: scale(0.92);
	}
	@media (hover: hover) and (pointer: fine) {
		.azione:hover {
			background: var(--mandarino);
		}
	}
	.azione[aria-pressed='true'] {
		background: var(--mandarino);
	}
	.azione.fatto {
		background: var(--ink);
		color: var(--nebbia);
	}
	.etichetta {
		position: absolute;
		left: 10px;
		right: 10px;
		bottom: 10px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 10px;
		padding: 8px 14px;
		border-radius: 16px;
		background: var(--nebbia);
		color: var(--ink);
		line-height: 1.2;
	}
	.etichetta__testo {
		display: grid;
		gap: 3px;
		min-width: 0;
	}
	.etichetta__nome {
		font-weight: 650;
		font-size: 0.9375rem;
		text-wrap: balance;
	}
	.etichetta__meta {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 0.8125rem;
		font-weight: 560;
	}
	.pallini {
		display: inline-flex;
	}
	.pallini i {
		width: 12px;
		height: 12px;
		border-radius: 50%;
		box-shadow: inset 0 0 0 1px rgb(29 16 51 / 0.55);
	}
	.pallini i + i {
		margin-left: -3px;
	}
	.etichetta__prezzo {
		font-family: var(--titoli-testo);
		font-size: 1.0625rem;
		white-space: nowrap;
	}
	.tessera--orig .etichetta {
		background: var(--mandarino);
	}

	/* aperta: la finestra riempie la tessera e il capo si vede per intero */
	.tessera__tasto:focus-visible .finestra,
	.tessera.aperta .finestra {
		clip-path: inset(0 round 22px);
	}
	.tessera__tasto:focus-visible .finestra img,
	.tessera.aperta .finestra img {
		transform: none;
	}
	@media (hover: hover) and (pointer: fine) {
		.tessera__tasto:hover .finestra {
			clip-path: inset(0 round 22px);
		}
		.tessera__tasto:hover .finestra img {
			transform: none;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.finestra,
		.finestra img {
			transition-duration: 0.01ms;
		}
	}

	.vuoto {
		display: grid;
		justify-items: start;
		gap: 12px;
		padding: 48px 0;
	}
	.vuoto[hidden] {
		display: none;
	}
	.vuoto__titolo {
		font-family: var(--titoli);
		font-size: clamp(2rem, 5vw, 3.4rem);
		line-height: 1;
	}

	/* pochi risultati (filtri stretti): tessere tutte della stessa altezza e della stessa larghezza, senza buchi a fianco.
	   data-pochi = quante sono; nella vista "più grandi" (una per riga) non serve */
	.griglia[data-pochi]:not([data-v='big']) .tessera {
		grid-column: span var(--sp);
		grid-row: span 5;
	}
	.griglia[data-pochi='1'][data-v],
	.griglia[data-pochi='2'][data-v],
	.griglia[data-pochi='4'][data-v] {
		--n: 2;
		--sp: 6;
	}
	.griglia[data-pochi='3'][data-v] {
		--n: 3;
		--sp: 4;
	}
	.griglia[data-pochi][data-v]:not([data-v='big']) {
		--f: 0.3;
	}
	@media (max-width: 1100px) {
		.griglia,
		.griglia[data-v='mix'] {
			--n: 2;
			--f: 0.23;
			--sp: 6;
			--spl: 12;
		}
		.griglia[data-v='compact'] {
			--n: 3;
			--f: 0.26;
			--sp: 4;
			--spl: 8;
		}
		.griglia[data-v='big'] {
			--n: 1;
			--f: 0.13;
			--sp: 12;
			--spl: 12;
		}
	}
	@media (max-width: 700px) {
		/* sul telefono due viste sole: due tessere per riga o una (il bottone "più piccole" sparisce, vale come "mix") */
		.griglia,
		.griglia[data-v='mix'],
		.griglia[data-v='compact'] {
			--n: 2;
			--f: 0.26;
			--sp: 6;
			--spl: 12;
		}
		.griglia[data-v='big'] {
			--n: 1;
			--f: 0.17;
			--sp: 12;
		}
		.tessera {
			border-radius: 18px;
		}
		.tessera--s {
			grid-row: span 5;
		}
		.tessera--m {
			grid-row: span 6;
		}
		.tessera--t {
			grid-row: span 7;
		}
		.tessera--l {
			grid-row: span 6;
		}
		.etichetta {
			left: 6px;
			right: 6px;
			bottom: 6px;
			display: grid;
			grid-template-columns: 1fr auto;
			align-items: center;
			gap: 0 6px;
			padding: 6px 10px;
			border-radius: 14px;
		}
		.etichetta__nome {
			font-size: 0.8125rem;
		}
		.etichetta__taglie {
			display: none;
		}
		.etichetta__testo {
			display: contents;
		}
		.etichetta__nome {
			grid-column: 1 / -1;
		}
		.invito {
			bottom: calc(100% + 6px);
			font-size: 0.75rem;
			gap: 5px;
			padding: 4px 10px 4px 4px;
		}
		.invito :global(.icona) {
			width: 18px;
			height: 18px;
			padding: 3px;
		}
		/* "più piccole" non c'è sul telefono: il pomo di "mix" sta al primo posto, "big" al secondo */
		.vista__b--fitta {
			display: none;
		}
		.vista,
		.vista[data-v='compact'] {
			--i: 0;
			order: 2;
		}
		.vista[data-v='big'] {
			--i: 1;
		}
		.etichetta__prezzo {
			font-size: 0.9375rem;
		}
		.catalogo__testa {
			flex-direction: column;
			align-items: flex-start;
			gap: 6px;
		}
		/* sul telefono la barra va su due righe: le categorie in alto, sotto "Filter" e l'ordine a tutta larghezza (pollice) */
		.filtri__in {
			flex-wrap: wrap;
			gap: 8px;
			padding-block: 8px;
		}
		.chips {
			flex: 1 1 100%;
			margin-left: calc(var(--gutter) * -1);
			margin-right: calc(var(--gutter) * -1);
			padding-inline: var(--gutter);
		}
		.filtri__destra {
			flex: 1 1 100%;
		}
		.filtro-tasto {
			order: -1;
			flex: none;
			padding: 0 16px 0 12px;
			gap: 8px;
		}
		.ordina {
			flex: 1;
			min-width: 0;
		}
		.ordina select {
			width: 100%;
			padding: 0 6px 0 12px;
			font-size: 0.875rem;
		}
		/* a metà lettura la barra si ritira sotto la testata (con la riga rapida) e torna scorrendo in su */
		.filtri {
			transition:
				top 0.22s var(--ease-out),
				transform 0.22s var(--ease-out);
		}
		:global(html.rapida-nascosta) .filtri.attaccata {
			transform: translateY(calc(-100% - 2px));
		}
		.griglia[data-pochi='3'][data-v] {
			--n: 2;
			--sp: 6;
		}
		.azione {
			width: 40px;
			height: 40px;
		}
		.tessera__azioni {
			top: 6px;
			right: 6px;
			gap: 4px;
		}
	}
</style>

<style is:global>
	.attivo {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 38px;
		padding: 0 12px 0 14px;
		border: 2px solid var(--ink);
		border-radius: 999px;
		background: var(--lavanda);
		font-weight: 650;
		font-size: 0.875rem;
	}
	.attivo .icona {
		width: 0.9rem;
		height: 0.9rem;
	}
</style>

<script>
	import { EURO, CATEGORIE, COLORI } from './dati';
	import { aggiungi, alternaCuore, apriScheda, cuori, prodotti, ridotto } from './stato';
	import type { Filtro } from './stato';

	const radice = document.querySelector<HTMLElement>('#shop');
	const pannello = document.querySelector<HTMLDialogElement>('[data-fp]');
	if (radice && pannello) {
		const tessere = [...radice.querySelectorAll<HTMLElement>('.tessera')];
		const conta = radice.querySelector<HTMLElement>('[data-conta]')!;
		const vuoto = radice.querySelector<HTMLElement>('[data-vuoto]')!;
		const griglia = radice.querySelector<HTMLElement>('[data-griglia]')!;
		const attivi = radice.querySelector<HTMLElement>('[data-attivi]')!;
		const ordina = radice.querySelector<HTMLSelectElement>('[data-ordina]')!;
		const nFiltri = radice.querySelector<HTMLElement>('[data-filtri-n]')!;
		const fp = (s: string) => pannello.querySelector<HTMLElement>(s)!;
		const minR = fp('[data-fp-min]') as HTMLInputElement;
		const maxR = fp('[data-fp-max]') as HTMLInputElement;
		const limiti = { min: Number(minR.min), max: Number(maxR.max) };

		const stato = {
			categorie: new Set<string>(),
			taglie: new Set<string>(),
			colori: new Set<string>(),
			originali: false,
			preferiti: false,
			testo: '',
			ordine: '',
			min: limiti.min,
			max: limiti.max,
		};
		const azzera = () => {
			stato.categorie.clear();
			stato.taglie.clear();
			stato.colori.clear();
			Object.assign(stato, { originali: false, preferiti: false, testo: '', ordine: '', min: limiti.min, max: limiti.max });
		};

		const premuto = (el: Element, v: boolean) => el.setAttribute('aria-pressed', String(v));
		const nomeCat = Object.fromEntries(CATEGORIE.map((c) => [c.chiave, c.nome]));

		// i filtri che non sono una categoria: servono per il conto sul bottone "Filter"
		const quanti = () =>
			stato.taglie.size +
			stato.colori.size +
			Number(stato.originali) +
			Number(stato.preferiti) +
			Number(!!stato.testo) +
			Number(stato.min > limiti.min || stato.max < limiti.max);

		const disegnaAttivi = () => {
			const voci: { testo: string; togli: () => void }[] = [];
			stato.categorie.forEach((c) => voci.push({ testo: nomeCat[c], togli: () => stato.categorie.delete(c) }));
			stato.taglie.forEach((t) => voci.push({ testo: `Size ${t}`, togli: () => stato.taglie.delete(t) }));
			stato.colori.forEach((c) => voci.push({ testo: COLORI[c].nome, togli: () => stato.colori.delete(c) }));
			if (stato.min > limiti.min || stato.max < limiti.max)
				voci.push({ testo: `${EURO(stato.min)} to ${EURO(stato.max)}`, togli: () => Object.assign(stato, { min: limiti.min, max: limiti.max }) });
			if (stato.originali) voci.push({ testo: 'Soft Riot originals', togli: () => (stato.originali = false) });
			if (stato.preferiti) voci.push({ testo: 'Saved pieces', togli: () => (stato.preferiti = false) });
			if (stato.testo) voci.push({ testo: `“${stato.testo}”`, togli: () => (stato.testo = '') });
			attivi.hidden = voci.length === 0;
			attivi.replaceChildren(
				...voci.map((v) => {
					const li = document.createElement('li');
					const b = document.createElement('button');
					b.type = 'button';
					b.className = 'attivo';
					b.textContent = v.testo;
					b.insertAdjacentHTML(
						'beforeend',
						'<svg class="icona" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg><span class="sr-only">, remove filter</span>',
					);
					b.addEventListener('click', () => {
						v.togli();
						applica();
					});
					li.append(b);
					return li;
				}),
			);
		};

		const applica = () => {
			const salvati = cuori();
			let n = 0;
			tessere.forEach((t) => {
				const taglie = (t.dataset.taglie || '').split('|');
				const colori = (t.dataset.colori || '').split(' ');
				const prezzo = Number(t.dataset.prezzo);
				const ok =
					(stato.categorie.size === 0 || stato.categorie.has(t.dataset.cat!)) &&
					(!stato.originali || t.dataset.orig === '1') &&
					(!stato.preferiti || salvati.has(t.dataset.prodotto!)) &&
					(stato.taglie.size === 0 || taglie.some((x) => [...stato.taglie].some((s) => x === s || x.split('/').includes(s)))) &&
					(stato.colori.size === 0 || colori.some((c) => stato.colori.has(c))) &&
					prezzo >= stato.min &&
					prezzo <= stato.max &&
					(!stato.testo || (t.dataset.nome || '').includes(stato.testo.toLowerCase()));
				t.hidden = !ok;
				if (ok) n++;
				const base = Number(t.style.getPropertyValue('--ordine'));
				t.style.order = String(stato.ordine === 'su' ? prezzo : stato.ordine === 'giu' ? -prezzo : base);
			});
			const testoConta = `${n} ${n === 1 ? 'piece' : 'pieces'}`;
			conta.textContent = testoConta;
			if (n > 0 && n <= 4) griglia.dataset.pochi = String(n);
			else delete griglia.dataset.pochi;
			vuoto.hidden = n > 0;
			griglia.hidden = n === 0;
			if (n === 0) {
				const soloCuori = stato.preferiti && !salvati.size;
				radice.querySelector('[data-vuoto-titolo]')!.textContent = soloCuori ? 'No saved pieces yet.' : 'Nothing in that mix.';
				radice.querySelector('[data-vuoto-testo]')!.textContent = soloCuori
					? 'Tap the heart on any piece and it will wait for you here.'
					: 'Try fewer filters, or start again from all the pieces.';
			}

			// la barra in cima al catalogo
			radice.querySelectorAll<HTMLElement>('[data-barra-cat]').forEach((c) => {
				const k = c.dataset.barraCat!;
				premuto(c, k === '' ? stato.categorie.size === 0 : stato.categorie.size === 1 && stato.categorie.has(k));
			});
			ordina.value = stato.ordine;
			const k = quanti();
			nFiltri.hidden = k === 0;
			nFiltri.textContent = String(k);

			// il cassetto
			pannello.querySelectorAll<HTMLElement>('[data-cat]').forEach((c) => premuto(c, stato.categorie.has(c.dataset.cat!)));
			pannello.querySelectorAll<HTMLElement>('[data-taglia]').forEach((c) => premuto(c, stato.taglie.has(c.dataset.taglia!)));
			pannello.querySelectorAll<HTMLElement>('[data-colore]').forEach((c) => premuto(c, stato.colori.has(c.dataset.colore!)));
			premuto(fp('[data-orig]'), stato.originali);
			premuto(fp('[data-pref]'), stato.preferiti);
			pannello.querySelectorAll<HTMLElement>('[data-ord]').forEach((c) => premuto(c, (c.dataset.ord || '') === stato.ordine));
			(fp('[data-fp-testo]') as HTMLInputElement).value = stato.testo;
			minR.value = String(stato.min);
			maxR.value = String(stato.max);
			const span = limiti.max - limiti.min;
			const binario = fp('.fp__binario span');
			binario.style.setProperty('--da', `${((stato.min - limiti.min) / span) * 100}%`);
			binario.style.setProperty('--a', `${((stato.max - limiti.min) / span) * 100}%`);
			fp('[data-fp-da]').textContent = EURO(stato.min);
			fp('[data-fp-a]').textContent = EURO(stato.max);
			const f = fp('[data-fp-n]');
			f.hidden = k + stato.categorie.size === 0;
			f.textContent = String(k + stato.categorie.size);
			fp('[data-fp-mostra]').textContent = n === 0 ? 'No pieces: change a filter' : `Show ${testoConta}`;
			disegnaAttivi();
		};

		// la barra
		radice.querySelectorAll<HTMLElement>('[data-barra-cat]').forEach((c) =>
			c.addEventListener('click', () => {
				stato.categorie.clear();
				if (c.dataset.barraCat) stato.categorie.add(c.dataset.barraCat);
				applica();
			}),
		);
		ordina.addEventListener('change', () => {
			stato.ordine = ordina.value;
			applica();
		});
		radice.querySelector('[data-apri-filtri]')?.addEventListener('click', () => pannello.showModal());
		radice.querySelector('[data-azzera]')?.addEventListener('click', () => {
			azzera();
			applica();
		});

		// il cassetto
		const alterna = (insieme: Set<string>, v: string) => (insieme.has(v) ? insieme.delete(v) : insieme.add(v));
		pannello.querySelectorAll<HTMLElement>('[data-cat]').forEach((c) => c.addEventListener('click', () => (alterna(stato.categorie, c.dataset.cat!), applica())));
		pannello.querySelectorAll<HTMLElement>('[data-taglia]').forEach((c) => c.addEventListener('click', () => (alterna(stato.taglie, c.dataset.taglia!), applica())));
		pannello.querySelectorAll<HTMLElement>('[data-colore]').forEach((c) => c.addEventListener('click', () => (alterna(stato.colori, c.dataset.colore!), applica())));
		pannello.querySelectorAll<HTMLElement>('[data-ord]').forEach((c) => c.addEventListener('click', () => ((stato.ordine = c.dataset.ord || ''), applica())));
		fp('[data-orig]').addEventListener('click', () => ((stato.originali = !stato.originali), applica()));
		fp('[data-pref]').addEventListener('click', () => ((stato.preferiti = !stato.preferiti), applica()));
		fp('[data-fp-testo]').addEventListener('input', (e) => {
			stato.testo = (e.target as HTMLInputElement).value.trim();
			applica();
		});
		// i due cursori del prezzo non si scavalcano
		minR.addEventListener('input', () => {
			stato.min = Math.min(Number(minR.value), stato.max - 5);
			applica();
		});
		maxR.addEventListener('input', () => {
			stato.max = Math.max(Number(maxR.value), stato.min + 5);
			applica();
		});
		fp('[data-fp-azzera]').addEventListener('click', () => {
			azzera();
			applica();
		});
		fp('[data-fp-mostra]').addEventListener('click', () => pannello.close());
		pannello.addEventListener('click', (e) => {
			if (e.target === pannello) pannello.close();
		});

		// i comandi della testata (sezioni, cerca, preferiti)
		document.addEventListener('sr:filtra', (e) => {
			const d = (e as CustomEvent<Filtro>).detail;
			if (d.azzera) azzera();
			if (d.categoria !== undefined) {
				stato.categorie.clear();
				if (d.categoria) stato.categorie.add(d.categoria);
			}
			if (d.originali !== undefined) stato.originali = d.originali;
			if (d.preferiti !== undefined) stato.preferiti = d.preferiti;
			if (d.testo !== undefined) stato.testo = d.testo;
			applica();
		});

		// tessere: scheda, cuore, aggiunta veloce
		radice.querySelectorAll<HTMLElement>('.tessera__tasto[data-apri]').forEach((b) => b.addEventListener('click', () => apriScheda(b.dataset.apri!)));
		const cuoriBtn = [...radice.querySelectorAll<HTMLButtonElement>('[data-cuore]')];
		cuoriBtn.forEach((b) => b.addEventListener('click', () => alternaCuore(b.dataset.cuore!)));
		const sincronizzaCuori = () => {
			const s = cuori();
			cuoriBtn.forEach((b) => {
				const acceso = s.has(b.dataset.cuore!);
				premuto(b, acceso);
				const nome = prodotti()[b.dataset.cuore!]?.nome ?? '';
				b.setAttribute('aria-label', acceso ? `Remove ${nome} from saved` : `Save ${nome}`);
			});
			if (stato.preferiti) applica();
		};
		sincronizzaCuori();
		document.addEventListener('sr:cuori', sincronizzaCuori);

		radice.querySelectorAll<HTMLButtonElement>('[data-rapido]').forEach((b) =>
			b.addEventListener('click', () => {
				const p = prodotti()[b.dataset.rapido!];
				if (!p) return;
				if (p.taglie.length > 1) {
					apriScheda(p.id);
					return;
				}
				aggiungi(p.id, p.taglie[0], 1, true);
				if (!ridotto()) {
					b.classList.add('fatto');
					setTimeout(() => b.classList.remove('fatto'), 900);
				}
			}),
		);

		// sul telefono non c'è il passaggio del mouse: la tessera si apre da sola quando sta a metà schermo
		// (anche sotto i 700 px: il DevTools "Responsive" cambia solo la larghezza e il mouse resta attivo)
		if ('IntersectionObserver' in window) {
			const senzaMouse = matchMedia('(hover: none), (max-width: 700px)');
			// l'invito "Tap to see details" lo porta una tessera sola: fra quelle aperte, la più vicina al centro dello schermo
			const invita = () => {
				const centro = innerHeight / 2;
				let migliore: HTMLElement | null = null;
				let distanza = Infinity;
				tessere.forEach((t) => {
					t.classList.remove('invitata');
					if (!t.classList.contains('aperta')) return;
					const r = t.getBoundingClientRect();
					const d = Math.abs(r.top + r.height / 2 - centro);
					if (d < distanza) {
						distanza = d;
						migliore = t;
					}
				});
				(migliore as HTMLElement | null)?.classList.add('invitata');
			};
			const io = new IntersectionObserver(
				(voci) => {
					voci.forEach((v) => senzaMouse.matches && v.target.classList.toggle('aperta', v.isIntersecting));
					invita();
				},
				{ rootMargin: '-34% 0px -34% 0px', threshold: 0 },
			);
			tessere.forEach((t) => io.observe(t));
			// se la condizione cambia (rotazione, DevTools) si riparte da zero: le tessere si riaprono rilevando di nuovo
			senzaMouse.addEventListener('change', () => {
				tessere.forEach((t) => {
					t.classList.remove('aperta');
					io.unobserve(t);
					io.observe(t);
				});
			});
		}

		// la barra sa quando è appiccicata (serve a ritirarla sul telefono, vedi CSS)
		const barra = radice.querySelector<HTMLElement>('.filtri');
		if (barra) {
			let atteso = false;
			const segna = () => {
				atteso = false;
				const top = parseFloat(getComputedStyle(barra).top) || 0;
				barra.classList.toggle('attaccata', barra.getBoundingClientRect().top <= top + 1 && scrollY > 0);
			};
			addEventListener('scroll', () => !atteso && ((atteso = true), requestAnimationFrame(segna)), { passive: true });
			segna();
		}

		// l'interruttore della griglia: più piccole / mix / più grandi (sul telefono "più piccole" vale come mix)
		const vista = radice.querySelector<HTMLElement>('[data-vista]')!;
		const scelte = [...vista.querySelectorAll<HTMLButtonElement>('[data-v-scelta]')];
		const telefono = matchMedia('(max-width: 700px)');
		let scelta = 'mix';
		const mostraVista = () => {
			const v = telefono.matches && scelta === 'compact' ? 'mix' : scelta;
			vista.dataset.v = v;
			griglia.dataset.v = v;
			scelte.forEach((b) => premuto(b, b.dataset.vScelta === v));
		};
		scelte.forEach((b) =>
			b.addEventListener('click', () => {
				if (b.dataset.vScelta === scelta) return;
				scelta = b.dataset.vScelta!;
				mostraVista();
				if (!ridotto())
					griglia.animate(
						[
							{ opacity: 0.25, transform: 'translateY(12px)' },
							{ opacity: 1, transform: 'none' },
						],
						{ duration: 360, easing: 'cubic-bezier(0.23, 1, 0.32, 1)' },
					);
			}),
		);
		telefono.addEventListener('change', mostraVista);
		mostraVista();
		applica();
	}
</script>

---
// Fascia di ritorno: dice che è una vetrina dimostrativa e porta all'hub o al contatto. Qui sta nel flusso e scorre
// via con la pagina; la testata, che le sta sotto, resta poi appiccicata in cima. Al centro porta gli avvisi del
// negozio (spedizione, resi): una sola riga sopra la testata invece di due.
import { SOGLIA_SPEDIZIONE } from './dati';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<aside class="fascia" aria-label="About this showcase">
	<p class="fascia__testo">Demo showcase <span class="fascia__studio">concept by Loop Studio</span></p>
	<p class="fascia__avvisi">Free shipping over €{SOGLIA_SPEDIZIONE}<span>30 days to change your mind</span></p>
	<nav class="fascia__link" aria-label="Showcases">
		<a href={`${base}/`}>All showcases</a>
		<a href="https://theloopstudio.org/contatti/?concept=softriot" class="fascia__cta">I want one like this</a>
	</nav>
</aside>

<style>
	.fascia {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		min-height: 34px;
		padding: 0 var(--gutter);
		background: var(--lavanda);
		color: var(--ink);
		border-bottom: 2px solid var(--ink);
		font-weight: 600;
		font-size: 0.8125rem;
		white-space: nowrap;
	}
	.fascia__studio {
		margin-left: 0.6em;
		padding-left: 0.7em;
		border-left: 2px solid var(--ink);
	}
	.fascia__avvisi {
		text-align: center;
	}
	.fascia__avvisi span::before {
		content: '·';
		margin: 0 0.8em;
	}
	.fascia__link {
		display: flex;
		gap: 24px;
	}
	.fascia a {
		display: inline-flex;
		align-items: center;
		min-height: 34px;
		text-decoration: none;
		border-bottom: 2px solid transparent;
	}
	.fascia a:hover {
		border-bottom-color: var(--ink);
	}
	.fascia a.fascia__cta {
		font-weight: 800;
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 4px;
	}
	.fascia :focus-visible {
		outline-offset: -3px;
	}
	@media (max-width: 1180px) {
		.fascia__avvisi span {
			display: none;
		}
	}
	@media (max-width: 900px) {
		.fascia__studio {
			display: none;
		}
	}
	@media (max-width: 760px) {
		.fascia__avvisi {
			display: none;
		}
		.fascia__link {
			gap: 16px;
		}
	}
	@media (max-width: 460px) {
		.fascia__testo {
			display: none;
		}
		.fascia {
			justify-content: center;
		}
	}
</style>

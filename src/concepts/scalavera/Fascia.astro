---
// Fascia di ritorno: vetrina dimostrativa, link all'hub e al contatto. Non è fissa: scorre via,
// la navbar fissa le sta sotto e risale mentre si scorre (--fascia).
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<aside class="fascia" data-fascia aria-label="Informazioni su questa vetrina">
	<p class="fascia__testo">Vetrina dimostrativa <span class="fascia__studio">· concept di Loop Studio</span></p>
	<nav class="fascia__link" aria-label="Vetrine">
		<a href={`${base}/`}><span aria-hidden="true">←</span> Tutte le vetrine</a>
		<a href="https://theloopstudio.org/contatti/?concept=scalavera" class="fascia__cta">Ne voglio una così <span aria-hidden="true">→</span></a>
	</nav>
</aside>

<style>
	.fascia {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		z-index: 150;
		height: var(--fascia-h);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding: 0 var(--gutter);
		background: var(--inchiostro);
		color: var(--nebbia);
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		white-space: nowrap;
	}
	.fascia p {
		margin: 0;
	}
	.fascia__link {
		display: flex;
		gap: 22px;
	}
	.fascia a {
		text-decoration: none;
		border-bottom: 1px solid transparent;
	}
	.fascia a:hover {
		border-bottom-color: var(--metro);
	}
	.fascia__cta {
		color: var(--metro);
	}
	@media (max-width: 640px) {
		.fascia__studio {
			display: none;
		}
	}
	@media (max-width: 480px) {
		.fascia__testo {
			display: none;
		}
		.fascia {
			justify-content: center;
		}
	}
</style>

<script>
	const fascia = document.querySelector<HTMLElement>('[data-fascia]');
	if (fascia) {
		let attesa = false;
		const aggiorna = () => {
			attesa = false;
			document.documentElement.style.setProperty('--fascia', `${Math.max(0, fascia.offsetHeight - scrollY)}px`);
		};
		addEventListener('scroll', () => { if (!attesa) { attesa = true; requestAnimationFrame(aggiorna); } }, { passive: true });
		addEventListener('resize', aggiorna);
		aggiorna();
	}
</script>

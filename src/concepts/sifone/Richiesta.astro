---
import { problemi, zone, orari, TEL, TEL_VISIBILE } from './dati';
---

<section class="ric sez sez--scura" id="richiesta" data-sez>
	<div class="sez__in">
		<p class="stazione"><b>05</b> Contatti</p>
		<h2 class="sez__titolo">Mandaci l’ordine di intervento.</h2>
		<p class="sez__sotto">Compila quattro campi: ti richiamiamo entro dieci minuti, o chiama subito se è un’emergenza.</p>

		<div class="ric__griglia">
			<div class="ric__modulo">
				<form class="mod" novalidate data-modulo>
					<div class="campo">
						<label for="r-nome">Nome</label>
						<input id="r-nome" name="nome" type="text" autocomplete="name" required />
						<p class="campo__err" data-err hidden></p>
					</div>
					<div class="campo">
						<label for="r-tel">Telefono</label>
						<input id="r-tel" name="tel" type="tel" inputmode="tel" autocomplete="tel" required placeholder="333 000 0000" />
						<p class="campo__err" data-err hidden></p>
					</div>
					<div class="campo">
						<label for="r-zona">Zona</label>
						<select id="r-zona" name="zona" required>
							{zone.map((z) => <option value={z.id}>{z.nome}</option>)}
						</select>
					</div>
					<div class="campo">
						<label for="r-prob">Problema</label>
						<select id="r-prob" name="problema" required>
							{problemi.map((p) => <option value={p.id}>{p.nome}</option>)}
							<option value="altro">Altro</option>
						</select>
					</div>
					<fieldset class="campo campo--pieno">
						<legend>Quando ti serve</legend>
						<div class="urg">
							<label><input type="radio" name="urg" value="ora" checked /><span>Subito</span></label>
							<label><input type="radio" name="urg" value="oggi" /><span>Oggi</span></label>
							<label><input type="radio" name="urg" value="settimana" /><span>Questa settimana</span></label>
						</div>
					</fieldset>
					<div class="campo campo--pieno">
						<label for="r-note">Note (facoltativo)</label>
						<textarea id="r-note" name="note" rows="3" placeholder="Ad esempio: piano, citofono, da quanto dura il problema"></textarea>
					</div>
					<button class="btn mod__invia" type="submit">Invia l’ordine</button>
					<p class="mod__nota">Demo: nessun dato viene inviato o salvato.</p>
				</form>

				<div class="ricevuta" data-ricevuta hidden tabindex="-1" aria-live="polite">
					<p class="ricevuta__sopra">Ordine di intervento</p>
					<p class="ricevuta__n" data-n>N° SF-0000</p>
					<dl>
						<div><dt>A nome di</dt><dd data-r-nome></dd></div>
						<div><dt>Zona</dt><dd data-r-zona></dd></div>
						<div><dt>Problema</dt><dd data-r-prob></dd></div>
						<div><dt>Quando</dt><dd data-r-urg></dd></div>
					</dl>
					<p class="ricevuta__eta" data-r-eta></p>
					<button class="btn btn--notte" type="button" data-nuovo>Nuovo ordine</button>
				</div>
			</div>

			<aside class="ric__lato" aria-label="Recapiti e orari">
				<a class="ric__tel" href={`tel:${TEL}`}>
					<span>Emergenza, rispondiamo subito</span>
					<b>{TEL_VISIBILE}</b>
				</a>
				<p class="ric__stato" data-stato><span class="ric__led" aria-hidden="true"></span> <span data-stato-t>Pronto intervento attivo</span></p>
				<dl class="ric__orari">
					{
						orari.map((o) => (
							<div>
								<dt>{o.g}</dt>
								<dd>{o.o}</dd>
							</div>
						))
					}
				</dl>
				<p class="ric__sede">Sede di fantasia: via dei Tubi 12, 00000 Città. Tecnici in tutta l’area, anche senza passare dalla sede.</p>
			</aside>
		</div>
	</div>
</section>

<style>
	.ric__griglia {
		margin-top: clamp(30px, 5vw, 56px);
		display: grid;
		grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
		gap: clamp(24px, 4vw, 56px);
		align-items: start;
	}
	.mod {
		border-radius: 4px 22px 4px 22px;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 18px 20px;
		padding: clamp(20px, 3vw, 32px);
		background: var(--calce);
		color: var(--notte);
		border: 1px solid rgba(8, 33, 42, 0.26);
		box-shadow: 0 24px 38px -26px rgba(8, 33, 42, 0.6);
	}
	.campo {
		display: grid;
		gap: 6px;
		align-content: start;
		border: 0;
		min-width: 0;
	}
	.campo--pieno {
		grid-column: 1 / -1;
	}
	.campo label,
	.campo legend {
		font-weight: 700;
		font-size: 0.82rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}
	.campo input[type='text'],
	.campo input[type='tel'],
	.campo select,
	.campo textarea {
		width: 100%;
		min-height: 50px;
		padding: 10px 14px;
		border: 2px solid rgba(8, 33, 42, 0.5);
		border-radius: 0;
		background: var(--bianco);
		font-size: 1.05rem;
	}
	.campo textarea {
		resize: vertical;
	}
	.campo input:focus-visible,
	.campo select:focus-visible,
	.campo textarea:focus-visible {
		outline: 3px solid var(--acqua-testo);
		outline-offset: 2px;
	}
	.campo.is-errore input {
		border-color: var(--errore);
		background: #fff1ef;
	}
	.campo__err {
		color: var(--errore);
		font-weight: 600;
		font-size: 0.92rem;
	}
	.urg {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 8px;
	}
	.urg label {
		position: relative;
		cursor: pointer;
	}
	.urg input {
		position: absolute;
		opacity: 0;
		inset: 0;
		width: 100%;
		height: 100%;
		margin: 0;
		cursor: pointer;
	}
	.urg span {
		display: grid;
		place-items: center;
		min-height: 50px;
		padding: 6px 8px;
		text-align: center;
		border: 2px solid rgba(8, 33, 42, 0.5);
		background: var(--bianco);
		font-family: var(--testo);
		font-weight: 700;
		font-size: 0.94rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		line-height: 1.05;
	}
	.urg input:checked + span {
		background: var(--notte);
		color: var(--rame);
	}
	.urg input:focus-visible + span {
		outline: 3px solid var(--acqua-testo);
		outline-offset: 3px;
	}
	.mod__invia {
		grid-column: 1 / -1;
		min-height: 58px;
	}
	.mod__nota {
		grid-column: 1 / -1;
		font-size: 0.85rem;
		color: var(--testo-2);
	}

	.ricevuta {
		border-radius: 4px 22px 4px 22px;
		padding: clamp(22px, 3vw, 34px);
		background: var(--rame);
		color: var(--notte);
		border: 1px solid rgba(8, 33, 42, 0.26);
		box-shadow: 0 24px 38px -26px rgba(8, 33, 42, 0.6);
		clip-path: polygon(0 0, 100% 0, 100% calc(100% - 14px), 96% 100%, 92% calc(100% - 14px), 88% 100%, 84% calc(100% - 14px), 80% 100%, 76% calc(100% - 14px), 72% 100%, 68% calc(100% - 14px), 64% 100%, 60% calc(100% - 14px), 56% 100%, 52% calc(100% - 14px), 48% 100%, 44% calc(100% - 14px), 40% 100%, 36% calc(100% - 14px), 32% 100%, 28% calc(100% - 14px), 24% 100%, 20% calc(100% - 14px), 16% 100%, 12% calc(100% - 14px), 8% 100%, 4% calc(100% - 14px), 0 100%);
		padding-bottom: 44px;
		animation: ric-esce 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
	}
	@keyframes ric-esce {
		from {
			opacity: 0;
			transform: translateY(-24px);
		}
	}
	.ricevuta[hidden] {
		display: none;
	}
	.ricevuta:focus {
		outline: none;
	}
	.ricevuta__sopra {
		font-weight: 700;
		font-size: 0.82rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}
	.ricevuta__n {
		font-family: var(--titoli);
		font-weight: 400;
		font-size: clamp(2.6rem, 6vw, 4rem);
		line-height: 1;
		margin: 6px 0 18px;
	}
	.ricevuta dl {
		display: grid;
		gap: 8px;
		margin-bottom: 18px;
	}
	.ricevuta dl div {
		display: flex;
		justify-content: space-between;
		gap: 16px;
		padding-bottom: 6px;
		border-bottom: 2px dashed rgba(17, 17, 17, 0.5);
	}
	.ricevuta dt {
		font-weight: 600;
	}
	.ricevuta dd {
		font-weight: 800;
		text-align: right;
	}
	.ricevuta__eta {
		margin-bottom: 18px;
		font-size: 1.1rem;
		font-weight: 600;
	}

	.ric__lato {
		display: grid;
		gap: 22px;
	}
	.ric__tel {
		border-radius: 4px 22px 4px 22px;
		display: grid;
		gap: 4px;
		padding: 20px 22px;
		background: var(--rame);
		color: var(--notte);
		text-decoration: none;
		border: 1px solid rgba(8, 33, 42, 0.26);
		box-shadow: 0 24px 38px -26px rgba(8, 33, 42, 0.6);
		transition: transform 0.12s, box-shadow 0.12s;
	}
	.ric__tel:hover {
		transform: translate(-2px, -2px);
		box-shadow: 0 24px 38px -26px rgba(8, 33, 42, 0.6);
	}
	.ric__tel span {
		font-weight: 700;
		font-size: 0.85rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}
	.ric__tel b {
		font-family: var(--titoli);
		font-weight: 400;
		font-size: clamp(2.4rem, 5vw, 3.4rem);
		line-height: 1;
	}
	.ric__stato {
		display: flex;
		align-items: center;
		gap: 10px;
		font-weight: 700;
	}
	.ric__led {
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: #3ddc84;
		box-shadow: 0 0 0 4px rgba(61, 220, 132, 0.25);
	}
	.ric__orari {
		display: grid;
		gap: 14px;
	}
	.ric__orari dt {
		font-family: var(--testo);
		font-weight: 700;
		font-size: 1.01rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--rame);
	}
	.ric__orari dd {
		color: #d4d0c3;
	}
	.ric__sede {
		font-size: 0.9rem;
		color: #b9b5a8;
	}
	@media (max-width: 960px) {
		.ric__griglia {
			grid-template-columns: minmax(0, 1fr);
		}
	}
	@media (max-width: 560px) {
		.mod {
			grid-template-columns: minmax(0, 1fr);
			box-shadow: 0 24px 38px -26px rgba(8, 33, 42, 0.6);
		}
		.urg {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>

<script>
	import { problemi, zone } from './dati';

	const mod = document.querySelector<HTMLFormElement>('[data-modulo]');
	const ricevuta = document.querySelector<HTMLElement>('[data-ricevuta]');
	if (mod && ricevuta) {
		const campo = (el: HTMLElement) => el.closest<HTMLElement>('.campo')!;
		const errore = (el: HTMLInputElement, testo: string) => {
			const c = campo(el);
			const p = c.querySelector<HTMLElement>('[data-err]')!;
			c.classList.toggle('is-errore', !!testo);
			p.hidden = !testo;
			p.textContent = testo;
			p.id = p.id || `${el.id}-err`;
			if (testo) {
				el.setAttribute('aria-invalid', 'true');
				el.setAttribute('aria-describedby', p.id);
			} else {
				el.removeAttribute('aria-invalid');
				el.removeAttribute('aria-describedby');
			}
		};
		const nome = mod.elements.namedItem('nome') as HTMLInputElement;
		const tel = mod.elements.namedItem('tel') as HTMLInputElement;
		const valida = () => {
			errore(nome, nome.value.trim().length < 2 ? 'Scrivi il tuo nome, così sappiamo con chi parlare.' : '');
			const cifre = tel.value.replace(/\D/g, '');
			errore(tel, cifre.length < 8 || cifre.length > 13 ? 'Scrivi un numero di telefono valido, anche fisso.' : '');
			return !nome.getAttribute('aria-invalid') && !tel.getAttribute('aria-invalid');
		};
		nome.addEventListener('input', () => nome.getAttribute('aria-invalid') && valida());
		tel.addEventListener('input', () => tel.getAttribute('aria-invalid') && valida());

		// il problema scelto sopra precompila il modulo
		addEventListener('sifone:problema', (e) => {
			const id = (e as CustomEvent).detail?.id;
			const sel = mod.elements.namedItem('problema') as HTMLSelectElement;
			if (id && [...sel.options].some((o) => o.value === id)) sel.value = id;
		});
		// anche la zona scelta sul manometro
		addEventListener('sifone:zona', (e) => {
			const id = (e as CustomEvent).detail?.id;
			const sel = mod.elements.namedItem('zona') as HTMLSelectElement;
			if (id && [...sel.options].some((o) => o.value === id)) sel.value = id;
		});

		mod.addEventListener('submit', (e) => {
			e.preventDefault();
			if (!valida()) {
				(nome.getAttribute('aria-invalid') ? nome : tel).focus();
				return;
			}
			const fd = new FormData(mod);
			const z = zone.find((x) => x.id === fd.get('zona'));
			const p = problemi.find((x) => x.id === fd.get('problema'));
			const urg = String(fd.get('urg'));
			const quando = urg === 'ora' ? 'Subito' : urg === 'oggi' ? 'Oggi' : 'Questa settimana';
			const set = (k: string, v: string) => (ricevuta.querySelector(k)!.textContent = v);
			set('[data-n]', `N° SF-${String(Math.floor(1000 + Math.random() * 9000))}`);
			set('[data-r-nome]', String(fd.get('nome')).trim());
			set('[data-r-zona]', z?.nome || '');
			set('[data-r-prob]', p?.nome || 'Altro');
			set('[data-r-urg]', quando);
			set(
				'[data-r-eta]',
				urg === 'ora' ? `Ti richiamiamo entro 10 minuti. Il tecnico può essere da te in circa ${z?.minuti ?? 30} minuti.` : 'Ti richiamiamo per fissare l’orario che preferisci.',
			);
			mod.hidden = true;
			ricevuta.hidden = false;
			ricevuta.focus({ preventScroll: true });
			ricevuta.scrollIntoView({ block: 'center', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
		});
		ricevuta.querySelector('[data-nuovo]')!.addEventListener('click', () => {
			mod.reset();
			mod.hidden = false;
			ricevuta.hidden = true;
			nome.focus();
		});
	}
</script>

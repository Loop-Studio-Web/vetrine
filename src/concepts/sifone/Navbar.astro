---
import simbolo from '../../assets/sifone/brand/simbolo.svg';
import marchio from '../../assets/sifone/brand/marchio-bianco.svg';
import { TEL, TEL_VISIBILE } from './dati';

const voci = [
	{ t: 'Che problema hai', href: '#problema' },
	{ t: 'Zone e tempi', href: '#zone' },
	{ t: 'Tariffe', href: '#tariffe' },
	{ t: 'Contatti', href: '#richiesta' },
];
---

<header class="nav" data-nav>
	<div class="nav__in">
		<a class="nav__logo" href="#top">
			<img src={simbolo.src} alt="" width="44" height="42" />
			<img class="nav__marchio" src={marchio.src} alt="" width="86" height="28" />
			<span class="sr-only">Sifone, torna in cima</span>
		</a>
		<nav class="nav__links" aria-label="Sezioni della pagina">
			{voci.map((v) => <a href={v.href} data-voce={v.href.slice(1)}>{v.t}</a>)}
		</nav>
		<div class="nav__az">
			<a class="nav__tel" href={`tel:${TEL}`}>
				<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
					><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"></path></svg
				>
				<span>{TEL_VISIBILE}</span>
				<span class="sr-only nav__tel-sr">Chiama</span>
			</a>
			<button class="nav__burger" type="button" aria-expanded="false" aria-controls="menu" data-burger>
				<span class="nav__burger-t">Menu</span>
				<span class="nav__tubi" aria-hidden="true"><i></i><i></i><i></i></span>
			</button>
		</div>
	</div>
</header>

<!-- menù mobile, fuori dall'header: una serranda che scende dall'alto, con la maniglia in fondo -->
<div class="menu" id="menu" data-menu role="dialog" aria-modal="true" aria-label="Menu" hidden>
	<div class="menu__top">
		<a class="menu__logo" href="#top">
			<img src={simbolo.src} alt="" width="44" height="42" />
			<img class="menu__marchio" src={marchio.src} alt="" width="86" height="28" />
			<span class="sr-only">Sifone, torna in cima</span>
		</a>
		<button class="menu__x" type="button" data-chiudi aria-label="Chiudi il menu">
			<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" /></svg>
		</button>
	</div>
	<nav class="menu__nav" aria-label="Sezioni della pagina">
		{
			voci.map((v, i) => (
				<a href={v.href} style={`--i:${i}`}>
					<span class="menu__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
					<span class="menu__t">{v.t}</span>
				</a>
			))
		}
	</nav>
	<a class="menu__tel" href={`tel:${TEL}`} style={`--i:${voci.length}`}>
		<span class="menu__tel-l">Pronto intervento 24 ore</span>
		<span class="menu__tel-n">{TEL_VISIBILE}</span>
	</a>
	<p class="menu__nota">Vetrina dimostrativa di Loop Studio</p>
	<span class="menu__maniglia" aria-hidden="true"></span>
</div>

<style>
	.nav {
		position: fixed;
		top: var(--fascia, 0px);
		left: 0;
		right: 0;
		z-index: 140;
		height: var(--nav-h);
		background: var(--petrolio);
		color: #f3efe3;
		border-bottom: 1px solid rgba(221, 122, 74, 0.55);
	}
	.nav__in {
		height: 100%;
		max-width: calc(var(--max) + var(--gutter) * 2);
		margin-inline: auto;
		padding-inline: var(--gutter);
		display: flex;
		align-items: center;
		gap: 24px;
	}
	.nav__logo {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		text-decoration: none;
		flex: none;
	}
	.nav__logo img:first-child {
		width: 44px;
		height: auto;
		transition: transform 0.4s cubic-bezier(0.3, 1.6, 0.5, 1);
	}
	.nav__logo:hover img:first-child {
		transform: rotate(-6deg) scale(1.06);
	}
	.nav__logo img.nav__marchio {
		height: 24px;
		width: auto;
	}
	.nav__links {
		display: flex;
		gap: 4px;
		margin-left: auto;
	}
	.nav__links a {
		position: relative;
		padding: 8px 14px;
		text-decoration: none;
		font-family: var(--testo);
		font-weight: 700;
		font-size: 0.87rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}
	.nav__links a::after {
		content: '';
		position: absolute;
		left: 14px;
		right: 14px;
		bottom: 2px;
		height: 4px;
		background: var(--rame);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.25s;
	}
	.nav__links a:hover::after,
	.nav__links a.is-attiva::after {
		transform: scaleX(1);
	}
	.nav__az {
		display: flex;
		align-items: center;
		gap: 12px;
	}
	.nav__tel {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 42px;
		padding: 0 16px;
		background: var(--rame);
		color: var(--notte);
		text-decoration: none;
		font-family: var(--titoli);
		font-weight: 400;
		font-size: 1.15rem;
		letter-spacing: 0.06em;
	}
	.nav__tel:hover {
		background: #e88a5a;
	}
	.nav__burger {
		display: none;
		align-items: center;
		gap: 10px;
		min-height: 42px;
		padding: 0 12px 0 14px;
		border: 2px solid var(--rame);
		background: transparent;
		color: var(--rame);
		font-family: var(--testo);
		font-weight: 700;
		font-size: 0.82rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}
	.nav__tubi {
		display: grid;
		gap: 4px;
		width: 22px;
	}
	.nav__tubi i {
		height: 4px;
		background: currentColor;
	}
	.nav__tubi i:nth-child(2) {
		width: 70%;
		transition: width 0.3s;
	}
	.nav__burger:hover .nav__tubi i:nth-child(2) {
		width: 100%;
	}

	/* serranda: assi orizzontali sul fondo scuro */
	.menu {
		position: fixed;
		inset: 0;
		height: 100vh;
		height: 100lvh;
		min-height: 100%;
		z-index: 160;
		display: flex;
		flex-direction: column;
		overflow-y: auto;
		padding: 100px var(--gutter) 40px;
		color: #fff;
		background: repeating-linear-gradient(to bottom, #145159 0 62px, #0c3338 62px 66px);
		border-bottom: 10px solid var(--rame);
		transform: translateY(-102%);
		transition: transform 0.7s cubic-bezier(0.7, 0, 0.2, 1);
	}
	.menu.is-open {
		transform: none;
	}
	.menu[hidden] {
		display: none;
	}
	.menu__top {
		position: absolute;
		top: 14px;
		left: var(--gutter);
		right: var(--gutter);
		height: 62px;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.menu__logo {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		text-decoration: none;
	}
	.menu__logo img:first-child {
		width: 44px;
		height: auto;
	}
	.menu__logo img.menu__marchio {
		height: 24px;
		width: auto;
	}
	.menu__x {
		display: grid;
		place-items: center;
		width: 48px;
		height: 48px;
		border: 3px solid var(--rame);
		background: var(--notte);
		color: var(--rame);
		transition: background 0.2s, color 0.2s;
	}
	.menu__x:hover,
	.menu__x:focus-visible {
		background: var(--rame);
		color: var(--notte);
	}
	.menu__nav {
		display: grid;
		gap: 6px;
	}
	.menu__nav a,
	.menu__tel {
		opacity: 0;
		transform: translateY(18px);
		transition: opacity 0.4s, transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
	}
	.menu__nav a {
		display: flex;
		align-items: baseline;
		gap: 16px;
		padding: 8px 14px;
		margin-inline: -14px;
		background: rgba(8, 33, 42, 0.0);
		text-decoration: none;
		font-family: var(--titoli);
		font-size: clamp(2.6rem, 13vw, 4.2rem);
		font-weight: 400;
		line-height: 1;
		text-transform: none;
		letter-spacing: -0.01em;
		color: #fff;
		width: fit-content;
	}
	.menu.is-open .menu__nav a,
	.menu.is-open .menu__tel {
		opacity: 1;
		transform: none;
		transition-delay: calc(var(--i) * 70ms + 350ms);
	}
	.menu__nav a:hover,
	.menu__nav a:focus-visible {
		color: var(--rame);
	}
	.menu__n {
		font-family: var(--testo);
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		color: var(--rame);
	}
	.menu__tel {
		display: grid;
		gap: 2px;
		margin-top: 26px;
		padding: 16px 20px;
		background: var(--rame);
		color: var(--notte);
		text-decoration: none;
		border: 3px solid var(--notte);
		box-shadow: 6px 6px 0 var(--notte);
	}
	.menu__tel-l {
		font-weight: 700;
		font-size: 0.82rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}
	.menu__tel-n {
		font-family: var(--titoli);
		font-weight: 400;
		font-size: 2.3rem;
		line-height: 1;
	}
	.menu__nota {
		margin-top: 22px;
		padding: 4px 8px;
		width: fit-content;
		background: rgba(17, 17, 17, 0.82);
		font-size: 0.85rem;
		color: #d7d3c6;
	}
	.menu__maniglia {
		position: absolute;
		left: 50%;
		bottom: -2px;
		width: 90px;
		height: 12px;
		margin-left: -45px;
		background: var(--notte);
		border: 3px solid var(--rame);
		border-bottom: 0;
	}
	@media (max-width: 1020px) {
		.nav__links,
		.nav__tel > span:not(.sr-only) {
			display: none;
		}
		.nav__tel {
			padding: 0 12px;
		}
		.nav__az {
			margin-left: auto;
		}
		.nav__burger {
			display: inline-flex;
		}
	}
	@media (max-width: 380px) {
		.nav__burger-t,
		.nav__marchio {
			display: none;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.menu {
			transition: none;
		}
	}
</style>

<script>
	// ---- menù mobile ----
	const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
	const menu = document.querySelector<HTMLElement>('[data-menu]');
	if (burger && menu) {
		const chiudi = (rendiFocus = true) => {
			menu.classList.remove('is-open');
			burger.setAttribute('aria-expanded', 'false');
			document.body.classList.remove('menu-aperto');
			setTimeout(() => !menu.classList.contains('is-open') && (menu.hidden = true), 750);
			if (rendiFocus) burger.focus();
		};
		const apri = () => {
			menu.hidden = false;
			menu.getBoundingClientRect(); // forza il riflusso: la transizione parte
			menu.classList.add('is-open');
			burger.setAttribute('aria-expanded', 'true');
			document.body.classList.add('menu-aperto');
			menu.querySelector<HTMLElement>('.menu__nav a')?.focus({ preventScroll: true });
		};
		burger.addEventListener('click', () => (menu.classList.contains('is-open') ? chiudi() : apri()));
		menu.querySelector('[data-chiudi]')?.addEventListener('click', () => chiudi());
		menu.addEventListener('click', (e) => {
			if ((e.target as HTMLElement).closest('a')) chiudi(false);
		});
		addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && menu.classList.contains('is-open')) chiudi();
			if (e.key === 'Tab' && menu.classList.contains('is-open')) {
				const el = [...menu.querySelectorAll<HTMLElement>('a, button')];
				const i = el.indexOf(document.activeElement as HTMLElement);
				if (e.shiftKey && i <= 0) {
					e.preventDefault();
					el[el.length - 1].focus();
				} else if (!e.shiftKey && i === el.length - 1) {
					e.preventDefault();
					el[0].focus();
				}
			}
		});
		matchMedia('(min-width: 1021px)').addEventListener('change', (m) => m.matches && chiudi(false));
	}

	// ---- voce attiva ----
	const link = [...document.querySelectorAll<HTMLAnchorElement>('.nav__links a')];
	const sezioni = link.map((a) => document.getElementById(a.dataset.voce || '')).filter(Boolean) as HTMLElement[];
	const io = new IntersectionObserver(
		(voci) => {
			for (const v of voci) {
				if (!v.isIntersecting) continue;
				for (const a of link) a.classList.toggle('is-attiva', a.dataset.voce === v.target.id);
			}
		},
		{ rootMargin: '-45% 0px -50% 0px' },
	);
	sezioni.forEach((s) => io.observe(s));
</script>

---
import { Image } from 'astro:assets';
import rame from '../../assets/sifone/foto/rame.jpg';
import { TEL, TEL_VISIBILE } from './dati';
---

<section class="ing sez" id="top" data-sez>
	<div class="ing__in">
		<div class="ing__testo">
			<p class="insegna ing__insegna">Pronto intervento · notte e giorno</p>
			<h1>
				Perde. Scarica. <br />Si ferma.
				<span class="ing__noi">Arriviamo noi<svg viewBox="0 0 320 18" aria-hidden="true" preserveAspectRatio="none"><path d="M3 11c34-9 62 7 98-1s64-8 96-1 70 5 120-3" /></svg></span>
			</h1>
			<p class="ing__lead">
				Prima ti diciamo cosa fare per limitare i danni, poi il prezzo, poi arriviamo. Idraulico di quartiere dal 1974: tre furgoni, sei tecnici, fattura sempre.
			</p>
			<ul class="ing__fatti" role="list">
				<li><b>25′</b> arrivo medio in città</li>
				<li><b>24/7</b> anche notte e festivi</li>
				<li><b>12 mesi</b> di garanzia sul lavoro</li>
			</ul>
		</div>

		<div class="ing__banco">
			<div class="ing__arco foto">
				<Image src={rame} alt="Due tubi di rame appena posati dentro una parete aperta, tra le travi di legno." widths={[480, 720, 1000]} sizes="(max-width: 900px) 90vw, 480px" loading="eager" fetchpriority="high" />
			</div>
			<button class="valvola" type="button" data-valvola aria-pressed="false" aria-describedby="valvola-stato">
				<svg viewBox="0 0 380 430" aria-hidden="true" focusable="false">
					<defs>
						<linearGradient id="v-rame" x1="0" y1="0" x2="0" y2="1">
							<stop offset="0" stop-color="#f0a37a" /><stop offset=".45" stop-color="#c8693a" /><stop offset="1" stop-color="#8a3f1c" />
						</linearGradient>
						<linearGradient id="v-ottone" x1="0" y1="0" x2="1" y2="0">
							<stop offset="0" stop-color="#9c7425" /><stop offset=".35" stop-color="#e6bd62" /><stop offset=".7" stop-color="#c09132" /><stop offset="1" stop-color="#7e5d1b" />
						</linearGradient>
					</defs>
					<!-- tubo di rame orizzontale con l'acqua che scorre quando si apre -->
					<rect x="0" y="292" width="380" height="64" fill="url(#v-rame)" />
					<rect x="0" y="300" width="380" height="8" fill="#fff" opacity=".28" />
					<rect class="valvola__acqua" x="0" y="330" width="380" height="14" />
					<rect x="66" y="284" width="30" height="80" rx="3" fill="url(#v-ottone)" /><rect x="284" y="284" width="30" height="80" rx="3" fill="url(#v-ottone)" />
					<!-- corpo valvola in ottone -->
					<path d="M112 262h156v112H112z" fill="url(#v-ottone)" />
					<path d="M112 374h156l-20 30H132z" fill="#8a6620" />
					<path d="M112 262h156" stroke="#f6dd9a" stroke-width="3" />
					<circle cx="190" cy="318" r="10" fill="#4d3a10" /><circle cx="130" cy="282" r="5" fill="#4d3a10" /><circle cx="250" cy="282" r="5" fill="#4d3a10" /><circle cx="130" cy="354" r="5" fill="#4d3a10" /><circle cx="250" cy="354" r="5" fill="#4d3a10" />
					<!-- stelo -->
					<rect x="178" y="170" width="24" height="96" fill="url(#v-ottone)" />
					<!-- volantino: rosso minio, come quelli veri -->
					<g class="valvola__ruota" data-ruota>
						<circle cx="190" cy="130" r="106" fill="none" stroke="#7d1f12" stroke-width="26" />
						<circle cx="190" cy="130" r="106" fill="none" stroke="#d8412a" stroke-width="18" />
						<g stroke="#7d1f12" stroke-width="22"><path d="M190 24v212M98 77l184 106M98 183L282 77" /></g>
						<g stroke="#d8412a" stroke-width="13"><path d="M190 24v212M98 77l184 106M98 183L282 77" /></g>
						<circle cx="190" cy="130" r="28" fill="#7d1f12" /><circle cx="190" cy="130" r="13" fill="#efe9dc" />
						<path d="M190 20l-13 17h26z" fill="#efe9dc" />
					</g>
					<!-- gocce quando la valvola è aperta -->
					<g class="valvola__gocce" fill="#34b3a8">
						<path d="M330 372c-8 12-8 20 0 20s8-8 0-20z" /><path d="M356 372c-8 12-8 20 0 20s8-8 0-20z" style="animation-delay:.4s" />
					</g>
				</svg>
				<span class="valvola__guida insegna" data-guida>Gira il volantino <span aria-hidden="true">↻</span></span>
			</button>
			<div class="ing__stato" id="valvola-stato" aria-live="polite" data-stato>
				<p class="ing__chiusa">Valvola chiusa. Gira il volantino (o premilo) per aprire l’emergenza.</p>
				<div class="ing__aperta" hidden>
					<p class="ing__eta"><b>Tecnico libero a 20 minuti</b> da te. Nessuna attesa in coda, rispondiamo noi.</p>
					<div class="ing__azioni">
						<a class="btn" href={`tel:${TEL}`}>Chiama {TEL_VISIBILE}</a>
						<a class="btn btn--nero" href="#problema">Dimmi cosa succede</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.ing {
		padding-top: calc(var(--fascia-h) + var(--nav-h) + clamp(40px, 6vw, 84px));
		padding-bottom: clamp(56px, 8vw, 110px);
		background: var(--calce);
		overflow: hidden;
	}
	.ing::before {
		/* una macchia d'acqua sul muro, in alto a sinistra */
		content: '';
		position: absolute;
		left: -12%;
		top: -20%;
		width: 70%;
		aspect-ratio: 1;
		border-radius: 50%;
		background: radial-gradient(circle, rgba(143, 224, 214, 0.28), transparent 62%);
		pointer-events: none;
	}
	.ing__in {
		position: relative;
		max-width: var(--max);
		margin-inline: auto;
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
		gap: clamp(28px, 5vw, 72px);
		align-items: start;
	}
	.ing__insegna {
		margin-bottom: 26px;
	}
	h1 {
		font-size: clamp(2.9rem, 6.4vw, 5.6rem);
		line-height: 0.96;
		letter-spacing: -0.025em;
	}
	.ing__noi {
		white-space: nowrap;
		position: relative;
		display: inline-block;
		margin-top: 10px;
		color: var(--rame-testo);
	}
	.ing__noi svg {
		position: absolute;
		left: 0;
		right: 0;
		bottom: -0.12em;
		width: 100%;
		height: 0.2em;
		overflow: visible;
	}
	.ing__noi path {
		fill: none;
		stroke: var(--rame);
		stroke-width: 5;
		stroke-linecap: round;
		vector-effect: non-scaling-stroke;
	}
	.ing__lead {
		margin-top: 34px;
		max-width: 44ch;
		font-size: 1.25rem;
		color: var(--testo-2);
	}
	.ing__fatti {
		display: flex;
		flex-wrap: wrap;
		gap: 14px 34px;
		margin-top: 34px;
		padding-top: 22px;
		border-top: 1px solid var(--riga);
		font-weight: 600;
	}
	.ing__fatti li {
		display: flex;
		align-items: baseline;
		gap: 10px;
	}
	.ing__fatti b {
		font-family: var(--titoli);
		font-weight: 400;
		font-size: 2.3rem;
		line-height: 1;
		color: var(--petrolio);
	}

	.ing__banco {
		position: relative;
		display: grid;
		gap: 0;
		justify-items: center;
		padding-top: 24px;
	}
	/* la foto è un arco, come l'ingresso di una bottega; i tubi di rame sono veri */
	.ing__arco {
		width: min(100%, 440px);
		aspect-ratio: 4 / 5.2;
		border-radius: 999px 999px 6px 6px;
		box-shadow: 0 30px 50px -28px rgba(8, 33, 42, 0.6);
		transform: rotate(1.2deg);
	}
	.valvola {
		position: relative;
		display: block;
		width: min(78%, 330px);
		margin-top: -150px;
		padding: 0;
		border: 0;
		background: none;
		touch-action: pan-y;
		-webkit-tap-highlight-color: transparent;
		user-select: none;
		filter: drop-shadow(0 14px 14px rgba(8, 33, 42, 0.45));
	}
	.valvola svg {
		width: 100%;
		height: auto;
		overflow: visible;
	}
	.valvola__ruota {
		transform-origin: 190px 130px;
		transition: transform 0.9s cubic-bezier(0.3, 1.1, 0.4, 1);
		cursor: grab;
	}
	.valvola.is-trascina .valvola__ruota {
		transition: none;
		cursor: grabbing;
	}
	.valvola__acqua {
		fill: var(--acqua);
		opacity: 0;
		transition: opacity 0.5s;
	}
	.valvola.is-aperta .valvola__acqua {
		opacity: 1;
		animation: val-scorre 0.6s linear infinite;
		stroke: #bff2ec;
		stroke-width: 3;
		stroke-dasharray: 36 24;
	}
	@keyframes val-scorre {
		to {
			stroke-dashoffset: -60;
		}
	}
	.valvola__gocce path {
		opacity: 0;
	}
	.valvola.is-aperta .valvola__gocce path {
		opacity: 1;
		animation: val-goccia 1s ease-in infinite;
	}
	@keyframes val-goccia {
		0% {
			transform: translateY(0);
			opacity: 1;
		}
		100% {
			transform: translateY(34px);
			opacity: 0;
		}
	}
	.valvola__guida {
		position: absolute;
		left: 50%;
		top: 18px;
		transform: translateX(-50%) rotate(-1.6deg);
		white-space: nowrap;
		transition: opacity 0.3s;
		pointer-events: none;
	}
	.valvola.is-usata .valvola__guida {
		opacity: 0;
	}
	.valvola:not(.is-usata) .valvola__ruota {
		animation: val-invito 3.2s ease-in-out 1.2s infinite;
	}
	@keyframes val-invito {
		0%,
		70%,
		100% {
			transform: rotate(0);
		}
		82% {
			transform: rotate(-24deg);
		}
		92% {
			transform: rotate(14deg);
		}
	}
	.valvola:focus-visible {
		outline-offset: 8px;
	}

	.ing__stato {
		width: 100%;
		max-width: 440px;
		min-height: 138px;
		margin-top: 16px;
		padding: 18px 22px;
		border-radius: 4px 18px 4px 18px;
		background: var(--bianco);
		box-shadow: 0 18px 30px -22px rgba(8, 33, 42, 0.55), inset 0 0 0 1px var(--riga);
		transition: background 0.4s;
	}
	.ing__stato.is-aperta {
		background: var(--rame);
		box-shadow: 0 18px 30px -22px rgba(8, 33, 42, 0.55);
	}
	.ing__chiusa {
		color: var(--testo-2);
		font-weight: 500;
	}
	.ing__eta {
		font-size: 1.1rem;
	}
	.ing__azioni {
		display: grid;
		gap: 12px;
		margin-top: 14px;
	}
	.ing__azioni .btn {
		min-height: 48px;
		font-size: 1.05rem;
	}
	.ing__azioni .btn:first-child {
		background: var(--notte);
		color: var(--calce);
	}
	.ing__azioni .btn--nero {
		background: transparent;
		color: var(--notte);
		box-shadow: inset 0 0 0 2px var(--notte);
	}

	@media (max-width: 900px) {
		.ing__in {
			grid-template-columns: minmax(0, 1fr);
		}
		.ing__banco {
			margin-top: 12px;
		}
		.ing__arco {
			aspect-ratio: 4 / 4.2;
		}
		.valvola {
			margin-top: -120px;
		}
	}
	@media (max-width: 560px) {
		.ing__fatti {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 10px;
			font-size: 0.88rem;
			line-height: 1.2;
		}
		.ing__fatti li {
			display: grid;
			gap: 2px;
		}
		.ing__fatti b {
			font-size: 1.9rem;
		}
		.ing__lead {
			margin-top: 24px;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.valvola:not(.is-usata) .valvola__ruota {
			animation: none;
		}
	}
</style>

<script>
	const valvola = document.querySelector<HTMLButtonElement>('[data-valvola]');
	const ruota = document.querySelector<SVGGElement>('[data-ruota]');
	const stato = document.querySelector<HTMLElement>('[data-stato]');
	if (valvola && ruota && stato) {
		const chiusa = stato.querySelector<HTMLElement>('.ing__chiusa')!;
		const aperta = stato.querySelector<HTMLElement>('.ing__aperta')!;
		const GIRO_MAX = 540; // un giro e mezzo
		let gradi = 0;
		let aperto = false;
		let trascina = false;
		let mosso = false;
		let ultimo = 0;
		let acc = 0;

		const mostra = (g: number, apri = aperto) => {
			ruota.style.transform = `rotate(${g}deg)`;
			aperto = apri;
			valvola.classList.toggle('is-aperta', apri);
			valvola.setAttribute('aria-pressed', String(apri));
			stato.classList.toggle('is-aperta', apri);
			chiusa.hidden = apri;
			aperta.hidden = !apri;
		};
		const angolo = (e: PointerEvent) => {
			const r = ruota.getBoundingClientRect();
			return (Math.atan2(e.clientY - (r.top + r.height / 2), e.clientX - (r.left + r.width / 2)) * 180) / Math.PI;
		};

		valvola.addEventListener('pointerdown', (e) => {
			const r = ruota.getBoundingClientRect();
			// si trascina solo prendendo il volantino
			if (Math.hypot(e.clientX - (r.left + r.width / 2), e.clientY - (r.top + r.height / 2)) > r.width / 2 + 6) return;
			trascina = true;
			mosso = false;
			acc = gradi;
			ultimo = angolo(e);
			valvola.setPointerCapture(e.pointerId);
		});
		valvola.addEventListener('pointermove', (e) => {
			if (!trascina) return;
			const a = angolo(e);
			let d = a - ultimo;
			if (d > 180) d -= 360;
			if (d < -180) d += 360;
			ultimo = a;
			if (Math.abs(d) > 0.3) mosso = true;
			if (!mosso) return;
			valvola.classList.add('is-trascina', 'is-usata');
			acc = Math.max(0, Math.min(GIRO_MAX, acc + d));
			mostra(acc, acc >= GIRO_MAX * 0.5);
		});
		const rilascia = () => {
			if (!trascina) return;
			trascina = false;
			valvola.classList.remove('is-trascina');
			if (mosso) {
				gradi = acc >= GIRO_MAX * 0.5 ? GIRO_MAX : 0;
				mostra(gradi, gradi > 0);
			}
		};
		valvola.addEventListener('pointerup', rilascia);
		valvola.addEventListener('pointercancel', rilascia);

		// tocco semplice, Invio o Spazio: apre e chiude
		valvola.addEventListener('click', () => {
			if (mosso) {
				mosso = false;
				return;
			}
			valvola.classList.add('is-usata');
			gradi = aperto ? 0 : GIRO_MAX;
			mostra(gradi, !aperto);
		});
	}
</script>

---
import { Image } from 'astro:assets';
import { PASOS, PREGUNTAS } from './datos';
import logo3d from '../../assets/malahierba/brand/logo-3d.png';
---

<section class="ped" id="pedir" aria-labelledby="ped-titulo">
	<div class="wrap ped__in">
		<div>
			<h2 id="ped-titulo" class="h2">Así de fácil es pedir.</h2>
			<ol class="ped__pasos">
				{
					PASOS.map((p) => (
						<li>
							<span class="ped__n" aria-hidden="true">{p.n}</span>
							<div>
								<h3>{p.t}</h3>
								<p>{p.d}</p>
							</div>
						</li>
					))
				}
			</ol>
			<Image src={logo3d} alt="Mala Hierba Flores" width={420} class="ped__firma" />
		</div>
		<div class="ped__faq">
			<h3 class="ped__faq-t">Lo que más nos preguntan</h3>
			{
				PREGUNTAS.map((p) => (
					<div class="ped__pregunta">
						<h4>{p.q}</h4>
						<p>{p.a}</p>
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	.ped {
		background: var(--papel);
		padding-block: clamp(56px, 8vw, 108px);
	}
	.ped__in {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
		gap: clamp(32px, 6vw, 88px);
		align-items: start;
	}
	.ped__pasos {
		margin-top: 32px;
		display: grid;
		gap: 26px;
	}
	.ped__pasos li {
		display: grid;
		grid-template-columns: 64px 1fr;
		gap: 18px;
		align-items: start;
	}
	.ped__n {
		font-family: var(--titulos);
		font-size: 3.4rem;
		line-height: 0.9;
		color: var(--fucsia);
	}
	.ped__pasos h3 {
		font-family: var(--texto);
		font-weight: 800;
		font-size: 1.25rem;
		line-height: 1.2;
	}
	.ped__pasos p {
		margin-top: 4px;
		max-width: 46ch;
	}
	.ped__firma {
		margin-top: 36px;
		width: min(340px, 80%);
		rotate: -2deg;
	}
	.ped__faq-t {
		font-size: 1.7rem;
		margin-bottom: 14px;
	}
	.ped__pregunta {
		border-top: 2px solid var(--tinta);
		padding: 16px 0 18px;
	}
	.ped__pregunta:last-child {
		border-bottom: 2px solid var(--tinta);
	}
	.ped__pregunta h4 {
		font-family: var(--texto);
		font-weight: 800;
		font-size: 1.08rem;
		line-height: 1.3;
	}
	.ped__pregunta p {
		margin-top: 6px;
		max-width: 52ch;
	}
	@media (max-width: 820px) {
		.ped__in {
			grid-template-columns: 1fr;
		}
	}
</style>

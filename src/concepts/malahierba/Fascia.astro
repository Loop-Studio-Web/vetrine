---
// Fascia de retorno: dice que es una vetrina dimostrativa y lleva al hub o al contacto. No es fija:
// se va con el scroll y la navbar, que le queda debajo, sube mientras tanto.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<aside class="fascia" data-fascia aria-label="Información sobre este escaparate">
	<p class="fascia__testo">Escaparate de demostración · <span class="fascia__studio">concepto de Loop Studio</span></p>
	<nav class="fascia__link" aria-label="Escaparates">
		<a href={`${base}/`}><span aria-hidden="true">←</span> Todos los escaparates</a>
		<a href="https://theloopstudio.org/contatti/?concept=malahierba" class="fascia__cta">Quiero una así <span aria-hidden="true">→</span></a>
	</nav>
</aside>

<style>
	.fascia {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		z-index: 150;
		height: var(--fascia-h);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding: 0 var(--gutter);
		background: var(--tinta);
		color: #f6e6ee;
		font-family: var(--texto);
		font-weight: 600;
		font-size: 0.8rem;
		letter-spacing: 0.03em;
		white-space: nowrap;
		border-bottom: 2px solid var(--fucsia-vivo);
	}
	.fascia__link {
		display: flex;
		gap: 22px;
	}
	.fascia a {
		display: inline-flex;
		align-items: center;
		height: var(--fascia-h);
		text-decoration: none;
		border-bottom: 1px solid transparent;
	}
	.fascia a:hover {
		border-bottom-color: var(--cempa);
	}
	.fascia__cta {
		color: var(--cempa);
	}
	@media (max-width: 640px) {
		.fascia {
			font-size: 0.875rem;
		}
		.fascia__link {
			gap: 14px;
		}
		.fascia__studio {
			display: none;
		}
	}
	@media (max-width: 480px) {
		.fascia__testo {
			display: none;
		}
		.fascia {
			justify-content: center;
		}
	}
</style>

<script>
	const fascia = document.querySelector<HTMLElement>('[data-fascia]');
	if (fascia) {
		let espera = false;
		const actualiza = () => {
			espera = false;
			document.documentElement.style.setProperty('--fascia', `${Math.max(0, fascia.offsetHeight - scrollY)}px`);
		};
		addEventListener(
			'scroll',
			() => {
				if (!espera) {
					espera = true;
					requestAnimationFrame(actualiza);
				}
			},
			{ passive: true },
		);
		addEventListener('resize', actualiza);
		actualiza();
	}
</script>

---
import { Image } from 'astro:assets';
import { papelPicado } from './papel';
import { TALLER } from './datos';
import ramos from '../../assets/malahierba/foto/ramos.jpg';

const papel = papelPicado(16, 7, ['#ff9a1f', '#12b5ad', '#ffc83d', '#ffffff', '#7a2e8e', '#ffc7dc']);
---

<section class="entrada" id="top" aria-labelledby="entrada-titulo">
	<div class="entrada__papel" set:html={papel}></div>
	<div class="wrap entrada__in">
		<div class="entrada__texto">
			<h1 id="entrada-titulo">Flores con carácter para las fechas que importan.</h1>
			<p class="entrada__lead">
				Ramos, centros de mesa y arcos para bodas, XV años, bautizos y despedidas. Los armamos a mano en el taller y los entregamos el mismo
				día en Guadalajara.
			</p>
			<div class="entrada__acciones">
				<a class="btn" href="#arma">Arma tu ramo</a>
				<a class="btn btn--linea entrada__wa" href={TALLER.whatsapp} target="_blank" rel="noopener"
					>Escríbenos por WhatsApp<span class="sr-only"> (se abre en una pestaña nueva)</span></a
				>
			</div>
			<p class="entrada__estado" data-estado aria-live="polite">Taller en Guadalajara, abierto de lunes a domingo.</p>
		</div>
		<figure class="entrada__foto">
			<Image
				src={ramos}
				alt="Ramos de flores mixtas envueltos en papel kraft, uno junto a otro"
				widths={[420, 640, 860]}
				sizes="(min-width: 900px) 440px, 78vw"
				loading="eager"
				fetchpriority="high"
				class="entrada__img"
			/>
			<figcaption class="entrada__cartel rotulo">
				<span>Ramo mediano, desde</span>
				<b>$780</b>
			</figcaption>
		</figure>
	</div>
</section>

<style>
	.entrada {
		position: relative;
		background: var(--fucsia);
		color: var(--blanco);
		padding-top: calc(var(--fascia-h) + var(--nav-h));
		overflow: clip;
	}
	.entrada__papel {
		margin-top: 18px;
	}
	@media (max-width: 700px) {
		.entrada__papel :global(svg) {
			width: 220%;
			max-width: none;
			margin-left: -60%;
		}
	}
	.entrada__in {
		display: grid;
		grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
		gap: clamp(28px, 5vw, 72px);
		align-items: center;
		padding-block: clamp(28px, 5vw, 64px) clamp(56px, 8vw, 104px);
	}
	h1 {
		font-size: clamp(2.5rem, 6vw, 4.9rem);
		line-height: 0.98;
		letter-spacing: -0.015em;
	}
	.entrada__lead {
		margin-top: 22px;
		font-size: clamp(1.08rem, 1.5vw, 1.25rem);
		max-width: 46ch;
	}
	.entrada__acciones {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin-top: 30px;
	}
	.entrada__wa {
		border-color: var(--blanco);
		color: var(--blanco);
	}
	@media (hover: hover) {
		.entrada__wa:hover {
			background: var(--blanco);
			color: var(--fucsia-osc);
		}
	}
	.entrada__estado {
		margin-top: 22px;
		font-weight: 600;
		font-size: 0.95rem;
		color: var(--blanco);
	}

	.entrada__foto {
		position: relative;
		justify-self: center;
		width: min(100%, 440px);
		rotate: 2.2deg;
	}
	/* El borde de abajo está "picado" como el papel de china */
	.entrada__img {
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		clip-path: polygon(
			0 0, 100% 0, 100% 93%,
			95.8% 100%, 91.6% 93%, 87.5% 100%, 83.3% 93%, 79.1% 100%, 75% 93%, 70.8% 100%, 66.6% 93%, 62.5% 100%, 58.3% 93%,
			54.1% 100%, 50% 93%, 45.8% 100%, 41.6% 93%, 37.5% 100%, 33.3% 93%, 29.1% 100%, 25% 93%, 20.8% 100%, 16.6% 93%,
			12.5% 100%, 8.3% 93%, 4.1% 100%, 0 93%
		);
	}
	.entrada__cartel {
		position: absolute;
		left: -9%;
		bottom: 11%;
		rotate: -5deg;
		display: grid;
		gap: 2px;
		background: var(--blanco);
		color: var(--tinta);
		padding: 14px 20px 12px;
		font-size: 1.15rem;
		text-align: center;
	}
	.entrada__cartel b {
		font-weight: 400;
		font-size: 2.1rem;
		line-height: 1;
		color: var(--fucsia);
	}
	.entrada__cartel::before {
		content: '';
		position: absolute;
		left: 50%;
		top: -11px;
		width: 66px;
		height: 22px;
		translate: -50% 0;
		rotate: 3deg;
		background: rgb(255 200 61 / 0.82);
	}
	@media (max-width: 820px) {
		.entrada__in {
			grid-template-columns: 1fr;
		}
		.entrada__foto {
			width: min(78%, 360px);
			margin-top: 8px;
		}
		.entrada__cartel {
			left: -6%;
		}
	}
</style>

<script>
	import { HORARIO, TALLER } from './datos';
	// "Abierto ahora" con la hora de México, no la del aparato.
	const ahora = () => {
		const p = new Intl.DateTimeFormat('en-US', { timeZone: TALLER.zona, weekday: 'short', hour: 'numeric', minute: 'numeric', hour12: false }).formatToParts(new Date());
		const g = (t: string) => p.find((x) => x.type === t)!.value;
		const dia = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(g('weekday'));
		return { dia, h: (parseInt(g('hour')) % 24) + parseInt(g('minute')) / 60 };
	};
	const el = document.querySelector<HTMLElement>('[data-estado]');
	if (el) {
		const { dia, h } = ahora();
		const hoy = HORARIO.find((x) => x.dias.includes(dia))!;
		const abierto = h >= hoy.abre && h < hoy.cierra;
		el.textContent = abierto
			? `Abierto ahora, hasta las ${hoy.cierra} h. Para entrega hoy, pide antes de las 14 h.`
			: h < hoy.abre
				? `Cerrado ahora. Hoy abrimos a las ${hoy.abre} h y el WhatsApp lo leemos en cuanto abrimos.`
				: 'Cerrado ahora. Abrimos mañana temprano y el WhatsApp lo leemos en cuanto abrimos.';
	}
</script>

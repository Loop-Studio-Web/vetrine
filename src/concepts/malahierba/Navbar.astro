---
import Simbolo from './Simbolo.astro';
import { papelPicado } from './papel';
import { TALLER } from './datos';

const papelMenu = papelPicado(9, 41);
const enlaces = [
	{ href: '#ocasiones', t: 'Ocasiones' },
	{ href: '#muertos', t: 'Día de Muertos' },
	{ href: '#arma', t: 'Arma tu ramo' },
	{ href: '#montajes', t: 'Montajes' },
	{ href: '#visita', t: 'Visítanos' },
];
---

<header class="nav" data-nav>
	<div class="nav__in">
		<a class="nav__marca" href="#top" aria-label="Mala Hierba Flores, inicio">
			<Simbolo tam={40} class="nav__simbolo" />
			<span class="nav__nombre">Mala Hierba</span>
		</a>
		<nav class="nav__links" aria-label="Principal">
			{enlaces.slice(0, 5).map((e) => <a href={e.href}>{e.t}</a>)}
		</nav>
		<a class="btn btn--fucsia nav__wa" href={TALLER.whatsapp} target="_blank" rel="noopener">WhatsApp<span class="sr-only"> (se abre en una pestaña nueva)</span></a>
		<button class="nav__burger" type="button" aria-expanded="false" aria-controls="menu" data-abrir>
			<span class="sr-only">Abrir el menú</span>
			<span class="nav__barras" aria-hidden="true"><i></i><i></i><i></i></span>
		</button>
	</div>
</header>

<div class="menu" id="menu" role="dialog" aria-label="Menú" aria-hidden="true" inert data-menu>
	<div class="menu__cabeza">
		<span class="menu__nombre"><Simbolo tam={40} class="menu__simbolo" flor="#ffffff" centro="#ffc83d" hoja="#9bd1a8" hoja2="#cfe8d5" /> Mala Hierba</span>
		<button class="menu__x" type="button" data-cerrar>
			<span class="sr-only">Cerrar el menú</span>
			<svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M4 4l16 16M20 4L4 20" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path></svg>
		</button>
	</div>
	<nav class="menu__links" aria-label="Menú móvil">
		{enlaces.map((e, i) => <a href={e.href} style={`--i:${i}`} data-cerrar>{e.t}</a>)}
		<a class="menu__wa" href={TALLER.whatsapp} target="_blank" rel="noopener" style="--i:5">Escríbenos por WhatsApp<span class="sr-only"> (se abre en una pestaña nueva)</span></a>
	</nav>
	<div class="menu__papel" set:html={papelMenu}></div>
</div>

<style>
	.nav {
		position: fixed;
		top: var(--fascia, 0px);
		left: 0;
		right: 0;
		z-index: 120;
		height: var(--nav-h);
		background: var(--papel);
		color: var(--tinta);
	}
	.nav::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		top: 100%;
		height: 7px;
		background:
			linear-gradient(135deg, var(--papel) 50%, transparent 50%) 0 0 / 14px 7px,
			linear-gradient(225deg, var(--papel) 50%, transparent 50%) 0 0 / 14px 7px;
		background-repeat: repeat-x;
		pointer-events: none;
	}
	.nav__in {
		max-width: var(--max);
		height: 100%;
		margin-inline: auto;
		padding-inline: var(--gutter);
		display: flex;
		align-items: center;
		gap: 28px;
	}
	.nav__marca {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		text-decoration: none;
		margin-right: auto;
		min-height: 44px;
	}
	.nav__simbolo {
		width: 40px;
		height: 40px;
		flex: none;
	}
	.nav__nombre {
		font-family: var(--titulos);
		font-size: 1.5rem;
		line-height: 1;
		color: var(--fucsia);
		white-space: nowrap;
	}
	.nav__links {
		display: flex;
		gap: 26px;
		font-weight: 700;
		font-size: 0.95rem;
	}
	.nav__links a {
		text-decoration: none;
		padding: 6px 0;
		border-bottom: 2px solid transparent;
		transition: border-color 160ms var(--ease);
	}
	.nav__links a:hover {
		border-bottom-color: var(--fucsia);
	}
	.nav__wa {
		min-height: 44px;
		padding: 0 20px;
		font-size: 0.95rem;
	}
	.nav__burger {
		display: none;
		width: 48px;
		height: 48px;
		border: 0;
		background: transparent;
		border-radius: 50%;
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
	}
	.nav__barras {
		display: grid;
		gap: 6px;
		width: 26px;
		margin: auto;
	}
	.nav__barras i {
		display: block;
		height: 3px;
		border-radius: 3px;
		background: var(--tinta);
	}
	.nav__barras i:nth-child(2) {
		width: 70%;
		justify-self: end;
		background: var(--fucsia);
	}

	/* Menú móvil: una cortina de papel picado que baja desde arriba */
	.menu {
		position: fixed;
		inset: 0;
		z-index: 300;
		height: 100lvh;
		background: var(--fucsia);
		color: var(--blanco);
		display: flex;
		flex-direction: column;
		transform: translateY(-102%);
		visibility: hidden;
		transition:
			transform 420ms var(--ease),
			visibility 0s linear 420ms;
		overflow-y: auto;
	}
	.menu.is-open {
		transform: none;
		visibility: visible;
		transition:
			transform 420ms var(--ease),
			visibility 0s;
	}
	.menu__cabeza {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 14px var(--gutter);
		height: var(--nav-h);
		flex: none;
	}
	.menu__nombre {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		font-family: var(--titulos);
		font-size: 1.5rem;
	}
	.menu__simbolo {
		width: 40px;
		height: 40px;
	}
	.menu__x {
		width: 52px;
		height: 52px;
		border-radius: 50%;
		border: 2px solid var(--blanco);
		background: transparent;
		color: var(--blanco);
		display: grid;
		place-items: center;
		cursor: pointer;
	}
	.menu__links {
		display: grid;
		padding: 8px var(--gutter) 24px;
		gap: 2px;
	}
	.menu__links a {
		font-family: var(--titulos);
		font-size: clamp(2.2rem, 11vw, 3.4rem);
		line-height: 1.1;
		text-decoration: none;
		padding: 6px 0;
		opacity: 0;
		transform: translateY(14px);
		transition:
			opacity 300ms var(--ease) calc(120ms + var(--i) * 45ms),
			transform 360ms var(--ease) calc(120ms + var(--i) * 45ms);
	}
	.menu.is-open .menu__links a {
		opacity: 1;
		transform: none;
	}
	.menu__links a.menu__wa {
		font-family: var(--texto);
		font-weight: 800;
		font-size: 1.05rem;
		margin-top: 18px;
		justify-self: start;
		background: var(--cempa);
		color: var(--tinta);
		border-radius: 999px;
		padding: 14px 24px;
	}
	.menu__papel {
		margin-top: auto;
		padding-top: 12px;
	}
	.menu__papel :global(svg) {
		width: 130%;
		max-width: none;
		margin-left: -15%;
	}

	@media (max-width: 900px) {
		.nav__links,
		.nav__wa {
			display: none;
		}
		.nav__burger {
			display: block;
		}
	}
	@media (min-width: 901px) {
		.menu {
			display: none;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.menu,
		.menu__links a {
			transition: none;
			transform: none;
			opacity: 1;
		}
		.menu {
			transform: translateY(-102%);
		}
		.menu.is-open {
			transform: none;
		}
	}
</style>

<script>
	const menu = document.querySelector<HTMLElement>('[data-menu]');
	const abrir = document.querySelector<HTMLButtonElement>('[data-abrir]');
	if (menu && abrir) {
		const cerrar = () => {
			menu.classList.remove('is-open');
			menu.setAttribute('aria-hidden', 'true');
			menu.setAttribute('inert', '');
			abrir.setAttribute('aria-expanded', 'false');
			document.body.classList.remove('menu-abierto');
		};
		const abre = () => {
			menu.classList.add('is-open');
			menu.removeAttribute('inert');
			menu.setAttribute('aria-hidden', 'false');
			abrir.setAttribute('aria-expanded', 'true');
			document.body.classList.add('menu-abierto');
			menu.querySelector<HTMLElement>('[data-cerrar]')?.focus();
		};
		abrir.addEventListener('click', abre);
		menu.querySelectorAll('[data-cerrar]').forEach((b) =>
			b.addEventListener('click', () => {
				cerrar();
				abrir.focus({ preventScroll: true });
			}),
		);
		addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && menu.classList.contains('is-open')) {
				cerrar();
				abrir.focus();
			}
		});
		matchMedia('(min-width: 901px)').addEventListener('change', (m) => m.matches && cerrar());
	}
</script>

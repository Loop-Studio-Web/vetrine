---
const motivi = [
	{
		t: 'Diagnosi chiara',
		d: 'Prima guardiamo, poi ti diciamo cos’ha. Senza gergo, senza far sentire nessuno ignorante.',
		i: '<circle cx="11" cy="11" r="6.5"/><path d="M16 16l5 5"/>',
	},
	{
		t: 'Assistenza locale',
		d: 'Una persona vera dietro il banco, a pochi passi da casa. Se serve, ci passi due volte.',
		i: '<path d="M12 21s7-6 7-11.5A7 7 0 0 0 5 9.5C5 15 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>',
	},
	{
		t: 'Tempi rapidi',
		d: 'Molte riparazioni si fanno mentre aspetti. Per le altre ti diamo un giorno, non un “vedremo”.',
		i: '<circle cx="12" cy="13" r="8"/><path d="M12 8v5l3 2M9.5 2.5h5"/>',
	},
	{
		t: 'Garanzia sulla riparazione',
		d: 'Sul pezzo sostituito e sul lavoro. Se qualcosa non va, torni e lo sistemiamo.',
		i: '<path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/>',
	},
];
const recensioni = [
	{ n: 'Marta R.', c: 'Studentessa', t: 'Mi hanno cambiato la batteria mentre prendevo un caffè. Prezzo detto prima, nessuna sorpresa.' },
	{ n: 'Davide L.', c: 'Libero professionista', t: 'Il PC era lentissimo. Con un SSD nuovo sembra un altro e mi hanno spiegato cosa avevano fatto, passo passo.' },
	{ n: 'Giulia B.', c: 'Mamma di due gamer', t: 'La console non dava immagine. Preventivo chiaro, riparata in tre giorni, e la prova l’hanno fatta davanti a me.' },
	{ n: 'Paolo S.', c: 'Piccolo negozio', t: 'Mi hanno recuperato i dati del vecchio disco. Mi hanno detto prima quante possibilità c’erano: onesti.' },
];
---

<section class="fiducia" id="perche" aria-labelledby="fiducia-titolo">
	<div class="wrap">
		<p class="campo"><b>N° 05</b> Perché FIXLAB</p>
		<h2 id="fiducia-titolo" class="h2">Competenza, trasparenza, velocità. Assistenza vera.</h2>

		<ul class="motivi" role="list">
			{
				motivi.map((m, i) => (
					<li data-reveal style={`--d:${i * 0.07}s`}>
						<svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={m.i} />
						<h3>{m.t}</h3>
						<p>{m.d}</p>
					</li>
				))
			}
		</ul>

		<div class="voti">
			<div class="voti__media" data-reveal>
				<p class="voti__num">4,8<span>/5</span></p>
				<p class="voti__stelle" aria-hidden="true">★★★★★</p>
				<p class="voti__nota">Media di esempio, su recensioni di fantasia.</p>
			</div>
			<ul class="voti__lista" role="list" tabindex="0" aria-label="Recensioni di esempio">
				{
					recensioni.map((r) => (
						<li>
							<blockquote>
								<p>“{r.t}”</p>
							</blockquote>
							<p class="voti__chi"><b>{r.n}</b> · {r.c}</p>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>

<style>
	.fiducia {
		padding: clamp(64px, 9vw, 120px) 0;
		background: var(--bianco);
		border-block: 1px solid var(--riga);
	}
	.fiducia .h2 {
		max-width: 22ch;
	}
	.motivi {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 20px;
		margin-top: 40px;
	}
	.motivi li {
		padding: 24px 22px;
		background: var(--ghiaccio);
		border: 2px solid var(--riga);
		border-radius: 14px;
		transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s, opacity 0.6s;
		transition-delay: 0s, 0s, 0s, var(--d);
	}
	.motivi li:hover {
		border-color: var(--elettrico-testo);
		transform: translateY(-4px);
		box-shadow: 5px 5px 0 var(--elettrico-testo);
	}
	.motivi svg {
		color: var(--elettrico-testo);
		margin-bottom: 14px;
	}
	.motivi h3 {
		font-size: 1.25rem;
		margin-bottom: 8px;
	}
	.motivi p {
		font-size: 0.96rem;
		color: var(--grigio-testo);
	}

	.voti {
		display: grid;
		grid-template-columns: 220px minmax(0, 1fr);
		gap: 32px;
		margin-top: clamp(44px, 6vw, 72px);
		align-items: start;
	}
	.voti__num {
		font-family: var(--titoli);
		font-weight: 800;
		font-size: 4.6rem;
		line-height: 0.9;
		letter-spacing: -0.04em;
	}
	.voti__num span {
		font-size: 1.4rem;
		color: var(--grigio-testo);
		letter-spacing: 0;
	}
	.voti__stelle {
		margin-top: 8px;
		font-size: 1.4rem;
		letter-spacing: 0.1em;
		color: #e0a100;
	}
	.voti__nota {
		margin-top: 8px;
		font-size: 0.85rem;
		color: var(--grigio-testo);
	}
	.voti__lista {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 16px;
	}
	.voti__lista li {
		padding: 20px 22px;
		border-left: 4px solid var(--elettrico);
		background: var(--ghiaccio);
		border-radius: 0 12px 12px 0;
	}
	.voti__lista blockquote p {
		font-size: 1.02rem;
	}
	.voti__chi {
		margin-top: 12px;
		font-size: 0.88rem;
		color: var(--grigio-testo);
	}
	.voti__chi b {
		color: var(--notte);
	}

	@media (max-width: 1000px) {
		.motivi {
			grid-template-columns: 1fr 1fr;
		}
	}
	@media (max-width: 820px) {
		.voti {
			grid-template-columns: minmax(0, 1fr);
			gap: 20px;
		}
		/* su telefono le recensioni scorrono di lato, una per volta */
		.voti__lista {
			display: flex;
			overflow-x: auto;
			scroll-snap-type: x mandatory;
			gap: 14px;
			margin-inline: calc(var(--gutter) * -1);
			padding: 4px var(--gutter) 10px;
			scroll-padding-inline: var(--gutter);
		}
		.voti__lista li {
			flex: 0 0 min(82vw, 340px);
			scroll-snap-align: start;
		}
	}
	@media (max-width: 560px) {
		.motivi {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>

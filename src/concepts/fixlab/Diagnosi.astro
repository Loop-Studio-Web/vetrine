---
import { dispositivi } from './riparazioni';

const icone: Record<string, string> = {
	smartphone: '<rect x="7" y="2.5" width="10" height="19" rx="2.2"/><path d="M11 18.5h2"/>',
	pc: '<rect x="4.5" y="5" width="15" height="10.5" rx="1.6"/><path d="M2 19h20"/>',
	tablet: '<rect x="4" y="3" width="16" height="18" rx="2.2"/><path d="M11 18h2"/>',
	console: '<rect x="2.5" y="7.5" width="19" height="10" rx="5"/><path d="M7.5 10.5v4M5.5 12.5h4"/><circle cx="15.5" cy="11.5" r="0.9"/><circle cx="18" cy="13.5" r="0.9"/>',
};
---

<section class="diagnosi" id="diagnosi" aria-labelledby="diagnosi-titolo">
	<div class="wrap">
		<p class="campo"><b>N° 02</b> Trova il servizio</p>
		<h2 id="diagnosi-titolo" class="h2">Cosa non funziona? Dillo in due tocchi.</h2>
		<p class="lead">Scegli il dispositivo e il problema: ti mostriamo la scheda di lavoro con prezzo indicativo, tempi e come procediamo.</p>

		<div class="diagnosi__griglia">
			<div class="diagnosi__scelte">
				<fieldset class="passo">
					<legend><span class="passo__n">1</span> Che dispositivo è?</legend>
					<div class="disp">
						{
							dispositivi.map((d) => (
								<label class="disp__c">
									<input type="radio" name="dispositivo" value={d.id} />
									<span class="disp__in">
										<svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icone[d.id]} />
										<span class="disp__nome">{d.nome}</span>
										<span class="disp__breve">{d.breve}</span>
									</span>
								</label>
							))
						}
					</div>
				</fieldset>

				<p class="passo__attesa" data-attesa>Scegli un dispositivo per vedere i problemi più comuni.</p>
				{
					dispositivi.map((d) => (
						<fieldset class="passo passo--prob" data-gruppo={d.id}>
							<legend><span class="passo__n">2</span> Cosa fa, o cosa non fa?</legend>
							<div class="prob">
								{d.problemi.map((p) => (
									<label class="prob__c">
										<input type="radio" name={`problema-${d.id}`} value={p.id} />
										<span class="prob__in">{p.nome}</span>
									</label>
								))}
							</div>
						</fieldset>
					))
				}
			</div>

			<div class="ticket" data-ticket aria-live="polite">
				<div class="ticket__vuoto" data-vuoto>
					<svg viewBox="0 0 64 64" width="64" height="64" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
						><path d="M10 14h44v12a6 6 0 0 0 0 12v12H10V38a6 6 0 0 0 0-12z"></path><path d="M22 24h20M22 32h20M22 40h12"></path></svg
					>
					<p>La tua scheda di lavoro comparirà qui.</p>
				</div>
				<div class="ticket__scheda" data-scheda hidden>
					<div class="ticket__corpo">
						<p class="ticket__testa"><span>Scheda di lavoro</span><span data-t="stato">Bozza</span></p>
						<dl class="ticket__campi">
							<div><dt>Dispositivo</dt><dd data-t="dispositivo"></dd></div>
							<div><dt>Problema</dt><dd data-t="problema"></dd></div>
						</dl>
						<div class="ticket__prezzo">
							<div>
								<p class="ticket__et">Prezzo indicativo</p>
								<p class="ticket__val">da <b data-t="da"></b></p>
							</div>
							<div>
								<p class="ticket__et">Tempi</p>
								<p class="ticket__val ticket__val--t" data-t="tempo"></p>
							</div>
						</div>
						<p class="ticket__nota" data-t="nota"></p>
						<ol class="ticket__passi" aria-label="Come procediamo">
							<li>Porti il dispositivo</li>
							<li>Diagnosi</li>
							<li>Preventivo</li>
							<li>Riparazione</li>
						</ol>
						<div class="ticket__az">
							<button type="button" class="btn" data-richiedi>Richiedi assistenza per questo</button>
							<a class="btn btn--chiaro" href="tel:+390200000000">Chiamaci</a>
						</div>
						<p class="ticket__avviso">Il prezzo definitivo viene confermato dopo la diagnosi. Approvi il preventivo prima della riparazione.</p>
					</div>
					<div class="ticket__tallone" aria-hidden="true"><span data-t="numero"></span></div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.diagnosi {
		padding: clamp(64px, 9vw, 120px) 0;
		background: var(--bianco);
		border-block: 1px solid var(--riga);
	}
	.diagnosi__griglia {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
		gap: clamp(24px, 4vw, 56px);
		margin-top: 36px;
		align-items: start;
	}
	fieldset {
		border: 0;
		min-width: 0;
	}
	.passo legend {
		display: flex;
		align-items: center;
		gap: 12px;
		font-family: var(--titoli);
		font-weight: 800;
		font-size: 1.25rem;
		margin-bottom: 14px;
	}
	.passo__n {
		display: inline-grid;
		place-items: center;
		width: 30px;
		height: 30px;
		border-radius: 50%;
		background: var(--notte);
		color: var(--bianco);
		font-size: 0.95rem;
	}
	.passo--prob {
		margin-top: 28px;
	}
	.passo__attesa {
		margin-top: 28px;
		padding: 16px 18px;
		border: 2px dashed var(--riga);
		border-radius: 12px;
		color: var(--grigio-testo);
		font-size: 0.95rem;
	}
	:global(.js) .passo--prob {
		display: none;
	}
	:global(.js) .passo--prob.is-attivo {
		display: block;
	}
	:global(.js) [data-attesa].is-nascosto {
		display: none;
	}

	/* scelta del dispositivo */
	.disp {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 12px;
	}
	.disp__c,
	.prob__c {
		position: relative;
		display: block;
		cursor: pointer;
	}
	.disp__c input,
	.prob__c input {
		position: absolute;
		opacity: 0;
		inset: 0;
		margin: 0;
		cursor: pointer;
	}
	.disp__in {
		height: 100%;
		display: grid;
		gap: 4px;
		padding: 16px;
		border: 2px solid var(--riga);
		border-radius: 12px;
		background: var(--ghiaccio);
		transition: border-color 0.15s, background-color 0.15s, transform 0.15s, box-shadow 0.15s;
	}
	.disp__in svg {
		color: var(--elettrico-testo);
		margin-bottom: 4px;
	}
	.disp__nome {
		font-family: var(--titoli);
		font-weight: 800;
		font-size: 1.12rem;
	}
	.disp__breve {
		font-size: 0.85rem;
		color: var(--grigio-testo);
		line-height: 1.3;
	}
	.disp__c:hover .disp__in {
		border-color: var(--elettrico);
		transform: translateY(-2px);
	}
	.disp__c input:checked + .disp__in {
		border-color: var(--elettrico-testo);
		background: #eaf1ff;
		box-shadow: 4px 4px 0 var(--elettrico-testo);
	}
	.disp__c input:focus-visible + .disp__in,
	.prob__c input:focus-visible + .prob__in {
		outline: 3px solid var(--elettrico);
		outline-offset: 3px;
	}

	/* scelta del problema */
	.prob {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}
	.prob__in {
		display: inline-block;
		padding: 11px 18px;
		border: 2px solid var(--riga);
		border-radius: 999px;
		background: var(--ghiaccio);
		font-weight: 600;
		font-size: 0.98rem;
		transition: border-color 0.15s, background-color 0.15s, color 0.15s;
	}
	.prob__c:hover .prob__in {
		border-color: var(--elettrico);
	}
	.prob__c input:checked + .prob__in {
		background: var(--elettrico-testo);
		border-color: var(--elettrico-testo);
		color: var(--bianco);
	}

	/* la scheda */
	.ticket {
		position: sticky;
		top: calc(var(--nav-h) + var(--fascia-h) + 16px);
	}
	.ticket__vuoto {
		display: grid;
		justify-items: center;
		gap: 14px;
		padding: 56px 24px;
		text-align: center;
		color: var(--grigio-testo);
		border: 2px dashed var(--grigio);
		border-radius: 16px;
		background: var(--ghiaccio);
	}
	.ticket__vuoto[hidden] {
		display: none;
	}
	.ticket__scheda {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 76px;
		background: var(--ghiaccio);
		border: 2px solid var(--notte);
		border-radius: 16px;
		box-shadow: 8px 8px 0 var(--notte);
		position: relative;
		animation: stampa 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
	}
	.ticket__scheda[hidden] {
		display: none;
	}
	@keyframes stampa {
		from {
			transform: translateY(10px) rotate(-0.8deg);
			opacity: 0.4;
		}
	}
	.ticket__corpo {
		padding: 0 22px 22px;
		min-width: 0;
	}
	.ticket__testa {
		display: flex;
		justify-content: space-between;
		margin: 0 -22px 18px;
		padding: 11px 22px;
		background: var(--notte);
		border-radius: 13px 0 0 0;
		color: #cbd6df;
		font-family: var(--titoli);
		font-weight: 700;
		font-size: 0.76rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}
	.ticket__campi {
		display: grid;
		gap: 10px;
	}
	.ticket__campi div {
		display: grid;
		grid-template-columns: 110px 1fr;
		gap: 10px;
		padding-bottom: 10px;
		border-bottom: 1px solid var(--riga);
	}
	.ticket__campi dt,
	.ticket__et {
		font-size: 0.74rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--grigio-testo);
	}
	.ticket__campi dd {
		font-family: var(--titoli);
		font-weight: 700;
		font-size: 1.1rem;
	}
	.ticket__prezzo {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 16px;
		margin-top: 18px;
	}
	.ticket__val {
		font-family: var(--titoli);
		font-weight: 700;
		font-size: 1.1rem;
		margin-top: 2px;
	}
	.ticket__val b {
		font-weight: 800;
		font-size: 2.3rem;
		line-height: 1;
		color: var(--elettrico-testo);
		letter-spacing: -0.02em;
	}
	.ticket__val--t {
		font-size: 1.5rem;
		line-height: 1.25;
		padding-top: 4px;
	}
	.ticket__nota {
		margin-top: 16px;
		font-size: 0.97rem;
	}
	.ticket__passi {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 6px;
		margin-top: 20px;
		counter-reset: p;
	}
	.ticket__passi li {
		counter-increment: p;
		font-size: 0.78rem;
		font-weight: 700;
		line-height: 1.2;
		padding-top: 10px;
		border-top: 4px solid var(--elettrico);
		color: var(--notte);
	}
	.ticket__passi li::before {
		content: counter(p) '. ';
		color: var(--elettrico-testo);
	}
	.ticket__az {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 22px;
	}
	.ticket__avviso {
		margin-top: 16px;
		font-size: 0.82rem;
		color: var(--grigio-testo);
	}
	/* il talloncino da staccare */
	.ticket__tallone {
		position: relative;
		display: grid;
		place-items: center;
		border-left: 2px dashed var(--grigio);
		overflow: hidden;
	}
	.ticket__tallone::before,
	.ticket__tallone::after {
		content: '';
		position: absolute;
		left: -9px;
		width: 16px;
		height: 16px;
		border-radius: 50%;
		background: var(--bianco);
		border: 2px solid var(--notte);
	}
	.ticket__tallone::before {
		top: -9px;
	}
	.ticket__tallone::after {
		bottom: -9px;
	}
	.ticket__tallone span {
		writing-mode: vertical-rl;
		transform: rotate(180deg);
		font-family: var(--titoli);
		font-weight: 800;
		font-size: 1.6rem;
		letter-spacing: 0.1em;
		color: var(--notte);
	}

	@media (max-width: 960px) {
		.diagnosi__griglia {
			grid-template-columns: minmax(0, 1fr);
		}
		.ticket {
			position: static;
		}
	}
	@media (max-width: 520px) {
		.disp__in {
			padding: 13px;
		}
		.ticket__scheda {
			grid-template-columns: minmax(0, 1fr) 54px;
			box-shadow: 5px 5px 0 var(--notte);
		}
		.ticket__corpo {
			padding: 0 16px 18px;
		}
		.ticket__testa {
			margin: 0 -16px 16px;
			padding-inline: 16px;
		}
		.ticket__campi div {
			grid-template-columns: 1fr;
			gap: 2px;
		}
		.ticket__tallone span {
			font-size: 1.2rem;
		}
		.ticket__passi {
			grid-template-columns: 1fr 1fr;
			gap: 10px 8px;
		}
		.ticket__az .btn {
			flex: 1 1 100%;
		}
	}
</style>

<script>
	import { dispositivi, prezzo } from './riparazioni';

	const sez = document.querySelector<HTMLElement>('#diagnosi')!;
	const attesa = sez.querySelector<HTMLElement>('[data-attesa]')!;
	const vuoto = sez.querySelector<HTMLElement>('[data-vuoto]')!;
	const scheda = sez.querySelector<HTMLElement>('[data-scheda]')!;
	const gruppi = [...sez.querySelectorAll<HTMLElement>('[data-gruppo]')];
	const t = (k: string) => sez.querySelector<HTMLElement>(`[data-t="${k}"]`)!;

	let disp = '';
	let prob = '';

	const numero = (s: string) => {
		let h = 7;
		for (const c of s) h = (h * 31 + c.charCodeAt(0)) % 9000;
		return `FX-${String(1000 + h).slice(-4).padStart(4, '0')}`;
	};

	function mostra() {
		for (const g of gruppi) g.classList.toggle('is-attivo', g.dataset.gruppo === disp);
		attesa.classList.toggle('is-nascosto', !!disp);
		const d = dispositivi.find((x) => x.id === disp);
		const p = d?.problemi.find((x) => x.id === prob);
		scheda.hidden = !p;
		vuoto.hidden = !!p;
		if (!d || !p) return;
		t('dispositivo').textContent = d.nome;
		t('problema').textContent = p.nome;
		t('da').textContent = prezzo(p.da);
		t('tempo').textContent = p.tempo;
		t('nota').textContent = p.nota;
		t('numero').textContent = numero(disp + prob);
		t('stato').textContent = 'Bozza';
		// riavvia l'animazione di stampa
		scheda.style.animation = 'none';
		void scheda.offsetWidth;
		scheda.style.animation = '';
	}

	sez.addEventListener('change', (e) => {
		const el = e.target as HTMLInputElement;
		if (el.name === 'dispositivo') {
			disp = el.value;
			prob = '';
			sez.querySelectorAll<HTMLInputElement>('.prob input').forEach((r) => (r.checked = false));
		} else if (el.name.startsWith('problema-')) {
			prob = el.value;
		}
		mostra();
	});

	// dal banco in alto: un pezzo dello smartphone sceglie già dispositivo e problema
	addEventListener('fixlab:scegli', (e) => {
		const { d, p } = (e as CustomEvent<{ d: string; p: string }>).detail;
		const r = sez.querySelector<HTMLInputElement>(`input[name="dispositivo"][value="${d}"]`);
		const q = sez.querySelector<HTMLInputElement>(`input[name="problema-${d}"][value="${p}"]`);
		if (!r || !q) return;
		r.checked = true;
		q.checked = true;
		disp = d;
		prob = p;
		mostra();
	});

	// la scheda passa i suoi dati alla richiesta di assistenza
	sez.querySelector<HTMLButtonElement>('[data-richiedi]')!.addEventListener('click', () => {
		dispatchEvent(new CustomEvent('fixlab:richiesta', { detail: { d: disp, p: prob } }));
		document.getElementById('richiesta')?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
	});

	mostra();
</script>

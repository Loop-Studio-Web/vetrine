---
// La parete del almacén: un marco de proporción fija (3:2, como el mockup) que se escala con el ancho y nunca pasa del
// alto de la pantalla; todo lo que va dentro se coloca en % del marco y se dimensiona con --k (un píxel del mockup).
---

<section class="pared" aria-label="Portada de Sobremesa">
	<div class="pared__marco">
		<slot />
	</div>
</section>

<style>
	.pared {
		--fascia-h: 34px;
		display: grid;
		justify-items: center;
		align-content: start;
		min-height: calc(100svh - var(--fascia-h));
	}
	.pared__marco {
		position: relative;
		width: min(100%, calc((100svh - var(--fascia-h)) * 1.5));
		aspect-ratio: 3 / 2;
		container-type: inline-size;
	}
	@media (max-width: 900px) {
		/* el telefono se rehace aparte: una columna de carteles (referencia comp-2-b). Las medidas del mockup que traen los
		   componentes en style="left:…" se anulan acá (con :where() para que cada componente pueda corregir lo suyo) y cada
		   uno dice en su CSS cómo se acomoda; --k pasa a ser un valor fijo para tornillos, bordes y sombras. */
		.pared {
			min-height: 0;
			padding: 18px var(--gutter) 40px;
		}
		.pared__marco {
			--k: 0.8px;
			width: min(100%, 520px);
			aspect-ratio: auto;
			container-type: normal;
			display: flex;
			flex-direction: column;
			gap: 14px;
		}
		.pared__marco :global(:where([style*='left:'])) {
			position: relative !important;
			left: auto !important;
			top: auto !important;
			width: auto !important;
			height: auto !important;
		}
	}
</style>

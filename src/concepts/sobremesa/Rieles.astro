---
// Los carteles verticales de las franjas, solo en pantallas anchas y solo cuando sirven (arriba, en el hero, esas franjas
// tienen los carteles de Laterales.astro). Pasado el hero aparece la bolsa (con su cuenta); el atajo al catálogo se ve
// entre el hero y el depósito; los filtros (con "volver arriba") se ven solo mientras el depósito está en pantalla. Son
// botones y enlaces de verdad: están en el orden de tabulación solo cuando se ven.
import enamelWhite from '../../assets/sobremesa/plates/enamel-grano.jpg';
const t = `--textura:url(${enamelWhite.src})`;
---

<nav class="rieles" aria-label="Accesos rápidos" data-rieles>
	<div class="riel riel--izq" data-riel-dep>
		<button class="chapa cartel" type="button" data-filtros-abrir aria-haspopup="dialog" style={`--c:var(--amarillo);--tornillo:#4a3706;${t}`}>
			<span class="v">Filtrar</span>
		</button>
		<a class="chapa cartel cartel--chico" href="#main" style={`--c:var(--esmalte);--tornillo:#55524c;${t}`}>
			<span class="v">↑ Arriba</span>
		</a>
	</div>
	<div class="riel riel--der">
		<button class="chapa cartel" type="button" data-bolsa-abrir aria-haspopup="dialog" style={`--c:var(--rojo);--tornillo:#2a0a05;${t}`}>
			<span class="v">Bolsa (<span data-bolsa-n>0</span>)</span>
		</button>
		<a class="chapa cartel cartel--chico cartel--cat" href="#deposito" style={`--c:var(--cobalto-vivo);--tornillo:#020f33;${t}`}>
			<span class="v">Catálogo 360</span>
		</a>
	</div>
</nav>

<style>
	.rieles {
		display: none;
	}
	@media (min-width: 1700px) and (min-aspect-ratio: 16 / 9) {
		.rieles {
			display: block;
			--k: 0.85px;
			/* el centro de cada franja: lo que sobra a cada lado de la columna de contenido (ver .cuerpo), con su margen */
			--franja: calc((100vw - clamp(1280px, calc((100svh - 34px) * 1.5), 1760px)) / 2 + clamp(16px, 4vw, 48px));
			position: fixed;
			inset: 0;
			z-index: 20;
			pointer-events: none;
			visibility: hidden;
			opacity: 0;
			transition: opacity 0.3s ease, visibility 0s 0.3s;
		}
		.rieles.on {
			visibility: visible;
			opacity: 1;
			transition: opacity 0.3s ease;
		}
		/* los filtros: solo con el depósito a la vista */
		.riel--izq {
			visibility: hidden;
			opacity: 0;
			transition: opacity 0.3s ease, visibility 0s 0.3s;
		}
		.rieles.dep .riel--izq {
			visibility: visible;
			opacity: 1;
			transition: opacity 0.3s ease;
		}
		/* el atajo al catálogo: solo entre el hero y el depósito */
		.rieles .cartel--cat {
			display: none;
		}
		.rieles.antes .cartel--cat {
			display: grid;
		}
		.riel {
			position: absolute;
			top: 50%;
			display: grid;
			gap: 14px;
			translate: 0 -50%;
			width: 56px;
		}
		.riel--izq {
			left: max(6px, calc(var(--franja) / 2 - 28px));
		}
		.riel--der {
			right: max(6px, calc(var(--franja) / 2 - 28px));
		}
		.cartel {
			position: relative;
			display: grid;
			place-items: center;
			width: 56px;
			padding: 34px 0;
			border: 0;
			color: var(--tinta);
			font-family: var(--f-cartel);
			font-weight: 700;
			font-size: 1.1875rem;
			letter-spacing: 0.12em;
			text-transform: uppercase;
			text-decoration: none;
			pointer-events: auto;
			transition: translate 0.2s var(--ease-out), filter 0.2s;
		}
		.cartel--chico {
			padding: 24px 0;
			font-size: 1rem;
		}
		.cartel:hover {
			translate: 0 -3px;
			filter: brightness(1.1);
		}
		.cartel[data-bolsa-abrir],
		.cartel[href='#deposito'] {
			color: #fff;
		}
		.v {
			writing-mode: vertical-rl;
			rotate: 180deg;
			white-space: nowrap;
		}
	}
</style>

<script>
	// qué carteles se ven según dónde está la persona: hero, entre hero y depósito, depósito o más abajo
	const riel = document.querySelector<HTMLElement>('[data-rieles]');
	const hero = document.querySelector<HTMLElement>('.pared');
	const dep = document.getElementById('deposito');
	if (riel && hero && dep && 'IntersectionObserver' in window) {
		const estado = () => {
			const pasoHero = hero.getBoundingClientRect().bottom < 0;
			const d = dep.getBoundingClientRect();
			riel.classList.toggle('on', pasoHero);
			riel.classList.toggle('dep', d.top < innerHeight && d.bottom > 0);
			riel.classList.toggle('antes', pasoHero && d.top >= innerHeight);
		};
		const io = new IntersectionObserver(estado, { threshold: 0 });
		io.observe(hero);
		io.observe(dep);
		addEventListener('resize', estado);
		estado();
	}
</script>

---
// El movimiento de la pared (no el del diálogo, que vive en Chapa.astro). Tres cosas, todas con propiedades individuales
// (rotate, translate, opacity) para no pisar los hover de cada componente:
//   1. Los carteles de la portada se cuelgan al cargar: un solo vaivén de péndulo desde el tornillo de arriba (CSS puro,
//      sin opacidad, así no toca el LCP ni depende de ningún script).
//   2. Las secciones de abajo se "atornillan" al entrar en pantalla: llegan torcidas desde un tornillo y se enderezan,
//      con 60 ms entre hermanos (máx. 4). Solo se ocultan los que quedan debajo del pliegue y recién cuando el script corre.
//   3. El reflejo: la lámina bajo el puntero (mouse) recibe una luz que la sigue. En el teléfono no hay reflejo ni
//      inclinación: el giroscopio en iOS pide un permiso y el efecto no vale ese cartel.
---

<style is:global>
	/* ---------- 3. reflejo del esmalte: una sola lámina a la vez, la que está bajo el puntero ---------- */
	@media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
		.chapa.luz::after {
			opacity: 1;
		}
	}

	/* ---------- 1. los carteles se cuelgan ---------- */
	@media (prefers-reduced-motion: no-preference) {
		.titulo-cartel,
		.historia,
		.tira {
			transform-origin: calc(22 * var(--k)) calc(22 * var(--k));
			animation: sb-colgar 760ms var(--sb-delay, 0ms) backwards;
			animation-timing-function: cubic-bezier(0.37, 0, 0.25, 1);
		}
		.titulo-cartel {
			--sb-delay: 60ms;
		}
		.historia:nth-of-type(1) {
			--sb-delay: 220ms;
		}
		.historia:nth-of-type(2) {
			--sb-delay: 300ms;
		}
		.tira {
			--sb-delay: 380ms;
		}
		@keyframes sb-colgar {
			0% {
				rotate: -2.4deg;
				translate: 0 calc(-10 * var(--k));
			}
			42% {
				rotate: 1.1deg;
				translate: 0 0;
			}
			72% {
				rotate: -0.45deg;
			}
			100% {
				rotate: 0deg;
			}
		}
	}

	/* ---------- 2. las secciones se atornillan al entrar ---------- */
	@media (prefers-reduced-motion: no-preference) {
		.sb-pre {
			opacity: 0;
			translate: 0 22px;
			rotate: var(--sb-giro, -1.3deg);
			transform-origin: 24px 24px;
		}
		.sb-pre.sb-entra {
			opacity: 1;
			translate: 0 0;
			rotate: 0deg;
			transition:
				opacity 360ms ease-out var(--sb-d, 0ms),
				translate 520ms cubic-bezier(0.23, 1, 0.32, 1) var(--sb-d, 0ms),
				rotate 620ms cubic-bezier(0.23, 1, 0.32, 1) var(--sb-d, 0ms);
		}
	}
</style>

<script>
	const reducido = matchMedia('(prefers-reduced-motion: reduce)');

	// ---- 3. reflejo ----
	if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
		let actual: HTMLElement | null = null;
		let raf = 0;
		let px = 0, py = 0;
		const pintar = () => {
			raf = 0;
			if (!actual) return;
			const r = actual.getBoundingClientRect();
			actual.style.setProperty('--lx', `${px - r.left}px`);
			actual.style.setProperty('--ly', `${py - r.top}px`);
		};
		document.addEventListener('pointermove', (e) => {
			if (e.pointerType !== 'mouse' || reducido.matches) return;
			const el = (e.target as Element).closest<HTMLElement>('.chapa');
			if (el !== actual) {
				actual?.classList.remove('luz');
				actual = el;
				actual?.classList.add('luz');
			}
			if (!actual) return;
			px = e.clientX;
			py = e.clientY;
			if (!raf) raf = requestAnimationFrame(pintar);
		});
		document.addEventListener('pointerleave', () => {
			actual?.classList.remove('luz');
			actual = null;
		});
	}

	// ---- 2. entradas ----
	if (!reducido.matches && 'IntersectionObserver' in window) {
		const objetivos = document.querySelectorAll<HTMLElement>(
			'.cuerpo .rotulo, .cuerpo .obj, .cuerpo .taller, .cuerpo .caja, .cuerpo .tapa, .cuerpo .panel, .pie__boletin',
		);
		const corte = innerHeight * 0.96;
		const ocultos: HTMLElement[] = [];
		objetivos.forEach((el, i) => {
			// solo lo que queda debajo del pliegue: lo que ya se ve al cargar (o al recargar a mitad de página) no parpadea
			if (el.getBoundingClientRect().top > corte) {
				el.style.setProperty('--sb-giro', `${i % 2 ? 1.3 : -1.3}deg`);
				el.classList.add('sb-pre');
				ocultos.push(el);
			}
		});
		const io = new IntersectionObserver(
			(entradas) => {
				const llegan = entradas.filter((e) => e.isIntersecting).map((e) => e.target as HTMLElement);
				llegan.sort((a, b) => (a.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1));
				llegan.forEach((el, i) => {
					io.unobserve(el);
					el.style.setProperty('--sb-d', `${Math.min(i, 4) * 60}ms`);
					el.classList.add('sb-entra');
					// terminada la entrada no queda rastro: las clases y las variables se van y mandan otra vez los estilos del componente
					setTimeout(() => {
						el.classList.remove('sb-pre', 'sb-entra');
						el.style.removeProperty('--sb-d');
						el.style.removeProperty('--sb-giro');
					}, 620 + Math.min(i, 4) * 60 + 60);
				});
			},
			{ rootMargin: '0px 0px -6% 0px' },
		);
		ocultos.forEach((el) => io.observe(el));
	}
</script>

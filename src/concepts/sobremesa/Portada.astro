---
// Portada: el cartel grande con el título de la historia y la foto de la mesa impresa sobre tres láminas, con los
// cartelitos de precio colgados de los objetos. Posiciones del mockup aprobado (caja / dentro).
import { Image, getImage } from 'astro:assets';
import { caja, dentro } from './caja';
import { OBJETOS_MESA, pesos } from './dati';
import { MEDIDAS } from './medidas';
import enamelBlue from '../../assets/sobremesa/plates/enamel-blue.png';
import photo1 from '../../assets/sobremesa/plates/photo-1.png';
import photo2 from '../../assets/sobremesa/plates/photo-2.png';
import photo3 from '../../assets/sobremesa/plates/photo-3.png';
import tagKraft from '../../assets/sobremesa/tag-kraft.png';

const texturaAzul = (await getImage({ src: enamelBlue, format: 'webp', quality: 85 })).src;

const laminas = [
	{ id: 'photo-1', img: photo1, w: 520 },
	{ id: 'photo-2', img: photo2, w: 580 },
	{ id: 'photo-3', img: photo3, w: 590 },
];
// cartelitos: la etiqueta de cartón cuelga de su objeto. Punto donde el hilo se ata (px del mockup 1536×1024, medido sobre la foto)
// e inclinación; la región del mockup se usa solo para el punto numerado del telefono
const cartelitos = [
	{ region: 'tag-lampara', objeto: OBJETOS_MESA[0], x: 1190, y: 262, giro: 4 },
	{ region: 'tag-jarra', objeto: OBJETOS_MESA[1], x: 811, y: 372, giro: 6 },
	{ region: 'tag-vasos', objeto: OBJETOS_MESA[2], x: 1036, y: 408, giro: 12 },
	{ region: 'tag-mantel', objeto: OBJETOS_MESA[3], x: 1085, y: 510, giro: 8 },
];
// telefono: la foto es una sola tira de tres láminas y los objetos se marcan con números (posición del cartelito del
// mockup dentro de la tira); la leyenda de abajo repite número, nombre y precio
const [fx0, fy0] = [MEDIDAS['photo-1'][0], Math.min(...laminas.map((l) => MEDIDAS[l.id][1]))];
const fx1 = MEDIDAS['photo-3'][0] + MEDIDAS['photo-3'][2];
const fy1 = Math.max(...laminas.map((l) => MEDIDAS[l.id][1] + MEDIDAS[l.id][3]));
const tira = { ratio: ((fx1 - fx0) * 1536) / ((fy1 - fy0) * 1024), w: fx1 - fx0, h: fy1 - fy0 };
// número, color del disco y ajuste fino del punto (en % de la tira) respecto del centro del cartelito
const pines: Record<string, { n: number; fondo: string; tinta: string; dx: number; dy: number }> = {
	'jarra-gres': { n: 1, fondo: 'var(--rojo)', tinta: '#fff', dx: 0, dy: 0 },
	'vasos-4': { n: 2, fondo: 'var(--amarillo)', tinta: 'var(--tinta)', dx: 0, dy: 0 },
	'mantel-lino': { n: 3, fondo: 'var(--esmalte-luz)', tinta: 'var(--tinta)', dx: 0, dy: 0 },
	'lampara-chapa': { n: 4, fondo: 'var(--negro)', tinta: '#fff', dx: -12.5, dy: -6 },
};
const pinDe = (region: string, id: string) => {
	const [x, y, w, h] = MEDIDAS[region];
	const p = pines[id];
	return `--px:${(((x + w / 2 - fx0) / tira.w) * 100 + p.dx).toFixed(2)}%;--py:${(((y + h / 2 - fy0) / tira.h) * 100 + p.dy).toFixed(2)}%`;
};
const leyenda = [...cartelitos].sort((a, b) => pines[a.objeto.id].n - pines[b.objeto.id].n);
---

<section class="portada" aria-labelledby="titulo" style={`--textura:url(${texturaAzul})`}>
	<div class="chapa titulo-cartel" style={`${caja('sign-headline')};--c:var(--cobalto);--tornillo:#020f33`}>
		<h1 id="titulo" class="titulo" style={dentro('headline-1', 'sign-headline')}>
			<span>LA MESA LARGA</span>{' '}
			<span>DE CARO Y MATI</span>
		</h1>
		<div class="titulo-regla" style={dentro('headline-rule', 'sign-headline')}></div>
		<p class="titulo-meta" style={dentro('headline-meta', 'sign-headline')}>Villa Crespo · 4 objetos</p>
	</div>

	<div class="tavola" role="group" aria-label="La mesa larga: objetos de esta historia" style={`--ratio:${tira.ratio.toFixed(3)};--c1:${(MEDIDAS['photo-1'][2]*1000).toFixed(1)}fr;--c2:${(MEDIDAS['photo-2'][2]*1000).toFixed(1)}fr;--c3:${(MEDIDAS['photo-3'][2]*1000).toFixed(1)}fr`}>
		{laminas.map((l) => (
			<figure class="lamina" style={caja(l.id)}>
				<Image src={l.img} alt="" width={l.w} quality={80} format="webp" sizes="18vw" loading="eager" />
			</figure>
		))}
		<p class="sr-only">Foto de ejemplo, generada: una mesa larga de madera con un mantel de lino, una jarra de gres con flores, vasos de vidrio y una lámpara colgante de chapa.</p>

		{cartelitos.map((c) => (
			<button class="cartelito" type="button" style={`--ax:${((c.x / 1536) * 100).toFixed(3)}%;--ay:${((c.y / 1024) * 100).toFixed(3)}%;--giro:${c.giro}deg;${pinDe(c.region, c.objeto.id)};--pin:${pines[c.objeto.id].fondo};--pin-tinta:${pines[c.objeto.id].tinta}`} data-objeto={c.objeto.id} aria-label={`${pines[c.objeto.id].n}. ${c.objeto.nombre}, ${pesos(c.objeto.precio)}. Ver y sumar a la bolsa`}>
				<span class="cartelito__lamina">
					<Image class="cartelito__carton" src={tagKraft} alt="" width={200} quality={85} format="webp" loading="eager" />
					<span class="cartelito__texto" aria-hidden="true">
						<span>{c.objeto.nombre}</span>
						<strong>{pesos(c.objeto.precio)}</strong>
					</span>
				</span>
				<span class="cartelito__pin" aria-hidden="true">{pines[c.objeto.id].n}</span>
			</button>
		))}
	</div>

	<ul class="leyenda" aria-hidden="true">
		{leyenda.map((c) => (
			<li data-objeto={c.objeto.id} style={`--pin:${pines[c.objeto.id].fondo};--pin-tinta:${pines[c.objeto.id].tinta}`}>
				<span class="leyenda__n">{pines[c.objeto.id].n}</span>
				<span class="leyenda__nombre">{c.objeto.nombre}</span>
				<strong>{pesos(c.objeto.precio)}</strong>
			</li>
		))}
	</ul>

	<button class="cta" type="button" style={caja('cta-bolsa')} data-sumar-mesa>
		<svg viewBox="0 0 229 70" preserveAspectRatio="none" aria-hidden="true">
			<polygon points="5,5 203,5 224,35 203,65 5,65" fill="var(--cobalto)" stroke="rgb(255 255 255 / 0.92)" stroke-width="3" stroke-linejoin="round" />
			<polygon points="11,11 200,11 217,35 200,59 11,59" fill="none" stroke="rgb(255 255 255 / 0.28)" stroke-width="1.5" stroke-linejoin="round" />
		</svg>
		<span>Sumá los 4<small class="sr-only"> objetos de la mesa a la bolsa</small></span>
	</button>
</section>

<style>
	.portada {
		display: contents;
	}

	.titulo-cartel {
		--tornillo-aro: rgb(255 255 255 / 0.3);
		color: var(--blanco);
	}
	.titulo {
		position: absolute;
		font-family: var(--f-titulo);
		font-weight: 400;
		font-size: calc(91 * var(--k));
		line-height: calc(110 * var(--k));
		letter-spacing: 0;
		white-space: nowrap;
		/* la caja del mockup envuelve solo la tinta del primer renglón: la altura se abre a los dos */
		height: auto !important;
		margin-top: calc(-14 * var(--k));
	}
	.titulo span {
		display: block;
	}
	.titulo-regla {
		position: absolute;
		background: rgb(255 255 255 / 0.9);
	}
	.titulo-meta {
		position: absolute;
		display: flex;
		align-items: center;
		font-family: var(--f-cartel);
		font-weight: 600;
		font-size: calc(40 * var(--k));
		letter-spacing: 0.03em;
		line-height: 1;
		white-space: nowrap;
	}

	/* la foto impresa sobre tres láminas esmaltadas, con tornillos y el hueco entre una y otra */
	.lamina {
		position: absolute;
		margin: 0;
		padding: calc(5 * var(--k));
		border-radius: calc(12 * var(--k));
		background:
			radial-gradient(circle at calc(14 * var(--k)) calc(14 * var(--k)), #2c2b28 0 calc(3 * var(--k)), rgb(255 255 255 / 0.5) calc(3.5 * var(--k)) calc(5 * var(--k)), transparent calc(6 * var(--k))),
			radial-gradient(circle at calc(100% - 14 * var(--k)) calc(14 * var(--k)), #2c2b28 0 calc(3 * var(--k)), rgb(255 255 255 / 0.5) calc(3.5 * var(--k)) calc(5 * var(--k)), transparent calc(6 * var(--k))),
			radial-gradient(circle at calc(14 * var(--k)) calc(100% - 14 * var(--k)), #2c2b28 0 calc(3 * var(--k)), rgb(255 255 255 / 0.5) calc(3.5 * var(--k)) calc(5 * var(--k)), transparent calc(6 * var(--k))),
			radial-gradient(circle at calc(100% - 14 * var(--k)) calc(100% - 14 * var(--k)), #2c2b28 0 calc(3 * var(--k)), rgb(255 255 255 / 0.5) calc(3.5 * var(--k)) calc(5 * var(--k)), transparent calc(6 * var(--k))),
			var(--esmalte);
		box-shadow:
			0 calc(7 * var(--k)) calc(14 * var(--k)) rgb(0 0 0 / 0.5),
			inset 0 0 0 calc(1.5 * var(--k)) rgb(255 255 255 / 0.35);
		overflow: hidden;
	}
	.lamina :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: calc(6 * var(--k));
	}

	/* etiqueta de cartón (foto real, girada de lado): el hilo se ata al objeto en (--ax, --ay) y la etiqueta gira desde ahí.
	   El precio y el nombre son texto real escrito a mano dentro del cuerpo del cartón */
	.cartelito {
		--tw: calc(74 * var(--k));
		--tl: calc(var(--tw) * 2.413);
		position: absolute;
		left: var(--ax);
		top: var(--ay);
		display: block;
		width: var(--tl);
		height: var(--tw);
		padding: 0;
		border: 0;
		background: none;
		z-index: 2;
		overflow: visible;
		translate: 0 -86%;
		rotate: var(--giro);
		transform-origin: 0 86%;
		transition: rotate 0.4s var(--ease-out);
	}
	.cartelito:hover {
		rotate: calc(var(--giro) + 5deg);
	}
	.cartelito__lamina {
		position: absolute;
		inset: 0;
		filter: drop-shadow(0 calc(4 * var(--k)) calc(5 * var(--k)) rgb(0 0 0 / 0.45));
	}
	.cartelito__lamina :global(.cartelito__carton) {
		position: absolute;
		left: 50%;
		top: 50%;
		width: var(--tw);
		height: var(--tl);
		max-width: none;
		translate: -50% -50%;
		rotate: -90deg;
		object-fit: contain;
		filter: brightness(1.1);
	}
	.cartelito__texto {
		position: absolute;
		left: 47%;
		width: 49%;
		top: 6%;
		height: 78%;
		display: grid;
		align-content: center;
		justify-items: center;
		gap: calc(2 * var(--k));
		font-family: var(--f-mano);
		font-weight: 600;
		font-size: calc(17 * var(--k));
		line-height: 0.92;
		color: #1a1006;
		text-align: center;
		text-wrap: balance;
	}
	.cartelito__texto strong {
		font-weight: 700;
		font-size: 1.28em;
		line-height: 1;
	}

	.cartelito__pin,
	.leyenda {
		display: none;
	}

	.cta {
		position: absolute;
		z-index: 3;
		display: grid;
		place-items: center;
		padding: 0 0 0 calc(4 * var(--k));
		border: 0;
		background: none;
		color: #fff;
		font-family: var(--f-cartel);
		font-weight: 700;
		font-size: calc(30 * var(--k));
		letter-spacing: 0.02em;
		line-height: 1;
		filter: drop-shadow(0 calc(5 * var(--k)) calc(8 * var(--k)) rgb(0 0 0 / 0.5));
		transition: translate 0.2s var(--ease-out), filter 0.2s;
	}
	.cta svg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
	}
	.cta span {
		position: relative;
		padding-right: calc(10 * var(--k));
	}
	.cta:hover {
		translate: calc(3 * var(--k)) 0;
		filter: drop-shadow(0 calc(5 * var(--k)) calc(8 * var(--k)) rgb(0 0 0 / 0.5)) brightness(1.15);
	}

	/* telefono: un solo cartel cobalto con el título, la tira de la foto con los objetos numerados, la leyenda y el botón */
	@media (max-width: 900px) {
		.portada {
			display: block;
			position: relative;
			isolation: isolate;
			padding: 26px 16px 18px;
			border-radius: calc(16 * var(--k));
			color: var(--blanco);
			background-color: var(--cobalto);
			background-image:
				radial-gradient(circle at 14px 14px, #020f33 0 3.5px, rgb(255 255 255 / 0.3) 4px 5.4px, transparent 6.2px),
				radial-gradient(circle at calc(100% - 14px) 14px, #020f33 0 3.5px, rgb(255 255 255 / 0.3) 4px 5.4px, transparent 6.2px),
				radial-gradient(circle at 14px calc(100% - 14px), #020f33 0 3.5px, rgb(255 255 255 / 0.3) 4px 5.4px, transparent 6.2px),
				radial-gradient(circle at calc(100% - 14px) calc(100% - 14px), #020f33 0 3.5px, rgb(255 255 255 / 0.3) 4px 5.4px, transparent 6.2px),
				linear-gradient(112deg, rgb(255 255 255 / 0.2), rgb(255 255 255 / 0) 34%, rgb(0 0 0 / 0.14) 100%);
			box-shadow:
				0 6px 12px rgb(0 0 0 / 0.5),
				inset 0 0 0 2px rgb(255 255 255 / 0.3),
				inset 0 -4px 8px rgb(0 0 0 / 0.28);
		}
		.portada::before {
			content: '';
			position: absolute;
			inset: 0;
			z-index: -1;
			border-radius: inherit;
			background: var(--textura) center / 340px auto repeat;
			mix-blend-mode: soft-light;
			opacity: 0.55;
			pointer-events: none;
		}

		.titulo-cartel {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			column-gap: 14px;
			container-type: inline-size;
			background: none;
			box-shadow: none;
			border-radius: 0;
		}
		.titulo-cartel::before {
			display: none;
		}
		.titulo {
			flex: 0 0 100%;
			font-size: 13.4cqw;
			line-height: 1.04;
			margin-top: 0;
		}
		.titulo-meta {
			order: 2;
			margin-top: 12px;
			font-size: 1.25rem;
			white-space: normal;
		}
		.titulo-regla {
			order: 3;
			flex: 1;
			margin-top: 12px;
			height: 0 !important;
			background: none;
			border-top: 2px solid rgb(255 255 255 / 0.9);
		}

		.tavola {
			position: relative;
			display: grid;
			grid-template-columns: var(--c1) var(--c2) var(--c3);
			grid-template-rows: minmax(0, 1fr);
			gap: 4px;
			aspect-ratio: var(--ratio);
			margin-top: 18px;
		}
		.lamina {
			padding: 3px;
			border-radius: 8px;
			box-shadow:
				0 3px 6px rgb(0 0 0 / 0.5),
				inset 0 0 0 1.5px rgb(255 255 255 / 0.35);
		}
		.lamina :global(img) {
			border-radius: 5px;
		}

		/* el cartelito de cartón se vuelve un punto numerado; el botón conserva 48 px de zona táctil */
		.cartelito {
			position: absolute !important;
			left: var(--px) !important;
			top: var(--py) !important;
			width: 48px !important;
			height: 48px !important;
			translate: -50% -50%;
			rotate: 0deg;
		}
		.cartelito:hover {
			translate: -50% -50%;
			rotate: 0deg;
		}
		.cartelito__lamina {
			display: none;
		}
		.cartelito__pin {
			position: absolute;
			inset: 9px;
			display: grid;
			place-items: center;
			border-radius: 50%;
			background: var(--pin);
			color: var(--pin-tinta);
			font-family: var(--f-cartel);
			font-weight: 700;
			font-size: 1.0625rem;
			line-height: 1;
			box-shadow: 0 0 0 2px rgb(255 255 255 / 0.92), 0 2px 6px rgb(0 0 0 / 0.55);
		}

		.leyenda {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 4px 14px;
			margin: 16px 0 0;
			padding: 0;
			list-style: none;
		}
		.leyenda li {
			display: grid;
			grid-template-columns: auto minmax(0, 1fr);
			grid-template-rows: auto auto;
			column-gap: 10px;
			align-items: center;
			padding: 8px 0;
			cursor: pointer;
		}
		.leyenda__n {
			grid-row: 1 / 3;
			display: grid;
			place-items: center;
			width: 28px;
			height: 28px;
			border-radius: 50%;
			background: var(--pin);
			color: var(--pin-tinta);
			font-weight: 700;
			font-size: 1rem;
			line-height: 1;
			box-shadow: 0 0 0 2px rgb(255 255 255 / 0.92);
		}
		.leyenda__nombre {
			font-size: 1rem;
			line-height: 1.1;
		}
		.leyenda strong {
			font-size: 1.1875rem;
			line-height: 1.15;
		}

		.cta {
			display: grid;
			width: 100% !important;
			height: 56px !important;
			margin-top: 12px;
			padding: 0;
			font-size: 1.375rem;
			filter: drop-shadow(0 3px 5px rgb(0 0 0 / 0.5));
		}
		.cta svg path,
		.cta svg polygon {
			vector-effect: non-scaling-stroke;
		}
		.cta:hover {
			translate: none;
		}
		.cta span {
			padding-right: 14px;
		}
	}
</style>

---
// Números anteriores: el archivo de la revista como una fila de chapas con la tapa. Cada una abre su índice.
import { Image } from 'astro:assets';
import { NUMEROS } from './dati';
import enamelWhite from '../../assets/sobremesa/plates/enamel-grano.jpg';
import enamelBlue from '../../assets/sobremesa/plates/enamel-blue.png';

const colores = ['var(--cobalto)', 'var(--rojo)', 'var(--amarillo)', 'var(--esmalte)', 'var(--cobalto)', 'var(--rojo)'];
const tintas = ['var(--blanco)', '#fff', 'var(--tinta)', 'var(--tinta)', 'var(--blanco)', '#fff'];
---

<section class="revista" id="revista" aria-labelledby="revista-titulo">
	<h2 id="revista-titulo" class="chapa chapa--flujo rotulo" style={`--c:var(--rojo);--tornillo:#4a1209;--textura:url(${enamelBlue.src});color:#fff`}>Números anteriores</h2>
	<p class="bajada">Un número por estación, siempre con una mesa. Tocá una tapa para ver qué trae.</p>

	<ul class="tapas" tabindex="-1">
		{NUMEROS.map((n, i) => (
			<li>
				<button class="chapa chapa--flujo tapa" type="button" data-numero={n.n} style={`--c:${colores[i]};--tinta-c:${tintas[i]};--textura:url(${i % 2 ? enamelWhite.src : enamelBlue.src});--tornillo:rgb(0 0 0 / 0.5)`} aria-haspopup="dialog" aria-label={`Número ${n.n}, ${n.titulo}, ${n.estacion}. Ver el índice`}>
					<Image class="tapa__foto" src={n.foto} alt="" width={520} quality={72} format="webp" sizes="260px" loading="lazy" />
					<span class="tapa__num">Nº {String(n.n).padStart(2, '0')}</span>
					<span class="tapa__titulo">{n.titulo}</span>
					<span class="tapa__estacion">{n.estacion}</span>
				</button>
			</li>
		))}
	</ul>

	<dialog class="indice" id="sb-indice" aria-labelledby="sb-indice-titulo">
		<div class="chapa chapa--flujo indice__caja" style={`--c:var(--esmalte);--tinta-c:var(--tinta);--tornillo:#55524c;--textura:url(${enamelWhite.src})`}>
			<img class="indice__foto" alt="" width="260" height="325" />
			<div class="indice__texto">
				<p class="indice__num"></p>
				<h3 id="sb-indice-titulo" class="indice__titulo"></h3>
				<p class="indice__estacion"></p>
				<ol class="indice__lista"></ol>
				<p class="indice__nota">Índice de ejemplo: los artículos no existen. La revista es parte de la maqueta.</p>
				<button class="btn-chapa" type="button" data-cerrar-indice>Cerrar</button>
			</div>
		</div>
	</dialog>
	<script type="application/json" id="sb-numeros" set:html={JSON.stringify(NUMEROS.map((n) => ({ n: n.n, titulo: n.titulo, estacion: n.estacion, indice: n.indice })))} />
</section>

<style>
	.revista {
		display: grid;
		justify-items: start;
	}
	.tapas {
		list-style: none;
		margin: clamp(28px, 4vw, 48px) 0 0;
		padding: 6px 4px 12px;
		width: 100%;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(20px, 3vw, 40px) clamp(16px, 2.6vw, 36px);
	}
	@media (max-width: 640px) {
		.tapas {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	.tapa {
		display: grid;
		grid-template-rows: auto auto auto auto;
		gap: 8px;
		width: 100%;
		padding: calc(22 * var(--k)) calc(22 * var(--k)) calc(46 * var(--k)) calc(26 * var(--k));
		border: 0;
		text-align: left;
		color: var(--tinta-c);
		border-radius: calc(16 * var(--k));
		transition: translate 0.25s var(--ease-out);
	}
	.tapa:nth-child(n) {
		rotate: 0deg;
	}
	li:nth-child(odd) .tapa {
		rotate: -0.8deg;
	}
	li:nth-child(even) .tapa {
		rotate: 0.8deg;
	}
	.tapa:hover {
		translate: 0 -6px;
	}
	.tapa :global(.tapa__foto) {
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		border-radius: calc(8 * var(--k));
		box-shadow: 0 0 0 calc(3 * var(--k)) rgb(255 255 255 / 0.55);
	}
	.tapa__num {
		margin-top: 6px;
		font-family: var(--f-titulo);
		font-size: 2.1rem;
		line-height: 1;
		letter-spacing: 0.01em;
	}
	.tapa__titulo {
		font-weight: 700;
		font-size: 1.25rem;
		line-height: 1.1;
		text-transform: uppercase;
		letter-spacing: 0.03em;
	}
	.tapa__estacion {
		font-weight: 600;
		font-size: 1rem;
		opacity: 0.92;
	}

	.indice {
		width: min(760px, calc(100vw - 2 * var(--gutter)));
		max-height: calc(100svh - 24px);
		overflow: auto;
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--tinta);
	}
	.indice::backdrop {
		background: rgb(8 16 11 / 0.86);
	}
	.indice__caja {
		--k: 1px;
		display: grid;
		grid-template-columns: minmax(0, 0.42fr) minmax(0, 1fr);
		gap: clamp(20px, 3vw, 36px);
		align-items: start;
		padding: clamp(28px, 4vw, 44px);
		border-radius: 18px;
		color: var(--tinta-c);
	}
	.indice__foto {
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		border-radius: 8px;
		box-shadow: 0 0 0 3px rgb(255 255 255 / 0.55), 0 8px 18px rgb(0 0 0 / 0.35);
		rotate: -1.5deg;
	}
	.indice__texto {
		display: grid;
		gap: 10px;
		justify-items: start;
		align-content: start;
	}
	.indice__num {
		font-family: var(--f-titulo);
		font-size: 1.1rem;
		letter-spacing: 0.08em;
		opacity: 0.85;
	}
	.indice__titulo {
		font-family: var(--f-titulo);
		font-weight: 400;
		font-size: clamp(2rem, 4vw, 3rem);
		line-height: 1;
		text-transform: uppercase;
	}
	.indice__estacion {
		font-weight: 700;
		font-size: 1.0625rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		padding-bottom: 10px;
		border-bottom: 2px solid currentColor;
		width: 100%;
	}
	.indice__lista {
		margin: 4px 0 0;
		padding-left: 1.4em;
		display: grid;
		gap: 8px;
		font-weight: 700;
		font-size: 1.1875rem;
	}
	.indice__nota {
		font-weight: 600;
		font-size: 0.875rem;
		opacity: 0.85;
	}
	.indice .btn-chapa {
		margin-top: 6px;
	}
	@media (max-width: 560px) {
		.indice__caja {
			grid-template-columns: minmax(0, 1fr);
		}
		.indice__foto {
			aspect-ratio: 16 / 9;
			max-height: 200px;
		}
	}
</style>

<script>
	const dlg = document.getElementById('sb-indice') as HTMLDialogElement;
	const datos: { n: number; titulo: string; estacion: string; indice: string[] }[] = JSON.parse(document.getElementById('sb-numeros')!.textContent!);
	document.querySelectorAll<HTMLButtonElement>('[data-numero]').forEach((b) =>
		b.addEventListener('click', () => {
			const d = datos.find((x) => x.n === Number(b.dataset.numero));
			if (!d) return;
			const caja = dlg.querySelector<HTMLElement>('.indice__caja')!;
			for (const v of ['--c', '--tinta-c', '--textura']) caja.style.setProperty(v, b.style.getPropertyValue(v));
			const foto = b.querySelector<HTMLImageElement>('.tapa__foto');
			if (foto) dlg.querySelector<HTMLImageElement>('.indice__foto')!.src = foto.currentSrc || foto.src;
			dlg.querySelector('.indice__num')!.textContent = `Nº ${String(d.n).padStart(2, '0')}`;
			dlg.querySelector('.indice__titulo')!.textContent = d.titulo;
			dlg.querySelector('.indice__estacion')!.textContent = d.estacion;
			dlg.querySelector('.indice__lista')!.replaceChildren(...d.indice.map((t) => Object.assign(document.createElement('li'), { textContent: t })));
			dlg.showModal();
		}),
	);
	dlg.addEventListener('click', (e) => {
		if (e.target === dlg || (e.target as HTMLElement).closest('[data-cerrar-indice]')) dlg.close();
	});
</script>

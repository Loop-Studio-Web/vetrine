---
// "Del cuadro a la chapa": el gesto firma. Tocar un cartelito de la foto (o la foto de un objeto del estante) baja la luz de
// la pared y el objeto se despega de donde estaba: la foto del objeto, impresa sobre una lámina esmaltada en su color, viaja
// desde el punto tocado hasta su lugar y al lado entra un cartel con el nombre, el precio y "Sumá a la bolsa". Todo el
// movimiento es WAAPI (transform y opacity); con movimiento reducido solo hay un fundido.
import { OBJETOS, COLOR, pesos } from './dati';
import enamelWhite from '../../assets/sobremesa/plates/enamel-grano.jpg';

const datos = OBJETOS.map((o) => ({
	id: o.id,
	nombre: o.nombre,
	precio: o.precio,
	precioTxt: pesos(o.precio),
	frase: o.frase,
	taller: o.taller,
	dias: o.dias,
	stock: o.stock,
	color: COLOR[o.color],
	foto: o.foto.src,
}));
---

<script type="application/json" id="sb-objetos" set:html={JSON.stringify(datos)} />

<dialog class="objeto" id="sb-objeto" aria-labelledby="sb-objeto-nombre">
	<div class="objeto__escena" data-escena>
		<div class="chapa chapa--flujo figura" data-figura aria-hidden="true" style="--tornillo:rgb(0 0 0 / 0.55)">
			<img class="figura__foto" alt="" />
		</div>

		<div class="chapa chapa--flujo datos" data-datos style={`--c:var(--esmalte);--tornillo:#55524c;--textura:url(${enamelWhite.src})`}>
			<button class="cerrar" type="button" data-cerrar aria-label="Cerrar">
				<svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
			</button>
			<h2 class="datos__nombre" id="sb-objeto-nombre"></h2>
			<p class="datos__precio"></p>
			<p class="datos__frase"></p>
			<ul class="datos__lista">
				<li data-taller></li>
				<li data-dias></li>
				<li data-stock></li>
			</ul>
			<div class="datos__acciones">
				<button class="btn-chapa" type="button" data-agregar>Sumá a la bolsa</button>
				<button class="corazon" type="button" data-guardar aria-pressed="false" aria-label="Guardar en mi libreta">
					<svg viewBox="0 0 24 24" aria-hidden="true" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M12 20.5s-7.5-4.6-9-9.4C1.9 7.6 4 5 6.8 5c2 0 3.7 1.1 5.2 3 1.5-1.9 3.2-3 5.2-3C20 5 22.1 7.6 21 11.1c-1.5 4.8-9 9.4-9 9.4Z" /></svg>
				</button>
				<button class="btn-chapa btn-chapa--claro" type="button" data-cerrar>Seguir mirando</button>
			</div>
		</div>
	</div>
</dialog>

<style>
	.objeto {
		width: min(1080px, calc(100vw - 2 * var(--gutter)));
		max-width: none;
		max-height: calc(100svh - 32px);
		margin: auto;
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--tinta);
		overflow: visible;
	}
	.objeto::backdrop {
		background: rgb(8 16 11 / 0.86);
	}
	.objeto__escena {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
		gap: clamp(24px, 4vw, 56px);
		align-items: center;
		padding: 8px;
		--k: clamp(0.7px, calc(100vw / 1536), 1px);
	}

	/* la foto del objeto impresa sobre una lámina esmaltada en su color, con los cuatro tornillos de todos los carteles */
	.figura {
		--alto: min(58svh, 520px);
		justify-self: center;
		width: min(100%, var(--alto));
		aspect-ratio: 1;
		padding: calc(26 * var(--k));
		border-radius: calc(18 * var(--k));
	}
	.figura__foto {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: calc(10 * var(--k));
		box-shadow: 0 0 0 calc(3 * var(--k)) rgb(255 255 255 / 0.55);
	}

	.datos {
		display: grid;
		gap: 14px;
		justify-items: start;
		padding: clamp(28px, 4vw, 52px);
		border-radius: 18px;
	}
	.cerrar {
		position: absolute;
		top: 30px;
		right: 30px;
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border: 2px solid var(--tinta);
		border-radius: 50%;
		background: transparent;
		color: var(--tinta);
		transition: background-color 0.15s, color 0.15s;
	}
	@media (hover: hover) and (pointer: fine) {
		.cerrar:hover {
			background: var(--tinta);
			color: #fff;
		}
	}
	.datos__nombre {
		font-family: var(--f-titulo);
		font-weight: 400;
		font-size: clamp(2.2rem, 4.4vw, 3.6rem);
		line-height: 1;
		text-transform: uppercase;
		padding-right: 52px;
	}
	.datos__precio {
		font-family: var(--f-titulo);
		font-size: clamp(1.9rem, 3.4vw, 2.8rem);
		line-height: 1;
		color: var(--cobalto-vivo);
	}
	.datos__frase {
		max-width: 38ch;
		font-weight: 600;
		font-size: 1.1875rem;
		line-height: 1.4;
	}
	.datos__lista {
		list-style: none;
		margin: 0;
		padding: 12px 0 0;
		display: grid;
		gap: 4px;
		border-top: 2px solid var(--tinta);
		width: 100%;
		font-weight: 700;
		font-size: 1rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	.datos__acciones {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		align-items: center;
		margin-top: 8px;
	}
	.datos .corazon {
		display: grid;
		place-items: center;
		width: 48px;
		height: 48px;
		border: 2px solid var(--tinta);
		border-radius: 10px;
		background: transparent;
		color: var(--tinta);
	}
	.datos .corazon[aria-pressed='true'] {
		background: var(--rojo);
		border-color: #fff;
		color: #fff;
	}
	.datos .corazon[aria-pressed='true'] svg {
		fill: currentColor;
	}

	@media (max-width: 820px) {
		.objeto {
			max-height: none;
			margin-block: 12px;
		}
		.objeto__escena {
			grid-template-columns: minmax(0, 1fr);
		}
		.figura {
			--alto: min(36svh, 300px);
		}
		.cerrar {
			top: 22px;
			right: 22px;
		}
	}
</style>

<script>
	import { sumar, alternarLibreta, leerLibreta } from './estado';

	type Dato = {
		id: string; nombre: string; precio: number; precioTxt: string; frase: string; taller: string; dias: number; stock: number;
		color: { fondo: string; tinta: string; filete: string };
		foto: string;
	};
	const datos: Dato[] = JSON.parse(document.getElementById('sb-objetos')!.textContent!);
	const dlg = document.getElementById('sb-objeto') as HTMLDialogElement;
	const escena = dlg.querySelector<HTMLElement>('[data-escena]')!;
	const figura = dlg.querySelector<HTMLElement>('[data-figura]')!;
	const foto = figura.querySelector<HTMLImageElement>('.figura__foto')!;
	const panel = dlg.querySelector<HTMLElement>('[data-datos]')!;
	const q = <T extends Element>(s: string) => dlg.querySelector<T>(s)!;
	const reducido = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
	const EASE = 'cubic-bezier(0.23, 1, 0.32, 1)';

	let actual: Dato | null = null;
	let origen: HTMLElement | null = null;
	let cerrando = false;
	let anims: Animation[] = [];

	// las fotos se bajan en el rato libre: al tocar, el objeto ya está listo y el movimiento no espera a la red
	const precargar = () => datos.forEach((d) => Object.assign(new Image(), { src: d.foto }));
	if ('requestIdleCallback' in window) requestIdleCallback(precargar);
	else setTimeout(precargar, 1500);

	// animaciones con fill: quedarían pegadas al diálogo cerrado (y lo dejarían invisible al reabrir): se anulan todas
	function limpiar() {
		anims.forEach((a) => a.cancel());
		anims = [];
		dlg.getAnimations({ subtree: true }).forEach((a) => a.cancel());
	}
	function correr(el: HTMLElement, kf: Keyframe[], op: KeyframeAnimationOptions & { pseudoElement?: string }) {
		const a = el.animate(kf, op);
		anims.push(a);
		return a;
	}
	// traslado y escala que llevan la lámina desde su lugar hasta un rectángulo de pantalla (el punto tocado, la bolsa)
	function haciaRect(t: DOMRect, minEscala: number) {
		const f = figura.getBoundingClientRect();
		const s = Math.min(1, Math.max(minEscala, Math.min(t.width / f.width, t.height / f.height)));
		const dx = t.left + t.width / 2 - (f.left + f.width / 2);
		const dy = t.top + t.height / 2 - (f.top + f.height / 2);
		return `translate(${dx}px, ${dy}px) scale(${s})`;
	}

	function abrir(id: string, desde: HTMLElement) {
		const d = datos.find((x) => x.id === id);
		if (!d || dlg.open) return;
		actual = d;
		origen = desde;
		cerrando = false;
		limpiar();

		q('.datos__nombre').textContent = d.nombre;
		q('.datos__precio').textContent = d.precioTxt;
		q('.datos__frase').textContent = d.frase;
		q('[data-taller]').textContent = `Hecho por ${d.taller}`;
		q('[data-dias]').textContent = `A pedido, listo en ${d.dias} días`;
		q('[data-stock]').textContent = d.stock <= 4 ? `Quedan ${d.stock}` : 'En stock';
		const g = q<HTMLButtonElement>('[data-guardar]');
		g.setAttribute('aria-pressed', String(leerLibreta().includes(d.id)));
		g.setAttribute('aria-label', `Guardar ${d.nombre} en mi libreta`);
		figura.style.setProperty('--c', d.color.fondo);
		foto.src = d.foto;
		dlg.showModal();

		if (reducido()) {
			correr(dlg, [{ opacity: 0 }, { opacity: 1 }], { duration: 160, easing: 'ease-out' });
			return;
		}
		// la lámina sale del punto tocado (foto del estante o cartelito) y llega a su lugar; el cartel entra un instante después
		correr(figura, [{ transform: haciaRect(origen.getBoundingClientRect(), 0.3), opacity: 0 }, { opacity: 1, offset: 0.3 }, { transform: 'none', opacity: 1 }], { duration: 340, easing: EASE, fill: 'backwards' });
		correr(panel, [{ opacity: 0, transform: 'translateX(24px)' }, { opacity: 1, transform: 'none' }], { duration: 260, delay: 90, easing: EASE, fill: 'backwards' });
		correr(dlg, [{ opacity: 0 }, { opacity: 1 }], { duration: 240, easing: 'ease-out', fill: 'backwards', pseudoElement: '::backdrop' });
	}

	// salir: la lámina vuelve adonde estaba (o hacia la bolsa) mientras el resto se apaga; recién entonces se cierra el diálogo
	function salir(destino: DOMRect | null, duracion: number) {
		if (!dlg.open || cerrando) return;
		cerrando = true;
		limpiar();
		const fin = () => {
			dlg.close();
			limpiar();
			cerrando = false;
		};
		if (reducido()) return fin();
		const visible = (r: DOMRect | null) => !!r && r.width > 0 && r.bottom > 0 && r.top < innerHeight && r.right > 0 && r.left < innerWidth;
		const t = destino ?? (origen?.isConnected ? origen.getBoundingClientRect() : null);
		const fuera = visible(t) ? haciaRect(t!, destino ? 0.12 : 0.3) : 'scale(0.95)';
		const fa = correr(figura, [{ transform: 'none', opacity: 1 }, { opacity: 1, offset: 0.45 }, { transform: fuera, opacity: 0 }], { duration: duracion, easing: EASE, fill: 'forwards' });
		correr(panel, [{ opacity: 1, transform: 'none' }, { opacity: 0, transform: 'translateX(16px)' }], { duration: Math.min(duracion, 160), easing: 'ease-out', fill: 'forwards' });
		correr(dlg, [{ opacity: 1 }, { opacity: 0 }], { duration: duracion, easing: 'ease-out', fill: 'forwards', pseudoElement: '::backdrop' });
		fa.finished.then(fin, fin);
	}
	const cerrar = () => salir(null, 220);
	const volar = () => {
		const bolsa = document.querySelector<HTMLElement>('[data-bolsa-abrir]');
		salir(bolsa ? bolsa.getBoundingClientRect() : null, 420);
	};

	document.addEventListener('click', (e) => {
		const el = (e.target as HTMLElement).closest<HTMLElement>('[data-objeto]');
		if (el) abrir(el.dataset.objeto!, el);
	});
	dlg.addEventListener('click', (e) => {
		const t = e.target as HTMLElement;
		// cualquier toque fuera de los dos carteles (el velo o el hueco entre ellos) cierra
		if (t === dlg || t === escena) return cerrar();
		if (t.closest('[data-cerrar]')) return cerrar();
		if (t.closest('[data-agregar]') && actual) {
			sumar(actual.id);
			window.dispatchEvent(new CustomEvent('sb:agregado', { detail: { id: actual.id } }));
			volar();
		}
		if (t.closest('[data-guardar]') && actual) {
			const on = alternarLibreta(actual.id);
			q('[data-guardar]').setAttribute('aria-pressed', String(on));
		}
	});
	dlg.addEventListener('cancel', (e) => {
		e.preventDefault();
		cerrar();
	});
</script>

---
// "Del cuadro a la chapa": el gesto firma. Tocar un cartelito de la foto (o la foto de un objeto del estante) baja la luz de
// la pared y el objeto se despega de donde estaba: la foto del objeto, impresa sobre una lámina esmaltada en su color, viaja
// desde el punto tocado hasta su lugar y al lado entra un cartel con el nombre, el precio y "Sumá a la bolsa". Todo el
// movimiento es WAAPI (transform y opacity); con movimiento reducido solo hay un fundido.
import { getImage } from 'astro:assets';
import { OBJETOS, COLOR, NOMBRE_COLOR, pesos } from './dati';
import enamelWhite from '../../assets/sobremesa/plates/enamel-grano.jpg';

// misma foto, mismos parámetros que el estante (Objetos.astro): un solo archivo webp en lugar del JPG original
const fotoWebp = (o: (typeof OBJETOS)[number]) => getImage({ src: o.foto, width: 720, quality: 76, format: 'webp' }).then((i) => i.src);
const datos = await Promise.all(OBJETOS.map(async (o) => ({
	id: o.id,
	nombre: o.nombre,
	precio: o.precio,
	precioTxt: pesos(o.precio),
	frase: o.frase,
	taller: o.taller,
	dias: o.dias,
	stock: o.stock,
	ilustrativa: !!o.ilustrativa,
	color: COLOR[o.color],
	foto: await fotoWebp(o),
	variantes: o.variantes ? await Promise.all(o.variantes.map(async (v) => ({ color: v.color, nombre: NOMBRE_COLOR[v.color], foto: await getImage({ src: v.foto, width: 720, quality: 76, format: 'webp' }).then((i) => i.src), ...COLOR[v.color] }))) : null,
})));
---

<script type="application/json" id="sb-objetos" set:html={JSON.stringify(datos)} />

<dialog class="objeto" id="sb-objeto" aria-labelledby="sb-objeto-nombre">
	<div class="objeto__escena" data-escena>
		<div class="chapa chapa--flujo figura" data-figura aria-hidden="true" style="--tornillo:rgb(0 0 0 / 0.55)">
			<img class="figura__foto" alt="" />
		</div>

		<div class="chapa chapa--flujo datos" data-datos style={`--c:var(--esmalte);--tornillo:#55524c;--textura:url(${enamelWhite.src})`}>
			<button class="cerrar" type="button" data-cerrar aria-label="Cerrar">
				<svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
			</button>
			<h2 class="datos__nombre" id="sb-objeto-nombre"></h2>
			<p class="datos__precio"></p>
			<div class="puntos" data-colores role="group" aria-label="Elegí el color" hidden>
				<span class="puntos__rotulo" data-color-nombre></span>
				<span class="puntos__fila" data-puntos></span>
			</div>
			<p class="datos__frase"></p>
			<ul class="datos__lista">
				<li data-taller></li>
				<li data-dias></li>
				<li data-stock></li>
					<li data-ilustrativa hidden>Foto ilustrativa: el objeto real es el de la portada.</li>
			</ul>
			<div class="datos__acciones">
				<button class="btn-chapa" type="button" data-agregar>Sumá a la bolsa</button>
				<button class="corazon" type="button" data-guardar aria-pressed="false" aria-label="Guardar en mi libreta">
					<svg viewBox="0 0 24 24" aria-hidden="true" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M12 20.5s-7.5-4.6-9-9.4C1.9 7.6 4 5 6.8 5c2 0 3.7 1.1 5.2 3 1.5-1.9 3.2-3 5.2-3C20 5 22.1 7.6 21 11.1c-1.5 4.8-9 9.4-9 9.4Z" /></svg>
				</button>
				<button class="btn-chapa btn-chapa--claro" type="button" data-cerrar>Seguir mirando</button>
			</div>
		</div>
	</div>
</dialog>

<style>
	.objeto {
		width: min(1080px, calc(100vw - 2 * var(--gutter)));
		max-width: none;
		max-height: calc(100svh - 32px);
		margin: auto;
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--tinta);
		overflow: visible;
	}
	.objeto::backdrop {
		background: rgb(8 16 11 / 0.86);
	}
	.objeto__escena {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
		gap: clamp(24px, 4vw, 56px);
		align-items: center;
		padding: 8px;
		--k: clamp(0.7px, calc(100vw / 1536), 1px);
	}

	/* la foto del objeto impresa sobre una lámina esmaltada en su color, con los cuatro tornillos de todos los carteles */
	.figura {
		--alto: min(58svh, 520px);
		justify-self: center;
		width: min(100%, var(--alto));
		aspect-ratio: 1;
		padding: calc(26 * var(--k));
		border-radius: calc(18 * var(--k));
	}
	/* con el shader activo (clase gl) el canvas dibuja la foto y el reborde; la img queda debajo solo para dar el tamaño */
	.figura.gl .figura__foto {
		visibility: hidden;
	}
	.figura.gl::after {
		display: none;
	}
	.figura__foto {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: calc(10 * var(--k));
		box-shadow: 0 0 0 calc(3 * var(--k)) rgb(255 255 255 / 0.55);
	}

	.datos {
		display: grid;
		gap: 14px;
		justify-items: start;
		padding: clamp(28px, 4vw, 52px);
		border-radius: 18px;
	}
	.cerrar {
		position: absolute;
		top: 30px;
		right: 30px;
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border: 2px solid var(--tinta);
		border-radius: 50%;
		background: transparent;
		color: var(--tinta);
		transition: background-color 0.15s, color 0.15s;
	}
	@media (hover: hover) and (pointer: fine) {
		.cerrar:hover {
			background: var(--tinta);
			color: #fff;
		}
	}
	.datos__nombre {
		font-family: var(--f-titulo);
		font-weight: 400;
		font-size: clamp(2.2rem, 4.4vw, 3.6rem);
		line-height: 1.08;
		text-wrap: balance;
		text-transform: uppercase;
		padding-right: 52px;
	}
	.datos__precio {
		font-family: var(--f-titulo);
		font-size: clamp(1.9rem, 3.4vw, 2.8rem);
		line-height: 1;
		color: var(--cobalto-vivo);
	}
	.datos__frase {
		max-width: 38ch;
		font-weight: 600;
		font-size: 1.1875rem;
		line-height: 1.4;
	}
	.datos__lista {
		list-style: none;
		margin: 0;
		padding: 12px 0 0;
		display: grid;
		gap: 4px;
		border-top: 2px solid var(--tinta);
		width: 100%;
		font-weight: 700;
		font-size: 1rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	.datos__acciones {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		align-items: center;
		margin-top: 8px;
	}
	.datos .corazon {
		display: grid;
		place-items: center;
		width: 48px;
		height: 48px;
		border: 2px solid var(--tinta);
		border-radius: 10px;
		background: transparent;
		color: var(--tinta);
	}
	.datos .corazon[aria-pressed='true'] {
		background: var(--rojo);
		border-color: #fff;
		color: #fff;
	}
	.datos .corazon[aria-pressed='true'] svg {
		fill: currentColor;
	}

	@media (max-width: 820px) {
		/* el diálogo ocupa toda la pantalla y se desplaza por dentro: en teléfonos bajos la lámina y el cartel no caben juntos y
		   un diálogo más alto que la pantalla (position: fixed) se cortaba arriba; así además el vuelo desde el punto tocado
		   no queda recortado por la caja del diálogo */
		.objeto {
			position: fixed;
			inset: 0;
			width: 100%;
			height: 100%;
			max-height: none;
			margin: 0;
			padding: 12px var(--gutter);
			overflow-y: auto;
			overscroll-behavior: contain;
		}
		.objeto__escena {
			grid-template-columns: minmax(0, 1fr);
			min-height: 100%;
			align-content: center;
			align-content: safe center; /* con un nombre largo el contenido supera la pantalla: sin "safe" se cortaba arriba, fuera de alcance del scroll */
			padding: 0;
		}
		.figura {
			--alto: min(36svh, 300px);
		}
		.cerrar {
			top: 22px;
			right: 22px;
		}
	}
</style>

<script>
	import { sumar, alternarLibreta, leerLibreta, bolsaVisible } from './estado';
	import type { Lamina } from './chapa-gl';

	type Dato = {
		id: string; nombre: string; precio: number; precioTxt: string; frase: string; taller: string; dias: number; stock: number; ilustrativa: boolean;
		color: { fondo: string; tinta: string; filete: string };
		foto: string;
		variantes: { color: string; nombre: string; foto: string; fondo: string; tinta: string; filete: string }[] | null;
	};
	const datos: Dato[] = JSON.parse(document.getElementById('sb-objetos')!.textContent!);
	const dlg = document.getElementById('sb-objeto') as HTMLDialogElement;
	const escena = dlg.querySelector<HTMLElement>('[data-escena]')!;
	const figura = dlg.querySelector<HTMLElement>('[data-figura]')!;
	const foto = figura.querySelector<HTMLImageElement>('.figura__foto')!;
	const panel = dlg.querySelector<HTMLElement>('[data-datos]')!;
	const q = <T extends Element>(s: string) => dlg.querySelector<T>(s)!;
	const reducido = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
	const EASE = 'cubic-bezier(0.23, 1, 0.32, 1)';

	let actual: Dato | null = null;
	let colorActual = ''; // color elegido de un objeto con variantes (vacío si el objeto tiene una sola foto)
	const claveActual = () => (actual && actual.variantes ? `${actual.id}~${colorActual}` : actual?.id ?? '');
	let origen: HTMLElement | null = null;
	let cerrando = false;
	let anims: Animation[] = [];

	// las fotos se bajan en el rato libre: al tocar, el objeto ya está listo y el movimiento no espera a la red
	// (salvo con ahorro de datos: ahí la foto se baja recién al tocar)
	const precargar = () => datos.forEach((d) => Object.assign(new Image(), { src: d.foto }));
	// el shader de la lámina (chapa-gl.ts) se baja y se compila también en el rato libre; si no está listo o no hay WebGL,
	// el diálogo abre con la lámina CSS de siempre
	let lamina: Lamina | null = null;
	const cargarGL = () =>
		import('./chapa-gl')
			.then((m) => (lamina = m.crearLamina(figura)))
			.catch(() => {});
	const enReposo = (f: () => void) => ('requestIdleCallback' in window ? requestIdleCallback(f) : setTimeout(f, 1500));
	if (!(navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData) enReposo(precargar);
	// compilar el shader pesa en el hilo principal (en equipos sin GPU o con WebGL por software, segundos): se espera al primer gesto
	// de la persona (o a los 8 s) para no cargarle esa cuenta a la primera pantalla
	let glPedido = false;
	const pedirGL = () => {
		if (glPedido) return;
		glPedido = true;
		['pointerdown', 'pointermove', 'touchstart', 'keydown', 'scroll', 'wheel'].forEach((t) => removeEventListener(t, pedirGL));
		enReposo(cargarGL);
	};
	['pointerdown', 'pointermove', 'touchstart', 'keydown', 'scroll', 'wheel'].forEach((t) => addEventListener(t, pedirGL, { passive: true }));
	setTimeout(pedirGL, 8000);

	// animaciones con fill: quedarían pegadas al diálogo cerrado (y lo dejarían invisible al reabrir): se anulan todas
	function limpiar() {
		anims.forEach((a) => a.cancel());
		anims = [];
		dlg.getAnimations({ subtree: true }).forEach((a) => a.cancel());
	}
	function correr(el: HTMLElement, kf: Keyframe[], op: KeyframeAnimationOptions & { pseudoElement?: string }) {
		const a = el.animate(kf, op);
		anims.push(a);
		return a;
	}
	// traslado y escala que llevan la lámina desde su lugar hasta un rectángulo de pantalla (el punto tocado, la bolsa)
	function haciaRect(t: DOMRect, minEscala: number) {
		const f = figura.getBoundingClientRect();
		const s = Math.min(1, Math.max(minEscala, Math.min(t.width / f.width, t.height / f.height)));
		const dx = t.left + t.width / 2 - (f.left + f.width / 2);
		const dy = t.top + t.height / 2 - (f.top + f.height / 2);
		return `translate(${dx}px, ${dy}px) scale(${s})`;
	}

	function pintarGuardar() {
		if (!actual) return;
		const g = q<HTMLButtonElement>('[data-guardar]');
		g.setAttribute('aria-pressed', String(leerLibreta().includes(claveActual())));
		g.setAttribute('aria-label', `Guardar ${actual.nombre}${colorActual ? ` (${nombreColor()})` : ''} en mi libreta`);
	}
	const nombreColor = () => actual?.variantes?.find((v) => v.color === colorActual)?.nombre ?? '';
	// los puntos de color: solo si el objeto viene en varios; al elegir uno la lámina cambia de color y la foto se funde de nuevo
	function pintarColores(d: Dato) {
		const caja = q<HTMLElement>('[data-colores]');
		caja.hidden = !d.variantes;
		if (!d.variantes) return;
		q('[data-color-nombre]').textContent = `Color: ${nombreColor()}`;
		const fila = q<HTMLElement>('[data-puntos]');
		// los botones se arman solo cuando cambia el objeto: al elegir un color el foco tiene que quedarse en su punto
		if (fila.dataset.objeto !== d.id) {
			fila.dataset.objeto = d.id;
			fila.replaceChildren(
				...d.variantes.map((v) => {
					const b = document.createElement('button');
					b.type = 'button';
					b.className = 'punto';
					b.dataset.color = v.color;
					b.style.setProperty('--p', v.fondo);
					b.setAttribute('aria-label', v.nombre);
					return b;
				}),
			);
		}
		fila.querySelectorAll<HTMLElement>('.punto').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.color === colorActual)));
	}
	function elegirColor(color: string) {
		const d = actual;
		const v = d?.variantes?.find((x) => x.color === color);
		if (!d || !v || color === colorActual || cerrando) return;
		colorActual = color;
		pintarColores(d);
		pintarGuardar();
		figura.style.setProperty('--c', v.fondo);
		foto.src = v.foto;
		if (lamina?.activa()) {
			foto
				.decode()
				.then(() => {
					if (dlg.open && actual === d && colorActual === color && !cerrando) lamina!.mostrar(foto, reducido());
				})
				.catch(() => figura.classList.remove('gl'));
		}
	}

	function abrir(id: string, desde: HTMLElement) {
		const d = datos.find((x) => x.id === id);
		if (!d || dlg.open) return;
		actual = d;
		origen = desde;
		cerrando = false;
		limpiar();

		q('.datos__nombre').textContent = d.nombre;
		q('.datos__precio').textContent = d.precioTxt;
		q('.datos__frase').textContent = d.frase;
		q('[data-taller]').textContent = `Hecho por ${d.taller}`;
		q('[data-dias]').textContent = `A pedido, listo en ${d.dias} días`;
		q('[data-stock]').textContent = d.stock <= 4 ? `Quedan ${d.stock}` : 'En stock';
		q<HTMLElement>('[data-ilustrativa]').hidden = !d.ilustrativa;
		colorActual = d.variantes ? (d.variantes.find((v) => v.color === desde.dataset.color) ?? d.variantes[0]).color : '';
		const v = d.variantes?.find((x) => x.color === colorActual);
		pintarColores(d);
		pintarGuardar();
		figura.style.setProperty('--c', v ? v.fondo : d.color.fondo);
		foto.src = v ? v.foto : d.foto;
		dlg.showModal();

		// la foto pasa a ser el shader: sus píxeles se funden en el esmalte (con movimiento reducido, el estado final quieto)
		if (lamina?.activa()) {
			figura.classList.add('gl');
			foto
				.decode()
				.then(() => {
					if (dlg.open && actual === d && !cerrando) lamina!.mostrar(foto, reducido());
				})
				.catch(() => figura.classList.remove('gl'));
		}

		if (reducido()) {
			correr(dlg, [{ opacity: 0 }, { opacity: 1 }], { duration: 160, easing: 'ease-out' });
			return;
		}
		// la lámina sale del punto tocado (foto del estante o cartelito) y llega a su lugar; el cartel entra un instante después
		correr(figura, [{ transform: haciaRect(origen.getBoundingClientRect(), 0.3), opacity: 0 }, { opacity: 1, offset: 0.3 }, { transform: 'none', opacity: 1 }], { duration: 340, easing: EASE, fill: 'backwards' });
		correr(panel, [{ opacity: 0, transform: 'translateX(24px)' }, { opacity: 1, transform: 'none' }], { duration: 260, delay: 90, easing: EASE, fill: 'backwards' });
		correr(dlg, [{ opacity: 0 }, { opacity: 1 }], { duration: 240, easing: 'ease-out', fill: 'backwards', pseudoElement: '::backdrop' });
	}

	// salir: la lámina vuelve adonde estaba (o hacia la bolsa) mientras el resto se apaga; recién entonces se cierra el diálogo
	function salir(destino: DOMRect | null, duracion: number) {
		if (!dlg.open || cerrando) return;
		cerrando = true;
		limpiar();
		const fin = () => {
			dlg.close();
			limpiar();
			lamina?.ocultar();
			figura.classList.remove('gl');
			cerrando = false;
		};
		if (reducido()) return fin();
		const visible = (r: DOMRect | null) => !!r && r.width > 0 && r.bottom > 0 && r.top < innerHeight && r.right > 0 && r.left < innerWidth;
		const t = destino ?? (origen?.isConnected ? origen.getBoundingClientRect() : null);
		const fuera = visible(t) ? haciaRect(t!, destino ? 0.12 : 0.3) : 'scale(0.95)';
		const fa = correr(figura, [{ transform: 'none', opacity: 1 }, { opacity: 1, offset: 0.45 }, { transform: fuera, opacity: 0 }], { duration: duracion, easing: EASE, fill: 'forwards' });
		correr(panel, [{ opacity: 1, transform: 'none' }, { opacity: 0, transform: 'translateX(16px)' }], { duration: Math.min(duracion, 160), easing: 'ease-out', fill: 'forwards' });
		correr(dlg, [{ opacity: 1 }, { opacity: 0 }], { duration: duracion, easing: 'ease-out', fill: 'forwards', pseudoElement: '::backdrop' });
		fa.finished.then(fin, fin);
	}
	const cerrar = () => salir(null, 220);
	const volar = () => {
		const bolsa = bolsaVisible();
		salir(bolsa ? bolsa.getBoundingClientRect() : null, 420);
	};

	document.addEventListener('click', (e) => {
		const el = (e.target as HTMLElement).closest<HTMLElement>('[data-objeto]');
		if (el) abrir(el.dataset.objeto!, el);
	});
	dlg.addEventListener('click', (e) => {
		const t = e.target as HTMLElement;
		// cualquier toque fuera de los dos carteles (el velo o el hueco entre ellos) cierra
		if (t === dlg || t === escena) return cerrar();
		if (t.closest('[data-cerrar]')) return cerrar();
		const punto = t.closest<HTMLElement>('.punto[data-color]');
		if (punto) return elegirColor(punto.dataset.color!);
		if (t.closest('[data-agregar]') && actual) {
			sumar(claveActual());
			window.dispatchEvent(new CustomEvent('sb:agregado', { detail: { id: claveActual() } }));
			volar();
		}
		if (t.closest('[data-guardar]') && actual) {
			const on = alternarLibreta(claveActual());
			q('[data-guardar]').setAttribute('aria-pressed', String(on));
		}
	});
	dlg.addEventListener('pointermove', (e) => lamina?.luz(e.clientX, e.clientY));
	dlg.addEventListener('cancel', (e) => {
		e.preventDefault();
		cerrar();
	});
</script>

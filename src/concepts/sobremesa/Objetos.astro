---
// Lo que vimos en la mesa: los objetos de la historia, cada uno en su cartel de esmalte. Ritmo irregular (3, 4 y 5 columnas),
// no una grilla de tarjetas iguales. Tocar la foto saca el objeto del cuadro (ver Chapa.astro).
import { Image } from 'astro:assets';
import { OBJETOS, COLOR, pesos } from './dati';
import enamelWhite from '../../assets/sobremesa/plates/enamel-grano.jpg';
---

<section class="objetos" id="objetos" aria-labelledby="objetos-titulo">
	<h2 id="objetos-titulo" class="chapa chapa--flujo rotulo" style={`--c:var(--esmalte);--tornillo:#55524c;--textura:url(${enamelWhite.src})`}>Lo que vimos en la mesa</h2>
	<p class="bajada">Todo lo que cuelga de la foto de la portada y unas cosas más de la misma casa. Tocá la foto de uno y lo ves de cerca.</p>

		  <ul class="estante">
	  {OBJETOS.slice(0, 1).map((o) => { const c = COLOR[o.color]; return (
	  <li class="obj obj--ancha">
	  <article class="chapa chapa--flujo tarjeta tarjeta--ancha" style={`--c:${c.fondo};--tinta-c:${c.tinta};--filete:${c.filete};--textura:url(${enamelWhite.src});--tornillo:rgb(0 0 0 / 0.55)`}>
	  <button class="tarjeta__foto" type="button" data-objeto={o.id} aria-label={`${o.nombre}: ver de cerca`}>
	  <Image src={o.foto} alt={`${o.nombre}, foto de ejemplo`} width={720} quality={76} format="webp" sizes="(min-width: 900px) 40vw, 90vw" loading="lazy" />
	  <span class="tarjeta__ver" aria-hidden="true">Ver de cerca</span>
	  </button>
	  <div class="tarjeta__cuerpo">
	  <div class="tarjeta__texto">
	  <h3 class="tarjeta__nombre">{o.nombre}</h3>
	  <p class="tarjeta__frase">{o.frase}</p>
	  <p class="tarjeta__meta">{o.taller} · listo en {o.dias} días</p>
	  </div>
	  <div class="tarjeta__pie">
	  <p class="tarjeta__precio">
	  <strong>{pesos(o.precio)}</strong>
	  <span class:list={['tarjeta__stock', { 'tarjeta__stock--poco': o.stock <= 4 }]}>{o.stock <= 4 ? `Quedan ${o.stock}` : 'En stock'}</span>
	  </p>
	  <button class="btn-chapa btn-chapa--chico" type="button" data-sumar={o.id} aria-label={`Sumá ${o.nombre} a la bolsa`}>Sumá</button>
	  <button class="corazon" type="button" data-libreta={o.id} aria-pressed="false" aria-label={`Guardar ${o.nombre} en mi libreta`}>
	  <svg viewBox="0 0 24 24" aria-hidden="true" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M12 20.5s-7.5-4.6-9-9.4C1.9 7.600 4 5 6.800 5c2 0 3.700 1.100 5.200 3 1.500-1.900 3.200-3 5.200-3C20 5 22.100 7.600 21 11.100c-1.500 4.800-9 9.400-9 9.400Z" /></svg>
	  </button>
	  </div>
	  </div>
	  </article>
	  </li>
	  ); })}
	  <li class="grupo">
	  <ul class="fila">
	  {OBJETOS.slice(1, 4).map((o) => { const c = COLOR[o.color]; return (
	  <li class="obj obj--alta">
	  <article class="chapa chapa--flujo tarjeta tarjeta--alta" style={`--c:${c.fondo};--tinta-c:${c.tinta};--filete:${c.filete};--textura:url(${enamelWhite.src});--tornillo:rgb(0 0 0 / 0.55)`}>
	  <button class="tarjeta__foto" type="button" data-objeto={o.id} aria-label={`${o.nombre}: ver de cerca`}>
	  <Image src={o.foto} alt={`${o.nombre}, foto de ejemplo`} width={720} quality={76} format="webp" sizes="(min-width: 900px) 40vw, 90vw" loading="lazy" />
	  <span class="tarjeta__ver" aria-hidden="true">Ver de cerca</span>
	  </button>
	  <div class="tarjeta__texto">
	  <h3 class="tarjeta__nombre">{o.nombre}</h3>
	  <p class="tarjeta__frase">{o.frase}</p>
	  <p class="tarjeta__meta">{o.taller} · listo en {o.dias} días</p>
	  </div>
	  <div class="tarjeta__pie">
	  <p class="tarjeta__precio">
	  <strong>{pesos(o.precio)}</strong>
	  <span class:list={['tarjeta__stock', { 'tarjeta__stock--poco': o.stock <= 4 }]}>{o.stock <= 4 ? `Quedan ${o.stock}` : 'En stock'}</span>
	  </p>
	  <button class="btn-chapa btn-chapa--chico" type="button" data-sumar={o.id} aria-label={`Sumá ${o.nombre} a la bolsa`}>Sumá</button>
	  <button class="corazon" type="button" data-libreta={o.id} aria-pressed="false" aria-label={`Guardar ${o.nombre} en mi libreta`}>
	  <svg viewBox="0 0 24 24" aria-hidden="true" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M12 20.5s-7.5-4.6-9-9.4C1.9 7.600 4 5 6.800 5c2 0 3.700 1.100 5.200 3 1.500-1.900 3.200-3 5.200-3C20 5 22.100 7.600 21 11.100c-1.500 4.800-9 9.400-9 9.400Z" /></svg>
	  </button>
	  </div>
	  </article>
	  </li>
	  ); })}
	  </ul>
	  </li>
	  {OBJETOS.slice(4, 5).map((o) => { const c = COLOR[o.color]; return (
	  <li class="obj obj--ancha obj--inversa">
	  <article class="chapa chapa--flujo tarjeta tarjeta--ancha" style={`--c:${c.fondo};--tinta-c:${c.tinta};--filete:${c.filete};--textura:url(${enamelWhite.src});--tornillo:rgb(0 0 0 / 0.55)`}>
	  <button class="tarjeta__foto" type="button" data-objeto={o.id} aria-label={`${o.nombre}: ver de cerca`}>
	  <Image src={o.foto} alt={`${o.nombre}, foto de ejemplo`} width={720} quality={76} format="webp" sizes="(min-width: 900px) 40vw, 90vw" loading="lazy" />
	  <span class="tarjeta__ver" aria-hidden="true">Ver de cerca</span>
	  </button>
	  <div class="tarjeta__cuerpo">
	  <div class="tarjeta__texto">
	  <h3 class="tarjeta__nombre">{o.nombre}</h3>
	  <p class="tarjeta__frase">{o.frase}</p>
	  <p class="tarjeta__meta">{o.taller} · listo en {o.dias} días</p>
	  </div>
	  <div class="tarjeta__pie">
	  <p class="tarjeta__precio">
	  <strong>{pesos(o.precio)}</strong>
	  <span class:list={['tarjeta__stock', { 'tarjeta__stock--poco': o.stock <= 4 }]}>{o.stock <= 4 ? `Quedan ${o.stock}` : 'En stock'}</span>
	  </p>
	  <button class="btn-chapa btn-chapa--chico" type="button" data-sumar={o.id} aria-label={`Sumá ${o.nombre} a la bolsa`}>Sumá</button>
	  <button class="corazon" type="button" data-libreta={o.id} aria-pressed="false" aria-label={`Guardar ${o.nombre} en mi libreta`}>
	  <svg viewBox="0 0 24 24" aria-hidden="true" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M12 20.5s-7.5-4.6-9-9.4C1.9 7.600 4 5 6.800 5c2 0 3.700 1.100 5.200 3 1.500-1.900 3.200-3 5.200-3C20 5 22.100 7.600 21 11.100c-1.500 4.800-9 9.400-9 9.400Z" /></svg>
	  </button>
	  </div>
	  </div>
	  </article>
	  </li>
	  ); })}
	  <li class="grupo">
	  <ul class="fila">
	  {OBJETOS.slice(5, 8).map((o) => { const c = COLOR[o.color]; return (
	  <li class="obj obj--alta">
	  <article class="chapa chapa--flujo tarjeta tarjeta--alta" style={`--c:${c.fondo};--tinta-c:${c.tinta};--filete:${c.filete};--textura:url(${enamelWhite.src});--tornillo:rgb(0 0 0 / 0.55)`}>
	  <button class="tarjeta__foto" type="button" data-objeto={o.id} aria-label={`${o.nombre}: ver de cerca`}>
	  <Image src={o.foto} alt={`${o.nombre}, foto de ejemplo`} width={720} quality={76} format="webp" sizes="(min-width: 900px) 40vw, 90vw" loading="lazy" />
	  <span class="tarjeta__ver" aria-hidden="true">Ver de cerca</span>
	  </button>
	  <div class="tarjeta__texto">
	  <h3 class="tarjeta__nombre">{o.nombre}</h3>
	  <p class="tarjeta__frase">{o.frase}</p>
	  <p class="tarjeta__meta">{o.taller} · listo en {o.dias} días</p>
	  </div>
	  <div class="tarjeta__pie">
	  <p class="tarjeta__precio">
	  <strong>{pesos(o.precio)}</strong>
	  <span class:list={['tarjeta__stock', { 'tarjeta__stock--poco': o.stock <= 4 }]}>{o.stock <= 4 ? `Quedan ${o.stock}` : 'En stock'}</span>
	  </p>
	  <button class="btn-chapa btn-chapa--chico" type="button" data-sumar={o.id} aria-label={`Sumá ${o.nombre} a la bolsa`}>Sumá</button>
	  <button class="corazon" type="button" data-libreta={o.id} aria-pressed="false" aria-label={`Guardar ${o.nombre} en mi libreta`}>
	  <svg viewBox="0 0 24 24" aria-hidden="true" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M12 20.5s-7.5-4.6-9-9.4C1.9 7.600 4 5 6.800 5c2 0 3.700 1.100 5.200 3 1.500-1.900 3.200-3 5.200-3C20 5 22.100 7.600 21 11.100c-1.500 4.800-9 9.400-9 9.400Z" /></svg>
	  </button>
	  </div>
	  </article>
	  </li>
	  ); })}
	  </ul>
	  </li>
	  </ul>
</section>

<style>
	.objetos {
		display: grid;
		justify-items: start;
	}
	/* el estante: una lámina ancha, tres altas a distinta altura, otra ancha, otras tres, y el cierre */
	.estante {
		list-style: none;
		margin: clamp(28px, 4vw, 48px) 0 0;
		padding: 0;
		width: 100%;
		display: grid;
		gap: clamp(36px, 5vw, 76px);
	}
	.estante ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.obj {
		container-type: inline-size;
	}
	.grupo {
		width: 100%;
	}
	.fila {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(20px, 3vw, 48px);
		align-items: start;
	}
	/* las altas no van en línea: cada una cuelga a su altura y gira un poco, como puestas a mano */
	.obj--alta:nth-child(1) {
		rotate: -0.5deg;
	}
	.obj--alta:nth-child(2) {
		rotate: 0.6deg;
		margin-top: clamp(0px, 7vw, 108px);
	}
	.obj--alta:nth-child(3) {
		rotate: -0.3deg;
		margin-top: clamp(0px, 3vw, 44px);
	}
	.obj--alta:nth-child(1) .tarjeta__foto {
		aspect-ratio: 4 / 5;
	}
	.obj--alta:nth-child(2) .tarjeta__foto {
		aspect-ratio: 1;
	}
	.obj--alta:nth-child(3) .tarjeta__foto {
		aspect-ratio: 3 / 4;
	}
	.tarjeta--alta .tarjeta__nombre {
		font-size: clamp(1.7rem, 2.6vw, 2.5rem);
	}
	.tarjeta--ancha {
		grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
		align-items: center;
		gap: clamp(18px, 3vw, 48px);
		padding: calc(40 * var(--k));
	}
	.obj--inversa .tarjeta--ancha {
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
	}
	.obj--inversa .tarjeta--ancha > .tarjeta__foto {
		order: 2;
	}
	.tarjeta--ancha .tarjeta__foto {
		aspect-ratio: 16 / 11;
	}
	.tarjeta__cuerpo {
		display: grid;
		gap: 18px;
	}
	.tarjeta--ancha .tarjeta__nombre {
		font-size: clamp(2.2rem, 4.2vw, 3.8rem);
	}
	.tarjeta--ancha .tarjeta__frase {
		font-size: 1.25rem;
		max-width: 34ch;
	}
	.tarjeta {
		display: grid;
		gap: calc(14 * var(--k));
		padding: calc(34 * var(--k)) calc(34 * var(--k)) calc(30 * var(--k));
		color: var(--tinta-c);
		border-radius: calc(18 * var(--k));
	}
	.tarjeta__foto {
		position: relative;
		display: block;
		padding: 0;
		border: 0;
		border-radius: calc(10 * var(--k));
		overflow: hidden;
		background: rgb(0 0 0 / 0.25);
		aspect-ratio: 4 / 3;
		box-shadow: 0 0 0 calc(4 * var(--k)) var(--filete), 0 calc(6 * var(--k)) calc(12 * var(--k)) rgb(0 0 0 / 0.4);
		cursor: pointer;
	}
	.tarjeta__foto :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: scale 0.5s var(--ease-out);
	}
	.tarjeta__foto:hover :global(img) {
		scale: 1.05;
	}
	.tarjeta__ver {
		position: absolute;
		left: 10px;
		bottom: 10px;
		padding: 6px 12px;
		border-radius: 6px;
		background: rgb(11 30 100 / 0.92);
		color: #fff;
		font-family: var(--f-cartel);
		font-weight: 700;
		font-size: 1rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		opacity: 0.94;
		transition: opacity 0.2s, background 0.2s;
	}
	.tarjeta__foto:hover .tarjeta__ver,
	.tarjeta__foto:focus-visible .tarjeta__ver {
		opacity: 1;
		background: var(--cobalto-vivo);
	}
	.tarjeta__nombre {
		font-family: var(--f-titulo);
		font-weight: 400;
		font-size: clamp(1.6rem, 2.6vw, 2.3rem);
		line-height: 1.05;
		text-transform: uppercase;
		letter-spacing: 0.01em;
	}
	.tarjeta__frase {
		margin-top: 6px;
		font-weight: 600;
		font-size: 1.0625rem;
		line-height: 1.35;
		max-width: 38ch;
	}
	.tarjeta__meta {
		margin-top: 8px;
		font-weight: 700;
		font-size: 0.9375rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		opacity: 0.9;
	}
	.tarjeta__pie {
		display: flex;
		align-items: center;
		gap: 12px;
		flex-wrap: wrap;
		padding-top: calc(14 * var(--k));
		border-top: 2px solid currentColor;
	}
	/* en las tarjetas angostas el precio ocupa su fila y Sumá + corazón van juntos debajo */
	.obj {
		container-type: inline-size;
	}
	@container (max-width: 330px) {
		.tarjeta__precio {
			flex: 1 1 100%;
			grid-auto-flow: column;
			justify-content: space-between;
			align-items: baseline;
		}
	}
	.tarjeta__precio {
		margin-right: auto;
		display: grid;
		line-height: 1.1;
	}
	.tarjeta__precio strong {
		font-family: var(--f-titulo);
		font-weight: 400;
		font-size: 1.75rem;
		letter-spacing: 0.01em;
	}
	.tarjeta__stock {
		font-weight: 700;
		font-size: 0.9375rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		opacity: 0.88;
	}
	.tarjeta__stock--poco {
		opacity: 1;
	}
	.tarjeta__stock--poco::before {
		content: '';
		display: inline-block;
		width: 0.5em;
		height: 0.5em;
		margin-right: 0.45em;
		border-radius: 50%;
		background: currentColor;
		vertical-align: 0.05em;
	}
	:global(.btn-chapa--chico) {
		min-height: 44px;
		padding: 0 18px;
		font-size: 1.125rem;
	}
	.corazon {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border: 2px solid currentColor;
		border-radius: 10px;
		background: transparent;
		color: inherit;
		transition: background 0.2s, color 0.2s, scale 0.2s var(--ease-out);
	}
	.corazon:hover {
		scale: 1.06;
	}
	.corazon[aria-pressed='true'] {
		background: var(--rojo);
		border-color: #fff;
		color: #fff;
	}
	.corazon[aria-pressed='true'] svg {
		fill: currentColor;
	}

	@media (max-width: 900px) {
		.tarjeta--ancha,
		.obj--inversa .tarjeta--ancha {
			grid-template-columns: minmax(0, 1fr);
		}
		.obj--inversa .tarjeta--ancha > .tarjeta__foto {
			order: 0;
		}
		.fila {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.obj--alta:nth-child(n) {
			margin-top: 0;
			rotate: 0deg;
		}
	}
	@media (max-width: 620px) {
		.fila {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>

<script>
	import { sumar, alternarLibreta, leerLibreta } from './estado';

	// sumar al instante desde la tarjeta y dar una señal visible en el propio botón
	document.addEventListener('click', (e) => {
		const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-sumar]');
		if (!b) return;
		sumar(b.dataset.sumar!);
		window.dispatchEvent(new CustomEvent('sb:agregado', { detail: { id: b.dataset.sumar, origen: b } }));
		const t = b.textContent;
		b.textContent = 'En la bolsa ✓';
		setTimeout(() => (b.textContent = t), 1400);
	});

	// el estado del corazón lo dice aria-pressed; la etiqueta no cambia
	const pintarCorazones = () => {
		const l = leerLibreta();
		document.querySelectorAll<HTMLButtonElement>('[data-libreta]').forEach((el) => el.setAttribute('aria-pressed', String(l.includes(el.dataset.libreta!))));
	};
	document.addEventListener('click', (e) => {
		const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-libreta]');
		if (!b) return;
		alternarLibreta(b.dataset.libreta!);
	});
	window.addEventListener('sb:libreta', pintarCorazones);
	pintarCorazones();
</script>

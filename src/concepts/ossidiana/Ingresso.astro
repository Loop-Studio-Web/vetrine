---
import { Image } from 'astro:assets';
import sala from '../../assets/ossidiana/sala/sala-rossa.jpg';
---

<section class="ingresso" id="ingresso" aria-labelledby="ingresso-titolo" data-ingresso>
	<div class="ingresso__room">
		<Image
			src={sala}
			alt=""
			widths={[900, 1400, 2000]}
			sizes="100vw"
			loading="eager"
			fetchpriority="high"
			class="ingresso__img"
		/>
	</div>
	<div class="ingresso__dark" aria-hidden="true"></div>

	<div class="ingresso__content">
		<p class="ingresso__kicker">Menù degustazione &middot; quattordici coperti</p>
		<h1 id="ingresso-titolo" class="ingresso__title">Ossidiana</h1>
		<p class="ingresso__lead">
			Una cena in cinque atti. La sala è al buio: accendiamo la luce una portata alla volta.
		</p>
		<a class="ingresso__cta" href="#percorso">
			<span>Entra in sala</span>
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"
				><path d="M12 4v16m0 0-6-6m6 6 6-6"></path></svg
			>
		</a>
	</div>
	<p class="ingresso__note">Vetrina dimostrativa &middot; ristorante di fantasia</p>
</section>

<style>
	.ingresso {
		--mx: 68%;
		--my: 58%;
		position: relative;
		min-height: 100svh;
		display: flex;
		align-items: flex-end;
		padding: 120px var(--gutter) 90px;
		overflow: hidden;
		isolation: isolate;
	}
	.ingresso__room {
		position: absolute;
		inset: 0;
		z-index: -2;
	}
	.ingresso__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 45%;
		filter: brightness(1.35) saturate(1.1);
	}
	/* Il buio: un velo quasi opaco con un foro di luce che si sposta */
	.ingresso__dark {
		position: absolute;
		inset: 0;
		z-index: -1;
		background: radial-gradient(
			circle clamp(220px, 34vmax, 520px) at var(--mx) var(--my),
			rgba(11, 11, 12, 0.08) 0%,
			rgba(11, 11, 12, 0.55) 38%,
			rgba(11, 11, 12, 0.93) 100%
		);
	}
	.ingresso__content {
		position: relative;
		max-width: 1100px;
	}
	.ingresso__kicker {
		font-family: var(--sans);
		font-size: 0.78rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--ivory-dim);
		margin-bottom: 18px;
		animation: sale 1.6s 0.3s both;
	}
	.ingresso__title {
		font-family: var(--serif);
		font-weight: 400;
		font-size: clamp(2.4rem, 10.5vw, 8.5rem);
		line-height: 1;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		margin-right: -0.18em;
		animation: sale 2.4s 0.6s both;
	}
	.ingresso__lead {
		max-width: 34ch;
		margin-top: 28px;
		font-size: 1.15rem;
		color: var(--ivory-dim);
		animation: sale 2s 1.4s both;
	}
	.ingresso__cta {
		display: inline-flex;
		align-items: center;
		gap: 14px;
		margin-top: 36px;
		padding: 15px 28px;
		border: 1px solid var(--ivory-faint);
		background: rgba(11, 11, 12, 0.55);
		font-size: 0.8rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		text-decoration: none;
		transition: background 0.3s, border-color 0.3s;
		animation: sale 2s 1.9s both;
	}
	.ingresso__cta:hover {
		background: var(--wine);
		border-color: var(--wine);
	}
	.ingresso__cta svg {
		animation: scendi 2.4s ease-in-out infinite;
	}
	.ingresso__note {
		position: absolute;
		right: var(--gutter);
		bottom: 28px;
		font-family: var(--sans);
		font-size: 0.7rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--ivory-dim);
	}
	@keyframes sale {
		from {
			opacity: 0;
			transform: translateY(14px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}
	@keyframes scendi {
		50% {
			transform: translateY(4px);
		}
	}
	@media (max-width: 600px) {
		.ingresso {
			padding-bottom: 80px;
		}
		.ingresso__note {
			left: var(--gutter);
			right: auto;
		}
	}
</style>

<script>
	// La luce segue il cursore; senza puntatore (touch) vaga lentamente da sola.
	const section = document.querySelector<HTMLElement>('[data-ingresso]');
	if (section) {
		const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
		let tx = 68;
		let ty = 58;
		let cx = tx;
		let cy = ty;
		let hovering = false;
		let visible = true;
		let raf = 0;

		const paint = () => {
			section.style.setProperty('--mx', cx.toFixed(2) + '%');
			section.style.setProperty('--my', cy.toFixed(2) + '%');
		};

		const tick = (t: number) => {
			if (!hovering) {
				tx = 66 + 16 * Math.sin(t / 5200);
				ty = 56 + 14 * Math.cos(t / 4100);
			}
			cx += (tx - cx) * 0.06;
			cy += (ty - cy) * 0.06;
			paint();
			raf = visible ? requestAnimationFrame(tick) : 0;
		};

		if (!reduce) {
			section.addEventListener('pointermove', (e) => {
				if (e.pointerType === 'touch') return;
				const r = section.getBoundingClientRect();
				tx = ((e.clientX - r.left) / r.width) * 100;
				ty = ((e.clientY - r.top) / r.height) * 100;
				hovering = true;
			});
			section.addEventListener('pointerleave', () => (hovering = false));
			new IntersectionObserver(([entry]) => {
				visible = entry.isIntersecting;
				if (visible && !raf) raf = requestAnimationFrame(tick);
			}).observe(section);
			raf = requestAnimationFrame(tick);
		}
	}
</script>

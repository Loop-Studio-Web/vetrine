---
// Fascia di ritorno, sottile e silenziosa come una didascalia di sala. Scorre via con la pagina;
// la barra fissa sta sotto di lei a inizio pagina e poi risale.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<aside class="fascia" data-fascia aria-label="Informazioni su questa vetrina">
	<p class="fascia__testo">Vetrina dimostrativa<span class="fascia__studio"> &nbsp;·&nbsp; concept di Loop Studio</span></p>
	<nav class="fascia__link" aria-label="Vetrine">
		<a href={`${base}/`}>Tutte le vetrine</a>
		<a href="https://theloopstudio.org/contatti/?concept=ossidiana" class="fascia__cta">Ne voglio una così <span aria-hidden="true">→</span></a>
	</nav>
</aside>

<style is:global>
	:root {
		--fascia-h: 34px;
	}
</style>

<style>
	.fascia {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		z-index: 60;
		height: var(--fascia-h);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding: 0 var(--gutter);
		background: var(--ink-2);
		border-bottom: 1px solid var(--ivory-faint);
		color: var(--ivory-dim);
		font-family: var(--sans);
		font-size: 0.68rem;
		letter-spacing: 0.24em;
		text-transform: uppercase;
		white-space: nowrap;
	}
	.fascia__link {
		display: flex;
		gap: 26px;
		align-items: baseline;
	}
	.fascia a {
		color: var(--ivory);
		text-decoration: none;
		padding-bottom: 2px;
		border-bottom: 1px solid transparent;
		transition: border-color 0.25s;
	}
	.fascia a:hover {
		border-bottom-color: var(--wine-text);
	}
	.fascia a.fascia__cta {
		font-family: var(--hand);
		font-size: 0.95rem;
		letter-spacing: 0.02em;
		text-transform: none;
		color: var(--wine-text);
	}
	@media (max-width: 640px) {
		.fascia {
			letter-spacing: 0.16em;
		}
		.fascia__studio {
			display: none;
		}
	}
	@media (max-width: 440px) {
		.fascia__testo {
			display: none;
		}
		.fascia {
			justify-content: center;
		}
	}
</style>

<script>
	const fascia = document.querySelector<HTMLElement>('[data-fascia]');
	if (fascia) {
		let attesa = false;
		const aggiorna = () => {
			attesa = false;
			document.documentElement.style.setProperty('--fascia', `${Math.max(0, fascia.offsetHeight - scrollY)}px`);
		};
		addEventListener(
			'scroll',
			() => {
				if (!attesa) {
					attesa = true;
					requestAnimationFrame(aggiorna);
				}
			},
			{ passive: true },
		);
		addEventListener('resize', aggiorna);
		aggiorna();
	}
</script>

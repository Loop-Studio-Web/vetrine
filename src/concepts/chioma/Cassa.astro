</style>

<script>
	import { FORMATI, METODI, MAX_LATTE, conto, eur, rate, partenza, numeroOrdine } from './dati';
	const banco = document.querySelector<HTMLFormElement>('[data-banco]');
	const dlg = document.querySelector<HTMLDialogElement>('[data-carrello]');
	if (banco && dlg) {
		const q = <T extends HTMLElement = HTMLElement>(s: string, d: ParentNode = document) => d.querySelector<T>(s)!;
		const eurC = (n: number) => n.toLocaleString('it-IT', { style: 'currency', currency: 'EUR' });
		const litri = (n: number) => (n === 1 ? '1 litro' : `${n} litri`);
		const p = partenza();
		const frase = p.prenotazione ? `L'olio nuovo parte ${p.testo}: chi prenota ora lo riceve per primo.` : `Se ordini oggi, la latta parte ${p.testo}.`;
		q('[data-partenza]', banco).textContent = frase;
		const breve = document.querySelector('[data-partenza-breve]');
		if (breve) breve.textContent = p.prenotazione ? `L'olio nuovo parte ${p.testo}` : `Spediamo ${p.testo}`;
		const hero = document.querySelector('[data-partenza-hero]');
		if (hero) hero.textContent = p.testo;

		// le immagini delle tre latte (già ottimizzate da astro:assets) servono anche alle righe del carrello
		const foto: Record<string, string> = {};
		banco.querySelectorAll<HTMLInputElement>('input[name="formato"]').forEach((i) => {
			foto[i.value] = i.parentElement!.querySelector('img')!.currentSrc || i.parentElement!.querySelector('img')!.src;
		});

		// ---------- scheda ----------
		let quante = 1;
		const out = q('[data-quante]', banco);
		const meno = q<HTMLButtonElement>('[data-meno]', banco);
		const piu = q<HTMLButtonElement>('[data-piu]', banco);
		const scelto = () => banco.querySelector<HTMLInputElement>('input[name="formato"]:checked')!;
		const scheda = () => {
			const f = scelto();
			const prezzo = Number(f.dataset.prezzo);
			out.textContent = String(quante);
			meno.disabled = quante <= 1;
			piu.disabled = quante >= MAX_LATTE;
			q('[data-prezzo]', banco).textContent = eur(prezzo);
			q('[data-al-litro]', banco).textContent = `${eurC(prezzo / Number(f.dataset.litri))} al litro, IVA inclusa`;
			q('[data-quota]', banco).textContent = eurC(rate(prezzo * quante).quota);
			q('[data-dati]', banco).textContent = `${f.dataset.nota}. ${f.dataset.misure}, pesa ${f.dataset.peso}.`;
			dispatchEvent(new CustomEvent('chioma:formato', { detail: { id: f.value, scala: Number(f.dataset.scala) } }));
		};
		banco.addEventListener('change', (e) => {
			if ((e.target as HTMLInputElement).name === 'formato') scheda();
		});
		meno.addEventListener('click', () => ((quante = Math.max(1, quante - 1)), scheda()));
		piu.addEventListener('click', () => ((quante = Math.min(MAX_LATTE, quante + 1)), scheda()));

		// ---------- la latta posata: si gira trascinando, con le frecce o con le miniature ----------
		const posto = q('[data-approdo]');
		const viste = [...document.querySelectorAll<HTMLButtonElement>('[data-vista]')];
		const nomi: Record<number, string> = { 0: 'Davanti', 90: 'Fianco', 180: 'Retro', 270: 'Altro fianco' };
		let giro = 0;
		let anim = 0;
		const ridotto = matchMedia('(prefers-reduced-motion: reduce)');
		const imposta = (g: number) => {
			giro = g;
			const norm = (((Math.round(g / 10) * 10) % 360) + 360) % 360;
			posto.setAttribute('aria-valuenow', String(norm));
			const vicina = Math.round(norm / 90) * 90 % 360;
			posto.setAttribute('aria-valuetext', Math.abs(norm - vicina) < 20 || Math.abs(norm - vicina) > 340 ? nomi[vicina] : `${norm} gradi`);
			viste.forEach((v) => v.setAttribute('aria-pressed', String(Number(v.dataset.vista) === norm)));
			dispatchEvent(new CustomEvent('chioma:giro', { detail: g }));
		};
		// dalle miniature: gira per la via più breve, 320 ms ease-in-out (curva --ease-in-out della skill)
		const curva = (x: number) => (x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2);
		const vaiA = (meta: number) => {
			cancelAnimationFrame(anim);
			let d = (((meta - giro) % 360) + 540) % 360 - 180;
			if (ridotto.matches) return imposta(giro + d);
			const da = giro;
			const t0 = performance.now();
			const passo = (ora: number) => {
				const k = Math.min(1, (ora - t0) / 320);
				imposta(da + d * curva(k));
				if (k < 1) anim = requestAnimationFrame(passo);
			};
			anim = requestAnimationFrame(passo);
		};
		viste.forEach((v) => v.addEventListener('click', () => vaiA(Number(v.dataset.vista))));
		let trascina: { x: number; g: number } | null = null;
		posto.addEventListener('pointerdown', (e) => {
			cancelAnimationFrame(anim);
			trascina = { x: e.clientX, g: giro };
			posto.setPointerCapture(e.pointerId);
		});
		posto.addEventListener('pointermove', (e) => {
			if (!trascina) return;
			imposta(trascina.g - (e.clientX - trascina.x) * 0.9);
		});
		const lascia = () => (trascina = null);
		posto.addEventListener('pointerup', lascia);
		posto.addEventListener('pointercancel', lascia);
		posto.addEventListener('keydown', (e) => {
			const passi: Record<string, number> = { ArrowRight: 10, ArrowLeft: -10, ArrowUp: 10, ArrowDown: -10, PageUp: 90, PageDown: -90 };
			if (e.key in passi) {
				e.preventDefault();
				imposta(giro + passi[e.key]);
			} else if (e.key === 'Home') {
				e.preventDefault();
				vaiA(0);
			}
		});

		// ---------- carrello ----------
		type Riga = { id: string; quante: number };
		let righe: Riga[] = [];
		let metodo = 'carta';
		const formato = (id: string) => FORMATI.find((f) => f.id === id)!;
		const merce = () => righe.reduce((s, r) => s + formato(r.id).prezzo * r.quante, 0);
		const pezzi = () => righe.reduce((s, r) => s + r.quante, 0);
		const ritiro = () => (q<HTMLInputElement>('input[name="consegna"]:checked', dlg)?.value ?? 'corriere') === 'ritiro';
		const totaleFinale = () => {
			const c = conto(merce(), 1);
			return ritiro() ? c.merce : c.totale;
		};
		const conta = [...document.querySelectorAll<HTMLElement>('[data-conta]')];
		const annuncio = q('[data-annuncio]', banco);

		const disegnaCarrello = () => {
			const lista = q('[data-righe]', dlg);
			lista.replaceChildren(
				...righe.map((r) => {
					const f = formato(r.id);
					const li = document.createElement('li');
					li.className = 'riga';
					li.innerHTML = `<img src="${foto[r.id]}" alt="" height="72">
						<span class="riga__nome">Chioma Saracena, ${litri(f.litri)}</span>
						<span class="riga__prezzo">${eur(f.prezzo * r.quante)}</span>
						<span class="riga__comandi">
							<button type="button" class="goffrato" data-r-meno aria-label="Una latta da ${litri(f.litri)} in meno">−</button>
							<output aria-live="polite">${r.quante}</output>
							<button type="button" class="goffrato" data-r-piu aria-label="Una latta da ${litri(f.litri)} in più" ${r.quante >= MAX_LATTE ? 'disabled' : ''}>+</button>
							<button type="button" class="goffrato riga__togli" data-r-togli>Togli</button>
						</span>`;
					li.querySelector('[data-r-meno]')!.addEventListener('click', () => cambia(r.id, -1));
					li.querySelector('[data-r-piu]')!.addEventListener('click', () => cambia(r.id, 1));
					li.querySelector('[data-r-togli]')!.addEventListener('click', () => cambia(r.id, -99));
					return li;
				}),
			);
			const m = merce();
			const c = conto(m, 1);
			q('[data-vuoto]', dlg).hidden = righe.length > 0;
			q<HTMLButtonElement>('[data-vai-cassa]', dlg).disabled = righe.length === 0;
			q('[data-c-merce]', dlg).textContent = eur(m);
			q('[data-c-sped]', dlg).textContent = !m ? '—' : c.spedizione ? eur(c.spedizione) : 'gratis';
			q('[data-c-tot]', dlg).textContent = eur(m ? c.totale : 0);
			const manca = Math.max(0, 60 - m);
			q('[data-soglia]', dlg).hidden = righe.length === 0;
			q('[data-soglia-testo]', dlg).textContent = manca ? `Mancano ${eur(manca)} alla spedizione gratis.` : 'La spedizione è gratis.';
			q('[data-soglia-barra]', dlg).style.setProperty('--pieno', String(Math.min(1, m / 60)));
			const r3 = rate(c.totale);
			q('[data-c-rate]', dlg).textContent = m ? `Oppure in 3 rate da ${eurC(r3.quota)} senza interessi con PayPal, Klarna o Scalapay.` : '';
			conta.forEach((el) => {
				el.textContent = String(pezzi());
				el.hidden = pezzi() === 0;
			});
		};
		const cambia = (id: string, d: number) => {
			const r = righe.find((x) => x.id === id);
			if (!r) return;
			r.quante = Math.max(0, Math.min(MAX_LATTE, r.quante + d));
			righe = righe.filter((x) => x.quante > 0);
			disegnaCarrello();
			aggiornaCheckout();
		};
		const aggiungi = (id: string, n: number) => {
			const r = righe.find((x) => x.id === id);
			if (r) r.quante = Math.min(MAX_LATTE, r.quante + n);
			else righe.push({ id, quante: n });
			disegnaCarrello();
		};

		// ---------- i tre passi del cassetto ----------
		const passi = [...dlg.querySelectorAll<HTMLElement>('[data-passo]')];
		const titoli: Record<string, string> = { carrello: 'Il tuo carrello', cassa: 'Spedizione e pagamento', fatto: 'Ordine ricevuto' };
		const mostra = (nome: string) => {
			passi.forEach((el) => (el.hidden = el.dataset.passo !== nome));
			q('[data-titolo-carrello]', dlg).textContent = titoli[nome];
			dlg.scrollTop = 0;
		};
		let opener: HTMLElement | null = null;
		const apri = (passo = 'carrello') => {
			opener = document.activeElement as HTMLElement;
			disegnaCarrello();
			aggiornaCheckout();
			mostra(passo);
			if (!dlg.open) dlg.showModal();
		};
		document.querySelectorAll('[data-apri-carrello]').forEach((b) => b.addEventListener('click', () => apri()));
		dlg.querySelectorAll('[data-chiudi]').forEach((b) =>
			b.addEventListener('click', () => {
				if ((b as HTMLElement).dataset.svuota !== undefined) {
					righe = [];
					disegnaCarrello();
					(q('[data-passo="cassa"]', dlg) as HTMLFormElement).reset();
				}
				dlg.close();
			}),
		);
		dlg.addEventListener('close', () => opener?.focus());
		dlg.addEventListener('click', (e) => {
			if (e.target === dlg) dlg.close(); // clic sullo sfondo
		});
		q('[data-vai-cassa]', dlg).addEventListener('click', () => mostra('cassa'));
		q('[data-indietro]', dlg).addEventListener('click', () => mostra('carrello'));

		// la fascetta: si strappa, poi dopo un attimo torna intera per un'altra aggiunta
		const fascetta = q('[data-aggiungi]', banco);
		let richiudi = 0;
		banco.addEventListener('submit', (e) => {
			e.preventDefault();
			const f = scelto();
			aggiungi(f.value, quante);
			fascetta.dataset.strappata = '';
			clearTimeout(richiudi);
			richiudi = window.setTimeout(() => delete fascetta.dataset.strappata, 1800);
			const n = quante === 1 ? 'una latta' : `${quante} latte`;
			annuncio.textContent = `Aggiunt${quante === 1 ? 'a' : 'e'} al carrello ${n} da ${litri(Number(f.dataset.litri))}. Nel carrello: ${pezzi()}.`;
		});
		// i pagamenti rapidi portano dritti alla cassa con il metodo scelto
		banco.querySelectorAll<HTMLButtonElement>('[data-rapido]').forEach((b) =>
			b.addEventListener('click', () => {
				if (!righe.length) aggiungi(scelto().value, quante);
				const m = b.dataset.rapido === 'paypal' ? 'paypal' : 'carta';
				const r = dlg.querySelector<HTMLInputElement>(`input[name="metodo"][value="${m}"]`);
				if (r) r.checked = true;
				apri('cassa');
				if (b.dataset.rapido !== 'paypal') {
					q('[data-errore]', dlg).textContent = `${b.dataset.rapido === 'applepay' ? 'Apple Pay' : 'Google Pay'} si aprirebbe qui con i dati del telefono. In questa vetrina scegli un metodo qui sotto.`;
				}
			}),
		);

		// ---------- checkout ----------
		const form = q<HTMLFormElement>('[data-passo="cassa"]', dlg);
		const paga = q('[data-paga]', dlg);
		const etichette: Record<string, (t: string) => string> = {
			carta: (t) => `Paga ${t}`,
			paypal: () => 'Continua con PayPal',
			'paypal-3': () => 'Continua con PayPal in 3 rate',
			klarna: () => 'Continua con Klarna',
			scalapay: () => 'Continua con Scalapay',
			satispay: () => 'Paga con Satispay',
			bonifico: () => 'Conferma e paga con bonifico',
		};
		function aggiornaCheckout() {
			metodo = q<HTMLInputElement>('input[name="metodo"]:checked', dlg).value;
			const tot = totaleFinale();
			const c = conto(merce(), 1);
			q('[data-c-corriere]', dlg).textContent = c.spedizione ? eur(c.spedizione) : 'gratis';
			q('[data-f-tot]', dlg).textContent = eur(tot);
			q('span', paga).textContent = etichette[metodo](eur(tot));
			const r3 = rate(tot);
			const conRate: Record<string, string> = {
				'paypal-3': `3 rate da ${eurC(r3.quota)} senza interessi, la prima oggi.`,
				klarna: `3 rate da ${eurC(r3.quota)} senza interessi, oppure paghi tutto tra 30 giorni.`,
				scalapay: `3 rate da ${eurC(r3.quota)} senza interessi, la prima oggi.`,
			};
			for (const id of Object.keys(conRate)) {
				q(`[data-nota-metodo="${id}"]`, dlg).textContent = tot >= 20 ? conRate[id] : METODI.find((m) => m.id === id)!.nota;
			}
		}
		form.addEventListener('change', () => {
			q('[data-errore]', dlg).textContent = '';
			aggiornaCheckout();
		});
		form.addEventListener('submit', (e) => {
			e.preventDefault();
			const campi = [...form.querySelectorAll<HTMLInputElement>('.campo input')];
			let primo: HTMLInputElement | null = null;
			campi.forEach((c) => {
				const ok = c.checkValidity();
				c.setAttribute('aria-invalid', String(!ok));
				if (!ok && !primo) primo = c;
			});
			if (primo) {
				q('[data-errore]', dlg).textContent = 'Mancano dei dati per la spedizione: controlla i campi segnati in rosso (il CAP ha cinque cifre).';
				(primo as HTMLInputElement).focus();
				return;
			}
			const nomeMetodo = METODI.find((m) => m.id === metodo)!.nome;
			q('[data-numero]', dlg).textContent = `Ordine di prova ${numeroOrdine()}`;
			const n = pezzi() === 1 ? 'Una latta' : `${pezzi()} latte`;
			q('[data-riepilogo]', dlg).textContent = `${n}, ${eur(totaleFinale())} con ${nomeMetodo}. ${ritiro() ? 'Ritiro al frantoio' : 'Spedizione con corriere'}: ${p.testo}.`;
			mostra('fatto');
			q<HTMLElement>('[data-passo="fatto"] [data-chiudi]', dlg).focus();
		});

		scheda();
		disegnaCarrello();
	}
</script>

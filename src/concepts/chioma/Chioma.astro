---
// La prima tappa: un ulivo monumentale della Piana (foto di archivio) stampato quasi a tutta pagina, con la cornice
// argento attorno. Il titolo sta in un pannello di vetro; "Chioma" è tagliata dal bordo basso della foto.
// L'oliva del palco parte da [data-ancora], sopra la chioma della foto.
import { getImage } from 'astro:assets';
import largo from '../../assets/chioma/foto/ulivo-largo.jpg';
import alto from '../../assets/chioma/foto/ulivo.jpg';
import { FORMATI, eur, partenza } from './dati';
const p = partenza();
// due tagli della stessa foto: orizzontale per lo schermo largo, verticale per il telefono
// qualità 62: la chioma è tutta foglie e a 80 la foto da telefono pesava 400 KB (è l'LCP)
const set = async (src: ImageMetadata, widths: number[]) => {
	const img = await getImage({ src, widths, format: 'webp', quality: 62 });
	return { srcset: img.srcSet.attribute, src: img.src };
};
const desk = await set(largo, [960, 1400, 1920, 2400]);
const mob = await set(alto, [480, 640, 800, 1080]);
const titolo = 'Olio nuovo da ulivi alti quindici metri.';
---

<section class="tappa chioma" data-tappa aria-labelledby="chioma-titolo">
	<div class="lastra chioma__lastra">
		<picture>
			<source media="(max-width: 899px)" srcset={mob.srcset} sizes="100vw" />
			<img
				src={desk.src}
				srcset={desk.srcset}
				sizes="100vw"
				alt="Un ulivo monumentale dal tronco attorcigliato, la chioma larga sopra un campo secco"
				width={largo.width}
				height={largo.height}
				loading="eager"
				fetchpriority="high"
				decoding="async"
			/>
		</picture>
		<span class="ancora" data-ancora aria-hidden="true"></span>
		<p class="parola chioma__parola" aria-hidden="true">Chioma</p>

		<div class="vetro chioma__vetro">
			<h1 id="chioma-titolo" class="inchiostri" data-testo={titolo}>{titolo}</h1>
			<p class="chioma__intro">
				Ottobratica della Piana di Gioia Tauro, presa dalla pianta a ottobre e franta in giornata. Solo in latta, da 1, 3 e 5 litri, per
				un anno di cucina.
			</p>
			<div class="chioma__azione">
				<a class="registro" href="#cassa"><span>Prenota l'olio nuovo</span></a>
				<p class="chioma__prezzo">da {eur(FORMATI[0].prezzo)} la latta da un litro</p>
			</div>
		</div>

		<ul class="fatti">
			<li class="vetro vetro--blu"><b>14 ottobre</b> si comincia, dalla pianta e mai da terra.</li>
			<li class="vetro vetro--blu"><b>Sotto i 27 gradi</b> in frantoio, la sera stessa.</li>
			<li class="vetro vetro--blu"><b>La latta parte</b> <span data-partenza-hero>{p.testo}</span>.</li>
		</ul>
	</div>
</section>

<style>
	.chioma {
		--fondo: var(--latta);
		padding-top: calc(var(--fascia-h) + var(--barra-h) + var(--cornice));
	}
	.chioma__lastra {
		min-height: calc(100svh - var(--fascia-h) - var(--barra-h) - 2 * var(--cornice));
		display: grid;
		grid-template-columns: minmax(0, 36rem) minmax(0, 1fr);
		grid-template-rows: 1fr auto;
		align-items: start;
		gap: 24px;
		padding: clamp(20px, 3.4vw, 52px);
	}
	.chioma__lastra img {
		object-position: 50% 42%;
	}
	.chioma__vetro {
		position: relative;
		z-index: 3;
		grid-column: 1;
		grid-row: 1;
	}
	h1 {
		font-size: clamp(2.5rem, 4.2vw, 4.3rem);
		color: var(--blu);
		--ombra: var(--rosso);
	}
	.chioma__intro {
		margin-top: 0.9em;
		max-width: 38ch;
		font-size: 1.1875rem;
		color: var(--oliva);
	}
	.chioma__azione {
		margin-top: 24px;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px 20px;
	}
	.chioma__prezzo {
		font-weight: 650;
		color: var(--blu);
	}
	/* tre vetrini blu in fila sul campo, sopra la parola gigante */
	.fatti {
		position: relative;
		z-index: 3;
		grid-column: 2;
		grid-row: 2;
		justify-self: end;
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 10px;
		max-width: 44rem;
		margin-bottom: clamp(70px, 11vw, 190px);
	}
	.fatti li {
		width: 13.5rem;
		padding: 14px 16px;
		font-size: 0.9375rem;
		line-height: 1.35;
	}
	.fatti b {
		display: block;
		margin-bottom: 2px;
		font-family: var(--titoli);
		font-weight: 400;
		font-size: 1.3rem;
		color: var(--olio);
	}
	/* dove pende l'oliva: su un ramo della chioma, a destra del tronco */
	.ancora {
		position: absolute;
		left: 66%;
		top: 24%;
		width: 2px;
		height: 2px;
	}
	.chioma__parola {
		left: -0.03em;
		bottom: -0.2em;
		font-size: min(25vw, 27rem);
		color: var(--rosso);
		--ombra: var(--blu);
	}

	@media (max-width: 899px) {
		.chioma__lastra {
			min-height: calc(100svh - var(--fascia-h) - var(--barra-h) - 2 * var(--cornice));
			grid-template-columns: minmax(0, 1fr);
			/* sopra il vetro resta sempre una fascia di chioma libera (>= 250 px): lì pende l'oliva */
			grid-template-rows: minmax(250px, 1fr) auto auto;
			padding: 14px;
			gap: 10px;
		}
		.chioma__lastra img {
			object-position: 50% 30%;
		}
		.chioma__vetro {
			grid-row: 2;
			padding: 20px 18px;
		}
		h1 {
			font-size: clamp(2.1rem, 9vw, 3.1rem);
		}
		.chioma__intro {
			font-size: 1.0625rem;
		}
		.fatti {
			grid-column: 1;
			grid-row: 3;
			justify-self: stretch;
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 8px;
			margin-bottom: 0;
		}
		.fatti li {
			width: auto;
			padding: 10px;
			font-size: 0.8125rem;
		}
		.fatti b {
			font-size: 1.05rem;
		}
		.ancora {
			left: 62%;
			top: 150px;
		}
		/* sul telefono la parola sta in alto, tagliata dal bordo superiore della foto */
		.chioma__parola {
			bottom: auto;
			top: -0.16em;
			font-size: 29vw;
		}
	}
</style>

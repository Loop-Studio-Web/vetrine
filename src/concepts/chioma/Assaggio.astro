---
// Quinta tappa: com'è. Una lastra scura con la ciotola: il titolo stampato direttamente sulla foto, le tre note come
// vetri di grandezza diversa (come l'intensità), i passi dell'assaggio in fila in fondo (è una sequenza vera, per questo
// è numerata) e il bicchierino in una lente tonda. La lastra copre la latta del palco, che aspetta la cassa.
import { Image } from 'astro:assets';
import ciotola from '../../assets/chioma/foto/assaggio-ciotola.jpg';
import bicchiere from '../../assets/chioma/foto/assaggio-bicchiere.jpg';
const note = [
	{ nome: 'Fruttato', quanto: 'medio', d: 'Erba tagliata, carciofo, mandorla verde.', peso: 'medio' },
	{ nome: 'Amaro', quanto: 'deciso', d: 'Sulla lingua. Si ammorbidisce entro gennaio.', peso: 'forte' },
	{ nome: 'Piccante', quanto: 'deciso', d: 'In gola, dopo un attimo. È il segno dei polifenoli.', peso: 'forte' },
];
const passi = [
	'Versane un dito in un bicchierino e scaldalo nel palmo, coperto con l’altra mano.',
	'Annusa subito: se sa d’erba e di pomodoro verde, è nuovo.',
	'Prendine un sorso e tira aria fra i denti. L’amaro arriva sulla lingua, il piccante in gola: può farti tossire, è normale.',
];
const titolo = "Com'è, appena fatto.";
---

<section class="tappa assaggio" data-tappa aria-labelledby="assaggio-titolo">
	<div class="lastra lastra--ferma assaggio__lastra">
		<Image src={ciotola} alt="Un filo d'olio cola su olive verdi in una ciotola di legno d'ulivo" widths={[720, 1200, 1800, 2400]} sizes="100vw" class="lastra__foto" />
		<p class="parola assaggio__parola" aria-hidden="true">Amaro</p>
		<div class="assaggio__dentro">
			<div class="assaggio__testa">
				<h2 id="assaggio-titolo" class="inchiostri" data-testo={titolo}>{titolo}</h2>
				<p class="vetro vetro--blu usi">Su pane caldo, legumi, pesce azzurro, minestre di verdura. Per friggere no: sarebbe un peccato.</p>
			</div>
			<dl class="note">
				{
					note.map((n) => (
						<div class={`vetro nota nota--${n.peso}`}>
							<dt>
								{n.nome} <span>{n.quanto}</span>
							</dt>
							<dd>{n.d}</dd>
						</div>
					))
				}
			</dl>
			<div class="come">
				<h3>Come assaggiarlo</h3>
				<ol class="passi">{passi.map((p) => <li class="vetro vetro--blu">{p}</li>)}</ol>
			</div>
			<figure class="lente">
				<Image src={bicchiere} alt="Un piccolo bicchiere di vetro pieno d'olio dorato su un tavolo grigio" widths={[320, 640]} sizes="14rem" />
				<figcaption class="vetro didascalia">Nei concorsi si assaggia in un bicchiere blu: il colore non deve guidarti.</figcaption>
			</figure>
		</div>
	</div>
</section>

<style>
	.assaggio {
		--fondo: var(--rosso);
	}
	/* qui la latta aspetta la cassa: la lastra le passa davanti */
	.assaggio__lastra {
		z-index: 6;
	}
	.assaggio__lastra > img {
		object-position: 50% 60%;
	}
	.assaggio__dentro {
		position: relative;
		z-index: 3;
		min-height: inherit;
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		grid-template-rows: auto 1fr auto;
		gap: 24px;
		padding: clamp(20px, 3.4vw, 52px);
		color: var(--smalto);
	}
	.assaggio__testa {
		grid-column: 1 / 7;
		grid-row: 1;
	}
	.usi {
		margin-top: 16px;
		max-width: 26rem;
		padding: 12px 16px;
		font-size: 0.9375rem;
	}
	/* il titolo è stampato sul fondo scuro della foto, senza pannello */
	h2 {
		color: var(--smalto);
		--ombra: var(--rosso);
		text-shadow: 0 2px 24px rgb(20 14 6 / 0.55);
	}
	/* le note: più l'intensità è forte, più il vetro è grande */
	.note {
		grid-column: 8 / -1;
		grid-row: 1 / 3;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 12px;
	}
	.nota {
		padding: 12px 18px 14px;
	}
	.nota--medio {
		max-width: 19rem;
		margin-right: 12%;
	}
	.nota--forte {
		max-width: 24rem;
	}
	.nota--forte:last-child {
		margin-right: 6%;
	}
	dt {
		font-family: var(--titoli);
		line-height: 1;
		color: var(--blu);
	}
	.nota--medio dt {
		font-size: clamp(1.9rem, 2.6vw, 2.4rem);
	}
	.nota--forte dt {
		font-size: clamp(2.4rem, 3.4vw, 3.2rem);
	}
	dt span {
		font-family: var(--testo);
		font-size: 0.9375rem;
		font-weight: 650;
		vertical-align: 0.4em;
		margin-left: 0.25em;
		color: #9a1a13; /* rosso scurito: sul vetro chiaro il rosso pieno non regge il testo piccolo */
	}
	dd {
		margin-top: 4px;
		color: var(--oliva);
	}
	.come {
		grid-column: 1 / 10;
		grid-row: 3;
		align-self: end;
	}
	h3 {
		font-size: 1.6rem;
		margin-bottom: 0.5em;
		text-shadow: 0 2px 18px rgb(20 14 6 / 0.6);
	}
	.passi {
		counter-reset: passo;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 12px;
	}
	/* il numero del passo sta sopra il testo: è ::after messo per primo, così il testo resta il primo nodo */
	.passi li {
		counter-increment: passo;
		display: flex;
		flex-direction: column;
		padding: 16px 18px;
		font-size: 0.9375rem;
		line-height: 1.45;
	}
	.passi li::after {
		content: counter(passo);
		order: -1;
		font-family: var(--titoli);
		font-size: 2.2rem;
		line-height: 1;
		margin-bottom: 6px;
		color: var(--olio);
	}
	/* il bicchierino: una lente tonda appoggiata in basso a destra */
	.lente {
		grid-column: 10 / -1;
		grid-row: 3;
		align-self: end;
		justify-self: end;
		display: grid;
		justify-items: end;
		gap: 10px;
		margin: 0;
	}
	.lente :global(img) {
		width: clamp(7rem, 9vw, 9rem);
		aspect-ratio: 1;
		object-fit: cover;
		border-radius: 50%;
		box-shadow:
			0 0 0 6px rgb(247 248 246 / 0.75),
			0 20px 40px -16px rgb(0 0 0 / 0.6);
	}
	.lente .didascalia {
		max-width: 15rem;
		font-size: 0.875rem;
	}
	.assaggio__parola {
		left: 30%;
		bottom: -0.2em;
		color: var(--rosso);
		--ombra: var(--blu);
		opacity: 0.92;
	}

	@media (max-width: 1100px) and (min-width: 900px) {
		.passi {
			grid-template-columns: minmax(0, 1fr);
		}
	}
	@media (max-width: 899px) {
		.assaggio__dentro {
			display: flex;
			flex-direction: column;
			gap: 0;
			padding: 14px;
		}
		.assaggio__testa {
			margin-top: 8svh;
		}
		.note {
			margin-top: 34svh;
			align-items: stretch;
			gap: 18svh;
		}
		.nota--medio,
		.nota--forte,
		.nota--forte:last-child {
			max-width: none;
			margin-right: 0;
		}
		.nota:nth-child(2) {
			margin-left: 10%;
		}
		.come {
			margin-top: 30svh;
		}
		.passi {
			grid-template-columns: minmax(0, 1fr);
		}
		.lente {
			margin-top: 30svh;
			justify-self: stretch;
			justify-items: start;
			padding-bottom: 28vw;
		}
		.assaggio__parola {
			left: -0.04em;
			font-size: 38vw;
		}
	}
</style>

---
// Barra sottile fissa con una sola azione, come sul fianco di una latta: il nome e il formato, niente menù.
import simbolo from '../../assets/chioma/brand/simbolo-leggero-mono.svg?raw';
const icona = simbolo.replace('<svg', '<svg aria-hidden="true" focusable="false" class="barra__simbolo"');
---

<header class="barra" data-barra>
	<a class="barra__marchio" href="#top" aria-label="Chioma Saracena, torna all'inizio">
		<Fragment set:html={icona} />
		<span class="barra__nome" aria-hidden="true">Chioma Saracena</span>
	</a>
	<p class="barra__info"><span data-partenza-breve>Olio nuovo</span></p>
	<div class="barra__azioni">
		<button type="button" class="barra__carrello" data-apri-carrello aria-label="Apri il carrello">
			<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 3h10l1.2 4H5.8zM5 8h14v12.5a.5.5 0 0 1-.5.5h-13a.5.5 0 0 1-.5-.5z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path><path d="M9 12h6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
			<span class="barra__conta" data-conta hidden>0</span>
		</button>
		<a class="registro registro--chiaro barra__cta" href="#cassa"><span>Prenota l'olio nuovo</span></a>
	</div>
</header>

<style>
	.barra {
		position: fixed;
		top: var(--fascia, var(--fascia-h));
		left: 0;
		right: 0;
		z-index: 120;
		height: var(--barra-h);
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 16px;
		padding: 0 var(--gutter);
		background: var(--rosso);
		color: var(--smalto);
		/* il bordo stampato: una riga blu appena fuori registro sotto la riga di latta */
		box-shadow:
			0 2px 0 var(--latta),
			1px 5px 0 var(--blu);
	}
	.barra__marchio {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		justify-self: start;
		text-decoration: none;
		min-height: 44px;
	}
	.barra__marchio :global(.barra__simbolo) {
		width: auto;
		height: calc(var(--barra-h) - 14px);
		color: var(--smalto);
	}
	.barra__nome {
		font-family: var(--titoli);
		font-size: 1.35rem;
		line-height: 1;
	}
	.barra__info {
		font-size: 0.875rem;
		font-weight: 560;
		color: var(--smalto);
		white-space: nowrap;
	}
	.barra__azioni {
		justify-self: end;
		display: flex;
		align-items: center;
		gap: 10px;
	}
	.barra__cta {
		min-height: 38px;
		padding: 0 18px;
		font-size: 0.9375rem;
	}
	.barra__carrello {
		position: relative;
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border: 0;
		background: none;
		color: var(--smalto);
		cursor: pointer;
	}
	.barra__carrello svg {
		width: 24px;
		height: 24px;
	}
	.barra__conta {
		position: absolute;
		top: 3px;
		right: 1px;
		min-width: 19px;
		height: 19px;
		padding: 0 5px;
		border-radius: 10px;
		background: var(--olio);
		color: var(--blu);
		font-size: 0.75rem;
		font-weight: 800;
		line-height: 19px;
		text-align: center;
	}
	.barra :focus-visible {
		outline-color: var(--smalto);
	}
	@media (max-width: 860px) {
		.barra {
			grid-template-columns: 1fr auto;
		}
		.barra__info {
			display: none;
		}
	}
	@media (max-width: 420px) {
		.barra__nome {
			font-size: 1.1rem;
		}
		.barra__cta {
			padding: 0 12px;
			font-size: 0.875rem;
		}
		.barra__azioni {
			gap: 4px;
		}
	}
</style>

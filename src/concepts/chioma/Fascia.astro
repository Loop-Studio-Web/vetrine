---
// Fascia di ritorno: dice che è una vetrina dimostrativa e porta all'hub o al contatto. Non è fissa: scorre via
// e la barra, che le sta sotto, intanto risale (lo script aggiorna --fascia).
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<aside class="fascia" data-fascia aria-label="Informazioni su questa vetrina">
	<p class="fascia__testo">Vetrina dimostrativa <span class="fascia__studio">concept di Loop Studio</span></p>
	<nav class="fascia__link" aria-label="Vetrine">
		<a href={`${base}/`}>Tutte le vetrine</a>
		<a href="https://theloopstudio.org/contatti/?concept=olio" class="fascia__cta">Ne voglio una così</a>
	</nav>
</aside>

<style>
	.fascia {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		z-index: 150;
		height: var(--fascia-h);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding: 0 var(--gutter);
		background: var(--blu);
		color: var(--smalto);
		font-family: var(--testo);
		font-weight: 560;
		font-size: 0.8125rem;
		white-space: nowrap;
	}
	.fascia__studio {
		color: var(--latta);
		margin-left: 0.6em;
		padding-left: 0.7em;
		border-left: 1px solid rgb(207 213 216 / 0.45);
	}
	.fascia__link {
		display: flex;
		gap: 24px;
	}
	.fascia a {
		display: inline-flex;
		align-items: center;
		height: var(--fascia-h);
		text-decoration: none;
		border-bottom: 2px solid transparent;
	}
	.fascia a:hover {
		border-bottom-color: var(--olio);
	}
	.fascia__cta {
		color: var(--olio);
	}
	.fascia :focus-visible {
		outline-color: var(--smalto);
		outline-offset: -3px;
	}
	@media (max-width: 640px) {
		.fascia__studio {
			display: none;
		}
		.fascia__link {
			gap: 16px;
		}
	}
	@media (max-width: 460px) {
		.fascia__testo {
			display: none;
		}
		.fascia {
			justify-content: center;
		}
	}
</style>

<script>
	const fascia = document.querySelector<HTMLElement>('[data-fascia]');
	if (fascia) {
		let attesa = false;
		const aggiorna = () => {
			attesa = false;
			document.documentElement.style.setProperty('--fascia', `${Math.max(0, fascia.offsetHeight - scrollY)}px`);
		};
		addEventListener(
			'scroll',
			() => {
				if (!attesa) {
					attesa = true;
					requestAnimationFrame(aggiorna);
				}
			},
			{ passive: true },
		);
		addEventListener('resize', aggiorna);
		aggiorna();
	}
</script>

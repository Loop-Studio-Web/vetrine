---
// Protocolli: sezione bloccata (pin) che scorre in orizzontale mentre si scorre in verticale. Ogni protocollo
// ha il suo disegno tecnico con una lente d'ingrandimento che segue il mouse. Su telefono e senza JavaScript
// la pista diventa un normale scorrimento orizzontale con scatti (scroll-snap).
import { protocolli } from './protocolli';
import { disegni } from './disegni';
import { euro } from './formato';

const macchine = protocolli.filter((p) => p.macchina);
---

<section class="prot" id="protocolli" aria-labelledby="prot-titolo" data-prot>
	<div class="prot__vista" data-prot-vista>
		<div class="prot__pista" data-prot-pista>
			<div class="prot__intro">
				<p class="etichetta" data-rivela>Protocolli</p>
				<h2 class="titolo" id="prot-titolo" data-split>Quattro strumenti. <em>Un solo metodo.</em></h2>
				<p class="lead" data-rivela>
					Ogni protocollo parte dal check-up e si compone con il medico: non si sceglie da un listino, si costruisce sul profilo di chi lo
					segue.
				</p>
				<p class="prot__scorri" data-rivela>
					<span class="solo-pin">Continua a scorrere verso il basso: i protocolli si sfogliano di lato.</span>
					<span class="solo-nativo">Fai scorrere di lato per sfogliare i protocolli.</span>
				</p>
				<a class="prot__salta-i" href="#metodo">Non ti interessa? Salta al metodo <span aria-hidden="true">↓</span></a>
			</div>

			{
				macchine.map((p, i) => (
					<article class="pannello" data-pannello aria-labelledby={`p-${p.id}`}>
						<div class="pannello__testo">
							<p class="pannello__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
							<h3 class="pannello__nome" id={`p-${p.id}`}>{p.nome}</h3>
							<p class="pannello__breve">{p.breve}</p>
							<p class="pannello__desc">{p.descrizione}</p>
							<dl class="pannello__spec">
								{p.specifiche.map(([k, v]) => (
									<div>
										<dt>{k}</dt>
										<dd>{v}</dd>
									</div>
								))}
							</dl>
							<div class="pannello__piede">
								<p class="pannello__prezzo">
									<span>da</span> {euro(p.prezzo)}
								</p>
								<a class="btn btn--vuoto" href="#suite" data-protocollo={p.id} data-magnetico data-cursore="SCEGLI">
									Prenota questo protocollo<span class="sr-only">: {p.nome}</span> <span aria-hidden="true">→</span>
								</a>
							</div>
						</div>
						<div class="macchina" data-macchina data-cursore="ZOOM" set:html={disegni[p.id]} />
					</article>
				))
			}

			<div class="prot__chiusa">
				<p class="etichetta">E adesso?</p>
				<p class="prot__chiusa-t">Non sai da dove iniziare?</p>
				<p class="lead">Quattro domande, un profilo e un protocollo consigliato. Senza registrazione.</p>
				<a class="btn" href="#assessment" data-magnetico data-cursore="INIZIA">Fai il Bio-Assessment <span aria-hidden="true">→</span></a>
			</div>
		</div>

		<p class="prot__guida" data-prot-guida aria-hidden="true"><span>Continua a scorrere</span><i></i></p>

		<div class="prot__barra" data-prot-barra>
			<p class="prot__conta" aria-live="off"><b data-prot-i>—</b> / {String(macchine.length).padStart(2, '0')}</p>
			<div class="prot__linea" aria-hidden="true"><i data-prot-linea></i></div>
			<ul class="prot__nav" role="list">
				{
					macchine.map((p, i) => (
						<li>
							<button type="button" data-vai={i} aria-label={`Vai al protocollo ${p.nome}`}>
								{String(i + 1).padStart(2, '0')} <span>{p.nome}</span>
							</button>
						</li>
					))
				}
			</ul>
			<a class="prot__salta prot__salta--su" href="#metriche"><span aria-hidden="true">↑</span> Salta<span class="sr-only"> i protocolli e torna agli indicatori</span></a>
			<a class="prot__salta" href="#metodo">Salta <span aria-hidden="true">↓</span><span class="sr-only"> i protocolli e vai al metodo</span></a>
		</div>
	</div>
</section>

<style>
	.prot {
		background: linear-gradient(180deg, var(--abisso) 0%, var(--navy) 18%, var(--navy) 100%);
		position: relative;
	}

	/* ---------- modalità nativa (telefono, senza JS, movimento ridotto): scorrimento orizzontale con scatti ---------- */
	.prot__vista {
		padding: clamp(80px, 10vw, 130px) 0 0;
	}
	.prot__pista {
		display: flex;
		gap: 0;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		padding: 0 var(--gutter) 24px;
		scrollbar-width: thin;
		scrollbar-color: var(--smeraldo) transparent;
		outline: none;
	}
	.prot__intro,
	.pannello,
	.prot__chiusa {
		flex: none;
		scroll-snap-align: start;
		scroll-margin-left: var(--gutter);
	}
	.prot__intro {
		width: min(86vw, 520px);
		padding-right: 32px;
		display: grid;
		gap: 22px;
		align-content: center;
	}
	.prot__scorri {
		font-size: 0.95rem;
		line-height: 1.5;
		color: var(--ghiaccio);
		padding-left: 16px;
		border-left: 2px solid var(--smeraldo);
		max-width: 34ch;
	}
	.solo-pin {
		display: none;
	}
	.prot.is-pin .solo-pin {
		display: inline;
	}
	.prot.is-pin .solo-nativo {
		display: none;
	}
	.prot__salta-i {
		justify-self: start;
		font-size: 0.74rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--smeraldo-chiaro);
		text-decoration: none;
		border-bottom: 1px solid rgba(134, 214, 195, 0.4);
		padding-bottom: 3px;
		transition: border-color 0.3s var(--ease);
	}
	.prot__salta-i:hover {
		border-color: var(--smeraldo-chiaro);
	}
	.prot__guida {
		display: none;
	}
	.pannello {
		width: min(88vw, 1080px);
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr);
		gap: clamp(20px, 4vw, 56px);
		align-items: center;
		padding: 0 clamp(20px, 3vw, 44px);
		border-left: 1px solid var(--linea);
	}
	.pannello__testo {
		display: grid;
		gap: 12px;
		align-content: center;
	}
	.pannello__n {
		font-family: var(--display);
		font-weight: 200;
		font-size: clamp(5.8rem, 12.76vw, 10.44rem);
		line-height: 0.9;
		letter-spacing: 0;
		color: transparent;
		-webkit-text-stroke: 1px rgba(134, 214, 195, 0.5);
		margin-bottom: 6px;
	}
	.pannello__nome {
		font-weight: 200;
		font-size: clamp(2.4rem, 4vw, 3.7rem);
		line-height: 1;
		letter-spacing: 0;
	}
	.pannello__breve {
		font-family: var(--mono);
		font-size: 0.74rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--smeraldo-chiaro);
	}
	.pannello__desc {
		color: var(--nebbia);
		max-width: 44ch;
		margin-top: 6px;
	}
	.pannello__spec {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0 28px;
		margin-top: 8px;
	}
	.pannello__spec > div {
		display: flex;
		justify-content: space-between;
		gap: 10px;
		padding: 9px 0;
		border-top: 1px solid var(--linea);
		font-family: var(--mono);
		font-size: 0.74rem;
	}
	.pannello__spec dt {
		color: var(--nebbia);
		letter-spacing: 0.06em;
	}
	.pannello__spec dd {
		margin: 0;
		color: var(--bianco);
		text-align: right;
	}
	.pannello__piede {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 16px 24px;
		margin-top: 14px;
	}
	.pannello__prezzo {
		font-family: var(--mono);
		font-size: 0.95rem;
		color: var(--oro);
	}
	.pannello__prezzo span {
		font-size: 0.7rem;
		color: var(--nebbia);
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}
	.pannello__piede .btn {
		--pad: 13px 20px;
		font-size: 0.72rem;
	}

	.macchina {
		position: relative;
		width: 100%;
		max-width: 520px;
		aspect-ratio: 1;
		margin-inline: auto;
		border: 1px solid var(--linea);
		border-radius: 50%;
		background: radial-gradient(circle at 50% 42%, rgba(78, 159, 142, 0.13), transparent 66%);
		overflow: hidden;
	}
	.macchina > :global(svg) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}
	.lente {
		position: absolute;
		left: 0;
		top: 0;
		width: 168px;
		height: 168px;
		border-radius: 50%;
		overflow: hidden;
		pointer-events: none;
		opacity: 0;
		border: 1px solid var(--smeraldo-chiaro);
		background: rgba(6, 11, 20, 0.88);
		box-shadow:
			0 0 0 6px rgba(6, 11, 20, 0.35),
			0 0 40px rgba(78, 159, 142, 0.35),
			inset 0 0 30px rgba(134, 214, 195, 0.18);
		transition: opacity 0.3s var(--ease);
		will-change: transform;
	}
	.lente.is-su {
		opacity: 1;
	}
	.lente__in {
		position: absolute;
		left: 0;
		top: 0;
		transform-origin: 0 0;
	}
	.lente__in :global(svg) {
		width: 100%;
		height: 100%;
	}

	.prot__chiusa {
		width: min(86vw, 520px);
		padding: 0 clamp(20px, 4vw, 56px);
		border-left: 1px solid var(--linea);
		display: grid;
		gap: 18px;
		align-content: center;
		justify-items: start;
	}
	.prot__chiusa-t {
		font-weight: 200;
		font-size: clamp(2.09rem, 3.48vw, 3.02rem);
		line-height: 1.1;
		letter-spacing: 0;
	}

	.prot__barra {
		display: none;
	}
	.prot__salta {
		display: none;
	}

	/* ---------- modalità bloccata (desktop): la pista scorre con la pagina ---------- */
	.prot.is-pin .prot__vista {
		height: 100vh;
		height: 100svh;
		padding: calc(var(--nav-h) + 8px) 0 96px;
		display: flex;
		align-items: center;
		overflow: clip;
		position: relative;
	}
	.prot.is-pin .prot__pista {
		overflow: visible;
		scroll-snap-type: none;
		padding: 0 var(--gutter);
		align-items: center;
		will-change: transform;
		width: max-content;
	}
	.prot.is-pin .prot__intro {
		width: min(520px, 40vw);
		margin-right: clamp(20px, 5vw, 80px);
	}
	.prot.is-pin .pannello {
		width: min(1080px, 78vw);
		margin-right: clamp(20px, 3vw, 44px);
	}
	.prot.is-pin .prot__chiusa {
		width: min(520px, 40vw);
	}
	.prot.is-pin .macchina {
		max-width: min(520px, calc(100svh - 330px));
	}
	/* la barra è un vetro a sé: non si confonde con i pulsanti dei protocolli */
	.prot.is-pin .prot__barra {
		position: absolute;
		z-index: 5;
		left: var(--gutter);
		right: var(--gutter);
		bottom: 22px;
		display: flex;
		align-items: center;
		gap: 22px;
		padding: 10px 14px 10px 20px;
		font-family: var(--mono);
		background: rgba(6, 11, 20, 0.7);
		-webkit-backdrop-filter: blur(16px) saturate(140%);
		backdrop-filter: blur(16px) saturate(140%);
		border: 1px solid var(--linea-oro);
		border-radius: 999px;
		box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.8);
	}
	.prot.is-pin .prot__salta {
		display: inline-flex;
		flex: none;
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		text-decoration: none;
		color: var(--abisso);
		background: var(--smeraldo-chiaro);
		padding: 9px 16px;
		border-radius: 999px;
		transition: background-color 0.3s var(--ease);
	}
	.prot__salta:hover {
		background: var(--bianco);
	}
	.prot.is-pin .prot__salta--su {
		background: transparent;
		color: var(--bianco);
		box-shadow: inset 0 0 0 1px rgba(243, 248, 246, 0.4);
	}
	.prot.is-pin .prot__salta--su:hover {
		background: var(--smeraldo-chiaro);
		color: var(--abisso);
	}
	.prot.is-pin .prot__guida {
		display: flex;
		position: absolute;
		right: var(--gutter);
		top: calc(var(--nav-h) + 28px);
		z-index: 4;
		align-items: center;
		gap: 12px;
		padding: 10px 16px;
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		background: rgba(6, 11, 20, 0.6);
		-webkit-backdrop-filter: blur(12px);
		backdrop-filter: blur(12px);
		border: 1px solid var(--linea-oro);
		border-radius: 999px;
		pointer-events: none;
		transition: opacity 0.5s var(--ease);
	}
	.prot__guida i {
		width: 26px;
		height: 1px;
		background: var(--smeraldo-chiaro);
		position: relative;
		animation: ae-guida 1.6s var(--ease) infinite;
	}
	.prot__guida i::after {
		content: '';
		position: absolute;
		right: 0;
		top: -3px;
		width: 6px;
		height: 6px;
		border-top: 1px solid var(--smeraldo-chiaro);
		border-right: 1px solid var(--smeraldo-chiaro);
		transform: rotate(45deg);
	}
	@keyframes ae-guida {
		50% {
			transform: translateX(8px);
		}
	}
	.prot.is-iniziato .prot__guida {
		opacity: 0;
	}
	.prot__barra .prot__salta {
		margin-left: 4px;
	}
	.prot__conta {
		font-size: 0.8rem;
		letter-spacing: 0.14em;
		color: var(--nebbia);
		white-space: nowrap;
	}
	.prot__conta b {
		font-weight: 400;
		color: var(--bianco);
	}
	.prot__linea {
		flex: 1;
		height: 1px;
		background: var(--linea);
		position: relative;
	}
	.prot__linea i {
		position: absolute;
		left: 0;
		top: -1px;
		height: 3px;
		width: 100%;
		background: linear-gradient(90deg, var(--smeraldo), var(--oro));
		transform: scaleX(0);
		transform-origin: left;
	}
	.prot__nav {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		gap: 6px;
	}
	.prot__nav button {
		background: transparent;
		border: 1px solid var(--linea);
		border-radius: 2px;
		padding: 7px 10px;
		font-family: var(--mono);
		font-size: 0.68rem;
		letter-spacing: 0.1em;
		color: var(--nebbia);
		transition:
			color 0.3s var(--ease),
			border-color 0.3s var(--ease),
			background-color 0.3s var(--ease);
	}
	.prot__nav button span {
		display: none;
	}
	.prot__nav button:hover,
	.prot__nav button.is-attivo {
		color: var(--bianco);
		border-color: var(--smeraldo);
		background: rgba(78, 159, 142, 0.14);
	}
	.prot__nav button.is-attivo span {
		display: inline;
	}

	/* schermi bassi (portatili): il contenuto si comprime, la barra resta sempre nel viewport */
	@media (min-width: 901px) and (max-height: 820px) {
		.prot.is-pin .pannello__n {
			font-size: clamp(3.4rem, 11svh, 6rem);
			margin-bottom: 0;
		}
		.prot.is-pin .pannello__nome {
			font-size: clamp(2rem, 6svh, 3rem);
		}
		.prot.is-pin .pannello__testo {
			gap: 8px;
		}
		.prot.is-pin .pannello__desc {
			font-size: 0.95rem;
			line-height: 1.5;
		}
		.prot.is-pin .pannello__spec > div {
			padding: 6px 0;
		}
		.prot.is-pin .pannello__piede {
			margin-top: 6px;
		}
		.prot.is-pin .prot__vista {
			padding-bottom: 84px;
		}
		.prot.is-pin .prot__barra {
			bottom: 14px;
			padding-block: 7px;
		}
		.prot.is-pin .macchina {
			max-width: min(520px, calc(100svh - 250px));
		}
	}
	@media (max-width: 900px) {
		.pannello {
			width: 86vw;
			grid-template-columns: 1fr;
			padding: 0 18px;
		}
		.pannello__n {
			font-size: 4.6rem;
		}
		.pannello__spec {
			grid-template-columns: 1fr;
		}
		.macchina {
			max-width: 380px;
			order: -1;
		}
	}
</style>

<style is:global>
	/* ---------- disegni tecnici ---------- */
	.macchina svg {
		overflow: hidden;
	}
	.d-cornice,
	.d-linea,
	.d-raggi {
		fill: none;
		stroke: #86d6c3;
		stroke-width: 1.4;
		stroke-linejoin: round;
	}
	.d-cornice {
		stroke: rgba(142, 158, 160, 0.45);
		stroke-width: 1;
	}
	.d-micro {
		font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
		font-size: 5.2px;
		letter-spacing: 0.1em;
		fill: #93a3a6;
		stroke: none;
	}
	.d-vetro {
		fill: rgba(134, 214, 195, 0.08);
	}
	.d-liquido {
		fill: rgba(78, 159, 142, 0.35);
		stroke: #86d6c3;
	}
	.d-livello {
		stroke: #d4af37;
		stroke-dasharray: 2 3;
	}
	.d-ago {
		fill: #d4af37;
		stroke: none;
	}
	.d-ago-man {
		stroke: #d4af37;
		transform-origin: 336px 130px;
		animation: d-lancetta 6s ease-in-out infinite alternate;
	}
	@keyframes d-lancetta {
		from {
			transform: rotate(-38deg);
		}
		to {
			transform: rotate(52deg);
		}
	}
	.d-vapore path {
		stroke: rgba(226, 236, 233, 0.5);
		stroke-dasharray: 90 170;
		animation: d-vapore 5s linear infinite;
	}
	.d-v2 {
		animation-delay: -1.6s !important;
	}
	.d-v3 {
		animation-delay: -3.2s !important;
	}
	@keyframes d-vapore {
		from {
			stroke-dashoffset: 260;
		}
		to {
			stroke-dashoffset: 0;
		}
	}
	.d-goccia {
		fill: #86d6c3;
		stroke: none;
		animation: d-goccia 1.8s ease-in infinite;
	}
	@keyframes d-goccia {
		0% {
			transform: translateY(-10px);
			opacity: 0;
		}
		20% {
			opacity: 1;
		}
		100% {
			transform: translateY(14px);
			opacity: 0;
		}
	}
	.d-led {
		fill: #d4af37;
		stroke: none;
		opacity: 0.35;
		animation: d-led 2.4s ease-in-out infinite;
	}
	@keyframes d-led {
		50% {
			opacity: 1;
		}
	}
	.d-raggi path {
		stroke: rgba(212, 175, 55, 0.4);
		stroke-dasharray: 4 5;
		animation: d-raggi 3s linear infinite;
	}
	.d-raggi .d-onda {
		stroke: #86d6c3;
		stroke-dasharray: none;
		animation: none;
	}
	@keyframes d-raggi {
		to {
			stroke-dashoffset: -18;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.d-vapore path,
		.d-goccia,
		.d-led,
		.d-raggi path,
		.d-ago-man {
			animation: none;
		}
	}
</style>

<script>
	import { gsap, mouseFine, vai } from './motore';

	const sez = document.querySelector<HTMLElement>('[data-prot]')!;
	const vista = sez.querySelector<HTMLElement>('[data-prot-vista]')!;
	const pista = sez.querySelector<HTMLElement>('[data-prot-pista]')!;
	const pannelli = Array.from(sez.querySelectorAll<HTMLElement>('[data-pannello]'));
	const linea = sez.querySelector<HTMLElement>('[data-prot-linea]')!;
	const indice = sez.querySelector<HTMLElement>('[data-prot-i]')!;
	const bottoni = Array.from(sez.querySelectorAll<HTMLButtonElement>('[data-vai]'));

	// ---------- lente d'ingrandimento sui disegni (solo mouse) ----------
	if (mouseFine) {
		const ZOOM = 2.4;
		sez.querySelectorAll<HTMLElement>('[data-macchina]').forEach((m) => {
			const svg = m.querySelector('svg')!;
			const lente = document.createElement('div');
			lente.className = 'lente';
			lente.setAttribute('aria-hidden', 'true');
			const dentro = document.createElement('div');
			dentro.className = 'lente__in';
			const copia = svg.cloneNode(true) as SVGElement;
			dentro.appendChild(copia);
			lente.appendChild(dentro);
			m.appendChild(lente);
			const R = 84;
			m.addEventListener('pointermove', (e) => {
				const r = m.getBoundingClientRect();
				const x = e.clientX - r.left;
				const y = e.clientY - r.top;
				dentro.style.width = `${r.width}px`;
				dentro.style.height = `${r.height}px`;
				lente.style.transform = `translate(${x - R}px, ${y - R}px)`;
				dentro.style.transform = `translate(${R - x * ZOOM}px, ${R - y * ZOOM}px) scale(${ZOOM})`;
				lente.classList.add('is-su');
			});
			m.addEventListener('pointerleave', () => lente.classList.remove('is-su'));
		});
	}

	// ---------- scelta del protocollo → prenotazione ----------
	sez.querySelectorAll<HTMLAnchorElement>('[data-protocollo]').forEach((a) => {
		a.addEventListener('click', () => {
			document.dispatchEvent(new CustomEvent('aeterna:protocollo', { detail: { id: a.dataset.protocollo } }));
		});
	});

	function segna(i: number) {
		indice.textContent = i >= 0 ? String(i + 1).padStart(2, '0') : '—';
		bottoni.forEach((b, k) => b.classList.toggle('is-attivo', k === i));
		pannelli.forEach((p, k) => p.classList.toggle('is-attivo', k === i));
	}
	segna(-1);

	// ---------- modalità bloccata sul desktop ----------
	const mm = gsap.matchMedia();
	mm.add('(min-width: 901px) and (prefers-reduced-motion: no-preference)', () => {
		sez.classList.add('is-pin');
		const sposta = () => Math.max(0, pista.scrollWidth - innerWidth);
		const tween = gsap.to(pista, {
			x: () => -sposta(),
			ease: 'none',
			onUpdate: () => {
				// protocollo "attivo": quello il cui centro è più vicino al centro dello schermo
				let migliore = -1;
				let dist = Infinity;
				pannelli.forEach((p, k) => {
					const r = p.getBoundingClientRect();
					const d = Math.abs(r.left + r.width / 2 - innerWidth * 0.5);
					if (d < dist && r.right > innerWidth * 0.2 && r.left < innerWidth * 0.8) {
						dist = d;
						migliore = k;
					}
				});
				segna(migliore);
			},
			scrollTrigger: {
				trigger: vista,
				start: 'top top',
				end: () => `+=${Math.round(sposta() * 0.62)}`,
				pin: true,
				scrub: 0.8,
				anticipatePin: 1,
				invalidateOnRefresh: true,
				onUpdate: (self) => {
					linea.style.transform = `scaleX(${self.progress})`;
					sez.classList.toggle('is-iniziato', self.progress > 0.03);
				},
			},
		});
		const st = tween.scrollTrigger!;

		// scorre fino a un protocollo (bottoni e tastiera)
		const verso = (i: number) => {
			const p = pannelli[i];
			const x = Math.min(sposta(), Math.max(0, p.offsetLeft - parseFloat(getComputedStyle(pista).paddingLeft) - 24));
			vai(st.start + (x / Math.max(1, sposta())) * (st.end - st.start));
		};
		const clic = (e: Event) => verso(Number((e.currentTarget as HTMLElement).dataset.vai));
		bottoni.forEach((b) => b.addEventListener('click', clic));
		// il focus da tastiera su un protocollo lo porta in vista senza far scorrere a caso la pista
		const foco = (e: FocusEvent) => {
			const k = pannelli.findIndex((p) => p.contains(e.target as Node));
			if (k >= 0) verso(k);
		};
		pista.addEventListener('focusin', foco);
		return () => {
			sez.classList.remove('is-pin');
			bottoni.forEach((b) => b.removeEventListener('click', clic));
			pista.removeEventListener('focusin', foco);
			segna(-1);
		};
	});
</script>

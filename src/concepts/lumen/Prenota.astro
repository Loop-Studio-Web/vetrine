---
import { Image } from 'astro:assets';
import sera from '../../assets/lumen/sera.jpg';
import { aree, servizi } from './servizi';
---

<section class="sezione prenota" id="prenota" data-ora="sera" aria-labelledby="prenota-titolo" data-prenota>
	<div class="prenota__orizzonte" aria-hidden="true"></div>
	<div class="prenota__sfondo" aria-hidden="true">
		<Image src={sera} alt="" widths={[800, 1400]} sizes="100vw" class="prenota__foto" />
	</div>

	<div class="sezione__in prenota__in">
		<header class="prenota__testa" data-reveal>
			<p class="ora">19:00 · la sera</p>
			<h2 id="prenota-titolo">Scegli il tuo <em>momento</em>.</h2>
			<p>Un trattamento, un giorno, una fascia di luce. Quattro passaggi, nessuna telefonata.</p>
		</header>

		<div class="prenota__griglia">
			<form class="modulo" data-modulo novalidate data-reveal>
				<div class="cielo" aria-hidden="true">
					<span class="cielo__arco"></span>
					<span class="cielo__sole" data-sole></span>
				</div>
				<ol class="tappe" aria-label="Passaggi della prenotazione">
					<li class="is-corrente" data-tappa="1">Trattamento</li>
					<li data-tappa="2">Giorno</li>
					<li data-tappa="3">Luce</li>
					<li data-tappa="4">Contatti</li>
				</ol>

				<div class="passo-p" data-passo="1">
					<h3 tabindex="-1">Che cosa vuoi?</h3>
					<label class="campo">
						<span>Trattamento</span>
						<select name="servizio" data-servizio>
							<option value="">Scegli un trattamento…</option>
							{
								aree
									.filter((a) => a.id !== 'tutti')
									.map((a) => (
										<optgroup label={a.nome}>
											{servizi
												.filter((s) => s.area === a.id)
												.map((s) => (
													<option value={s.id}>
														{s.nome} · {s.min} min · {s.prezzo} €
													</option>
												))}
										</optgroup>
									))
							}
						</select>
						<small class="errore" data-errore="servizio" role="alert"></small>
					</label>
					<p class="suggerimento">Non sai quale? <a href="#su-misura">Componi un rituale su misura</a> e poi prenotalo da lì.</p>
				</div>

				<div class="passo-p" data-passo="2" hidden>
					<h3 tabindex="-1">Quando?</h3>
					<div class="giorni" role="radiogroup" aria-label="Giorno" data-giorni></div>
					<small class="errore" data-errore="giorno" role="alert"></small>
				</div>

				<div class="passo-p" data-passo="3" hidden>
					<h3 tabindex="-1">Con quale luce?</h3>
					<div data-fasce></div>
					<small class="errore" data-errore="ora" role="alert"></small>
				</div>

				<div class="passo-p" data-passo="4" hidden>
					<h3 tabindex="-1">A chi intestiamo?</h3>
					<label class="campo">
						<span>Nome</span>
						<input type="text" name="nome" autocomplete="name" required aria-describedby="err-nome" />
						<small class="errore" id="err-nome" data-errore="nome" role="alert"></small>
					</label>
					<label class="campo">
						<span>Telefono</span>
						<input type="tel" name="tel" autocomplete="tel" inputmode="tel" placeholder="000 000 0000" required aria-describedby="err-tel" />
						<small class="errore" id="err-tel" data-errore="tel" role="alert"></small>
					</label>
					<label class="campo">
						<span>Note <i>(facoltative)</i></span>
						<textarea name="note" rows="3" placeholder="Allergie, desideri, una persona che viene con te…"></textarea>
					</label>
					<p class="suggerimento">Vetrina dimostrativa: i dati non vengono inviati né salvati da nessuna parte.</p>
				</div>

				<div class="azioni">
					<button type="button" class="btn btn--chiaro-s" data-indietro hidden>← Indietro</button>
					<button type="button" class="btn btn--oro" data-avanti>Avanti <span aria-hidden="true">→</span></button>
				</div>
			</form>

			<aside class="riepilogo" data-reveal style="--d:0.1s" aria-label="Riepilogo della prenotazione">
				<p class="riepilogo__t">Il tuo momento</p>
				<dl>
					<div><dt>Trattamento</dt><dd data-r="servizio">Da scegliere</dd></div>
					<div><dt>Giorno</dt><dd data-r="giorno">Da scegliere</dd></div>
					<div><dt>Ora</dt><dd data-r="ora">Da scegliere</dd></div>
					<div class="riepilogo__prezzo"><dt>Totale</dt><dd data-r="prezzo">—</dd></div>
				</dl>
			</aside>

			<div class="biglietto" data-biglietto hidden>
				<div class="biglietto__alone" aria-hidden="true"></div>
				<div class="biglietto__corpo" tabindex="-1">
					<p class="biglietto__t">Biglietto di luce</p>
					<h3>Ti aspettiamo, <span data-b="nome"></span>.</h3>
					<p class="biglietto__quando"><strong data-b="giorno"></strong> alle <strong data-b="ora"></strong></p>
					<p data-b="servizio" class="biglietto__servizio"></p>
					<p class="biglietto__nota">
						Prenotazione di esempio: non è stato inviato nulla. In un centro vero qui arriverebbe una conferma via messaggio, con un promemoria il
						giorno prima.
					</p>
					<button type="button" class="btn btn--oro" data-nuova>Nuova prenotazione</button>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.prenota {
		background: var(--prugna);
		color: var(--cipria);
		overflow: clip;
		padding-top: clamp(110px, 10vw, 140px);
		--ink: var(--cipria);
		--acc: var(--oro-chiaro);
	}
	.prenota__orizzonte {
		position: absolute;
		left: 0;
		right: 0;
		top: 0;
		height: clamp(100px, 10vw, 150px);
		background: linear-gradient(180deg, #f0cdb9 0%, #b7766c 40%, #5a3040 75%, var(--prugna) 100%);
	}
	.prenota__sfondo {
		position: absolute;
		inset: 0;
		opacity: 0.22;
		mask-image: linear-gradient(180deg, transparent 8%, #000 40%, transparent 100%);
	}
	.prenota__foto {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.prenota__in {
		position: relative;
	}
	.prenota__testa {
		max-width: 40em;
		margin-bottom: 34px;
	}
	.prenota__testa h2 {
		margin: 18px 0 18px;
	}
	.prenota__testa em {
		color: var(--oro-chiaro);
	}
	.prenota__testa p:last-child {
		color: #e6cdc4;
		font-size: 1.1rem;
	}
	.prenota__griglia {
		display: grid;
		grid-template-columns: 1.35fr 0.65fr;
		gap: clamp(20px, 4vw, 56px);
		align-items: start;
	}

	.modulo {
		position: relative;
		padding: clamp(22px, 3.4vw, 40px);
		border-radius: 28px;
		background: rgb(54 34 42 / 0.82);
		backdrop-filter: blur(12px);
		border: 1px solid rgb(247 227 220 / 0.14);
	}
	.cielo {
		position: relative;
		height: 38px;
		margin-bottom: 8px;
		overflow: visible;
	}
	.cielo__arco {
		position: absolute;
		left: 4%;
		right: 4%;
		top: 14px;
		height: 120px;
		border-radius: 50%;
		border: 1px dashed rgb(247 227 220 / 0.3);
	}
	.cielo__sole {
		position: absolute;
		left: var(--sx, 8%);
		top: var(--sy, 24px);
		width: 16px;
		height: 16px;
		margin: -8px 0 0 -8px;
		border-radius: 50%;
		background: #ffd6b8;
		box-shadow: 0 0 22px 8px rgb(255 190 150 / 0.6);
		transition:
			left 1s var(--ease),
			top 1s var(--ease);
	}
	.tappe {
		list-style: none;
		display: flex;
		gap: 6px;
		margin-bottom: 26px;
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}
	.tappe li {
		flex: 1;
		padding-top: 10px;
		border-top: 2px solid rgb(247 227 220 / 0.2);
		color: #c9aaa0;
		transition:
			color 0.5s,
			border-color 0.5s;
	}
	.tappe li.is-fatta {
		border-color: var(--oro);
		color: #e6cdc4;
	}
	.tappe li.is-corrente {
		border-color: var(--oro-chiaro);
		color: var(--cipria);
	}
	.passo-p {
		animation: entra-p 0.7s var(--ease) both;
	}
	.passo-p[hidden] {
		display: none;
	}
	@keyframes entra-p {
		from {
			opacity: 0;
			transform: translateX(22px);
		}
	}
	.passo-p h3 {
		font-size: clamp(1.9rem, 4vw, 2.6rem);
		font-weight: 500;
		margin-bottom: 20px;
		outline: none;
	}
	.campo {
		display: block;
		margin-bottom: 16px;
	}
	.campo > span {
		display: block;
		margin-bottom: 6px;
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0.06em;
	}
	.campo i {
		font-weight: 400;
		opacity: 0.8;
	}
	.campo select,
	.campo input,
	.campo textarea {
		width: 100%;
		padding: 14px 16px;
		border-radius: 14px;
		border: 1px solid rgb(247 227 220 / 0.3);
		background: rgb(36 22 25 / 0.7);
		color: var(--cipria);
	}
	.campo select {
		appearance: none;
		background-image: linear-gradient(45deg, transparent 50%, var(--oro-chiaro) 50%), linear-gradient(135deg, var(--oro-chiaro) 50%, transparent 50%);
		background-position:
			calc(100% - 22px) 52%,
			calc(100% - 16px) 52%;
		background-size: 6px 6px;
		background-repeat: no-repeat;
	}
	.campo ::placeholder {
		color: #bb9e95;
	}
	.campo input[aria-invalid='true'],
	.campo select[aria-invalid='true'] {
		border-color: #ffb3a0;
	}
	.errore {
		display: block;
		min-height: 1.2em;
		margin-top: 6px;
		color: #ffc3b2;
		font-size: 0.85rem;
	}
	.suggerimento {
		font-size: 0.88rem;
		color: #d8bdb3;
	}
	.suggerimento a {
		color: var(--oro-chiaro);
	}

	.giorni {
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		gap: 8px;
	}
	.giorno,
	.ora-slot {
		position: relative;
		display: block;
		cursor: pointer;
	}
	.giorno input,
	.ora-slot input {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}
	.giorno span {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 12px 4px;
		border-radius: 16px;
		border: 1px solid rgb(247 227 220 / 0.28);
		transition:
			background 0.35s,
			transform 0.35s var(--ease),
			color 0.35s;
	}
	.giorno small {
		font-size: 0.74rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: #d8bdb3;
	}
	.giorno b {
		font-family: var(--titoli);
		font-size: 1.9rem;
		font-weight: 600;
		line-height: 1.1;
	}
	.giorno em {
		font-style: normal;
		font-size: 0.78rem;
		color: #d8bdb3;
	}
	.giorno:hover span {
		transform: translateY(-3px);
	}
	.giorno input:checked + span,
	.ora-slot input:checked + span {
		background: var(--oro-chiaro);
		border-color: var(--oro-chiaro);
		color: var(--prugna);
	}
	.giorno input:checked + span small,
	.giorno input:checked + span em {
		color: var(--prugna);
	}
	.giorno input:focus-visible + span,
	.ora-slot input:focus-visible + span {
		outline: 3px solid var(--oro-chiaro);
		outline-offset: 3px;
	}

	.fascia-luce {
		margin-bottom: 16px;
	}
	.fascia-luce h4 {
		font-family: var(--titoli);
		font-size: 1.4rem;
		font-weight: 500;
		margin-bottom: 8px;
		display: flex;
		align-items: baseline;
		gap: 10px;
	}
	.fascia-luce h4 small {
		font-family: var(--testo);
		font-size: 0.8rem;
		color: #d8bdb3;
		font-weight: 400;
	}
	.slot-riga {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 8px;
	}
	.ora-slot span {
		display: block;
		text-align: center;
		padding: 12px 4px;
		border-radius: 14px;
		border: 1px solid rgb(247 227 220 / 0.28);
		font-weight: 600;
		transition:
			background 0.35s,
			transform 0.35s var(--ease);
	}
	.ora-slot:hover span {
		transform: translateY(-2px);
	}
	.ora-slot.is-pieno {
		cursor: not-allowed;
	}
	.ora-slot.is-pieno span {
		opacity: 0.45;
		text-decoration: line-through;
		border-style: dashed;
	}

	.azioni {
		display: flex;
		justify-content: space-between;
		gap: 12px;
		margin-top: 22px;
	}
	.btn--chiaro-s {
		background: transparent;
		color: var(--cipria);
		border-color: rgb(247 227 220 / 0.35);
	}
	.azioni [hidden] {
		display: none;
	}
	.azioni [data-avanti] {
		margin-left: auto;
	}

	.riepilogo {
		position: sticky;
		top: calc(var(--nav-h) + var(--fascia, 0px) + 20px);
		padding: 26px;
		border-radius: 24px;
		border: 1px solid rgb(247 227 220 / 0.18);
		background: linear-gradient(160deg, rgb(231 169 148 / 0.14), rgb(247 227 220 / 0.04));
	}
	.riepilogo__t {
		font-family: var(--titoli);
		font-size: 1.8rem;
		margin-bottom: 12px;
	}
	.riepilogo dl > div {
		padding: 11px 0;
		border-top: 1px solid rgb(247 227 220 / 0.14);
	}
	.riepilogo dt {
		font-size: 0.74rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: #d8bdb3;
	}
	.riepilogo dd {
		font-size: 1.05rem;
		transition: color 0.5s;
	}
	.riepilogo dd.is-scelto {
		color: var(--oro-chiaro);
	}
	.riepilogo__prezzo dd {
		font-family: var(--titoli);
		font-size: 1.9rem;
	}

	.biglietto {
		grid-column: 1 / -1;
		position: relative;
		display: grid;
		place-items: center;
		padding: 20px 0;
	}
	.biglietto[hidden] {
		display: none;
	}
	.biglietto__alone {
		position: absolute;
		width: min(640px, 100%);
		aspect-ratio: 1.6;
		background: radial-gradient(closest-side, rgb(255 196 160 / 0.55), transparent);
		animation: alone 4s ease-in-out infinite;
	}
	@keyframes alone {
		50% {
			transform: scale(1.12);
			opacity: 0.7;
		}
	}
	.biglietto__corpo {
		position: relative;
		max-width: 560px;
		width: 100%;
		padding: clamp(28px, 5vw, 48px);
		border-radius: 26px;
		background: linear-gradient(160deg, #fbe7dd, #f1c5b2);
		color: var(--inchiostro);
		text-align: center;
		animation: stampa 1.1s var(--ease) both;
		outline: none;
	}
	@keyframes stampa {
		from {
			opacity: 0;
			transform: translateY(40px) rotate(-2deg) scale(0.94);
		}
	}
	.biglietto__t {
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--oro-testo);
	}
	.biglietto h3 {
		font-size: clamp(2rem, 5vw, 3rem);
		margin: 10px 0 14px;
	}
	.biglietto__quando {
		font-size: 1.25rem;
	}
	.biglietto__servizio {
		margin-top: 4px;
		font-family: var(--titoli);
		font-size: 1.6rem;
		font-style: italic;
		color: var(--oro-testo);
	}
	.biglietto__nota {
		margin: 20px 0 22px;
		font-size: 0.88rem;
		color: #5b413c;
	}

	@media (max-width: 900px) {
		.prenota__griglia {
			grid-template-columns: 1fr;
		}
		.riepilogo {
			position: static;
			order: 3;
		}
	}
	@media (max-width: 480px) {
		.giorni {
			grid-template-columns: repeat(3, 1fr);
		}
		.tappe {
			font-size: 0.66rem;
			letter-spacing: 0.04em;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.passo-p,
		.biglietto__corpo,
		.biglietto__alone {
			animation: none;
		}
		.cielo__sole {
			transition: none;
		}
	}
</style>

<script>
	import { breve, chiave, esteso, giorniPrenotabili, orariDelGiorno } from './fasce';
	import { servizi, type Servizio } from './servizi';

	const sez = document.querySelector<HTMLElement>('[data-prenota]')!;
	const modulo = sez.querySelector<HTMLFormElement>('[data-modulo]')!;
	const q = <T extends Element>(s: string) => sez.querySelector<T>(s)!;
	const select = q<HTMLSelectElement>('[data-servizio]');
	const giorniEl = q<HTMLElement>('[data-giorni]');
	const fasceEl = q<HTMLElement>('[data-fasce]');
	const avanti = q<HTMLButtonElement>('[data-avanti]');
	const indietro = q<HTMLButtonElement>('[data-indietro]');
	const sole = q<HTMLElement>('[data-sole]');
	const biglietto = q<HTMLElement>('[data-biglietto]');
	const riepilogo = q<HTMLElement>('.riepilogo');

	type Stato = { servizio: string; nomeServizio: string; prezzo: number; giorno: string; giornoTesto: string; ora: string };
	const vuoto: Stato = { servizio: '', nomeServizio: '', prezzo: 0, giorno: '', giornoTesto: '', ora: '' };
	let stato: Stato = { ...vuoto };
	let passo = 1;
	const adesso = new Date();
	const giorni = giorniPrenotabili(adesso, 10);

	const scrivi = (k: string, t: string, scelto: boolean) => {
		const el = q<HTMLElement>(`[data-r="${k}"]`);
		el.textContent = t;
		el.classList.toggle('is-scelto', scelto);
	};
	const aggiornaRiepilogo = () => {
		scrivi('servizio', stato.nomeServizio || 'Da scegliere', !!stato.nomeServizio);
		scrivi('giorno', stato.giornoTesto || 'Da scegliere', !!stato.giornoTesto);
		scrivi('ora', stato.ora || 'Da scegliere', !!stato.ora);
		scrivi('prezzo', stato.prezzo ? `${stato.prezzo} €` : '—', !!stato.prezzo);
	};

	const errore = (k: string, msg: string) => {
		const el = sez.querySelector<HTMLElement>(`[data-errore="${k}"]`);
		if (el) el.textContent = msg;
		const campo = modulo.elements.namedItem(k);
		if (campo instanceof HTMLElement) campo.setAttribute('aria-invalid', msg ? 'true' : 'false');
	};

	// il sole attraversa il cielo a ogni passo: alba → sera
	const muoviSole = () => {
		const t = (passo - 1) / 3;
		sole.style.setProperty('--sx', `${8 + t * 84}%`);
		sole.style.setProperty('--sy', `${30 - Math.sin(t * Math.PI) * 22}px`);
	};

	const vai = (n: number, focus = true) => {
		passo = n;
		modulo.querySelectorAll<HTMLElement>('[data-passo]').forEach((p) => (p.hidden = Number(p.dataset.passo) !== n));
		modulo.querySelectorAll<HTMLElement>('[data-tappa]').forEach((t) => {
			const i = Number(t.dataset.tappa);
			t.classList.toggle('is-corrente', i === n);
			t.classList.toggle('is-fatta', i < n);
			if (i === n) t.setAttribute('aria-current', 'step');
			else t.removeAttribute('aria-current');
		});
		indietro.hidden = n === 1;
		avanti.innerHTML = n === 4 ? 'Conferma la prenotazione <span aria-hidden="true">→</span>' : 'Avanti <span aria-hidden="true">→</span>';
		muoviSole();
		if (focus) modulo.querySelector<HTMLElement>(`[data-passo="${n}"] h3`)?.focus();
	};

	const disegnaGiorni = () => {
		giorniEl.replaceChildren(
			...giorni.map((d) => {
				const b = breve(d);
				const l = document.createElement('label');
				l.className = 'giorno';
				l.innerHTML = `<input type="radio" name="giorno" value="${chiave(d)}"><span><small>${b.g}</small><b>${b.n}</b><em>${b.m}</em></span>`;
				l.querySelector('input')!.addEventListener('change', () => {
					stato.giorno = chiave(d);
					stato.giornoTesto = esteso(d);
					stato.ora = '';
					errore('giorno', '');
					aggiornaRiepilogo();
				});
				return l;
			}),
		);
	};
	const disegnaFasce = () => {
		const d = giorni.find((x) => chiave(x) === stato.giorno);
		if (!d) return;
		fasceEl.replaceChildren(
			...orariDelGiorno(d, adesso).map((f) => {
				const box = document.createElement('div');
				box.className = 'fascia-luce';
				box.innerHTML = `<h4>${f.nome} <small>${f.luce}</small></h4>`;
				const riga = document.createElement('div');
				riga.className = 'slot-riga';
				riga.setAttribute('role', 'radiogroup');
				riga.setAttribute('aria-label', f.nome);
				f.slot.forEach((s) => {
					const l = document.createElement('label');
					l.className = `ora-slot${s.libero ? '' : ' is-pieno'}`;
					l.innerHTML = `<input type="radio" name="ora" value="${s.o}" ${s.libero ? '' : 'disabled'}><span>${s.o}${s.libero ? '' : '<span class="sr-only"> (non disponibile)</span>'}</span>`;
					l.querySelector('input')!.addEventListener('change', () => {
						stato.ora = s.o;
						errore('ora', '');
						aggiornaRiepilogo();
					});
					riga.append(l);
				});
				box.append(riga);
				return box;
			}),
		);
	};

	const imposta = (nome: string, prezzo: number, id: string) => {
		stato.servizio = id;
		stato.nomeServizio = nome;
		stato.prezzo = prezzo;
		errore('servizio', '');
		aggiornaRiepilogo();
	};

	select.addEventListener('change', () => {
		const s = servizi.find((x: Servizio) => x.id === select.value);
		if (s) imposta(`${s.nome} · ${s.min} min`, s.prezzo, s.id);
		else imposta('', 0, '');
	});

	// da "Prenota" delle schede o dal rituale su misura
	document.addEventListener('lumen:servizio', (e) => {
		const d = (e as CustomEvent).detail as { id?: string; rituale?: { nome: string; prezzo: number } };
		select.querySelector('option[data-rituale]')?.remove();
		if (d.id) {
			select.value = d.id;
			select.dispatchEvent(new Event('change'));
		} else if (d.rituale) {
			const o = document.createElement('option');
			o.value = 'rituale';
			o.dataset.rituale = '1';
			o.textContent = `${d.rituale.nome} · ${d.rituale.prezzo} €`;
			select.prepend(o);
			select.value = 'rituale';
			imposta(d.rituale.nome, d.rituale.prezzo, 'rituale');
		}
		biglietto.hidden = true;
		modulo.hidden = false;
		riepilogo.hidden = false;
		vai(2, false);
	});

	const valida = (): boolean => {
		if (passo === 1) {
			if (!stato.servizio) return errore('servizio', 'Scegli un trattamento per continuare.'), false;
		}
		if (passo === 2) {
			if (!stato.giorno) return errore('giorno', 'Scegli un giorno.'), false;
			disegnaFasce();
		}
		if (passo === 3 && !stato.ora) return errore('ora', 'Scegli un orario libero.'), false;
		if (passo === 4) {
			const nome = (modulo.elements.namedItem('nome') as HTMLInputElement).value.trim();
			const tel = (modulo.elements.namedItem('tel') as HTMLInputElement).value.replace(/[\s.\-()+]/g, '');
			let ok = true;
			errore('nome', nome.length < 2 ? 'Scrivi il tuo nome.' : '');
			if (nome.length < 2) ok = false;
			errore('tel', /^\d{8,14}$/.test(tel) ? '' : 'Controlla il numero di telefono (almeno 8 cifre).');
			if (!/^\d{8,14}$/.test(tel)) ok = false;
			if (!ok) modulo.querySelector<HTMLInputElement>('[aria-invalid="true"]')?.focus();
			return ok;
		}
		return true;
	};

	avanti.addEventListener('click', () => {
		if (!valida()) return;
		if (passo < 4) return vai(passo + 1);
		// conferma: stampa il "biglietto di luce"
		const nome = (modulo.elements.namedItem('nome') as HTMLInputElement).value.trim().split(' ')[0];
		const set = (k: string, t: string) => (q<HTMLElement>(`[data-b="${k}"]`).textContent = t);
		set('nome', nome);
		set('giorno', stato.giornoTesto);
		set('ora', stato.ora);
		set('servizio', stato.nomeServizio);
		modulo.hidden = true;
		riepilogo.hidden = true;
		biglietto.hidden = false;
		biglietto.querySelector<HTMLElement>('.biglietto__corpo')!.focus({ preventScroll: true });
	});
	modulo.addEventListener('input', (e) => {
		const n = (e.target as HTMLInputElement).name;
		if (n === 'nome' || n === 'tel') errore(n, '');
	});
	indietro.addEventListener('click', () => vai(passo - 1));
	modulo.addEventListener('submit', (e) => e.preventDefault());
	modulo.addEventListener('keydown', (e) => {
		if (e.key === 'Enter' && (e.target as HTMLElement).tagName === 'INPUT' && (e.target as HTMLInputElement).type !== 'radio') {
			e.preventDefault();
			avanti.click();
		}
	});

	q('[data-nuova]').addEventListener('click', () => {
		stato = { ...vuoto };
		modulo.reset();
		select.querySelector('option[data-rituale]')?.remove();
		disegnaGiorni();
		fasceEl.replaceChildren();
		aggiornaRiepilogo();
		biglietto.hidden = true;
		modulo.hidden = false;
		riepilogo.hidden = false;
		vai(1);
	});

	disegnaGiorni();
	aggiornaRiepilogo();
	vai(1, false);
</script>

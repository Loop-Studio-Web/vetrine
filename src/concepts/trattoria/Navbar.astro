---
import { Image } from 'astro:assets';
import emblema from '../../assets/trattoria/brand/emblema.png';
---

<!-- Navbar sticky con theme switcher -->
<nav class="navbar" aria-label="Navigazione principale">
	<div class="navbar__container">
		<a href="#" class="navbar__logo">
			<Image src={emblema} alt="" width={46} densities={[1, 2, 3]} class="navbar__emblem" />
			<span>Trattoria del Borgo</span>
		</a>
		<ul class="navbar__menu">
			<li><a href="#hero" class="navbar__link">Home</a></li>
			<li><a href="#menu" class="navbar__link">Menu</a></li>
			<li><a href="#reviews" class="navbar__link">Recensioni</a></li>
			<li><a href="#info" class="navbar__link">Contatti</a></li>
		</ul>
		<div class="navbar__actions">
			<a href="#prenota" class="navbar__cta">Prenota</a>
			<button class="theme-switcher" type="button" aria-label="Passa al tema scuro" title="Passa al tema scuro">
				<svg class="theme-switcher__icon theme-switcher__icon--moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
					<path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a8.5 8.5 0 1 0 10.7 10.7z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
				</svg>
				<svg class="theme-switcher__icon theme-switcher__icon--sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
					<circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2" />
					<path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
				</svg>
					</button>
				<button class="navbar__burger" type="button" aria-expanded="false" aria-controls="menu-mobile" aria-label="Apri il menù" data-burger>
					<span class="navbar__bar"></span>
					<span class="navbar__bar"></span>
					<span class="navbar__bar"></span>
				</button>
			</div>
		</div>
		<div class="navbar__panel" id="menu-mobile" data-panel inert>
			<ul class="navbar__plist">
				<li style="--i:0"><a href="#hero" class="navbar__plink">Home</a></li>
				<li style="--i:1"><a href="#menu" class="navbar__plink">Menu</a></li>
				<li style="--i:2"><a href="#reviews" class="navbar__plink">Recensioni</a></li>
				<li style="--i:3"><a href="#info" class="navbar__plink">Contatti</a></li>
			</ul>
			<div class="navbar__pfoot" style="--i:4">
				<a href="#prenota" class="navbar__cta navbar__plink">Prenota un tavolo</a>
				<button class="theme-switcher theme-switcher--panel" type="button" aria-label="Passa al tema scuro" title="Passa al tema scuro">
					<svg class="theme-switcher__icon theme-switcher__icon--moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
						<path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a8.5 8.5 0 1 0 10.7 10.7z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
					<svg class="theme-switcher__icon theme-switcher__icon--sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
						<circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2" />
						<path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
					</svg>
				</button>
			</div>
		</div>
	</nav>

<style>
	/* Navbar */
	.navbar {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 1000;
		background: transparent;
		backdrop-filter: blur(0px);
		-webkit-backdrop-filter: blur(0px);
		transition: background-color 0.3s, border-color 0.3s, backdrop-filter 0.3s, box-shadow 0.3s;
		border-bottom: 1px solid transparent;
	}

	.navbar.scrolled {
		background: var(--glass-backdrop);
		border-bottom-color: var(--border-color);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
	}

	.navbar:not(.scrolled) .navbar__logo,
	.navbar:not(.scrolled) .navbar__link {
		color: rgba(255, 255, 255, 0.92);
	}

	.navbar.scrolled .navbar__logo,
	.navbar.scrolled .navbar__link {
		color: var(--text-primary);
	}

	.navbar__container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 16px 24px;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 24px;
	}

	.navbar__logo {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		font-family: var(--font-display);
		font-size: 24px;
		font-weight: 700;
		color: var(--text-primary);
		text-decoration: none;
		letter-spacing: -0.3px;
		transition: color 0.2s;
	}

	.navbar__emblem {
		width: auto;
		height: 46px;
		flex-shrink: 0;
	}

	.navbar__logo:hover {
		color: var(--accent-primary);
	}

	.navbar__menu {
		list-style: none;
		display: flex;
		gap: 36px;
		flex: 1;
		justify-content: center;
	}

	.navbar__link {
		font-size: 17px;
		font-weight: 500;
		color: var(--text-secondary);
		text-decoration: none;
		transition: color 0.2s;
		position: relative;
	}

	.navbar__link:hover {
		color: var(--text-primary);
	}

	.navbar__link::after {
		content: '';
		position: absolute;
		bottom: -4px;
		left: 0;
		width: 0;
		height: 2px;
		background: var(--accent-primary);
		transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.navbar__link:hover::after {
		width: 100%;
	}

	.navbar__actions {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.navbar__cta {
		background: var(--accent-primary);
		color: var(--on-accent);
		font-size: 16px;
		font-weight: 600;
		text-decoration: none;
		padding: 10px 20px;
		border-radius: 8px;
		transition: transform 0.2s, filter 0.2s;
	}

	.navbar__cta:hover {
		transform: translateY(-1px);
		filter: brightness(1.08);
	}
	/* Theme Switcher */
	.theme-switcher {
		background: var(--bg-secondary);
		border: 1px solid var(--border-color);
		border-radius: 8px;
		padding: 8px 10px;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		transition: background-color 0.3s, color 0.3s, border-color 0.3s;
		color: var(--text-primary);
	}

	.theme-switcher:hover {
		background: var(--accent-primary);
		color: var(--bg-main);
		border-color: var(--accent-primary);
	}

	.theme-switcher:focus-visible {
		outline: 2px solid var(--accent-primary);
		outline-offset: 2px;
	}

	.theme-switcher__icon {
		display: block;
	}

	/* Mostra l'icona del tema in cui si passa: luna nel chiaro, sole nello scuro */
	.theme-switcher__icon--sun {
		display: none;
	}

	:global(html[data-theme='dark']) .theme-switcher__icon--moon {
		display: none;
	}

	:global(html[data-theme='dark']) .theme-switcher__icon--sun {
		display: block;
	}


	@media (max-width: 768px) {
		.navbar__menu {
			gap: 18px;
		}

		.navbar__link {
			font-size: 15px;
		}

		.navbar__logo {
			font-size: 20px;
		}
	}

	/* Menù su schermi stretti: un cartoncino del menù che si srotola dalla barra */
	.navbar__burger {
		display: none;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		gap: 4px;
		width: 40px;
		height: 38px;
		padding: 0;
		background: var(--bg-secondary);
		border: 1px solid var(--border-color);
		border-radius: 8px;
		color: var(--text-primary);
		cursor: pointer;
		transition: background-color 0.3s, color 0.3s, border-color 0.3s;
	}
	.navbar__burger:focus-visible {
		outline: 2px solid var(--accent-primary);
		outline-offset: 2px;
	}
	.navbar__bar {
		display: block;
		width: 18px;
		height: 2px;
		border-radius: 2px;
		background: currentColor;
		transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.25s;
	}
	.navbar__burger[aria-expanded='true'] {
		background: var(--accent-primary);
		border-color: var(--accent-primary);
		color: var(--on-accent);
	}
	.navbar__burger[aria-expanded='true'] .navbar__bar:nth-child(1) {
		transform: translateY(6px) rotate(45deg);
	}
	.navbar__burger[aria-expanded='true'] .navbar__bar:nth-child(2) {
		opacity: 0;
	}
	.navbar__burger[aria-expanded='true'] .navbar__bar:nth-child(3) {
		transform: translateY(-6px) rotate(-45deg);
	}

	.navbar__panel {
		display: none;
	}

	@media (max-width: 768px) {
		.navbar__menu,
		.navbar__actions > .theme-switcher {
			display: none;
		}
		.navbar__burger {
			display: inline-flex;
		}
		.navbar__panel {
			display: block;
			position: absolute;
			top: 100%;
			left: 12px;
			right: 12px;
			margin-top: 6px;
			padding: 10px 24px 22px;
			background: var(--bg-main);
			border: 1px solid var(--border-color);
			border-radius: 16px;
			box-shadow: 0 18px 40px -12px rgba(0, 0, 0, 0.35);
			clip-path: inset(0 0 100% 0 round 16px);
			visibility: hidden;
			transition: clip-path 0.55s cubic-bezier(0.4, 0, 0.2, 1), visibility 0s 0.55s;
		}
		.navbar__panel.is-open {
			clip-path: inset(0 0 0 0 round 16px);
			visibility: visible;
			transition: clip-path 0.55s cubic-bezier(0.4, 0, 0.2, 1), visibility 0s;
		}
		.navbar__plist {
			list-style: none;
			margin: 0;
			padding: 0;
		}
		.navbar__plist li {
			border-bottom: 1px dashed var(--border-color);
		}
		.navbar__panel .navbar__plink:not(.navbar__cta) {
			display: block;
			padding: 14px 0;
			font-family: var(--font-display);
			font-size: 28px;
			font-weight: 600;
			letter-spacing: -0.3px;
			color: var(--text-primary);
			text-decoration: none;
		}
		.navbar__panel .navbar__plink:not(.navbar__cta):hover {
			color: var(--accent-primary);
		}
		.navbar__pfoot {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 12px;
			margin-top: 20px;
		}
		.navbar__pfoot .navbar__cta {
			flex: 1;
			text-align: center;
		}
		.navbar__plist li,
		.navbar__pfoot {
			opacity: 0;
			transform: translateY(12px);
			transition: opacity 0.3s, transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
		}
		.navbar__panel.is-open .navbar__plist li,
		.navbar__panel.is-open .navbar__pfoot {
			opacity: 1;
			transform: none;
			transition-delay: calc(0.15s + var(--i) * 0.06s);
		}
		/* Con il pannello aperto la barra non resta trasparente sul video */
		.navbar.is-menu-open {
			background: var(--glass-backdrop);
			border-bottom-color: var(--border-color);
		}
		.navbar.is-menu-open .navbar__logo {
			color: var(--text-primary);
		}
		:global(html.menu-open) {
			overflow: hidden;
		}
	}

	@media (max-width: 480px) {
		.navbar__container {
			padding-inline: 16px;
			gap: 10px;
		}

		.navbar__logo {
			font-size: 16px;
			gap: 8px;
		}

		.navbar__emblem {
			height: 36px;
		}

		.navbar__cta {
			padding: 9px 14px;
			font-size: 15px;
		}
	}
</style>

<script>
	// Theme switcher
	const themeSwitchers = document.querySelectorAll<HTMLButtonElement>('.theme-switcher');
	const html = document.documentElement;

	// Il tema iniziale è già applicato dallo script inline in <head> (evita il lampo)
	const isDark = () => html.getAttribute('data-theme') === 'dark';
	const syncLabel = () => {
		const label = isDark() ? 'Passa al tema chiaro' : 'Passa al tema scuro';
		themeSwitchers.forEach((b) => {
			b.setAttribute('aria-label', label);
			b.setAttribute('title', label);
		});
	};
	syncLabel();

	themeSwitchers.forEach((b) =>
		b.addEventListener('click', () => {
			const newTheme = isDark() ? 'light' : 'dark';
			html.setAttribute('data-theme', newTheme);
			try {
				localStorage.setItem('theme', newTheme);
			} catch {
				// storage non disponibile (es. navigazione privata): il tema vale solo per la sessione
			}
			syncLabel();
		}),
	);

	// Navbar scroll effect
	const navbar = document.querySelector('.navbar') as HTMLElement;

	window.addEventListener('scroll', () => {
		if (window.scrollY > 10) {
			navbar.classList.add('scrolled');
		} else {
			navbar.classList.remove('scrolled');
		}
	});

	// Menù su schermi stretti: apri/chiudi, Esc, voci, ritorno del focus
	const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
	const panel = document.querySelector<HTMLElement>('[data-panel]');
	const setMenu = (open: boolean) => {
		if (!burger || !panel) return;
		panel.classList.toggle('is-open', open);
		panel.toggleAttribute('inert', !open);
		navbar.classList.toggle('is-menu-open', open);
		html.classList.toggle('menu-open', open);
		burger.setAttribute('aria-expanded', String(open));
		burger.setAttribute('aria-label', open ? 'Chiudi il menù' : 'Apri il menù');
		if (open) panel.querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
	};
	burger?.addEventListener('click', () => setMenu(burger.getAttribute('aria-expanded') !== 'true'));
	window.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && burger?.getAttribute('aria-expanded') === 'true') {
			setMenu(false);
			burger.focus();
		}
	});
	window.matchMedia('(min-width: 769px)').addEventListener('change', (e) => e.matches && setMenu(false));

	// Smooth scroll per navbar links
	document.querySelectorAll<HTMLAnchorElement>('.navbar__link, .navbar__plink').forEach(link => {
		link.addEventListener('click', (e) => {
			const href = link.getAttribute('href');
			if (href && href.startsWith('#')) {
				e.preventDefault();
				setMenu(false);
				const target = document.querySelector(href);
				if (target) {
					target.scrollIntoView({ behavior: 'smooth' });
				}
			}
		});
	});
</script>

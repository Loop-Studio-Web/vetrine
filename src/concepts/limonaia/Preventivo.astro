---
---

<section class="sezione preventivo fascia-colore fascia-colore--cotto" id="preventivo" aria-labelledby="t-preventivo">
	<div class="wrap">
		<h2 id="t-preventivo">Quanto costa, <em>voce per voce.</em></h2>
		<p class="sezione__intro">
			Una forchetta, non una cifra a sorpresa: cambia sala, data o ospiti e le voci si ricalcolano. Tieni due versioni e
			confrontale.
		</p>

		<div class="prev__griglia">
			<div class="conto">
				<p class="conto__testata" data-testata>—</p>
				<ul class="conto__voci" data-voci></ul>
				<label class="conto__catering">
					<input type="checkbox" data-catering />
					<span>Aggiungi il catering del nostro cuoco <small data-cat-nota></small></span>
				</label>
				<div class="conto__totale">
					<span>Circa</span>
					<strong data-totale>—</strong>
				</div>
				<p class="conto__forchetta">
					Forchetta da <span data-forchetta>—</span>, cioè <span data-testa>—</span> a persona
				</p>
				<p class="conto__nota">Cifre di fantasia, IVA inclusa. Il preventivo vero arriva dopo il sopralluogo.</p>
			</div>

			<div class="confronto">
				<h3>Confronta due idee</h3>
				<p class="confronto__aiuto">Tieni la scheda com’è adesso, cambia qualcosa sopra, tienine un’altra.</p>
				<div class="opz">
					<article class="opz__c" data-slot="A">
						<h4>Prima idea</h4>
						<div class="opz__corpo" data-corpo>Vuota</div>
						<div class="opz__azioni">
							<button type="button" class="btn btn--vuoto" data-tieni="A">Salva la scheda di ora</button>
							<button type="button" class="opz__link" data-usa="A" hidden>Riapri</button>
						</div>
					</article>
					<article class="opz__c" data-slot="B">
						<h4>Seconda idea</h4>
						<div class="opz__corpo" data-corpo>Vuota</div>
						<div class="opz__azioni">
							<button type="button" class="btn btn--vuoto" data-tieni="B">Salva la scheda di ora</button>
							<button type="button" class="opz__link" data-usa="B" hidden>Riapri</button>
						</div>
					</article>
				</div>
				<p class="confronto__diff" data-diff aria-live="polite"></p>

				<div class="link">
					<label for="link-scheda">Il link a questa scheda</label>
					<div class="link__riga">
						<input id="link-scheda" type="text" readonly data-link />
						<button type="button" class="btn" data-copia>Copia</button>
					</div>
					<p class="link__nota" data-copia-esito aria-live="polite">Chi lo apre vede la tua stessa pianta.</p>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.preventivo .wrap > h2,
	.preventivo .wrap > .sezione__intro {
		margin-inline: auto;
		text-align: center;
	}
	.prev__griglia {
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
		gap: clamp(24px, 4vw, 64px);
		margin-top: 40px;
		align-items: start;
	}
	.conto {
		background: var(--carta);
		color: var(--testo);
		padding: clamp(18px, 3vw, 32px);
		border-radius: 6px 6px 0 0;
		position: relative;
		margin-bottom: 12px;
	}
	.conto::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		top: 100%;
		height: 10px;
		background:
			linear-gradient(135deg, var(--carta) 50%, transparent 50%) 0 0 / 20px 10px,
			linear-gradient(225deg, var(--carta) 50%, transparent 50%) 0 0 / 20px 10px;
		background-repeat: repeat-x;
	}
	.conto__testata {
		font-weight: 800;
		font-size: 1.05rem;
		padding-bottom: 14px;
		border-bottom: 3px solid var(--testo);
	}
	.conto__voci :global(li) {
		display: flex;
		justify-content: space-between;
		gap: 16px;
		padding: 12px 0;
		border-bottom: 1px dashed color-mix(in oklab, var(--testo) 35%, transparent);
	}
	.conto__voci :global(small) {
		display: block;
		font-size: 0.85rem;
		color: var(--testo-2);
	}
	.conto__voci :global(b) {
		font-weight: 800;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}
	.conto__catering {
		display: flex;
		gap: 12px;
		align-items: flex-start;
		padding: 14px 0;
		cursor: pointer;
	}
	.conto__catering input {
		flex: none;
		width: 24px;
		height: 24px;
		margin-top: 1px;
		accent-color: var(--foglia);
	}
	.conto__catering small {
		display: block;
		color: var(--testo-2);
	}
	.conto__totale {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 12px;
		padding: 14px 16px;
		background: var(--limone);
		color: var(--inchiostro);
		border-radius: 28px 28px 10px 10px;
		font-weight: 700;
	}
	.conto__totale strong {
		font-size: clamp(1.8rem, 4vw, 2.6rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		font-variant-numeric: tabular-nums;
	}
	.conto__forchetta {
		margin-top: 12px;
		font-weight: 700;
	}
	.conto__nota {
		margin-top: 6px;
		font-size: 0.85rem;
		color: var(--testo-2);
	}
	.confronto h3 {
		font-size: clamp(1.5rem, 3vw, 2rem);
		color: var(--bianco);
	}
	.confronto__aiuto {
		margin-top: 6px;
		color: color-mix(in oklab, var(--bianco) 88%, transparent);
	}
	.opz {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 12px;
		margin-top: 18px;
	}
	.opz__c {
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding: 18px 16px 16px;
		border: 2px solid color-mix(in oklab, var(--bianco) 55%, transparent);
		border-radius: 28px 28px 10px 10px;
	}
	.opz__c[data-piena='true'] {
		border-color: var(--limone);
	}
	.opz__c h4 {
		font-family: var(--serif);
		font-style: italic;
		font-size: 1.15rem;
		color: var(--bianco);
	}
	.opz__corpo {
		flex: 1;
		font-size: 0.93rem;
		color: var(--bianco);
	}
	.opz__corpo :global(b) {
		display: block;
		font-size: 1.4rem;
		letter-spacing: -0.02em;
		color: var(--bianco);
	}
	.opz__azioni {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 10px;
	}
	.opz__azioni .btn {
		border-color: var(--bianco);
		color: var(--bianco);
		min-height: 44px;
		padding: 0 16px;
		font-size: 0.9rem;
	}
	.opz__link {
		background: none;
		border: 0;
		min-height: 44px;
		padding: 0 4px;
		color: var(--limone);
		text-decoration: underline;
		text-underline-offset: 3px;
		cursor: pointer;
	}
	.confronto__diff {
		margin-top: 14px;
		min-height: 1.5em;
		font-weight: 700;
		color: var(--limone);
	}
	.link {
		margin-top: 28px;
	}
	.link label {
		display: block;
		font-size: 0.95rem;
		font-weight: 700;
		color: var(--bianco);
		margin-bottom: 8px;
	}
	.link__riga {
		display: flex;
		gap: 10px;
	}
	.link input {
		flex: 1;
		min-width: 0;
		min-height: 48px;
		padding: 0 14px;
		border: 2px solid var(--bianco);
		border-radius: 10px;
		background: var(--cotto-scuro);
		color: var(--bianco);
		font-size: 0.85rem;
	}
	.link__nota {
		margin-top: 8px;
		font-size: 0.9rem;
		color: color-mix(in oklab, var(--bianco) 90%, transparent);
	}
	@media (max-width: 900px) {
		.prev__griglia {
			grid-template-columns: minmax(0, 1fr);
		}
	}
	@media (max-width: 420px) {
		.opz {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>

<script>
	import { eur, preventivo, verdetto, type Evento } from './evento';
	import { formato, spazio, tipo } from './dati';
	import { ascolta, imposta, leggi, linkScheda, scelte, tieni, usa } from './stato';

	const radice = document.getElementById('preventivo')!;
	const q = <T extends HTMLElement>(s: string) => radice.querySelector<T>(s)!;
	const dataFmt = new Intl.DateTimeFormat('it-IT', { day: 'numeric', month: 'long' });
	const cat = q<HTMLInputElement>('[data-catering]');

	const descrivi = (e: Evento) => {
		const data = e.data ? dataFmt.format(new Date(`${e.data}T12:00:00`)) : 'data da scegliere';
		return `${e.ospiti} ospiti ${spazio(e.spazio).dove}, ${formato(e.formato).nome.toLowerCase()}, ${data}`;
	};

	function aggiorna() {
		const ev = leggi();
		const p = preventivo(ev);
		q('[data-testata]').textContent = `${tipo(ev.tipo).nome}, ${descrivi(ev)}${verdetto(ev).giudizio === 'noncista' ? '. Attenzione: in questa sala non ci state tutti, il prezzo è solo indicativo.' : ''}`;
		q('[data-voci]').innerHTML = p.voci
			.map((v) => `<li><span>${v.nome}${v.nota ? `<small>${v.nota}</small>` : ''}</span><b>${eur(v.importo)}</b></li>`)
			.join('');
		q('[data-totale]').textContent = eur(Math.round(p.totale / 50) * 50);
		q('[data-forchetta]').textContent = `${eur(p.da)} a ${eur(p.a)}`;
		q('[data-testa]').textContent = eur(p.allaTesta);
		cat.checked = ev.catering;
		q('[data-cat-nota]').textContent = `${tipo(ev.tipo).cateringTesta} € a persona`;
		q<HTMLInputElement>('[data-link]').value = linkScheda();

		const s = scelte();
		(['A', 'B'] as const).forEach((k) => {
			const card = q(`[data-slot="${k}"]`);
			const o = s[k];
			card.dataset.piena = String(!!o);
			card.querySelector<HTMLElement>('[data-corpo]')!.innerHTML = o
				? `<b>${eur(Math.round(preventivo(o).totale / 50) * 50)}</b>${descrivi(o)}${o.catering ? ' · con catering' : ''}`
				: 'Vuota';
			card.querySelector<HTMLElement>('[data-usa]')!.hidden = !o;
			card.querySelector<HTMLElement>('[data-tieni]')!.textContent = o ? 'Sostituisci con la scheda di ora' : 'Salva la scheda di ora';
		});
		const diff = q('[data-diff]');
		if (s.A && s.B) {
			const d = preventivo(s.B).totale - preventivo(s.A).totale;
			const va = verdetto(s.A).giudizio;
			const vb = verdetto(s.B).giudizio;
			const nota = va === 'noncista' || vb === 'noncista' ? ' Attenzione: in una delle due non ci state.' : '';
			diff.textContent = d === 0 ? `Costano uguale.${nota}` : `La seconda costa circa ${eur(Math.round(Math.abs(d) / 50) * 50)} ${d > 0 ? 'in più' : 'in meno'} della prima.${nota}`;
		} else diff.textContent = '';
	}

	cat.addEventListener('change', () => imposta({ catering: cat.checked }));
	radice.querySelectorAll<HTMLButtonElement>('[data-tieni]').forEach((b) => b.addEventListener('click', () => tieni(b.dataset.tieni as 'A' | 'B')));
	radice.querySelectorAll<HTMLButtonElement>('[data-usa]').forEach((b) => b.addEventListener('click', () => usa(b.dataset.usa as 'A' | 'B')));

	const esito = q('[data-copia-esito]');
	q<HTMLButtonElement>('[data-copia]').addEventListener('click', async () => {
		const campo = q<HTMLInputElement>('[data-link]');
		try {
			await navigator.clipboard.writeText(campo.value);
			esito.textContent = 'Copiato. Chi lo apre vede la tua stessa pianta.';
		} catch {
			campo.select();
			esito.textContent = 'Seleziona e copia il link qui sopra.';
		}
	});

	ascolta(aggiorna);
	aggiorna();
</script>

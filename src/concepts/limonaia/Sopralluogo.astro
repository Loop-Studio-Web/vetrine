---
---

<section class="sezione sopralluogo" id="sopralluogo" aria-labelledby="t-sopr">
	<div class="wrap sopr__in">
		<div class="sopr__testo">
			<h2 id="t-sopr">Vieni a vedere la sala <em>con la tua pianta in mano.</em></h2>
			<p class="sezione__intro">
				Un’ora, un caffè, il giardino al tramonto se capita. Portiamo la scheda che hai composto: la ritrovi qui sotto.
			</p>
			<div class="riepilogo" aria-label="La tua scheda">
				<div class="riepilogo__mini" data-mini aria-hidden="true"></div>
				<div class="riepilogo__testo">
					<p class="riepilogo__t">La tua scheda</p>
					<p class="riepilogo__c" data-riepilogo>—</p>
					<p class="riepilogo__p" data-riepilogo-prezzo>—</p>
				</div>
			</div>
			<div class="arrivo">
				<h3>Come si arriva</h3>
				<ul>
					<li>Via dei Limoni 12, a due chilometri dal paese (indirizzo di fantasia).</li>
					<li>Parcheggio nel prato: 60 posti, con una zona per i pullman.</li>
					<li data-aziendale>Per le cene aziendali: proiettore e schermo nella limonaia, presa e prolunghe sul palco.</li>
				</ul>
			</div>
		</div>

		<div class="sopr__scheda">
			<form class="modulo" novalidate data-modulo>
				<div class="campo">
					<label for="s-nome">Come ti chiami</label>
					<input id="s-nome" name="nome" type="text" autocomplete="name" required aria-describedby="e-nome" />
					<p class="errore" id="e-nome" hidden></p>
				</div>
				<div class="campo">
					<label for="s-email">La tua email</label>
					<input id="s-email" name="email" type="email" autocomplete="email" required aria-describedby="e-email" />
					<p class="errore" id="e-email" hidden></p>
				</div>
				<div class="campo">
					<label for="s-giorno">Quando puoi venire</label>
					<select id="s-giorno" name="giorno" required aria-describedby="e-giorno" data-giorni>
						<option value="">Scegli un giorno</option>
					</select>
					<p class="errore" id="e-giorno" hidden></p>
				</div>
				<fieldset class="campo">
					<legend>A che ora</legend>
					<div class="orari">
						<label class="orario"><input type="radio" name="fascia" value="mattina" checked /><span>Mattina</span></label>
						<label class="orario"><input type="radio" name="fascia" value="pomeriggio" /><span>Pomeriggio</span></label>
						<label class="orario"><input type="radio" name="fascia" value="tramonto" /><span>Al tramonto</span></label>
					</div>
				</fieldset>
				<div class="campo">
					<label for="s-note">Qualcosa da sapere <small>(facoltativo)</small></label>
					<textarea id="s-note" name="note" rows="3"></textarea>
				</div>
				<button type="submit" class="btn">Prenota il sopralluogo</button>
				<p class="modulo__nota">Vetrina dimostrativa: non viene inviato nulla e nessun dato è conservato.</p>
			</form>

			<div class="invito" data-invito hidden tabindex="-1" role="status">
				<p class="invito__t">Ti aspettiamo</p>
				<p class="invito__g" data-i-giorno></p>
				<div class="invito__mini" data-i-mini aria-hidden="true"></div>
				<p class="invito__c" data-i-corpo></p>
				<p class="invito__nota">Questa è una prova: nessuna richiesta è partita davvero.</p>
				<button type="button" class="btn btn--vuoto" data-i-nuova>Compila di nuovo</button>
			</div>
		</div>
	</div>
</section>

<style>
	.sopralluogo {
		background: var(--fondo);
	}
	.sopr__in {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: clamp(28px, 5vw, 80px);
		align-items: start;
	}
	.riepilogo {
		display: grid;
		grid-template-columns: minmax(0, 150px) minmax(0, 1fr);
		gap: 18px;
		align-items: center;
		margin-top: 30px;
		padding: 16px;
		background: var(--carta);
		border: 2px solid var(--testo);
		border-radius: 28px 28px 10px 10px;
		padding-top: 22px;
	}
	.riepilogo__mini :global(svg) {
		width: 100%;
		min-width: 0;
	}
	.riepilogo__t {
		font-family: var(--serif);
		font-style: italic;
		font-size: 1.15rem;
		color: var(--cotto);
	}
	:root[data-fase='sera'] .riepilogo__t,
	:root[data-fase='notte'] .riepilogo__t {
		color: var(--limone);
	}
	.riepilogo__c {
		margin-top: 2px;
		font-weight: 700;
	}
	.riepilogo__p {
		margin-top: 4px;
		color: var(--testo-2);
	}
	.arrivo {
		margin-top: 28px;
	}
	.arrivo h3 {
		font-size: 1.5rem;
		margin-bottom: 8px;
	}
	.arrivo li {
		position: relative;
		padding-left: 22px;
		margin-top: 6px;
		max-width: 52ch;
	}
	.arrivo li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.6em;
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: var(--foglia-2);
	}
	.sopr__scheda {
		min-width: 0;
	}
	.modulo,
	.invito {
		display: grid;
		gap: 18px;
		padding: clamp(20px, 3vw, 36px);
		background: var(--carta);
		border: 2px solid var(--testo);
		border-radius: 28px 28px 8px 8px;
	}
	.modulo[hidden],
	.invito[hidden] {
		display: none;
	}
	.campo {
		border: 0;
		min-width: 0;
		display: grid;
		gap: 6px;
	}
	.campo label,
	.campo legend {
		font-weight: 700;
		font-size: 0.95rem;
	}
	.campo small {
		font-weight: 400;
		color: var(--testo-2);
	}
	.campo textarea {
		resize: vertical;
	}
	.orari {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}
	.orario input {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}
	.orario span {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: 0 16px;
		border: 2px solid var(--testo);
		border-radius: 999px;
		font-weight: 700;
		cursor: pointer;
	}
	.orario input:checked + span {
		background: var(--foglia);
		border-color: var(--foglia);
		color: var(--bianco);
	}
	.orario input:focus-visible + span {
		outline: 3px solid var(--terracotta);
		outline-offset: 3px;
	}
	.modulo .btn {
		justify-self: start;
	}
	.modulo__nota,
	.invito__nota {
		font-size: 0.9rem;
		color: var(--testo-2);
	}
	.invito {
		justify-items: center;
		text-align: center;
		background: var(--foglia);
		color: var(--bianco);
		border-color: var(--foglia);
	}
	.invito__t {
		font-family: var(--serif);
		font-style: italic;
		font-size: 1.3rem;
	}
	.invito__g {
		font-family: var(--serif);
		font-weight: 600;
		font-size: clamp(1.8rem, 4vw, 2.6rem);
		line-height: 1.1;
	}
	.invito__mini {
		width: min(100%, 360px);
	}
	.invito__nota {
		color: color-mix(in oklab, var(--bianco) 88%, transparent);
	}
	.invito .btn--vuoto {
		color: var(--bianco);
		border-color: var(--bianco);
	}
	@media (max-width: 860px) {
		.sopr__in {
			grid-template-columns: minmax(0, 1fr);
		}
	}
	@media (max-width: 440px) {
		.riepilogo {
			grid-template-columns: minmax(0, 1fr);
			border-radius: 24px;
		}
		.riepilogo__mini {
			max-width: 200px;
		}
	}
</style>

<script>
	import { migliaia, eur, oraTesto, preventivo } from './evento';
	import { dispone } from './pianta';
	import { svgPianta } from './pianta-svg';
	import { ascolta, leggi } from './stato';
	import { formato, spazio, tipo } from './dati';

	const radice = document.getElementById('sopralluogo')!;
	const modulo = radice.querySelector<HTMLFormElement>('[data-modulo]')!;
	const invito = radice.querySelector<HTMLElement>('[data-invito]')!;
	const sel = radice.querySelector<HTMLSelectElement>('[data-giorni]')!;
	const mini = radice.querySelector<HTMLElement>('[data-mini]')!;
	const miniInvito = radice.querySelector<HTMLElement>('[data-i-mini]')!;
	const aziendale = radice.querySelector<HTMLElement>('[data-aziendale]')!;
	const dataFmt = new Intl.DateTimeFormat('it-IT', { day: 'numeric', month: 'long', year: 'numeric' });
	const giornoFmt = new Intl.DateTimeFormat('it-IT', { weekday: 'long', day: 'numeric', month: 'long' });

	// i prossimi sei giorni utili: la sala non fa sopralluoghi la domenica
	{
		const d = new Date();
		let n = 0;
		while (n < 6) {
			d.setDate(d.getDate() + 1);
			if (d.getDay() === 0) continue;
			const o = document.createElement('option');
			o.value = giornoFmt.format(d);
			o.textContent = giornoFmt.format(d);
			sel.append(o);
			n++;
		}
	}

	function riepilogo() {
		const ev = leggi();
		const p = preventivo(ev);
		const data = ev.data ? dataFmt.format(new Date(`${ev.data}T12:00:00`)) : 'data ancora da scegliere';
		radice.querySelector('[data-riepilogo]')!.textContent =
			`${tipo(ev.tipo).nome}, ${migliaia(ev.ospiti)} ospiti ${spazio(ev.spazio).dove}, ${formato(ev.formato).nome.toLowerCase()}, ${data}. Pianta vista alle ${oraTesto(ev.ora)}.`;
		radice.querySelector('[data-riepilogo-prezzo]')!.textContent = `Forchetta indicativa: da ${eur(p.da)} a ${eur(p.a)}.`;
		aziendale.hidden = ev.tipo !== 'aziendale';
		const pianta = dispone(ev.spazio, ev.formato, ev.ospiti, ev.palco);
		mini.innerHTML = svgPianta(pianta);
		mini.querySelector('svg')?.classList.add('ps-sola');
	}

	const campi = ['nome', 'email', 'giorno'] as const;
	const msg: Record<(typeof campi)[number], string> = {
		nome: 'Scrivi come ti chiami.',
		email: 'Scrivi un indirizzo email valido, per esempio nome@posta.it.',
		giorno: 'Scegli un giorno per il sopralluogo.',
	};

	modulo.addEventListener('submit', (e) => {
		e.preventDefault();
		const dati = new FormData(modulo);
		let primo: HTMLElement | null = null;
		for (const c of campi) {
			const v = String(dati.get(c) ?? '').trim();
			const ok = c === 'email' ? /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v) : v.length > 0;
			const el = modulo.elements.namedItem(c) as HTMLElement;
			const err = radice.querySelector<HTMLElement>(`#e-${c}`)!;
			el.setAttribute('aria-invalid', String(!ok));
			err.hidden = ok;
			err.textContent = ok ? '' : msg[c];
			if (!ok && !primo) primo = el;
		}
		if (primo) {
			primo.focus();
			return;
		}
		const ev = leggi();
		const fascia = String(dati.get('fascia'));
		radice.querySelector('[data-i-giorno]')!.textContent = `${String(dati.get('giorno'))}, ${fascia === 'tramonto' ? 'al tramonto' : `di ${fascia}`}`;
		radice.querySelector('[data-i-corpo]')!.textContent =
			`${dati.get('nome')}, ti mostriamo la sala con questa pianta: ${tipo(ev.tipo).nome.toLowerCase()}, ${migliaia(ev.ospiti)} ospiti ${spazio(ev.spazio).dove}.`;
		miniInvito.innerHTML = svgPianta(dispone(ev.spazio, ev.formato, ev.ospiti, ev.palco));
		miniInvito.querySelector('svg')?.classList.add('ps-sola');
		modulo.hidden = true;
		invito.hidden = false;
		invito.focus();
	});
	modulo.addEventListener('input', (e) => {
		const t = e.target as HTMLElement;
		if (t.getAttribute('aria-invalid') === 'true') {
			t.setAttribute('aria-invalid', 'false');
			const err = radice.querySelector<HTMLElement>(`#e-${(t as HTMLInputElement).name}`);
			if (err) err.hidden = true;
		}
	});
	radice.querySelector('[data-i-nuova]')!.addEventListener('click', () => {
		invito.hidden = true;
		modulo.hidden = false;
		modulo.reset();
		modulo.querySelector<HTMLElement>('input')?.focus();
	});

	ascolta(riepilogo);
	riepilogo();
</script>

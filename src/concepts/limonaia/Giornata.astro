---
import { Image } from 'astro:assets';
import serra from '../../assets/limonaia/foto/apertura-serra.jpg';
import tramonto from '../../assets/limonaia/foto/tramonto.jpg';
import sera from '../../assets/limonaia/foto/sera.jpg';
import notte from '../../assets/limonaia/foto/notte.jpg';
import { MOMENTI, oraTesto } from './evento';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const video = [
	{ tappa: 1, file: 'tramonto' },
	{ tappa: 2, file: 'sera' },
];
const foto = [
	{ src: serra, alt: 'La serra di giorno, tavolata apparecchiata tra le piante' },
	{ src: tramonto, alt: 'Il giardino al tramonto, un gazebo con le luci a ghirlanda accese' },
	{ src: sera, alt: 'La sala di sera, tavoli lunghi sotto i lampadari e le luci appese' },
	{ src: notte, alt: 'La serra di notte, tutta illuminata dall’interno' },
];
const scene = [
	'Gli ospiti arrivano sotto le vetrate: acqua e limone, musica bassa, il tempo di salutarsi.',
	'Sedie in file lungo il corridoio centrale, poi il brindisi in piedi.',
	'Si esce tra i vasi di agrumi, mentre in sala si apparecchia.',
	'Tutti seduti: i tavoli sono quelli della pianta, ognuno col suo numero.',
	'Luci basse, un brindisi, il taglio.',
	'I tavoli si ritirano ai lati: al centro nasce la pista.',
	'Si spengono le ghirlande e restano i vetri illuminati.',
];
const momenti = MOMENTI.map((m, i) => ({ ...m, testo: scene[i], ora: oraTesto(m.da) }));
---

<section class="giornata" id="giornata" aria-labelledby="t-giornata" data-giornata>
	<div class="wrap giornata__testata">
		<h2 id="t-giornata">Dalle quattro all’una di notte, <em>nella stessa sala.</em></h2>
		<p class="sezione__intro">
			L’orologio in basso muove tutta la pagina. Qui trovi cosa succede a ogni ora: tocca un momento per andarci.
		</p>
	</div>

	<div class="giornata__scena" data-foto>
		{
			foto.map((f, i) => (
				<Image
					src={f.src}
					alt={f.alt}
					widths={[640, 1000, 1500]}
					sizes="100vw"
					loading="lazy"
					quality={66}
					class={i === 0 ? 'on' : ''}
					data-tappa={i}
				/>
			))
		}
		{
			video.map((v) => (
				<video data-tappa={v.tappa} data-src={`${base}/video/limonaia/${v.file}.mp4`} muted loop playsinline preload="none" aria-hidden="true" tabindex="-1" />
			))
		}
		<div class="scena" aria-live="polite">
			<p class="scena__ora" data-scena-ora>19:00</p>
			<p class="scena__nome" data-scena-nome></p>
			<p class="scena__testo" data-scena-testo></p>
		</div>
		<p class="giornata__didascalia">Foto di archivio, illustrative</p>
	</div>

	<div class="wrap">
		<div class="cielo" aria-hidden="true"><i data-segno></i></div>
		<ol class="tappe" aria-label="Salta a un momento">
			{
				momenti.map((m) => (
					<li>
						<button type="button" data-da={m.da} data-testo={m.testo}>
							<span class="tappe__ora">{m.ora}</span>
							<span class="tappe__nome">{m.breve}</span>
						</button>
					</li>
				))
			}
		</ol>
	</div>
</section>

<style>
	.giornata {
		padding-block: clamp(56px, 8vw, 104px) clamp(48px, 7vw, 88px);
	}
	.giornata__testata {
		text-align: center;
	}
	.giornata__testata h2,
	.giornata__testata .sezione__intro {
		margin-inline: auto;
	}
	.giornata__testata h2 {
		max-width: 22ch;
	}
	.giornata__scena {
		position: relative;
		margin-top: 36px;
		width: 100%;
		aspect-ratio: 21 / 8;
		min-height: 320px;
		overflow: hidden;
		background: var(--inchiostro-2);
		color: var(--bianco);
	}
	.giornata__scena :global(img),
	.giornata__scena :global(video) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0;
		transition: opacity 700ms var(--ease);
	}
	.giornata__scena :global(img.on) {
		opacity: 1;
	}
	.giornata__scena :global(video) {
		z-index: 1;
	}
	.giornata__scena :global(video.on.pronto) {
		opacity: 1;
	}
	.scena {
		position: absolute;
		z-index: 2;
		left: 0;
		right: 0;
		bottom: 0;
		padding: 80px var(--gutter) clamp(18px, 3vw, 36px);
		background: linear-gradient(transparent, rgb(8 14 34 / 0.86));
		display: grid;
		gap: 2px;
	}
	.scena__ora {
		font-weight: 700;
		font-size: 0.95rem;
		font-variant-numeric: tabular-nums;
		color: var(--limone);
	}
	.scena__nome {
		font-family: var(--serif);
		font-style: italic;
		font-weight: 600;
		font-size: clamp(1.8rem, 4vw, 3rem);
		line-height: 1.1;
	}
	.scena__testo {
		max-width: 56ch;
		color: #e3ebf3;
	}
	.giornata__didascalia {
		position: absolute;
		z-index: 2;
		right: var(--gutter);
		top: 12px;
		font-size: 0.78rem;
		padding: 2px 8px;
		border-radius: 999px;
		background: rgb(8 14 34 / 0.6);
		color: var(--bianco);
	}
	/* Il cielo della giornata: il segno scorre con l'ora */
	.cielo {
		position: relative;
		height: 12px;
		margin-top: 28px;
		border-radius: 8px;
		background: linear-gradient(90deg, #f7ea8c 0%, #f2b45a 30%, #c8532b 45%, #3b3f7a 65%, #0b1230 100%);
		border: 2px solid var(--testo);
	}
	.cielo i {
		position: absolute;
		top: -9px;
		left: var(--x, 0%);
		width: 14px;
		height: 28px;
		margin-left: -7px;
		border-radius: 7px 7px 3px 3px;
		background: var(--limone);
		border: 3px solid var(--inchiostro);
		transition: left 200ms var(--ease);
	}
	.tappe {
		margin-top: 22px;
		display: grid;
		grid-template-columns: repeat(7, minmax(0, 1fr));
		gap: 8px;
	}
	.tappe li {
		display: flex;
	}
	.tappe button {
		height: 100%;
		display: grid;
		align-content: center;
		justify-items: center;
		text-align: center;
		gap: 2px;
		width: 100%;
		min-height: 74px;
		padding: 10px 12px;
		background: transparent;
		border: 2px solid color-mix(in oklab, var(--testo) 35%, transparent);
		border-radius: 28px 28px 10px 10px;
		text-align: left;
		cursor: pointer;
		transition:
			background-color 140ms var(--ease),
			color 140ms var(--ease);
	}
	.tappe button[aria-current='true'] {
		background: var(--foglia);
		color: var(--bianco);
		border-color: var(--foglia);
	}
	.tappe__ora {
		font-weight: 800;
		font-variant-numeric: tabular-nums;
	}
	.tappe__ora,
	.tappe__nome {
		text-align: center;
	}
	.tappe__nome {
		font-family: var(--serif);
		font-weight: 600;
		line-height: 1.15;
		font-size: 0.98rem;
	}
	@media (hover: hover) {
		.tappe button:hover {
			border-color: var(--testo);
		}
	}
	@media (max-width: 1000px) {
		.tappe {
			grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
		}
		.giornata__scena {
			aspect-ratio: auto;
			height: 380px;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.giornata__scena :global(img),
		.giornata__scena :global(video),
		.cielo i {
			transition: none;
		}
	}
</style>

<script>
	import { momento, oraTesto, tappa, MOMENTI } from './evento';
	import { ascolta, imposta, leggi } from './stato';

	const radice = document.getElementById('giornata')!;
	const ora = radice.querySelector<HTMLElement>('[data-scena-ora]')!;
	const nome = radice.querySelector<HTMLElement>('[data-scena-nome]')!;
	const testo = radice.querySelector<HTMLElement>('[data-scena-testo]')!;
	const segno = radice.querySelector<HTMLElement>('[data-segno]')!;
	const foto = [...radice.querySelectorAll<HTMLElement>('[data-tappa]')];
	const bottoni = [...radice.querySelectorAll<HTMLButtonElement>('[data-da]')];

	function aggiorna() {
		const ev = leggi();
		const m = momento(ev.ora);
		const idx = MOMENTI.indexOf(m);
		ora.textContent = `Alle ${oraTesto(ev.ora)}`;
		nome.textContent = m.nome;
		testo.textContent = bottoni[idx]?.dataset.testo ?? '';
		bottoni.forEach((b, i) => (i === idx ? b.setAttribute('aria-current', 'true') : b.removeAttribute('aria-current')));
		const t = tappa(ev.ora);
		foto.forEach((f) => f.classList.toggle('on', Number(f.dataset.tappa) === t));
		segno.style.setProperty('--x', `${((ev.ora - 16) / 9) * 100}%`);
	}

	// i video partono solo con la sezione in vista, mai con reduced-motion o risparmio dati
	const video = [...radice.querySelectorAll<HTMLVideoElement>('video[data-src]')];
	const ridotto = matchMedia('(prefers-reduced-motion: reduce)').matches;
	const risparmio = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
	let caricati = false;
	function sincronizza() {
		const t = tappa(leggi().ora);
		for (const v of video) {
			if (!v.src) continue;
			if (Number(v.dataset.tappa) === t) v.play().catch(() => {});
			else v.pause();
		}
	}
	if (!ridotto && !risparmio && 'IntersectionObserver' in window) {
		new IntersectionObserver(
			(voci, o) => {
				if (!voci.some((x) => x.isIntersecting) || caricati) return;
				caricati = true;
				o.disconnect();
				for (const v of video) {
					v.addEventListener('canplay', () => v.classList.add('pronto'), { once: true });
					v.src = v.dataset.src!;
					v.load();
				}
				sincronizza();
			},
			{ rootMargin: '0px 0px -10% 0px' },
		).observe(radice);
	}
	ascolta(sincronizza);

	bottoni.forEach((b) => b.addEventListener('click', () => imposta({ ora: Number(b.dataset.da) })));
	ascolta(aggiorna);
	aggiorna();
</script>

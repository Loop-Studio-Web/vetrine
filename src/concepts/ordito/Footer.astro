---
import simbolo from '../../assets/ordito/brand/simbolo.svg';
import marchio from '../../assets/ordito/brand/marchio.svg';
import logo from '../../assets/hub/loop-logo-on-dark.svg';
---

<footer class="piede grana">
	<p class="piede__parola" aria-hidden="true">ordito</p>
	<div class="piede__in">
		<p class="piede__nome">
			<img src={simbolo.src} alt="" width="44" height="44" />
			<img class="piede__marchio" src={marchio.src} alt="Ordito" width="116" height="26" />
		</p>
		<nav class="piede__nav" aria-label="Piè di pagina">
			<a href="#casa">La casa</a>
			<a href="#capitolato">Su misura</a>
			<a href="#casi">Casi</a>
			<a href="#metodo">Metodo</a>
			<a href="#sopralluogo">Sopralluogo</a>
		</nav>
		<p class="piede__copy">
			&copy; 2026 Ordito. Studio di fantasia: concept dimostrativo. L’attività, i progetti, i prezzi, i numeri e i recapiti non esistono. Privacy e cookie: in una vetrina vera troveresti qui le pagine dedicate.
		</p>
		<a class="piede__credito" href="https://theloopstudio.org/" target="_blank" rel="noopener">
			<span>Sito ideato da</span>
			<img src={logo.src} width="84" height="44" alt="Loop Studio" />
			<span class="sr-only">(si apre in una nuova scheda)</span>
		</a>
	</div>
</footer>

<style>
	.piede {
		position: relative;
		background: var(--inchiostro);
		color: var(--nebbia);
		padding: 0 var(--gutter) 40px;
		overflow: hidden;
	}
	/* la parola gigante: gradiente d'aurora che attraversa tutta la larghezza */
	.piede__parola {
		font-family: var(--titoli);
		font-weight: 700;
		font-size: clamp(5rem, 22vw, 20rem);
		letter-spacing: -0.07em;
		line-height: 0.8;
		text-align: center;
		margin: clamp(24px, 4vw, 60px) 0 -0.06em;
		background: var(--aurora);
		background-size: 200% 100%;
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		-webkit-text-fill-color: transparent;
		animation: aurora-scorre 10s ease-in-out infinite alternate;
		user-select: none;
	}
	.piede__in {
		position: relative;
		max-width: var(--max);
		margin-inline: auto;
		padding-top: 36px;
		border-top: 1px solid rgba(255, 255, 255, 0.18);
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 18px 36px;
	}
	.piede__nome {
		display: flex;
		align-items: center;
		gap: 14px;
		line-height: 1;
	}
	.piede__marchio {
		height: 26px;
		width: auto;
	}
	.piede__nav {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 24px;
		font-weight: 600;
	}
	.piede__nav a {
		text-decoration: none;
		border-bottom: 2px solid transparent;
	}
	.piede__nav a:hover {
		border-bottom-color: var(--lime);
		color: var(--lime);
	}
	.piede__copy {
		grid-column: 1 / 3;
		font-size: 0.86rem;
		color: var(--nebbia-2);
		max-width: 62em;
	}
	.piede__credito {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		font-size: 0.8rem;
		text-decoration: none;
		color: var(--nebbia-2);
	}
	@media (max-width: 760px) {
		.piede__in {
			grid-template-columns: minmax(0, 1fr);
		}
		.piede__copy {
			grid-column: auto;
		}
	}
</style>
